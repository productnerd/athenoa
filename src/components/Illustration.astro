---
// Inlines a line-art SVG from src/assets/illustrations so it can take the page's ink colour
// and be drawn stroke by stroke. To swap artwork, replace the .svg file; nothing else changes.
// A drawing that is one of the symbols (src/data/lemmas.ts) also carries a small note saying what
// it stands for, which opens when a visitor rests on it. Pass note={false} to leave it off.
import { symbolNote } from '../lib/lemma';
import { getLocale } from '../lib/locale';

interface Props {
  name: string;
  class?: string;
  draw?: boolean;
  label?: string;
  note?: boolean;
  [key: string]: unknown;
}
const { name, class: className, draw = false, label, note = true, ...rest } = Astro.props;
const files = import.meta.glob<string>('../assets/illustrations/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});
const svg = files[`../assets/illustrations/${name}.svg`];
if (!svg) throw new Error(`Illustration "${name}" not found in src/assets/illustrations`);
const about = note ? symbolNote(name, getLocale(Astro.url)) : undefined;
// The sun's rays are handed to the page as three drawings laid over one another, every third ray in
// each, so that each set can lengthen and shorten in its own time (global.css) by its transform
// alone. Animating the rays inside one drawing would have it redrawn on every frame.
const layers = (source: string, n: number) => {
  const open = source.match(/^<svg[^>]*>/)?.[0];
  const shapes = source.match(/<path[^>]*\/>/g);
  if (!open || !shapes) return [source];
  return Array.from({ length: n }, (_, k) => open + shapes.filter((_, i) => i % n === k).join('') + '</svg>');
};
const drawings = name === 'sun-rays' ? layers(svg, 3) : [svg];
---

<span
  class:list={['illo', `illo--${name}`, className]}
  data-draw={draw ? '' : undefined}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label || about ? undefined : 'true'}
  data-lemma={about ? '' : undefined}
  tabindex={about ? 0 : undefined}
  aria-describedby={about?.id}
  {...rest}
>
  {drawings.map((drawing) => <Fragment set:html={drawing} />)}{about && <Fragment set:html={about.html} />}
</span>
