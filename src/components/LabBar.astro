---
// Preview aid, not part of the final site: quick links to pages that are still being built.
// Remove this component (and its import in Base.astro) before launch.
const pages = Object.keys(import.meta.glob('../pages/**/*.astro'));
const has = (file: string) => pages.includes(`../pages/${file}`);
const links = [
  { label: 'Home', href: '/', show: has('index.astro') },
  { label: 'About Athena', href: '/about-athena/', show: has('about-athena.astro') },
  { label: 'Courses', href: '/courses/', show: has('courses/index.astro') },
  { label: 'Hero A', href: '/lab/hero-a/', show: has('lab/hero-a.astro') },
  { label: 'Hero B', href: '/lab/hero-b/', show: has('lab/hero-b.astro') },
  { label: 'Hero C', href: '/lab/hero-c/', show: has('lab/hero-c.astro') },
  { label: 'Kit', href: '/lab/kit/', show: has('lab/kit.astro') },
].filter((link) => link.show);
---

<nav class="lab-bar" aria-label="Work in progress">
  <span>In progress</span>
  {links.map((link) => <a href={link.href}>{link.label}</a>)}
</nav>

<style>
  .lab-bar {
    position: fixed;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 60;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem 0.2rem;
    max-width: calc(100vw - 1.8rem);
    padding: 0.35rem 0.5rem 0.35rem 0.9rem;
    background: color-mix(in srgb, var(--creme-light) 92%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--blue) 28%, transparent);
    border-radius: 1.3rem 1.6rem 1.2rem 1.7rem / 1.7rem 1.2rem 1.6rem 1.3rem;
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    color: var(--blue-deep);
    backdrop-filter: blur(6px);
  }
  .lab-bar span {
    margin-right: 0.3rem;
    opacity: 0.7;
  }
  .lab-bar a {
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .lab-bar a:hover {
    background: var(--blue);
    color: var(--creme-light);
  }
  @media (max-width: 40rem) {
    .lab-bar {
      display: none;
    }
  }
  @media print {
    .lab-bar {
      display: none;
    }
  }
</style>
