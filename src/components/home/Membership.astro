---
// Home: the annual membership invitation, on crème paper with light-blue cut-outs.
// Apollo stands in a plain arch niche with a ring of light behind; the three promises sit beside
// him as three different cut-outs; the frieze procession passes in front as a ribbon.
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import apollo from '../../assets/media/apollo-statue.jpg';
import frieze from '../../assets/media/frieze-procession.jpg';
import { content } from '../../data';
import { getLocale, mainLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { home } = content(locale);
const { title, question, points } = home.membership;

// Words this component adds itself.
const t = {
  en: {
    apolloAlt: 'Gilded statue of Apollo holding a lyre, standing on top of an Ionic column',
    friezeAlt: 'Painted frieze of a procession of women in white robes carrying flowers and offerings',
  },
  el: {
    apolloAlt: 'Επίχρυσο άγαλμα του Απόλλωνα με λύρα, στημένο πάνω σε ιωνικό κίονα',
    friezeAlt: 'Ζωγραφιστή ζωφόρος με πομπή γυναικών σε λευκούς χιτώνες, που κρατούν άνθη και προσφορές',
  },
}[mainLocale(locale)];

// One look per point, in the order of the copy: paper with a light-blue plate behind it,
// a light-blue pebble, darker paper. Shape and emblem differ; the depths stay close together.
const looks = [
  { emblem: 'icon-spirit', box: 'box box--offset', depth: '0.02' },
  { emblem: 'icon-community', box: 'box on-blue-light', depth: '-0.03' },
  // The ear of wheat shown at Eleusis: what is given comes back as new life
  { emblem: 'wheat', box: 'box box--deep', depth: '0.02' },
];
---

<section class="section membership" aria-labelledby="membership-title">
  <div class="wrap membership__grid">
    <header class="membership__head">
      <h2 class="t-2" id="membership-title" data-split>{title}</h2>
      <p class="lead" data-reveal style="--delay:250ms">{question}</p>
    </header>

    <div class="niche theme-day">
      <div class="niche__rays" data-depth="0.3">
        <Illustration name="sun-rays" draw />
      </div>
      <!-- The statue's white ground is multiplied onto plain paper, so it reads as paper. -->
      <Media
        class="niche__statue"
        src={apollo}
        alt={t.apolloAlt}
        shape="arch"
        ratio="3 / 5"
        focus="50% 12%"
        widths={[360, 560, 768]}
        sizes="(min-width: 62rem) 27vw, 70vw"
      />
    </div>

    <ul class="points" role="list">
      {
        points.map((point, i) => (
          <li
            class:list={['point', `point--${i + 1}`, looks[i].box]}
            data-reveal
            data-depth={looks[i].depth}
            style={`--i:${i + 1}`}
          >
            <Illustration name={looks[i].emblem} class="point__emblem" draw />
            <div class="point__copy">
              <h3 class="t-3">{point.title}</h3>
              <p>{point.text}</p>
            </div>
          </li>
        ))
      }
    </ul>

    {/* The "Discover all the features" button was removed at the client's wish (11 October 2026) */}

    <Media
      class="membership__frieze"
      src={frieze}
      alt={t.friezeAlt}
      shape="pill"
      focus="62% 30%"
      widths={[560, 800, 1096]}
      sizes="(min-width: 62rem) 76vw, 120vw"
      data-depth="0.06"
    />
  </div>
</section>

<style>
  /* The ring of rays runs off the page edge; clip it there without cutting the parallax vertically */
  .membership {
    overflow-x: clip;
  }
  .membership__grid {
    --col-gap: clamp(1rem, 0.4rem + 1.7vw, 2rem);
    position: relative;
    isolation: isolate;
  }

  .membership__head {
    position: relative;
    z-index: 2;
  }
  .membership__head .lead {
    margin-top: var(--space-m);
  }

  /* ---------- The niche ---------- */
  .niche {
    position: relative;
    width: min(68%, 19rem);
    margin: clamp(5.5rem, 26vw, 8rem) auto 0;
  }
  /* A ring of light behind the arch, far away: it drifts slower than the page. */
  .niche__rays {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 30%;
    width: 196%;
    margin: -98% 0 0 -98%;
    pointer-events: none;
  }
  .niche__rays :global(.illo) {
    color: color-mix(in srgb, var(--blue) 46%, transparent);
  }
  /* The paper ground sits on the figure and is handed down to the photo's frame, so the
     multiplied photograph always has it to blend with, whichever of the two is being clipped. */
  .niche :global(.niche__statue) {
    z-index: 1;
    border-radius: var(--r-arch);
    background-color: var(--creme-deep);
  }
  .niche :global(.niche__statue .media__clip) {
    background: inherit;
  }
  .niche :global(.niche__statue img) {
    mix-blend-mode: multiply;
  }
  /* Hairline echo of the arch, like the border of a label */
  .niche::after {
    content: '';
    position: absolute;
    inset: -0.75rem;
    z-index: 1;
    border: 1.5px solid var(--line);
    border-radius: var(--r-arch);
    pointer-events: none;
  }
  /* The same slow breathing as the line around the framed portrait, without the turn (it is an arch) */
  @keyframes niche-breathe {
    0%,
    100% {
      transform: scale(1);
    }
    35% {
      transform: scale(1.018, 1.01);
    }
    70% {
      transform: scale(0.992, 1.014);
    }
  }
  :global(html.motion) .niche::after {
    transform-origin: 50% 100%;
    animation: niche-breathe 10s ease-in-out infinite;
    will-change: transform;
  }

  /* ---------- The three points ---------- */
  .points {
    position: relative;
    z-index: 1;
    display: grid;
    /* The three belong together: close enough that the shapes almost touch */
    gap: 1.25rem var(--col-gap);
    margin-top: -3.25rem;
  }
  .point {
    display: grid;
    align-content: start;
    gap: 0.85rem 1.4rem;
  }
  .point :global(.point__emblem) {
    width: clamp(4rem, 3.4rem + 2vw, 5.25rem);
  }
  .point__copy > p {
    margin-top: 0.5rem;
    max-width: 44ch;
  }

  /* 1: a wide sheet of paper. The second plate of the print, in light blue, shows behind it. */
  .points .point--1 {
    --box-r: var(--r-soft);
  }
  .points .point--1::after {
    border: 0;
    background: var(--blue-light);
    filter: url(#rough-sm);
  }
  /* 2: a light-blue pebble. The shape overshoots its text so the curve never crowds a word. */
  .points .point--2 {
    --box-r: var(--r-pebble-2);
    width: min(84%, 21rem);
    margin-inline: auto;
    margin-block: 1.4rem 1.2rem;
    padding: 1.9rem 2rem 2.2rem 2.4rem;
  }
  .points .point--2::before {
    inset: -1.9rem -1.3rem -2.1rem -1rem;
  }
  /* 3: a leaf of darker paper, its emblem set on the upper edge, half on the page */
  .points .point--3 {
    --box-r: var(--r-leaf);
    padding-inline: clamp(1.9rem, 1.4rem + 1.6vw, 2.5rem);
  }
  .point--3 :global(.point__emblem) {
    position: absolute;
    /* The ear of wheat is tall: narrower than the square emblems, and set higher */
    top: -3.6rem;
    right: 1.8rem;
    width: clamp(2.9rem, 2.5rem + 1vw, 3.5rem);
  }
  .point--3 .point__copy {
    padding-right: 1rem;
  }

  /* ---------- The frieze ribbon ---------- */
  .membership__grid :global(.membership__frieze) {
    width: 128%;
    margin-top: var(--space-l);
  }
  .membership__grid :global(.membership__frieze .media__clip) {
    aspect-ratio: 3.1 / 1;
  }

  @media (min-width: 36rem) {
    .points .point--1 {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
    }
    .membership__grid :global(.membership__frieze) {
      width: 112%;
    }
    .membership__grid :global(.membership__frieze .media__clip) {
      aspect-ratio: 4 / 1;
    }
  }

  /* From wide tablets up the three stand side by side in one row across the page (client direction,
     11 October 2026): emblem, title and text stacked in each, the shapes the same height and nearly
     touching. */
  @media (min-width: 52rem) {
    .points {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
      gap: 1rem;
      margin-top: var(--space-l);
    }
    .points .point {
      grid-template-columns: none;
      width: auto;
      margin: 0;
      padding: 1.6rem 1.4rem 1.9rem;
    }
    .point h3 {
      font-size: clamp(1.35rem, 0.9rem + 1.3vw, 1.9rem);
    }
    /* the pebble's shape overshoots its box only a little here, so it does not ride over its neighbours */
    .points .point--2 {
      padding: 1.8rem 1.5rem 2.1rem 1.7rem;
    }
    .points .point--2::before {
      inset: -0.8rem -0.35rem -1rem -0.35rem;
    }
    .points .point--3 {
      padding: 2.5rem 1.5rem 1.9rem;
    }
    .point--3 :global(.point__emblem) {
      top: -2.4rem;
      right: 1.2rem;
    }
    .point--3 .point__copy {
      padding-right: 0;
    }
  }

  @media (min-width: 62rem) {
    .membership__grid {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
      align-items: start;
    }
    .membership__head {
      grid-column: 1 / span 9;
      grid-row: 1;
    }
    .points {
      grid-column: 1 / -1;
      grid-row: 2;
      gap: 1.25rem;
      margin-top: calc(var(--space-l) + 1rem);
    }
    /* The statue stands at the foot of the section; the frieze passes behind it */
    .niche {
      grid-column: 10 / span 3;
      grid-row: 3 / span 2;
      align-self: end;
      width: auto;
      margin: var(--space-l) 0.75rem -1.75rem;
    }
    .niche__rays {
      width: 230%;
      margin: -115% 0 0 -115%;
    }
    /* The procession passes behind the niche: its far end is hidden by the arch */
    .membership__grid :global(.membership__frieze) {
      grid-column: 1 / span 10;
      grid-row: 4;
      align-self: end;
      width: auto;
      margin-top: var(--space-l);
    }
    .membership__grid :global(.membership__frieze .media__clip) {
      aspect-ratio: 4.6 / 1;
    }
  }
</style>
