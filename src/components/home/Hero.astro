---
// Home hero. The original hero picture of athenoa.academy (the temple at night, Athena rising
// behind its pediment with her spear and a Nike, the flame in the doorway) redrawn as a two-ink
// night print. One wide cut-out of darker Greek blue below the sticky header: the title stands in
// the open sky on the left, Athena and the temple take the right, stars and the Milky Way run
// behind both, trees stand in the lower corners. On narrow or upright screens the title sits
// above and the picture below. It is a night scene in both themes, hence theme-day on the panel.
//
// Artwork: src/assets/illustrations/portal-b-*.svg, generated by scripts/illustrations/portal-b-build.mjs.
// The picture layers share one square frame (viewBox 0 0 1000 1000, temple axis at x 500, the
// temple's ground at y 946). The frame is placed by --scene-h (its size), --scene-x (its centre
// line) and --scene-b (how far it stands above the bottom of the panel). --u is one drawing unit,
// so the trees and the near ground keep the same stroke weight as the rest.
import Illustration from '../Illustration.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { home } = content(locale);
const highlight = home.hero.highlight;
---

<section class:list={['hero', `hero--${locale}`]} data-pointer-scene>
  <div class="hero__panel panel panel--big on-blue-deep theme-day">
    <div class="panel__clip hero__stage" aria-hidden="true">
      <div class="hero__layer hero__layer--sky" data-depth="0.5" data-pointer="-6" data-reveal="fade">
        <Illustration name="portal-b-sky" />
      </div>
      <div class="hero__layer hero__layer--milky" data-depth="0.42" data-pointer="-4" data-reveal="fade">
        <Illustration name="portal-b-milkyway" />
      </div>
      <div class="hero__layer hero__layer--glow hero__scene" data-depth="0.3" data-reveal="fade">
        <Illustration name="portal-b-rays" draw />
      </div>
      <div class="hero__layer hero__layer--athena hero__scene" data-depth="0.22" data-reveal="fade">
        <Illustration name="portal-b-athena" draw />
      </div>
      <div class="hero__layer hero__layer--temple hero__scene" data-depth="0.12" data-reveal="fade">
        <Illustration name="portal-b-hill" draw />
        <Illustration name="portal-b-cella" />
        <Illustration name="portal-b-light" />
        <Illustration name="portal-b-temple" draw />
        <Illustration name="portal-b-flame" />
      </div>
      <div class="hero__layer hero__layer--trees-l hero__trees" data-depth="-0.2" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-trees-left" />
      </div>
      <div class="hero__layer hero__layer--trees-r hero__trees" data-depth="-0.28" data-pointer="12" data-reveal="fade">
        <Illustration name="portal-b-trees-right" />
      </div>
      <div class="hero__layer hero__layer--ground" data-depth="-0.1" data-pointer="5" data-reveal="fade">
        <Illustration name="portal-b-ground" />
      </div>
      <div class="hero__grain"></div>
    </div>

    <h1 class="hero__title t-hero" data-split>
      {
        home.hero.titleLines.map((line, n) => {
          const at = line.indexOf(highlight);
          // The first line is the title; what follows is its subtitle, set smaller and shown in
          // lower case (home.hero.subtitle), because the handwritten face is unreadable in capitals.
          // (the space keeps the lines apart when the heading is read out as one sentence)
          if (at < 0)
            return (
              <>
                {n > 0 && ' '}
                <span class:list={['hero__line', n > 0 && 't-sub']}>{n > 0 ? home.hero.subtitle : line}</span>
              </>
            );
          return (
            <span class="hero__line">
              {line.slice(0, at)}
              <span class="hl">
                {highlight.split(' ').map((word, n) => (
                  <>
                    {n > 0 && ' '}
                    <span class="hl__w">{word}</span>
                  </>
                ))}
              </span>
              {line.slice(at + highlight.length)}
            </span>
          );
        })
      }
    </h1>
  </div>
</section>

<style>
  .hero {
    --hero-inset: clamp(0.6rem, 0.2rem + 1.1vw, 1.25rem);
    --hero-pad: clamp(1.4rem, 0.2rem + 4.6vw, 5.25rem);
    --panel-w: calc(100vw - 2 * var(--hero-inset));
    --panel-h: max(calc(100svh - var(--header-h) - var(--hero-inset)), 30rem);
    /* The picture: from the tips of the rays over Athena's head to the near ground it is 1.124
       frames tall, so 0.84 of the panel leaves it air under the top edge. */
    --scene-h: min(var(--panel-h) * 0.84, var(--panel-w) * 0.5);
    --scene-m: calc(var(--panel-w) * 0.04);
    --scene-x: calc(100% - var(--scene-m) - var(--scene-h) / 2);
    --scene-b: calc(var(--u) * 34);
    --u: calc(var(--scene-h) / 1000);
    /* The open sky left of the roof: the column the title is set in, and how many ems of title
       it has to hold (the longest line the language needs). */
    --hero-col: calc(var(--panel-w) - var(--scene-m) - var(--scene-h) * 0.93 - var(--hero-pad));
    --hero-fit: 6.9;
    --hero-fs: min(calc(var(--hero-col) / var(--hero-fit)), 10.4svh, 6.6rem);

    /* The sticky header keeps its strip of crème paper; the night cut-out starts right below it,
       inset from the page edge like every cut-out. */
    padding: 0 var(--hero-inset) var(--hero-inset);
  }
  /* Greek titles fall back to a wider face and the words are longer. */
  .hero--el {
    --hero-fit: 8.75;
  }

  .hero__panel {
    /* The three blues, as the drawings read them: night ground, stone wash, light wash. Set here,
       on the element that carries theme-day, so they are the daytime blues in both themes. */
    --pb-night: var(--blue-deep);
    --pb-stone: var(--blue);
    --pb-light: var(--blue-light);

    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: min(var(--panel-h), var(--panel-w) * 0.66);
    /* the bottom padding keeps the title above the trees */
    padding: clamp(1.6rem, 4svh, 3rem) var(--hero-pad) calc(var(--scene-h) * 0.27);
  }

  /* ---------- title ---------- */
  /* The block is as wide as its longest line needs and no wider, whatever limits the size, so
     the lines always break the same way: the highlighted words one above the other. */
  .hero__title {
    width: calc(var(--hero-fit) * 1em);
    max-width: 100%;
    font-size: var(--hero-fs);
    text-wrap: wrap;
  }
  .hero__line {
    display: block;
  }
  /* On the night panel the highlighted words are dark, so their swash has to hold every letter:
     a little wider and squarer than the kit's. */
  .hero__title .hl__w::before {
    inset: -0.03em -0.36em -0.08em -0.34em;
    border-radius: 22% 27% 20% 29% / 44% 40% 47% 42%;
  }
  .hero__title .hl__w:nth-child(even)::before {
    inset: -0.06em -0.38em -0.05em -0.33em;
    border-radius: 27% 21% 29% 22% / 41% 46% 40% 45%;
  }
  /* The subtitle in the handwritten voice face, light blue on the night ground. It keeps the
     kit's proportion to its title (step-3 under step-5 is 0.48), so it follows whichever hand
     the kit settles on, and never drops below the size a hand needs. Usually one line; where
     the column is too narrow it breaks into two even ones. */
  .hero__title .t-sub {
    margin-top: 0.6em;
    font-size: max(0.48em, 1.3rem);
    text-wrap: balance;
  }

  /* ---------- stage ---------- */
  .hero__layer {
    position: absolute;
    inset: 0;
  }
  /* Each drawing's wrapper is the positioned box; the SVG fills it and may draw outside its frame. */
  .hero__layer :global(.illo) {
    position: absolute;
    color: var(--creme);
  }
  .hero__layer :global(svg) {
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }
  .hero__layer--sky :global(.illo),
  .hero__layer--milky :global(.illo) {
    inset: -5% -2%;
  }
  .hero__scene :global(.illo) {
    left: var(--scene-x);
    bottom: var(--scene-b);
    width: var(--scene-h);
    height: var(--scene-h);
    translate: -50% 0;
  }
  /* The trees stand behind the near ground line, which hides their feet. */
  .hero__layer--trees-l :global(.illo) {
    left: calc(var(--u) * -34);
    bottom: calc(var(--scene-b) - var(--u) * 20);
    width: calc(var(--u) * 620);
    height: calc(var(--u) * 360);
  }
  .hero__layer--trees-r :global(.illo) {
    right: calc(var(--u) * -44);
    bottom: calc(var(--scene-b) - var(--u) * 20);
    width: calc(var(--u) * 320);
    height: calc(var(--u) * 430);
  }
  .hero__layer--ground :global(.illo) {
    left: 50%;
    bottom: calc(var(--scene-b) - var(--u) * 66);
    width: calc(var(--u) * 3200);
    height: calc(var(--u) * 140);
    translate: -50% 0;
  }

  /* Paper grain over the flat washes, still while they move underneath. */
  .hero__grain {
    position: absolute;
    inset: 0;
    background-image: url('/textures/grain-light.webp');
    background-size: 400px 400px;
  }

  /* The drawings carry their stroke in their own units, so the line thins as the picture shrinks.
     These steps keep it near one and a half pixels. */
  @media (max-height: 46rem), (max-width: 80rem) {
    .hero__layer :global(svg) {
      stroke-width: 3;
    }
  }

  /* ---------- load sequence (only when motion is on) ----------
     One sequence: the sky; the temple and Athena draw themselves; the light behind her head; the
     trees come up; the doorway opens and its light reaches out; the title rises word by word; its
     highlight arrives last. */
  .hero__layer--milky {
    --delay: 150ms;
  }
  .hero__layer--temple {
    --delay: 250ms;
  }
  .hero__layer--ground {
    --delay: 350ms;
  }
  .hero__layer--athena {
    --delay: 500ms;
  }
  .hero__layer--trees-l {
    --delay: 650ms;
    --rise: 3.5rem;
  }
  .hero__layer--trees-r {
    --delay: 800ms;
    --rise: 5rem;
  }
  .hero__layer--glow {
    --delay: 850ms;
  }
  .hero__title {
    --delay: 1400ms;
    --hl-delay: 2.2s;
  }
  /* The title face stands taller than its line: sink the waiting words fully out of the mask. */
  :global(html.motion) .hero__title:not(.is-in) :global(.w__i) {
    transform: translate3d(0, 135%, 0);
  }
  /* The trees come up from behind the ground line. The drawing rises inside its layer, so the
     layer itself keeps still and the parallax script measures it where it will stand. */
  :global(html.motion) .hero__trees :global(.illo) {
    transition: transform var(--dur-3) var(--ease-out) var(--delay, 0ms);
  }
  :global(html.motion) .hero__trees:not(.is-in) :global(.illo) {
    transform: translate3d(0, var(--rise, 3rem), 0);
  }
  /* Quicker, tighter line drawing than the site default, so the picture is whole in two seconds. */
  :global(html.motion) .hero__stage :global([data-draw] path) {
    transition-duration: 1.3s;
    transition-delay: calc(min(var(--i, 0), 110) * 6ms + var(--delay, 0ms) + 100ms);
  }
  /* the rays behind her all reach outwards together */
  :global(html.motion) .hero__layer--glow :global([data-draw] path) {
    transition-duration: 1.5s;
    transition-delay: calc(var(--delay, 0ms) + 250ms);
  }
  /* what is not drawn (the lettering, the pupils, the disc of light) follows the lines */
  :global(html.motion) .hero__stage :global([data-draw] [data-nodraw]) {
    transition-delay: calc(var(--delay, 0ms) + 1000ms);
  }
  :global(html.motion) .hero__layer--glow :global([data-draw] [data-nodraw]) {
    transition-delay: calc(var(--delay, 0ms) + 100ms);
  }
  /* Until the script has prepared a path, its dashes are in plain units and would show as dots. */
  :global(html.motion) .hero__stage :global([data-draw] path:not([pathLength], [data-nodraw])) {
    stroke-opacity: 0;
  }
  /* The doorway opens: the flame appears, the arch of light grows from it, then the rays reach
     out between the columns and down the steps. */
  .hero__stage :global(.pb-door),
  .hero__stage :global(.pb-beams),
  .hero__stage :global(.pb-spill) {
    transform-box: view-box;
    transform-origin: 50% 84.8%;
  }
  :global(html.motion) .hero__stage :global(.illo--portal-b-flame) {
    transition: opacity 0.8s var(--ease-out) 1050ms;
  }
  :global(html.motion) .hero__stage :global(.pb-door) {
    transition:
      transform 1.1s var(--ease-out) 1250ms,
      opacity 0.35s linear 1250ms;
  }
  :global(html.motion) .hero__stage :global(.pb-beams),
  :global(html.motion) .hero__stage :global(.pb-spill) {
    transition:
      transform 1.3s var(--ease-out) 1500ms,
      opacity 0.9s var(--ease-out) 1500ms;
  }
  :global(html.motion) .hero__layer--temple:not(.is-in) :global(.illo--portal-b-flame) {
    opacity: 0;
  }
  :global(html.motion) .hero__layer--temple:not(.is-in) :global(.pb-door) {
    transform: scale(0.3, 0.12);
    opacity: 0;
  }
  :global(html.motion) .hero__layer--temple:not(.is-in) :global(.pb-beams),
  :global(html.motion) .hero__layer--temple:not(.is-in) :global(.pb-spill) {
    transform: scale(0.25);
    opacity: 0;
  }

  /* The flame breathes, very slowly. Nothing else loops. */
  @keyframes hero-breathe {
    from {
      transform: scale(1, 1);
      opacity: 1;
    }
    to {
      transform: scale(0.95, 1.06);
      opacity: 0.88;
    }
  }
  .hero__stage :global(.pb-fire) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  :global(html.motion) .hero__stage :global(.pb-fire) {
    animation: hero-breathe 5.2s var(--ease-in-out) infinite alternate;
  }

  /* ---------- narrow or upright screens: the title in the sky above, the picture below ---------- */
  @media (max-width: 61.99rem), (max-aspect-ratio: 1/1) {
    .hero {
      --scene-h: min(var(--panel-w) * 1.06, 47.5svh);
      --scene-x: 50%;
      /* the picture stands higher, on a band of ground deep enough for the music button, which is
         fixed in the lower left corner of the screen */
      --scene-b: calc(var(--u) * 95);
      --hero-col: calc(var(--panel-w) - 2 * var(--hero-pad));
      --hero-fs: min(calc(var(--hero-col) / var(--hero-fit)), 6svh);
    }
    .hero__panel {
      justify-content: flex-start;
      min-height: 0;
      /* room for the picture (rays, frame and ground band are 1.185 frames tall) and a breath
         between the subtitle and the rays */
      padding: clamp(1.5rem, 3.4svh, 2.6rem) var(--hero-pad) calc(var(--scene-h) * 1.245);
    }
    .hero__layer :global(svg) {
      stroke-width: 3.5;
    }
    /* here the band of stars would lie hidden behind the picture: lift it into the open sky */
    .hero__layer--milky :global(.illo) {
      inset: -19% -2% 9%;
    }
    .hero__title .hl__w::before,
    .hero__title .hl__w:nth-child(even)::before {
      left: -0.24em;
      right: -0.3em;
    }
    /* The trees keep to the picture instead of the corners of the panel: on a phone only a
       cypress shows at each end of the steps, on an upright tablet the groups stand beside them. */
    .hero__layer--trees-l :global(.illo) {
      left: calc(50% - var(--u) * 1018);
    }
    .hero__layer--trees-r :global(.illo) {
      left: calc(50% + var(--u) * 333);
      right: auto;
    }
  }
</style>
