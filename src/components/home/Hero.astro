---
// Home hero. The original hero picture of athenoa.academy (the temple, Athena rising behind its
// pediment with her spear and a Nike, the flame in the doorway) redrawn as a two-ink print.
//
// CLIENT DIRECTION, 11 October 2026: the picture is full bleed (it runs under the header to the
// edges of the window, no cut-out) and its foot fades into the page below the first screen; the
// trees on the left are gone so the title can be large and tall; and the picture follows the
// day/night switch: a marble temple under a light-blue sky by day, the starry night scene by night.
//
// The title stands in the open sky on the left, one or two words to a row; Athena and the temple
// take the right. On narrow or upright screens the title sits above and the picture below.
//
// Artwork: src/assets/illustrations/portal-b-*.svg, generated by scripts/illustrations/portal-b-build.mjs.
// The picture layers share one square frame (viewBox 0 0 1000 1000, temple axis at x 500, the
// temple's ground at y 946). The frame is placed by --scene-h (its size), --scene-x (its centre
// line) and --scene-b (how far it stands above the foot of the first screen). --u is one drawing
// unit, so the trees and the near ground keep the same stroke weight as the rest.
import Illustration from '../Illustration.astro';
import HeroBird from './HeroBird.astro';
import FireSound from './FireSound.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { home } = content(locale);
const highlight = home.hero.highlight;
// CLIENT DIRECTION, 11 October 2026: Athena (with her spear and the Nike) is hidden for now and may
// come back later, and so are the disc and rays behind her head, which read as a sun over the roof
// without her. Set this to true to show them all again; nothing else needs to change.
const showAthena = false;
// Beside the picture the title is a tall stack. Words per row, for the words before the highlight
// (each highlighted word takes a row of its own). English: "STUDY AT / THE MODERN / PLATONIC /
// ACADEMY" (client direction, 13 October 2026).
const stack = { en: [2, 2], el: [1, 2], grc: [1, 3] }[locale];
const rowsOf = (text: string) => {
  const words = text.trim().split(/\s+/).filter(Boolean);
  const rows: string[] = [];
  let i = 0;
  for (const n of stack) {
    if (i < words.length) rows.push(words.slice(i, i + n).join(' '));
    i += n;
  }
  if (i < words.length) rows.push(words.slice(i).join(' '));
  return rows;
};
---

<section class:list={['hero', `hero--${locale}`, !showAthena && 'hero--bare']} data-pointer-scene>
  <div class="hero__panel theme-day">
    <div class="hero__stage" aria-hidden="true">
      <div class="hero__layer hero__layer--sky" data-depth="0.5" data-pointer="-6" data-reveal="fade">
        <Illustration name="portal-b-sky" />
      </div>
      {
        [1, 2, 3].map((n) => (
          <div
            class="hero__layer hero__layer--sky hero__layer--tw"
            data-depth="0.5"
            data-pointer="-6"
            data-reveal="fade"
            style={`--n:${n - 1}`}
          >
            <Illustration name={`portal-b-stars-${n}`} />
          </div>
        ))
      }
      <div class="hero__layer hero__layer--milky" data-depth="0.42" data-pointer="-4" data-reveal="fade">
        <Illustration name="portal-b-milkyway" />
      </div>
      {/* The day sky: soft shapes of cloud with no outline drift across it, slower than the drawn clouds */}
      <div class="hero__layer hero__layer--haze" data-depth="0.46" data-reveal="fade">
        {[0, 1, 2, 3, 4, 5, 6].map((n) => <Illustration name="hero-cloud-soft" class={`hero__haze hero__haze--${n + 1}`} />)}
      </div>
      {/* The drawn clouds are gone (client direction, 11 October 2026): only the loose streaks remain */}
      <div class="hero__layer"><span class="hero__meteor"></span></div>
      {/* Now and then two birds cross the sky */}
      <div class="hero__layer hero__layer--birds" data-depth="0.3">
        <Illustration name="hero-bird" class="hero__bird hero__bird--1" />
        <Illustration name="hero-bird" class="hero__bird hero__bird--2" />
      </div>
      {
        showAthena && (
          <>
            <div class="hero__layer hero__layer--glow hero__scene" data-depth="0.3" data-reveal="fade">
              <Illustration name="portal-b-rays" draw />
            </div>
            <div class="hero__layer hero__layer--athena hero__scene" data-depth="0.22" data-reveal="fade">
              <Illustration name="portal-b-athena" draw />
            </div>
          </>
        )
      }
      <div class="hero__layer hero__layer--temple hero__scene" data-depth="0.12" data-reveal="fade">
        <Illustration name="portal-b-cella" />
        <Illustration name="portal-b-light" />
        <Illustration name="portal-b-temple" draw />
        <Illustration name="portal-b-flame" />
      </div>
      {/* The fire: two small drawings over the bowl (the dark tongue and its bright heart), so it can flicker without redrawing the temple */}
      <div class="hero__layer hero__layer--fire" data-depth="0.12" data-reveal="fade">
        <Illustration name="portal-b-fire-1" class="hero__fire hero__fire--1" />
        <Illustration name="portal-b-fire-2" class="hero__fire hero__fire--2" />
      </div>
      <div class="hero__layer hero__layer--trees-l hero__trees" data-depth="-0.2" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-trees-left" />
      </div>
      <div class="hero__layer hero__layer--trees-r hero__trees" data-depth="-0.28" data-pointer="12" data-reveal="fade">
        <Illustration name="portal-b-trees-right" />
      </div>
      <div class="hero__layer hero__layer--ground" data-depth="-0.1" data-pointer="5" data-reveal="fade">
        <Illustration name="portal-b-ground" />
      </div>
      <div class="hero__grain"></div>
    </div>
    <div class="hero__fade" aria-hidden="true"></div>
    <HeroBird />
    <FireSound />

    <h1 class="hero__title t-hero" data-split>
      {
        home.hero.titleLines.map((line, n) => {
          const at = line.indexOf(highlight);
          // The first line is the title; what follows is its subtitle, set smaller and shown in
          // lower case (home.hero.subtitle), because the handwritten face is unreadable in capitals.
          // (the space keeps the lines apart when the heading is read out as one sentence)
          if (at < 0)
            return (
              <>
                {n > 0 && ' '}
                <span class:list={['hero__line', n > 0 && 't-sub']}>{n > 0 ? home.hero.subtitle : line}</span>
              </>
            );
          return (
            <span class="hero__line">
              {rowsOf(line.slice(0, at)).map((row) => (
                <>
                  <span class="hero__row">{row}</span>{' '}
                </>
              ))}
              <span class="hl">
                {highlight.split(' ').map((word, n) => (
                  <>
                    {n > 0 && ' '}
                    <span class="hl__w">{word}</span>
                  </>
                ))}
              </span>
              {line.slice(at + highlight.length)}
            </span>
          );
        })
      }
    </h1>
  </div>
</section>

<script>
  // The clouds, the birds, the stars and the fire only move while the hero is on screen.
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!hero || hero.dataset.watched) return;
    hero.dataset.watched = 'true';
    new IntersectionObserver(([entry]) => hero.classList.toggle('is-away', !entry.isIntersecting)).observe(hero);
  });
</script>

<style>
  .hero {
    --hero-pad: clamp(1.4rem, 0.2rem + 4.6vw, 5.25rem);
    --panel-w: 100vw;
    --panel-h: max(100svh, 32rem);
    /* the first screen below the header, which lies over the top of the picture */
    --hero-open: calc(var(--panel-h) - var(--header-h));
    /* how far below the first screen the picture takes to fade into the page */
    --hero-fade: clamp(5rem, 20svh, 12rem);
    /* The picture: from the tips of the rays over Athena's head to the near ground it is 1.124
       frames tall, so 0.86 of the open height leaves it a little air under the header. */
    --scene-h: min(var(--hero-open) * 0.86, var(--panel-w) * 0.5);
    --scene-m: calc(var(--panel-w) * 0.04);
    --scene-x: calc(100% - var(--scene-m) - var(--scene-h) / 2);
    --scene-b: calc(var(--u) * 34);
    --u: calc(var(--scene-h) / 1000);
    /* The open sky left of the roof: the column the title is set in. The title is as large as
       that column allows (--hero-fit: the ems its widest row needs, swash included) and as the
       height allows (--hero-rows rows at the title's leading, plus the subtitle). */
    --hero-col: calc(var(--panel-w) - var(--scene-m) - var(--scene-h) * 0.93 - var(--hero-pad));
    --hero-fit: 5.3;
    /* the same, scaled for a title face of another width (--type-wide; 1 for PP Editorial New) */
    --hero-fitw: calc(var(--hero-fit) * var(--type-wide, 1));
    --hero-rows: 4;
    /* air between the header and the title: the title starts high, under the header */
    --hero-top: clamp(1.25rem, 5svh, 3.5rem);
    --hero-fs: calc(
      min(
          calc(var(--hero-col) / var(--hero-fitw)),
          calc((var(--hero-open) - var(--hero-top)) * 0.9 / (var(--hero-rows) * 0.95 + 1)),
          10rem
        ) * var(--hero-trim, 1)
    );

    /* The picture runs under the sticky header, to the top of the window. */
    margin-top: calc(var(--header-h) * -1);
    padding-bottom: var(--hero-fade);
  }
  /* Greek titles fall back to a wider face and the words are longer: four rows. The column has
     to hold the two highlighted words, which stand beside the roof; the second row is longer,
     but it stands high in the open sky above the temple, so it may run past the column. */
  /* English beside the temple: a little smaller than the column would allow (client direction,
     13 October 2026). Only this stack reads it; the phone and nearly-square titles set their own size. */
  .hero--en {
    --hero-trim: 0.9;
  }
  .hero--el {
    --hero-fit: 6.85;
    --hero-rows: 4;
  }
  .hero--grc {
    --hero-fit: 7.5;
    --hero-rows: 4;
  }

  .hero__panel {
    /* Day. The drawings read three washes (--pb-night: whatever must match the ground they stand
       on, --pb-stone: the temple and the goddess, --pb-light: light itself) and one line colour.
       theme-day keeps the palette itself from being swapped, so both scenes are set from the same
       daytime inks: light-blue sky, marble in the paper colour, Greek-blue line. */
    --hero-sky: var(--blue-light);
    --hero-line: var(--blue);
    --hero-grain: url('/textures/grain-dark.webp');
    --pb-night: var(--blue-light);
    --pb-stone: var(--creme-light);
    --pb-light: var(--creme-light);
    --ink-strong: var(--blue);
    --highlight: var(--creme-light);
    --highlight-ink: var(--blue);
    --sub-ink: var(--blue);

    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    min-height: var(--panel-h);
    padding: calc(var(--header-h) + var(--hero-top)) var(--hero-pad) calc(var(--scene-b) + var(--u) * 62);
  }
  /* Night: the darker blue ground, stone in Greek blue, light in light blue, crème line. */
  :global(html[data-theme='dark']) .hero__panel {
    --hero-sky: var(--blue-deep);
    --hero-line: var(--creme);
    --hero-grain: url('/textures/grain-light.webp');
    --pb-night: var(--blue-deep);
    --pb-stone: var(--blue);
    --pb-light: var(--blue-light);
    --ink-strong: var(--creme-light);
    --highlight: var(--blue-light);
    --highlight-ink: var(--blue-deep);
    --sub-ink: var(--blue-light);
  }

  /* ---------- title ---------- */
  /* The title is one stacking context and its highlighted words are not, so the swashes lie behind
     every word of the title, never over the end of the row above (client direction). */
  .hero__title {
    isolation: isolate;
    max-width: 100%;
    font-size: var(--hero-fs);
    /* a touch more air between the rows than other titles have (client direction, 15 October 2026) */
    line-height: calc(var(--title-leading) + 0.05);
    text-wrap: wrap;
  }
  /* The highlighted words are set heavier than the rest of the title (client direction) */
  .hero__title .hl__w {
    isolation: auto;
    font-weight: 500;
  }
  .hero__line,
  .hero__row {
    display: block;
  }
  /* Beside the picture every highlighted word takes its own row */
  .hero__title .hl__w {
    display: block;
    width: max-content;
  }
  /* The swash has to hold every letter of its word: a little wider and squarer than the kit's. */
  /* The swash is centred on the letters, from a little above the capitals to a little under the
     baseline, so it covers whole words and does not hang below them (client direction, 14 October
     2026). In the title face the capitals rise 0.01em above the line's box and the baseline sits
     0.79em down it (line height 1); the stand-in face is set to the same lines (fonts.css). */
  .hero__title .hl__w::before {
    inset: -0.125em -0.36em 0.095em -0.34em;
    border-radius: 22% 27% 20% 29% / 44% 40% 47% 42%;
  }
  .hero__title .hl__w:nth-child(even)::before {
    inset: -0.105em -0.38em 0.075em -0.33em;
    border-radius: 27% 21% 29% 22% / 41% 46% 40% 45%;
  }
  /* The subtitle in the handwritten voice face. It may run wider than the stack above it, as far
     as the column goes, and never drops below the size a hand needs. */
  .hero__title .t-sub {
    width: max-content;
    max-width: var(--hero-col);
    margin-top: 0.42em;
    font-size: max(0.36em, 1.3rem);
    text-wrap: balance;
  }

  /* ---------- stage ---------- */
  /* The sheet the picture is printed on: the first screen. Below it the sky thins out into the page
     on a strip of its own (.hero__fade). The strip is still, and it alone carries the mask: a mask
     over the whole stage had every frame of the clouds, the stars and the fire pass through it,
     which kept the machine busy. Under the ground line the picture is plain sky colour in both
     themes, so the strip only needs that colour. */
  .hero__stage {
    position: absolute;
    /* (it starts above the top of the page: the header can stand a few pixels taller than
       --header-h, and the page's paper showed there as a pale line) */
    inset: -2rem 0 0;
    z-index: -1;
    overflow: hidden;
    background-color: var(--hero-sky);
    pointer-events: none;
  }
  .hero__fade {
    position: absolute;
    inset: 100% 0 auto;
    z-index: -1;
    height: var(--hero-fade);
    background-color: var(--hero-sky);
    background-image: var(--hero-grain);
    background-size: 400px 400px;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, #000, transparent);
  }
  .hero__layer {
    position: absolute;
    inset: 2rem 0 0;
  }
  /* Nothing in the picture moves while it is out of sight (class set by the script below) */
  .hero.is-away :global(*) {
    animation-play-state: paused !important;
  }
  /* Each drawing's wrapper is the positioned box; the SVG fills it and may draw outside its frame. */
  .hero__layer :global(.illo) {
    position: absolute;
    color: var(--hero-line);
  }
  .hero__layer :global(svg) {
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }
  /* The stars run on behind the header to the top of the window, so the sky is not cut off under it
     (client direction, 11 October 2026). */
  .hero__layer--sky :global(.illo),
  .hero__layer--milky :global(.illo) {
    inset: -5% -2%;
  }
  .hero__scene :global(.illo) {
    left: var(--scene-x);
    bottom: var(--scene-b);
    width: var(--scene-h);
    height: var(--scene-h);
    translate: -50% 0;
  }
  /* The trees stand behind the near ground line, which hides their feet. There are none on the
     left any more (client direction): the title has that side. The drawing is kept for later. */
  .hero__layer--trees-l {
    display: none;
  }
  .hero__layer--trees-l :global(.illo) {
    bottom: calc(var(--scene-b) + var(--u) * 6);
    width: calc(var(--u) * 620);
    height: calc(var(--u) * 360);
  }
  .hero__layer--trees-r :global(.illo) {
    right: calc(var(--u) * -44);
    bottom: calc(var(--scene-b) + var(--u) * 6);
    width: calc(var(--u) * 320);
    height: calc(var(--u) * 430);
  }
  /* One ground line from edge to edge (client direction): it runs at the foot of the temple's
     lowest step, 54 units above the bottom of the frame (the line is 94 units up in its own box). */
  .hero__layer--ground :global(.illo) {
    left: 50%;
    bottom: calc(var(--scene-b) - var(--u) * 40);
    width: calc(var(--u) * 3200);
    height: calc(var(--u) * 140);
    translate: -50% 0;
  }

  /* Paper grain over the flat washes, still while they move underneath. */
  .hero__grain {
    position: absolute;
    inset: 0;
    background-image: var(--hero-grain);
    background-size: 400px 400px;
  }

  /* ---------- day and night ---------- */
  /* By day the stars are out of sight and loose streaks of cloud cross the sky; the inside of the
     temple is in shade. By night the streaks go.
     When the switch is pressed the page cross-fades (about 0.7s); over that, with motion on, the
     clouds drift off and the stars come out a moment after the sky has turned, the Milky Way
     last. Going back to day the stars go quickly and the clouds drift back in. */
  .hero__layer--sky :global(.illo),
  .hero__layer--milky :global(.illo) {
    visibility: hidden;
    opacity: 0;
  }
  :global(html[data-theme='dark']) .hero__layer--sky :global(.illo),
  :global(html[data-theme='dark']) .hero__layer--milky :global(.illo) {
    visibility: visible;
    opacity: 1;
  }
  :global(html.motion) .hero__layer--sky :global(.illo),
  :global(html.motion) .hero__layer--milky :global(.illo) {
    transition:
      opacity 0.5s var(--ease-soft),
      visibility 0s linear 0.5s;
  }
  :global(html.motion[data-theme='dark']) .hero__layer--sky :global(.illo) {
    transition:
      opacity 1.6s var(--ease-soft) 0.55s,
      visibility 0s;
  }
  :global(html.motion[data-theme='dark']) .hero__layer--milky :global(.illo) {
    transition:
      opacity 2s var(--ease-soft) 1s,
      visibility 0s;
  }
  /* The texture of the day sky (client direction): loose formations of cloud, long streaks with no
     outline (not cloud shapes, which read as childish), a shade lighter than the sky, crossing the
     whole of it very slowly. Only by day; at night the stars and
     the Milky Way are the texture. Only their transforms move. */
  .hero__layer--haze {
    visibility: hidden;
  }
  :global(html:not([data-theme='dark'])) .hero__layer--haze {
    visibility: visible;
  }
  .hero__layer--haze :global(.illo) {
    left: 0;
    top: var(--top);
    width: var(--w);
    aspect-ratio: 600 / 120;
    color: color-mix(in srgb, var(--creme-light) var(--mix, 44%), var(--blue-light));
    /* where it stands when nothing moves */
    transform: translate3d(var(--at), 0, 0);
  }
  .hero__layer--haze :global(.hero__haze--1) {
    --w: clamp(18rem, 46vw, 46rem);
    --top: 5%;
    --at: 52vw;
    --t: 180s;
  }
  .hero__layer--haze :global(.hero__haze--2) {
    --w: clamp(13rem, 30vw, 30rem);
    --top: 30%;
    --at: 8vw;
    --t: 235s;
    --mix: 34%;
    scale: -1 1;
  }
  .hero__layer--haze :global(.hero__haze--3) {
    --w: clamp(16rem, 38vw, 38rem);
    --top: 47%;
    --at: 66vw;
    --t: 205s;
    --mix: 38%;
  }
  .hero__layer--haze :global(.hero__haze--4) {
    --w: clamp(11rem, 24vw, 24rem);
    --top: 0.5%;
    --at: 30vw;
    --t: 265s;
    --mix: 30%;
  }
  .hero__layer--haze :global(.hero__haze--5) {
    --w: clamp(15rem, 34vw, 34rem);
    --top: 62%;
    --at: -6vw;
    --t: 220s;
    --mix: 32%;
    scale: -1 1;
  }
  /* two more, lower: between the last row of the title and the roof */
  .hero__layer--haze :global(.hero__haze--6) {
    --w: clamp(14rem, 32vw, 32rem);
    --top: 39%;
    --at: 38vw;
    --t: 205s;
    --mix: 40%;
  }
  .hero__layer--haze :global(.hero__haze--7) {
    --w: clamp(12rem, 26vw, 26rem);
    --top: 54%;
    --at: 20vw;
    --t: 235s;
    --mix: 34%;
    scale: -1 1;
  }
  @keyframes hero-haze {
    from {
      transform: translate3d(-105%, 0, 0);
    }
    to {
      transform: translate3d(100vw, 0, 0);
    }
  }
  /* (each starts part of the way across, about where it stands in the still picture) */
  :global(html.motion:not([data-theme='dark'])) .hero__layer--haze :global(.illo) {
    animation: hero-haze var(--t) linear calc(var(--t) * -0.45) infinite;
    will-change: transform;
  }
  :global(html.motion:not([data-theme='dark'])) .hero__layer--haze :global(.hero__haze--2),
  :global(html.motion:not([data-theme='dark'])) .hero__layer--haze :global(.hero__haze--5) {
    animation-delay: calc(var(--t) * -0.12);
  }
  :global(html.motion:not([data-theme='dark'])) .hero__layer--haze :global(.hero__haze--3),
  :global(html.motion:not([data-theme='dark'])) .hero__layer--haze :global(.hero__haze--7) {
    animation-delay: calc(var(--t) * -0.7);
  }
  :global(html.motion:not([data-theme='dark'])) .hero__layer--haze :global(.hero__haze--6) {
    animation-delay: calc(var(--t) * -0.28);
  }

  /* A falling star, at night, once every twenty-five seconds: a short streak that crosses a piece of
     the sky above the temple and is gone. One small element; only its transform and opacity move. */
  .hero__meteor {
    display: none;
    position: absolute;
    left: 66%;
    top: 15%;
    width: clamp(4rem, 9vmin, 7rem);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to left, transparent, color-mix(in srgb, var(--creme) 55%, transparent) 55%, var(--creme-light));
    opacity: 0;
  }
  :global(html.motion[data-theme='dark']) .hero__meteor {
    display: block;
    animation: hero-meteor 25s linear 7s infinite;
    will-change: transform, opacity;
  }
  @keyframes hero-meteor {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(-19.5deg);
    }
    0.5% {
      opacity: 1;
    }
    2.9% {
      opacity: 1;
    }
    3.8% {
      opacity: 0;
      transform: translate3d(-36vmin, 12.7vmin, 0) rotate(-19.5deg);
    }
    100% {
      opacity: 0;
      transform: translate3d(-36vmin, 12.7vmin, 0) rotate(-19.5deg);
    }
  }

  /* Two birds, now and then: a pair crosses from left to right, rising a little, about once a
     minute. Only by day and only with motion on. The flight moves the wrapper and the wing beat
     squeezes the little drawing, so neither is redrawn. */
  .hero__layer--birds {
    display: none;
  }
  :global(html.motion:not([data-theme='dark'])) .hero__layer--birds {
    display: block;
  }
  .hero__layer--birds :global(.illo) {
    left: 0;
    top: 21%;
    width: clamp(1.1rem, 0.8rem + 1vw, 1.9rem);
