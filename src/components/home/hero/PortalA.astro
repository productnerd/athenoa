---
// Home hero "Portal A" (Monument): the original hero image of athenoa.academy redrawn as a night
// line illustration. One arch-topped cut-out of darker Greek blue. Far to near: stars, the Milky
// Way, the glow behind Athena's head, Athena with Nike and spear, the temple on its hill with the
// lit doorway and the flame, the trees at each side, and the near ground the title stands on.
// Every layer is its own inline SVG at its own depth.
//
// Artwork: src/assets/illustrations/portal-a-*.svg, generated by scripts/illustrations/portal-a-build.mjs.
// The scene layers share one frame (viewBox 0 0 1200 1050). --fh is the height of that frame; the
// trees are sized from it too, so every stroke in the picture has the same weight.
import Illustration from '../../Illustration.astro';
import { content } from '../../../data';
import { getLocale } from '../../../lib/locale';

const { home } = content(getLocale(Astro.url));
const highlight = home.hero.highlight;
---

<section class="pa" data-pointer-scene>
  <div class="pa__panel panel on-blue-deep">
    <div class="pa__inner">
      <div class="pa__scene" aria-hidden="true">
        <div class="pa__layer pa__sky" data-depth="0.5" data-pointer="-3" data-reveal="fade">
          <Illustration name="portal-a-sky" />
        </div>
        <div class="pa__layer pa__sky" data-depth="0.42" data-pointer="-5" data-reveal="fade" style="--delay: 250ms">
          <Illustration name="portal-a-milkyway" />
        </div>

        <div class="pa__frame">
          <div class="pa__layer" data-depth="0.32" data-pointer="-7" data-reveal="fade" style="--delay: 500ms">
            <Illustration name="portal-a-rays" draw style="--delay: 800ms" />
          </div>
          <div class="pa__layer" data-depth="0.24" data-pointer="-4" data-reveal="fade" style="--delay: 200ms">
            <Illustration name="portal-a-athena" draw style="--delay: 350ms" />
          </div>
          <div class="pa__layer" data-depth="0.14" data-reveal="fade" style="--delay: 80ms">
            <Illustration name="portal-a-hill" />
            <Illustration name="portal-a-cella" />
            <Illustration name="portal-a-light" class="pa__light" draw style="--delay: 1500ms" />
            <Illustration name="portal-a-temple" draw style="--delay: 200ms" />
            <Illustration name="portal-a-flame" class="pa__flame" data-reveal="fade" style="--delay: 1250ms" />
          </div>
        </div>

        <div class="pa__layer pa__trees pa__trees--l" data-depth="-0.2" data-pointer="9" data-reveal style="--delay: 550ms">
          <Illustration name="portal-a-trees-left" />
        </div>
        <div class="pa__layer pa__trees pa__trees--r" data-depth="-0.28" data-pointer="13" data-reveal style="--delay: 650ms">
          <Illustration name="portal-a-trees-right" />
        </div>
        <div class="pa__frame">
          <div class="pa__layer" data-depth="-0.05">
            <Illustration name="portal-a-ground" />
          </div>
        </div>
      </div>

      <h1 class="pa__title t-hero" data-split style="--delay: 1150ms; --hl-delay: 2.2s">
        {
          home.hero.titleLines.map((line, n) => {
            const at = line.indexOf(highlight);
            // The first line is the title; what follows is its subtitle, set smaller.
            if (at < 0) return <span class:list={['pa__line', n > 0 && 't-sub']}>{line}</span>;
            return (
              <span class:list={['pa__line', n > 0 && 't-sub']}>
                {line.slice(0, at)}
                <span class="hl">
                  {highlight.split(' ').map((word, i) => (
                    <>
                      {i > 0 && ' '}
                      <span class="hl__w">{word}</span>
                    </>
                  ))}
                </span>
                {line.slice(at + highlight.length)}
              </span>
            );
          })
        }
      </h1>
    </div>
  </div>
</section>

<style>
  .pa {
    --pa-inset: clamp(0.5rem, 0.1rem + 1.2vw, 1.25rem);
    /* the two tones of the figure: body and face in Greek blue, helmet, hair and aegis in the night blue */
    --pa-skin: var(--blue);
    --pa-armour: var(--blue-deep);
    /* The sticky header keeps its strip of crème paper; the night cut-out starts right below it. */
    padding: 0 var(--pa-inset) var(--pa-inset);
  }

  /* One great arch. The colour and the rough edge live on .panel::before; everything else sits in
     .pa__inner, which is cut to the same outline a few pixels inside it. */
  .pa__panel {
    --panel-r: 50% 50% 3.4rem 3.8rem / min(57%, 50vw, 32rem) min(55%, 49vw, 31rem) 3rem 3.4rem;
    padding: 5px;
  }
  .pa__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--header-h) - var(--pa-inset) - 10px);
    overflow: hidden;
    border-radius: inherit;
  }

  /* ---------- the scene ---------- */
  .pa__scene {
    /* space kept above the tip of the spear */
    --gap: clamp(0.4rem, 1.2svh, 0.9rem);
    /* height of the shared frame: all the room there is, but never wider than the cut-out */
    --fh: min(100% - var(--gap), 104vw);
    position: relative;
    flex: 1 1 auto;
    min-height: 21rem;
  }
  .pa__frame {
    position: absolute;
    left: 50%;
    bottom: 0;
    height: var(--fh);
    aspect-ratio: 1200 / 1050;
    transform: translateX(-50%);
  }
  .pa__layer {
    position: absolute;
    inset: 0;
  }
  .pa__layer :global(.illo) {
    position: absolute;
    inset: 0;
  }
  .pa__layer :global(svg) {
    width: 100%;
    height: 100%;
    max-width: none;
  }
  /* the sky is larger than the cut-out, so its slow drift never shows an edge */
  .pa__sky {
    inset: -9% -2% -4%;
  }
  .pa__trees :global(.illo) {
    inset: auto;
    bottom: calc(var(--fh) * -0.15);
  }
  .pa__trees :global(svg) {
    width: auto;
  }
  .pa__trees--l :global(.illo) {
    left: 0.5%;
    height: calc(var(--fh) * 0.724);
  }
  .pa__trees--r :global(.illo) {
    right: 0.5%;
    height: calc(var(--fh) * 0.857);
  }

  /* ---------- the title, on the near ground ---------- */
  /* Set like an inscription under the monument: one wide line where the face and the language allow
     it, two balanced lines where they do not. The scene above takes whatever height is left. */
  .pa__title {
    position: relative;
    padding: clamp(0.35rem, 1.2svh, 0.9rem) clamp(1rem, 3.2vw, 3rem) clamp(1.4rem, 3.8svh, 2.3rem);
    font-size: calc(clamp(2.2rem, 4.1vw, 5rem) * var(--title-scale));
    text-align: center;
  }
  /* Greek falls back to a wider, darker face: a step smaller keeps the two languages in balance. */
  :global(html[lang='el']) .pa__title {
    font-size: calc(clamp(2rem, 3.7vw, 4.4rem) * var(--title-scale));
  }
  .pa__line {
    display: block;
  }
  .pa__title :global(.t-sub) {
    margin-top: 0.46em;
    font-size: 0.5em;
    letter-spacing: 0.012em;
  }
  /* On the night ground the highlighted words are only legible where the swash is, so here it
     covers the capitals whole, in the title face and in its fallback. */
  .pa__title :global(.hl__w::before) {
    inset: -0.03em -0.19em 0.07em -0.17em;
    border-radius: 0.5em 0.7em 0.45em 0.62em / 48% 56% 44% 52%;
  }
  .pa__title :global(.hl__w:nth-child(even)::before) {
    inset: -0.04em -0.2em 0.06em -0.19em;
    border-radius: 0.66em 0.48em 0.7em 0.5em / 54% 46% 56% 44%;
  }

  /* ---------- load sequence (only when motion is on) ----------
     The sky fades up, the temple and Athena draw themselves, the glow spreads behind her head, the
     trees rise, the doorway opens and its light fans out, then the title, and the highlight last. */
  :global(html.motion) .pa__scene :global([data-draw] :is(path, circle)) {
    transition-duration: 1.35s;
    transition-delay: calc(min(var(--i, 0), 22) * 30ms + var(--delay, 0ms));
  }
  /* Until the script has prepared a path, its dashes are in plain units and would show as dots. */
  :global(html.motion) .pa__scene :global([data-draw] :is(path, circle):not([pathLength], [data-nodraw])) {
    stroke-opacity: 0;
  }
  :global(html.motion) .pa__trees[data-reveal]:not(.is-in) {
    transform: translate3d(0, 3.5rem, 0);
  }
  :global(html.motion) .pa__scene :global(.pa-door) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transform: scaleX(0.02);
    opacity: 0;
    transition:
      transform 1.2s var(--ease-out) 1.4s,
      opacity 0.4s linear 1.4s;
  }
  :global(html.motion) .pa__scene :global(.is-in .pa-door) {
    transform: none;
    opacity: 1;
  }
  /* The flame breathes, very slowly. Nothing else in the picture loops. */
  @keyframes pa-breathe {
    from {
      transform: scale(1);
      opacity: 1;
    }
    to {
      transform: scale(0.94, 1.07);
      opacity: 0.84;
    }
  }
  :global(html.motion) .pa__scene :global(.pa-fire) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: pa-breathe 4.6s var(--ease-in-out) infinite alternate;
  }

  /* ---------- narrow screens: the picture above at the width of the cut-out, the title below ---------- */
  @media (max-width: 47.99rem) {
    .pa__inner {
      min-height: 0;
    }
    .pa__scene {
      --gap: clamp(2.5rem, 13vw, 4.5rem);
      --fh: 104vw;
      flex: none;
      height: calc(var(--fh) + var(--gap));
      min-height: 0;
    }
    .pa__scene :global(svg) {
      stroke-width: 3.2;
    }
    .pa__title,
    :global(html[lang='el']) .pa__title {
      padding-inline: 1.1rem;
      font-size: calc(clamp(2rem, 10.4vw, 4rem) * var(--title-scale));
    }
    :global(html[lang='el']) .pa__title {
      font-size: calc(clamp(1.7rem, 8.4vw, 3.4rem) * var(--title-scale));
    }
    .pa__title :global(.t-sub) {
      font-size: 0.56em;
    }
    /* the trees step outwards and keep to the corners, clear of the columns */
    .pa__trees--l :global(.illo) {
      left: -17%;
      height: calc(var(--fh) * 0.56);
    }
    .pa__trees--r :global(.illo) {
      right: -19%;
      height: calc(var(--fh) * 0.66);
    }
  }
</style>
