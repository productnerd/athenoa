---
// Home hero, "Portal" attempt B: side by side.
// The original hero picture of athenoa.academy (the temple at night, Athena rising behind its
// pediment with her spear and a Nike, the flame in the doorway) redrawn as a two-ink night print.
// One wide cut-out of darker Greek blue: the title stands in the open sky on the left, Athena and
// the temple take the right, stars and the Milky Way run behind both, trees along the bottom.
//
// Artwork: src/assets/illustrations/portal-b-*.svg, generated by scripts/illustrations/portal-b-build.mjs.
// The scene layers share one square frame (viewBox 0 0 1000 1000, temple axis at x 500). It is
// placed by --scene-h (its size), --scene-x (its centre line) and sits on the bottom of the panel;
// --u is one drawing unit, so the trees and the ground keep the same stroke weight.
import Illustration from '../../Illustration.astro';
import { content } from '../../../data';
import { getLocale } from '../../../lib/locale';

const locale = getLocale(Astro.url);
const { home } = content(locale);
const { titleLines, highlight } = home.hero;
---

<section class:list={['pb', `pb--${locale}`]} data-pointer-scene>
  <div class="pb__panel panel panel--big on-blue-deep">
    <div class="panel__clip pb__stage" aria-hidden="true">
      <div class="pb__layer pb__cover pb__layer--sky" data-depth="0.5" data-pointer="-4" data-reveal="fade">
        <Illustration name="portal-b-sky" />
      </div>
      <div class="pb__layer pb__cover pb__layer--milky" data-depth="0.44" data-pointer="-5" data-reveal="fade">
        <Illustration name="portal-b-milkyway" />
      </div>
      <div class="pb__layer pb__scene pb__layer--rays" data-depth="0.32" data-pointer="-3" data-reveal="fade">
        <Illustration name="portal-b-rays" draw />
      </div>
      <div class="pb__layer pb__scene pb__layer--athena" data-depth="0.24" data-pointer="4" data-reveal="fade">
        <Illustration name="portal-b-athena" draw />
      </div>
      <div class="pb__layer pb__scene pb__layer--hill" data-depth="0.12" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-hill" draw />
      </div>
      <div class="pb__layer pb__scene pb__layer--cella" data-depth="0.15" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-cella" />
      </div>
      <div class="pb__layer pb__scene pb__layer--light" data-depth="0.14" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-light" />
      </div>
      <div class="pb__layer pb__scene pb__layer--temple" data-depth="0.12" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-temple" draw />
      </div>
      <div class="pb__layer pb__scene pb__layer--flame" data-depth="0.11" data-pointer="8" data-reveal="fade">
        <Illustration name="portal-b-flame" />
      </div>
      <div class="pb__layer pb__layer--ground" data-depth="-0.1" data-pointer="12" data-reveal>
        <Illustration name="portal-b-ground" />
      </div>
      <div class="pb__layer pb__layer--trees-l" data-depth="-0.2" data-pointer="16" data-reveal>
        <Illustration name="portal-b-trees-left" />
      </div>
      <div class="pb__layer pb__layer--trees-r" data-depth="-0.3" data-pointer="22" data-reveal>
        <Illustration name="portal-b-trees-right" />
      </div>
      <div class="pb__grain"></div>
    </div>

    <h1 class="pb__title t-hero" data-split>
      {
        titleLines.map((line, n) => {
          const at = line.indexOf(highlight);
          // The first line is the title; what follows is its subtitle, set smaller.
          if (at < 0) return <span class:list={['pb__line', n > 0 && 't-sub']}>{line}</span>;
          return (
            <span class="pb__line">
              {line.slice(0, at)}
              <span class="hl">
                {highlight.split(' ').map((word, n) => (
                  <>
                    {n > 0 && ' '}
                    <span class="hl__w">{word}</span>
                  </>
                ))}
              </span>
              {line.slice(at + highlight.length)}
            </span>
          );
        })
      }
    </h1>
  </div>
</section>

<style>
  .pb {
    /* The three blues and the crème line, as the drawings read them. */
    --pb-night: var(--blue-deep);
    --pb-stone: var(--blue);
    --pb-light: var(--blue-light);

    --pb-inset: clamp(0.6rem, 0.2rem + 1.1vw, 1.25rem);
    --pb-pad: clamp(1.4rem, 0.2rem + 4.6vw, 5.25rem);
    --panel-w: calc(100vw - 2 * var(--pb-inset));
    --panel-h: max(calc(100svh - var(--header-h) - var(--pb-inset)), 30rem);
    /* The scene: a square frame standing on the bottom of the panel. */
    --scene-h: min(var(--panel-h) * 0.975, var(--panel-w) * 0.56);
    --scene-m: calc(var(--panel-w) * 0.035);
    --scene-x: calc(100% - var(--scene-m) - var(--scene-h) / 2);
    --u: calc(var(--scene-h) / 1000);
    /* The open sky left of the roof: the column the title is set in, and how many ems of
       title it has to hold (the longest line the language needs). */
    --pb-col: calc(var(--panel-w) - var(--scene-m) - var(--scene-h) * 0.93 - var(--pb-pad));
    --pb-fit: 6.9;
    --pb-fs: min(calc(var(--pb-col) / var(--pb-fit)), 10.4svh, 6.6rem);

    /* The hero starts below the sticky header, on the crème page, inset like every cut-out. */
    padding: 0 var(--pb-inset) var(--pb-inset);
  }
  .pb--el {
    --pb-fit: 8.75;
  }

  .pb__panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: min(var(--panel-h), var(--panel-w) * 0.66);
    padding: clamp(1.6rem, 4svh, 3rem) var(--pb-pad) calc(var(--scene-h) * 0.2);
  }

  /* ---------- title ---------- */
  .pb__title {
    width: var(--pb-col);
    max-width: 100%;
    font-size: var(--pb-fs);
    text-wrap: wrap;
  }
  .pb__line {
    display: block;
  }
  /* On the night panel the highlighted words are dark, so their swash has to hold every letter:
     a little wider and squarer than the kit's. */
  .pb__title .hl__w::before {
    inset: -0.03em -0.36em -0.08em -0.34em;
    border-radius: 22% 27% 20% 29% / 44% 40% 47% 42%;
  }
  .pb__title .hl__w:nth-child(even)::before {
    inset: -0.06em -0.38em -0.05em -0.33em;
    border-radius: 27% 21% 29% 22% / 41% 46% 40% 45%;
  }
  .pb__title .t-sub {
    margin-top: 0.5em;
    font-size: 0.45em;
    line-height: 1.08;
    letter-spacing: 0.004em;
    text-wrap: balance;
  }

  /* ---------- stage ---------- */
  .pb__layer {
    position: absolute;
    inset: 0;
  }
  /* Each drawing's wrapper is the positioned box; the SVG fills it and may draw outside its frame. */
  .pb__layer :global(.illo) {
    position: absolute;
    color: var(--creme);
  }
  .pb__layer :global(svg) {
    width: 100%;
    height: 100%;
    max-width: none;
    overflow: visible;
  }
  .pb__cover :global(.illo) {
    inset: -5% -2%;
  }
  .pb__scene :global(.illo) {
    left: var(--scene-x);
    bottom: 0;
    width: var(--scene-h);
    height: var(--scene-h);
    transform: translateX(-50%);
  }
  .pb__layer--ground :global(.illo) {
    left: 50%;
    bottom: calc(var(--u) * -66);
    width: calc(var(--u) * 3200);
    height: calc(var(--u) * 140);
    transform: translateX(-50%);
  }
  .pb__layer--trees-l :global(.illo) {
    left: calc(var(--u) * -34);
    bottom: calc(var(--u) * -26);
    width: calc(var(--u) * 620);
    height: calc(var(--u) * 360);
  }
  .pb__layer--trees-r :global(.illo) {
    right: calc(var(--u) * -44);
    bottom: calc(var(--u) * -26);
    width: calc(var(--u) * 320);
    height: calc(var(--u) * 430);
  }

  /* Paper grain over the flat washes, still while they move underneath. */
  .pb__grain {
    position: absolute;
    inset: 0;
    background-image: url('/textures/grain-light.webp');
    background-size: 400px 400px;
  }

  /* ---------- load sequence (only when motion is on) ----------
     Sky first; the temple and Athena draw themselves; the light behind her and the doorway open;
     the trees come up; the title rises word by word and its highlight arrives last. */
  .pb__layer--milky {
    --delay: 200ms;
  }
  .pb__layer--hill,
  .pb__layer--cella,
  .pb__layer--temple {
    --delay: 250ms;
  }
  .pb__layer--athena {
    --delay: 520ms;
  }
  .pb__layer--rays {
    --delay: 900ms;
  }
  .pb__layer--light {
    --delay: 1350ms;
  }
  .pb__layer--flame {
    --delay: 1200ms;
  }
  .pb__layer--ground {
    --delay: 500ms;
    --rise: 2.5rem;
  }
  .pb__layer--trees-l {
    --delay: 650ms;
    --rise: 5rem;
  }
  .pb__layer--trees-r {
    --delay: 800ms;
    --rise: 7rem;
  }
  .pb__title {
    --delay: 1000ms;
    --hl-delay: 1.95s;
  }
  /* The title face stands taller than its line: sink the waiting words fully out of the mask. */
  :global(html.motion) .pb__title:not(.is-in) :global(.w__i) {
    transform: translate3d(0, 135%, 0);
  }
  :global(html.motion) .pb__layer[data-reveal='']:not(.is-in) {
    transform: translate3d(0, var(--rise, 2rem), 0);
  }
  /* Quicker, tighter line drawing than the site default, so the picture is whole in two seconds. */
  :global(html.motion) .pb__stage :global([data-draw] path) {
    transition-duration: 1.3s;
    transition-delay: calc(min(var(--i, 0), 60) * 9ms + var(--delay, 0ms) + 100ms);
  }
  /* what is not drawn (the lettering, the pupils, the disc of light) follows the lines */
  :global(html.motion) .pb__stage :global([data-draw] [data-nodraw]) {
    transition-delay: calc(var(--delay, 0ms) + 1000ms);
  }
  :global(html.motion) .pb__layer--rays :global([data-draw] [data-nodraw]) {
    transition-delay: calc(var(--delay, 0ms) + 100ms);
  }
  /* Until the script has prepared a path, its dashes are in plain units and would show as dots. */
  :global(html.motion) .pb__stage :global([data-draw] path:not([pathLength])) {
    stroke-opacity: 0;
  }
  /* The doorway opens: the arch of light grows from the flame, then the rays reach out. */
  .pb__layer--light :global(.pb-door),
  .pb__layer--light :global(.pb-beams),
  .pb__layer--flame :global(.pb-spill) {
    transform-box: view-box;
    transform-origin: 50% 84.8%;
  }
  :global(html.motion) .pb__layer--light :global(.pb-door) {
    transition: transform 1.1s var(--ease-out) calc(var(--delay) + 0ms);
  }
  :global(html.motion) .pb__layer--light :global(.pb-beams),
  :global(html.motion) .pb__layer--flame :global(.pb-spill) {
    transition:
      transform 1.3s var(--ease-out) 1600ms,
      opacity 0.9s var(--ease-out) 1600ms;
  }
  :global(html.motion) .pb__layer--light:not(.is-in) :global(.pb-door) {
    transform: scale(0.3, 0.12);
  }
  :global(html.motion) .pb__layer--light:not(.is-in) :global(.pb-beams),
  :global(html.motion) .pb__layer--flame:not(.is-in) :global(.pb-spill) {
    transform: scale(0.25);
    opacity: 0;
  }

  /* The flame breathes, very slowly. Nothing else loops. */
  @keyframes pb-breathe {
    from {
      transform: scale(1, 1);
      opacity: 1;
    }
    to {
      transform: scale(0.94, 1.07);
      opacity: 0.86;
    }
  }
  .pb__layer--flame :global(.pb-fire) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  :global(html.motion) .pb__layer--flame :global(.pb-fire) {
    animation: pb-breathe 3.8s var(--ease-in-out) infinite alternate;
  }

  /* ---------- narrow or upright screens: the title in the sky above, the picture below ---------- */
  @media (max-width: 61.99rem), (max-aspect-ratio: 1/1) {
    .pb {
      --scene-h: min(var(--panel-w) * 1.12, 62svh);
      --scene-x: 50%;
      --pb-col: calc(var(--panel-w) - 2 * var(--pb-pad));
      --pb-fs: min(calc(var(--pb-col) / var(--pb-fit)), 6.4svh);
    }
    .pb__panel {
      justify-content: flex-start;
      min-height: 0;
      /* the rays reach a little above the frame; the title stays clear of them */
      padding: clamp(1.5rem, 3.4svh, 2.6rem) var(--pb-pad) calc(var(--scene-h) * 1.2);
    }
    .pb__layer :global(svg) {
      stroke-width: 3.5;
    }
    /* here the band of stars would lie hidden behind the picture: lift it into the open sky */
    .pb__layer--milky :global(.illo) {
      inset: -19% -2% 9%;
    }
    .pb__title .hl__w::before,
    .pb__title .hl__w:nth-child(even)::before {
      left: -0.24em;
      right: -0.3em;
    }
    .pb__layer--trees-l :global(.illo) {
      left: calc(var(--u) * -474);
    }
    .pb__layer--trees-r :global(.illo) {
      right: calc(var(--u) * -150);
    }
  }
</style>
