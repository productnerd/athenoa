---
// Home hero, candidate C: "Landscape".
// An Attic paper theatre on one blue cut-out. Far to near: the sun and its rays, two mountain
// ranges, the sea, two headlands (the left one carries the temple), the pine wood on the near
// shore, and two groups of tall pines. Every layer is its own inline SVG at its own depth, so
// scrolling reads as walking down through the pines towards the temple.
//
// Artwork: src/assets/illustrations/hero-c-*.svg, generated by scripts/illustrations/hero-c-build.mjs.
// The band layers share one frame (viewBox 0 0 1000 640, horizon at y 380) and are placed by
// --band-h (height of that frame) and --band-x (where its centre line sits in the panel).
import Illustration from '../../Illustration.astro';
import { home } from '../../../data/home';

const lines = home.hero.titleLines;
---

<section class="hc" data-pointer-scene>
  <div class="hc__panel panel panel--big on-blue">
    <div class="panel__clip hc__stage" aria-hidden="true">
      <div class="hc__layer hc__layer--rays" data-depth="0.5" data-pointer="-5" data-reveal style="--delay: 260ms">
        <Illustration name="hero-c-rays" draw />
      </div>
      <div class="hc__layer hc__layer--sun" data-depth="0.46" data-pointer="-6" data-reveal>
        <Illustration name="hero-c-sun" />
      </div>
      <div class="hc__layer hc__band hc__layer--far" data-depth="0.38" data-reveal style="--delay: 60ms">
        <Illustration name="hero-c-range-far" draw />
      </div>
      <div class="hc__layer hc__band hc__layer--mid" data-depth="0.3" data-reveal style="--delay: 140ms">
        <Illustration name="hero-c-range-mid" draw />
      </div>
      <div class="hc__layer hc__band hc__layer--sea" data-depth="0.22" data-reveal style="--delay: 220ms">
        <Illustration name="hero-c-sea" />
      </div>
      <div class="hc__layer hc__band hc__layer--cape" data-depth="0.17" data-reveal style="--delay: 300ms">
        <Illustration name="hero-c-hill-right" draw />
      </div>
      <div class="hc__layer hc__band hc__layer--temple" data-depth="0.12" data-pointer="8" data-reveal style="--delay: 380ms">
        <Illustration name="hero-c-hill-left" draw />
      </div>
      <div class="hc__layer hc__band hc__layer--shore" data-depth="-0.06" data-pointer="13" data-reveal style="--delay: 700ms">
        <Illustration name="hero-c-shore-pines" />
      </div>
      <div class="hc__layer hc__band hc__layer--under" data-depth="-0.14" data-pointer="17" data-reveal style="--delay: 800ms">
        <Illustration name="hero-c-undergrowth" />
      </div>
      <div class="hc__layer hc__layer--low" data-depth="-0.22" data-pointer="22" data-reveal style="--delay: 900ms">
        <Illustration name="hero-c-pines-low" />
      </div>
      <div class="hc__layer hc__layer--right" data-depth="-0.28" data-pointer="26" data-reveal style="--delay: 980ms">
        <Illustration name="hero-c-pines-right" />
      </div>
      <div class="hc__layer hc__layer--tall" data-depth="-0.36" data-pointer="32" data-reveal style="--delay: 1060ms">
        <Illustration name="hero-c-pines-tall" />
      </div>
      <div class="hc__layer hc__layer--birds" data-depth="0.34" data-pointer="-12" data-reveal="fade" style="--delay: 1500ms">
        <Illustration name="hero-c-birds" class="drift" />
      </div>
      <div class="hc__grain"></div>
    </div>

    <h1 class="hc__title t-hero" data-split data-depth="0.05" style="--delay: 480ms">
      <span class="hc__line hc__line--1">{lines[0]}</span>{' '}
      <span class="hc__line hc__line--2">{lines[1]}</span>
    </h1>
  </div>
</section>

<style>
  .hc {
    /* Four blues, far to near, and the bright Aegean. All mixed from the ink tokens. */
    --hc-far: color-mix(in srgb, var(--blue) 52%, var(--blue-bright));
    --hc-mid: color-mix(in srgb, var(--blue) 78%, var(--blue-bright));
    --hc-hill: color-mix(in srgb, var(--blue) 70%, var(--blue-deep));
    --hc-near: var(--blue-deep);
    --hc-sea: var(--blue-bright);
    --hc-light: var(--creme-light);
    --hc-ink: var(--blue);

    --hc-inset: clamp(0.6rem, 0.2rem + 1.1vw, 1.25rem);
    /* The scene: its frame height, where the frame's centre line sits, and the sun hung off it. */
    --band-h: max(min(64svh, 46vw), 30vw);
    --band-x: 65.7%;
    --sun-dx: 0.365;
    --sun-dy: 0.63;
    --sun-w: 1.56;
    /* Share of the frame that must stay clear under the title. */
    --clear: 0.63;

    display: flex;
    flex-direction: column;
    min-height: max(100svh, 40rem);
    /* Pulled up under the sticky header: the header keeps its strip of crème paper,
       the blue cut-out starts right below it. */
    margin-top: calc(var(--header-h) * -1);
    padding: var(--header-h) var(--hc-inset) var(--hc-inset);
  }

  .hc__panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: clamp(2rem, 0.8rem + 4svh, 3.5rem) clamp(1.4rem, 0.2rem + 4.6vw, 5.25rem) 0;
  }

  /* ---------- title ---------- */
  .hc__title {
    max-width: 10.6em;
    /* the scene is anchored to the bottom of the panel; this keeps the title out of it */
    margin-bottom: calc(var(--band-h) * var(--clear));
    font-size: min(calc(clamp(2.7rem, 1rem + 5.4vw, 7.4rem) * var(--title-scale)), 5.78vw);
  }
  .hc__line {
    display: block;
  }
  .hc__line--2 {
    max-width: 11em;
    margin-top: 0.36em;
    font-size: 0.6em;
    letter-spacing: 0.01em;
    line-height: 1.02;
  }

  /* ---------- stage ---------- */
  .hc__layer {
    position: absolute;
    inset: 0;
  }
  /* Each drawing's wrapper is the positioned box (it needs a real size for the reveal observer);
     the SVG fills it and may draw outside its frame. */
  .hc__layer :global(.illo) {
    position: absolute;
  }
  .hc__layer :global(svg) {
    max-width: none;
    width: auto;
    height: 100%;
  }
  .hc__band :global(.illo) {
    left: var(--band-x);
    bottom: 0;
    height: var(--band-h);
    transform: translateX(-50%);
  }
  /* Sun and rays hang off the same frame, so the ranges always hide the same slice of the disc. */
  .hc__layer--sun :global(.illo),
  .hc__layer--rays :global(.illo) {
    left: calc(var(--band-x) + var(--band-h) * var(--sun-dx));
    bottom: calc(var(--band-h) * var(--sun-dy));
    height: calc(var(--band-h) * var(--sun-w));
    transform: translate(-50%, 50%);
  }
  .hc__layer--low :global(.illo) {
    left: -1.5%;
    bottom: -4%;
    height: calc(var(--band-h) * 0.86);
  }
  .hc__layer--right :global(.illo) {
    right: 3%;
    bottom: -5%;
    height: calc(var(--band-h) * 0.72);
  }
  .hc__layer--tall :global(.illo) {
    right: -4%;
    bottom: -7%;
    height: calc(var(--band-h) * 1.2);
  }
  .hc__layer--birds :global(.illo) {
    left: calc(var(--band-x) + var(--band-h) * -0.52);
    bottom: calc(var(--band-h) * 0.83);
    height: calc(var(--band-h) * 0.14);
  }

  /* Paper grain over the cut-outs, still while they move underneath. */
  .hc__grain {
    position: absolute;
    inset: 0;
    background-image: url('/textures/grain-dark.webp'), url('/textures/grain-light.webp');
    background-size: 400px 400px;
  }

  /* ---------- load sequence (only when motion is on) ----------
     Far layers settle first with a short rise, the sun comes up from behind the range while its
     rays draw outwards, the title rises word by word, and the pines come up last and furthest. */
  :global(html.motion) .hc__layer[data-reveal]:not(.is-in) {
    transform: translate3d(0, var(--rise, 1.5rem), 0);
  }
  .hc__layer--far {
    --rise: 0.9rem;
  }
  .hc__layer--mid {
    --rise: 1.3rem;
  }
  .hc__layer--sea {
    --rise: 1rem;
  }
  .hc__layer--cape {
    --rise: 2rem;
  }
  .hc__layer--temple {
    --rise: 2.6rem;
  }
  .hc__layer--shore {
    --rise: 4.5rem;
  }
  .hc__layer--under {
    --rise: 5.5rem;
  }
  .hc__layer--low {
    --rise: 7rem;
  }
  .hc__layer--right {
    --rise: 8rem;
  }
  .hc__layer--tall {
    --rise: 9rem;
  }
  .hc__layer--sun,
  .hc__layer--rays {
    --rise: calc(var(--band-h) * 0.16);
  }
  :global(html.motion) .hc__layer--sun[data-reveal],
  :global(html.motion) .hc__layer--rays[data-reveal] {
    transition-duration: var(--dur-4);
  }
  :global(html.motion) .hc__layer--sun[data-reveal]:not(.is-in) {
    opacity: 1;
  }
  /* Quicker, tighter line drawing than the site default, so the picture is whole within two seconds. */
  :global(html.motion) .hc__stage :global([data-draw] path) {
    transition-duration: 1.25s;
    transition-delay: calc(min(var(--i, 0), 18) * 26ms + var(--delay, 0ms) + 120ms);
  }
  /* Until the script has prepared a path, its dashes are in plain units and would show as dots. */
  :global(html.motion) .hc__stage :global([data-draw] path:not([pathLength])) {
    stroke-opacity: 0;
  }

  /* The sea keeps a slow swell once everything is in place; the boat rides with it. */
  @keyframes hc-swell {
    from {
      transform: translateX(calc(-50% - 0.55rem));
    }
    to {
      transform: translateX(calc(-50% + 0.55rem));
    }
  }
  :global(html.motion) .hc__layer--sea :global(.illo) {
    animation: hc-swell 15s var(--ease-in-out) infinite alternate;
  }

  /* Between tablet and laptop the tall pine steps aside so it does not stand in front of the sun. */
  @media (min-width: 62rem) and (max-width: 76rem) {
    .hc__layer--tall :global(.illo) {
      right: -10%;
    }
  }

  /* ---------- narrow screens: title above, the scene re-centred on temple and sun ---------- */
  @media (max-width: 61.99rem) {
    .hc {
      --band-h: clamp(21rem, 110vw, 34rem);
      --band-x: 54%;
      --sun-dx: 0.2;
      --sun-dy: 0.62;
      --sun-w: 1.1;
      /* the title has to clear the tips of the rays here */
      --clear: 1.04;
      min-height: 0;
    }
    .hc__title {
      max-width: none;
      font-size: calc(clamp(2rem, 10.4vw, 4.4rem) * var(--title-scale));
    }
    .hc__layer--low :global(.illo) {
      left: -9%;
      bottom: -5%;
      height: calc(var(--band-h) * 0.64);
    }
    .hc__layer--right :global(.illo) {
      right: -24%;
      bottom: -7%;
      height: calc(var(--band-h) * 0.58);
    }
    .hc__layer--birds :global(.illo) {
      left: 7%;
      bottom: calc(var(--band-h) * 0.86);
    }
    /* No room for the tall pine beside the sun here. */
    .hc__layer--tall {
      display: none;
    }
  }
</style>
