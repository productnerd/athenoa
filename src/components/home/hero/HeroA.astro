---
// Home hero, candidate A "Portal".
// A Greek-blue paper cut-out lies on the crème page. Right of centre the sea portrait stands in a
// tall arch with a crème label border: a doorway of light. Wavy lines radiate from behind it,
// the mountains of Attica and a scallop sea lie beyond, and a crème knoll with umbrella pines
// rises in front, breaking past the panel edge onto the paper.
//
// Depth, far to near (data-depth): rays 0.5, mountains 0.36, sea 0.26, arch 0.14 (the photo
// inside it a further 0.06), title -0.05, pines -0.1 and -0.14, knoll -0.2, owl -0.28,
// stars -0.24 to -0.35. Far layers are crème line on blue, cut to the panel. Near layers are
// crème cut-outs carrying blue line, so they keep reading where they leave the panel.
//
// Load sequence (--delay): rays draw, mountains and sea draw, the arch grows out of the ground,
// the title words rise, then pines, knoll, owl and stars arrive.
//
// Sizes: --u is a tenth of the arch width. The right-hand scene is placed in --u from the
// panel's bottom right corner, so the picture keeps its proportions at any viewport.
// Artwork: src/assets/illustrations/hero-a-*.svg, generated by scripts/illustrations/hero-a-build.mjs.
import Media from '../../Media.astro';
import Illustration from '../../Illustration.astro';
import portrait from '../../../assets/media/portrait-sea.jpg';
import { home } from '../../../data/home';

const lines = home.hero.titleLines;
---

<section class="hero-a" data-pointer-scene>
  <div class="hero-a__panel panel panel--big on-blue">
    <div class="panel__clip">
      <div class="hero-a__rays" data-depth="0.5" data-pointer="-10">
        <Illustration name="hero-a-rays" draw />
      </div>
      <div class="hero-a__mountains" data-depth="0.36" data-pointer="-6">
        <Illustration name="hero-a-mountains" draw style="--delay:200ms" />
      </div>
      <div class="hero-a__sea" data-depth="0.26" data-pointer="-3">
        <Illustration name="hero-a-sea" draw style="--delay:320ms" />
      </div>
      <div class="hero-a__grain"></div>
    </div>

    <div class="hero-a__door" data-depth="0.14" data-pointer="4">
      <div class="hero-a__frame" data-reveal="grow" style="--delay:380ms">
        <Media
          src={portrait}
          alt="Athena Potari seated in meditation above the Aegean sea, eyes closed"
          shape="arch"
          ratio="3 / 5"
          focus="86% 50%"
          widths={[360, 560, 800, 1100]}
          sizes="(min-width: 56rem) 25vw, 62vw"
          priority
          reveal={false}
          innerDepth={0.06}
        />
      </div>
    </div>

    <h1 class="hero-a__title" data-split data-depth="-0.05" style="--delay:650ms">
      {
        lines.map((line, i) => (
          <>
            <span class={`hero-a__line hero-a__line--${i + 1}`}>{line}</span>{' '}
          </>
        ))
      }
    </h1>

    <div class="hero-a__pine hero-a__pine--2 hero-a__cut" data-depth="-0.1" data-pointer="8" data-reveal style="--delay:1000ms">
      <Illustration name="hero-a-pine-2" />
    </div>
    <div class="hero-a__pine hero-a__pine--1 hero-a__cut" data-depth="-0.14" data-pointer="11" data-reveal style="--delay:1080ms">
      <Illustration name="hero-a-pine-1" />
    </div>
    <div class="hero-a__ground hero-a__cut" data-depth="-0.2" data-pointer="15" data-reveal style="--delay:1150ms">
      <Illustration name="hero-a-ground" />
    </div>
    <div class="hero-a__owl hero-a__cut" data-depth="-0.28" data-pointer="20" data-reveal style="--delay:1300ms">
      <Illustration name="hero-a-owl" />
    </div>

    <div class="hero-a__star hero-a__star--1" data-depth="-0.35" data-pointer="26" data-reveal="grow" style="--delay:1400ms">
      <Illustration name="hero-a-star" class="drift" />
    </div>
    <div class="hero-a__star hero-a__star--2" data-depth="-0.24" data-pointer="18" data-reveal="grow" style="--delay:1470ms">
      <Illustration name="hero-a-star" class="drift" style="--i:2" />
    </div>
    <div class="hero-a__star hero-a__star--3" data-depth="-0.3" data-pointer="22" data-reveal="grow" style="--delay:1540ms">
      <Illustration name="hero-a-star" class="drift" style="--i:3" />
    </div>
  </div>
</section>

<style>
  .hero-a {
    --hero-pb: clamp(1rem, 3.2svh, 2.1rem);
    position: relative;
    display: grid;
    margin-top: calc(-1 * var(--header-h));
    padding: calc(var(--header-h) + 0.25rem) var(--gutter) var(--hero-pb);
  }

  /* ---------- The blue cut-out ---------- */
  /* Lengths in cqw are read by the panel's children, so they measure the panel itself. */
  .hero-a__panel {
    /* Mobile: the title on top, the arch standing on the knoll below it. */
    --door-w: min(66cqw, 21rem);
    --door-h: calc(var(--door-w) * 5 / 3);
    --door-right: calc(50cqw - var(--door-w) / 2);
    --door-bottom: calc(var(--u) * 0.5);
    --u: calc(var(--door-w) / 10);
    --band: calc(var(--u) * 0.38);
    --rays-w: max(300cqw, 60rem);
    --ground-w: calc(var(--u) * 19);
    --cut: var(--creme);
    container-type: inline-size;
    min-width: 0;
    padding: 0;
  }
  /* The grain is laid over the far layers instead (see .hero-a__grain), so the flat fills that
     hide one mountain behind another keep the same paper texture as the rest of the panel. */
  .hero-a__panel::before {
    background-image: none;
  }
  .hero-a__grain {
    position: absolute;
    inset: 0;
    background-image: var(--grain);
    background-size: 400px 400px;
  }

  /* ---------- Far layers: crème line on blue, cut to the panel ---------- */
  .hero-a__rays,
  .hero-a__mountains,
  .hero-a__sea {
    position: absolute;
  }
  .hero-a__rays {
    /* centred on the head of the arch */
    right: calc(var(--door-right) + var(--door-w) / 2 - var(--rays-w) / 2);
    bottom: calc(var(--door-bottom) + var(--door-h) - var(--door-w) / 2 - var(--rays-w) / 2);
    width: var(--rays-w);
  }
  .hero-a__rays :global(.illo) {
    color: color-mix(in srgb, var(--creme) 40%, var(--blue));
  }
  .hero-a__mountains {
    right: -52cqw;
    bottom: 9cqw;
    width: 250cqw;
  }
  .hero-a__mountains :global(.illo) {
    color: color-mix(in srgb, var(--creme) 76%, var(--blue));
  }
  .hero-a__sea {
    right: -20cqw;
    bottom: -4cqw;
    width: 210cqw;
  }
  .hero-a__sea :global(.illo) {
    color: color-mix(in srgb, var(--creme) 56%, var(--blue));
  }
  /* The rays are many: draw them quickly, a few at a time. */
  :global(html.motion) .hero-a__rays :global([data-draw] path) {
    transition-duration: 1.7s;
    transition-timing-function: var(--ease-out);
    transition-delay: calc(min(var(--i, 0), 30) * 10ms + var(--delay, 0ms));
  }
  :global(html.motion) .hero-a__mountains :global([data-draw] path),
  :global(html.motion) .hero-a__sea :global([data-draw] path) {
    transition-duration: 1.2s;
    transition-delay: calc(min(var(--i, 0), 30) * 14ms + var(--delay, 0ms));
  }

  /* ---------- The arch: a doorway of light ---------- */
  .hero-a__door {
    position: absolute;
    z-index: 1;
    right: calc(var(--door-right) - var(--band));
    bottom: calc(var(--door-bottom) - var(--band));
    width: calc(var(--door-w) + 2 * var(--band));
  }
  .hero-a__frame {
    --frame-r: 999px 999px calc(var(--u) * 1.5) calc(var(--u) * 1.7) / 999px 999px calc(var(--u) * 1.4)
      calc(var(--u) * 1.6);
    position: relative;
    padding: var(--band);
    border-radius: var(--frame-r);
    background-color: var(--creme-light);
    transform-origin: 50% 100%;
  }
  /* Label border: a blue hairline inside the crème band, and a crème echo outside it. */
  .hero-a__frame::before,
  .hero-a__frame::after {
    content: '';
    position: absolute;
    border-radius: var(--frame-r);
    pointer-events: none;
  }
  .hero-a__frame::before {
    inset: calc(var(--band) * 0.42);
    border: max(1px, calc(var(--u) * 0.04)) solid var(--blue);
    z-index: 1;
  }
  .hero-a__frame::after {
    inset: calc(var(--band) * -1.15);
    border: max(1px, calc(var(--u) * 0.045)) solid color-mix(in srgb, var(--creme) 62%, transparent);
  }
  .hero-a__frame :global(.media) {
    --media-r: 999px 999px calc(var(--u) * 1.18) calc(var(--u) * 1.38) / 999px 999px calc(var(--u) * 1.08)
      calc(var(--u) * 1.28);
  }
  .hero-a__frame :global(.media--inner-depth .media__clip picture) {
    scale: 1.09;
  }
  /* While the arch grows out of the ground, the picture settles inside it. */
  :global(html.motion) .hero-a__frame {
    transition-duration: 1.4s;
  }
  :global(html.motion) .hero-a__frame :global(img) {
    transform: scale(1.12);
    transition: transform 2s var(--ease-out) 380ms;
  }
  :global(html.motion) .hero-a__frame.is-in :global(img) {
    transform: none;
  }

  /* ---------- Title ---------- */
  /* Sized to its column, not from the type scale: the widest row ("MODERN PLATONIC",
     "& REMEMBER WHO") is close to 9.3em in each of the faces under test, so one size gives
     five rows in all of them. A wider face simply wraps to more rows. */
  .hero-a__title {
    position: relative;
    z-index: 2;
    margin: 8.5cqw 5cqw calc(var(--door-h) + var(--band) + var(--door-bottom) + 9cqw);
    font-family: var(--font-title);
    font-weight: var(--title-weight-xl, var(--title-weight));
    font-size: min(9.3cqw, 5rem);
    letter-spacing: var(--title-tracking);
    line-height: 0.93;
    color: var(--creme-light);
    font-variant-numeric: lining-nums;
    text-wrap: balance;
  }
  .hero-a__line {
    display: block;
  }
  .hero-a__line--2 {
    margin-top: 0.12em;
  }

  /* ---------- Near layers: crème cut-outs carrying blue line ---------- */
  .hero-a__cut :global(.illo) {
    color: var(--blue);
  }
  .hero-a__pine,
  .hero-a__ground,
  .hero-a__owl,
  .hero-a__star {
    position: absolute;
    pointer-events: none;
  }
  .hero-a__pine--2 {
    z-index: 3;
    right: calc(var(--door-right) + var(--u) * 7.6);
    bottom: calc(var(--u) * -0.4);
    width: calc(var(--u) * 5);
  }
  .hero-a__pine--1 {
    z-index: 3;
    /* past the panel edge, but never past the page edge */
    right: calc(-1 * min(var(--u) * 1.9, var(--gutter) - 0.3rem));
    bottom: calc(var(--u) * 1.1);
    width: calc(var(--u) * 5.6);
  }
  .hero-a__ground {
    z-index: 4;
    right: calc(-1 * var(--gutter));
    bottom: calc(var(--u) * -0.7);
    width: var(--ground-w);
  }
  /* Where the pointer can push the knoll sideways, let it run a little past the page edge. */
  @media (min-width: 56rem) and (hover: hover) and (pointer: fine) {
    .hero-a__ground {
      right: calc(-1 * var(--gutter) - 1.25rem);
    }
  }
  .hero-a__owl {
    z-index: 5;
    left: calc(var(--u) * -1.5);
    bottom: calc(var(--door-bottom) + var(--door-h) - var(--u) * 5.2);
    width: calc(var(--u) * 6.2);
  }
  .hero-a__star {
    z-index: 5;
    width: calc(var(--s) * 1cqw);
  }
  .hero-a__star :global(.illo) {
    color: var(--creme-light);
  }
  .hero-a__star--1 {
    --s: 5.6;
    right: 6cqw;
    bottom: calc(var(--door-bottom) + var(--door-h) + 1cqw);
  }
  .hero-a__star--2 {
    --s: 2.8;
    right: 22cqw;
    bottom: calc(var(--door-bottom) + var(--door-h) + 2.6cqw);
  }
  .hero-a__star--3 {
    --s: 4;
    left: 7cqw;
    bottom: calc(var(--door-bottom) + var(--door-h) - 3cqw);
  }

  /* ---------- Desktop: title left, the arch right of centre, one screen ---------- */
  @media (min-width: 56rem) {
    .hero-a {
      --hero-h: max(40rem, 100svh);
      min-height: var(--hero-h);
    }
    .hero-a__panel {
      --panel-h: calc(var(--hero-h) - var(--header-h) - 0.25rem - var(--hero-pb));
      --door-w: min(25cqw, calc(var(--panel-h) * 0.47));
      --door-right: calc(var(--u) * 4.5);
      --door-bottom: calc(var(--u) * 0.9);
      --rays-w: max(172cqw, calc(var(--panel-h) * 2.3));
      --ground-w: calc(var(--u) * 27);
      --pad-x: 5.2cqw;
    }
    .hero-a__ground {
      bottom: calc(var(--u) * -0.3);
    }
    .hero-a__mountains {
      right: -4cqw;
      /* on a short, wide screen the mountains sink so they stay under the title */
      bottom: min(1cqw, calc(var(--panel-h) * 0.3 - 16.5cqw));
      width: 108cqw;
    }
    .hero-a__sea {
      right: -2cqw;
      bottom: -5.4cqw;
      width: 104cqw;
    }
    .hero-a__title {
      position: absolute;
      left: var(--pad-x);
      top: 12.5%;
      /* everything left of the arch, less a gap */
      width: calc(100cqw - var(--pad-x) - var(--door-right) - var(--door-w) - var(--u) * 1.6);
      margin: 0;
      font-size: min(5.75cqw, calc(var(--panel-h) * 0.112));
    }
    .hero-a__pine--2 {
      right: calc(var(--door-right) + var(--u) * 8.1);
      bottom: calc(var(--u) * 0.4);
      width: calc(var(--u) * 5.6);
    }
    .hero-a__pine--1 {
      bottom: calc(var(--u) * 1.6);
      width: calc(var(--u) * 7.2);
    }
    .hero-a__owl {
      left: calc(var(--u) * -1.3);
      bottom: calc(var(--u) * 1.9);
      width: calc(var(--u) * 8.4);
    }
    .hero-a__star--1 {
      --s: 2.3;
      right: auto;
      bottom: auto;
      left: 50cqw;
      top: 7%;
    }
    .hero-a__star--2 {
      --s: 1.3;
      right: auto;
      bottom: auto;
      left: 56cqw;
      top: 17%;
    }
    .hero-a__star--3 {
      --s: 1.7;
      left: auto;
      right: 4.2cqw;
      top: 13%;
      bottom: auto;
    }
  }
</style>
