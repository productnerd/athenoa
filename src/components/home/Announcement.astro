---
// Home: Athena writes to her students. A letter on a sheet of paper, a dark-blue slip for the
// newsletter laid over its corner, then three course pictures hung from one rail.
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import republic from '../../assets/media/course-platos-republic.jpg';
import aurelius from '../../assets/media/course-marcus-aurelius.jpg';
import plato from '../../assets/media/plato-statue.jpg';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { home } = content(locale);
const { greeting, text, newsletter, courses } = home.announcement;

// Words this component adds itself: what each picture shows. Keyed by the image name used in the data.
const t = {
  en: {
    'course-platos-republic': 'The Parthenon lit up under a starry night sky',
    'course-marcus-aurelius':
      'A temple front at night with a glowing tablet of Greek letters and a bronze statue of Marcus Aurelius raising his hand',
    'plato-statue': 'Marble statue of Plato, seated, with a statue of Athena on a column behind',
  },
  el: {
    'course-platos-republic': 'Ο Παρθενώνας φωτισμένος κάτω από έναν έναστρο νυχτερινό ουρανό',
    'course-marcus-aurelius':
      'Πρόσοψη ναού τη νύχτα, με μια φωτεινή πλάκα με ελληνικά γράμματα και ένα χάλκινο άγαλμα του Μάρκου Αυρηλίου με υψωμένο το χέρι',
    'plato-statue': 'Μαρμάρινο άγαλμα του Πλάτωνα, καθιστού, με ένα άγαλμα της Αθηνάς πάνω σε κίονα στο βάθος',
  },
}[locale];

// How each picture is cropped.
const hang = {
  'course-platos-republic': { src: republic, ratio: '4 / 5', focus: '52% 50%' },
  'course-marcus-aurelius': { src: aurelius, ratio: '6 / 5', focus: '50% 50%' },
  'plato-statue': { src: plato, ratio: '4 / 5', focus: '80% 50%' },
};
---

<section class="section announcement" aria-labelledby="announcement-title">
  <div class="wrap">
    <div class="announcement__top">
      <div class="letter box box--offset" data-reveal>
        <Illustration name="laurel" class="letter__seal" draw />
        <h2 class="hand hand--l" id="announcement-title">{greeting}</h2>
        <p class="letter__text t-3">{text}</p>
      </div>

      <div class="slip box on-blue-deep" data-reveal data-depth="-0.04" style="--i:3">
        <p class="slip__text">{newsletter.text}</p>
        <p><a class="btn" href={newsletter.cta.href}>{newsletter.cta.label}</a></p>
      </div>
    </div>

    <ul class="tiles" role="list" data-depth="0.04">
      {
        courses.map((course, i) => {
          const look = hang[course.image];
          const Body = course.href ? 'a' : 'div';
          return (
            <li class:list={['tile', `tile--${i + 1}`]} style={`--i:${i}`}>
              <Body class="tile__body" href={course.href}>
                <Media
                  class="tile__photo"
                  src={look.src}
                  alt={t[course.image]}
                  shape="arch"
                  ratio={look.ratio}
                  focus={look.focus}
                  widths={[360, 560, 800, 940]}
                  sizes="(min-width: 56rem) 36vw, 88vw"
                />
                <h3 class="tile__title t-3" data-reveal>
                  {course.title}
                </h3>
              </Body>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .announcement__top {
    position: relative;
    display: grid;
    gap: 0;
  }

  /* ---------- The letter ---------- */
  .letter {
    --box-r: var(--r-soft-2);
    padding: clamp(1.9rem, 1.2rem + 3.4vw, 4rem);
    padding-bottom: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
  }
  .letter h2 {
    max-width: 22ch;
    padding-right: 2.5rem;
  }
  .letter__text {
    margin-top: var(--space-m);
    max-width: 20ch;
  }
  /* A laurel postmark on the corner of the sheet */
  .letter :global(.letter__seal) {
    position: absolute;
    top: -1.5rem;
    right: 0.5rem;
    width: clamp(4.5rem, 3.6rem + 5vw, 8.5rem);
    color: color-mix(in srgb, var(--blue) 62%, transparent);
    pointer-events: none;
  }

  /* ---------- The newsletter slip ---------- */
  .slip {
    --box-r: var(--r-soft);
    z-index: 1;
    justify-self: end;
    width: min(94%, 23rem);
    margin-top: -1.75rem;
    padding: clamp(1.35rem, 1rem + 1.6vw, 2.25rem);
  }
  .slip .btn {
    padding-inline: 1.25em;
    text-align: center;
  }
  .slip__text {
    margin-bottom: var(--space-s);
  }

  /* ---------- The course pictures ---------- */
  .tiles {
    --rail: 2.25rem;
    position: relative;
    display: grid;
    gap: calc(var(--space-l) + var(--rail));
    margin-top: calc(var(--space-xl) + var(--rail));
  }
  .tile {
    --drop: 0rem;
    position: relative;
    margin-top: var(--drop);
  }
  /* The cord each picture hangs from: a hairline up to a small nail */
  .tile::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1.5px;
    height: calc(var(--rail) + var(--drop));
    background: var(--line);
  }
  .tile::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: calc(100% + var(--rail) + var(--drop));
    width: 0.5rem;
    height: 0.45rem;
    margin: 0 0 -0.2rem calc(-0.25rem + 0.75px);
    background: var(--ink-strong);
    border-radius: var(--r-pebble-1);
  }
  .tile__body {
    display: block;
    text-decoration: none;
  }
  .tile__title {
    --delay: 320ms;
    margin-top: 1rem;
    font-size: calc(var(--step-2) * 0.78);
    max-width: 26ch;
  }
  a.tile__body .tile__title {
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 0.05em;
    text-underline-offset: 0.16em;
    transition: text-decoration-color var(--dur-1);
  }
  a.tile__body:hover .tile__title,
  a.tile__body:focus-visible .tile__title {
    text-decoration-color: currentColor;
  }
  a.tile__body :global(.media__clip picture) {
    display: block;
    transition: scale var(--dur-3) var(--ease-out);
  }
  a.tile__body:hover :global(.media__clip picture) {
    scale: 1.045;
  }
  a.tile__body:focus-visible {
    outline-offset: 0.6rem;
    border-radius: var(--r-soft);
  }

  /* Small screens: one column. Left, full width, right. */
  .tile--1,
  .tile--3 {
    width: 76%;
  }
  .tile--3 {
    margin-left: auto;
  }

  /* Middle widths: two on the left, the wide one beside them on the right */
  @media (min-width: 40rem) and (max-width: 55.99rem) {
    .tiles {
      grid-template-columns: 5fr 6fr;
      column-gap: 7%;
      align-items: start;
    }
    .tile--1 {
      grid-column: 1;
      grid-row: 1;
      width: auto;
    }
    .tile--2 {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }
    .tile--3 {
      grid-column: 1;
      grid-row: 2;
      width: auto;
      margin-left: 0;
    }
  }

  @media (min-width: 56rem) {
    .announcement__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 0.4rem + 1.7vw, 2rem);
      align-items: end;
    }
    /* The sheet sits to the right; the slip is laid over its lower left corner, in the margin */
    .letter {
      grid-column: 6 / span 7;
      grid-row: 1;
      padding-left: clamp(3rem, 1rem + 5vw, 5.5rem);
    }
    /* On a wide sheet the laurel moves to the foot of the letter, where a seal would go:
       pressed over the lower edge, half on the sheet and half on the page, clear of the words */
    .letter :global(.letter__seal) {
      --seal-w: clamp(6.5rem, 3.5rem + 6vw, 9.75rem);
      top: auto;
      right: clamp(2rem, 5vw, 4.5rem);
      bottom: calc(var(--seal-w) * -0.52);
      width: var(--seal-w);
    }
    .slip {
      grid-column: 2 / span 4;
      grid-row: 1;
      justify-self: stretch;
      width: auto;
      margin: 0 -3.5rem -3.25rem 0;
    }
    .letter h2 {
      max-width: 25ch;
      padding-right: 0;
    }
    .letter__text {
      max-width: 24ch;
    }

    /* Three pictures on one rail, evenly spaced, at slightly different heights */
    .tiles {
      --rail: 3rem;
      grid-template-columns: 3fr 5fr 3fr;
      column-gap: clamp(2.5rem, 7%, 6rem);
      align-items: start;
      row-gap: var(--space-l);
      margin-top: calc(var(--space-xl) + var(--rail) + 1rem);
    }
    .tiles::before {
      content: '';
      position: absolute;
      inset: calc(var(--rail) * -1) 0 auto;
      height: 1.5px;
      background: var(--line);
      border-radius: 2px;
    }
    .tile--1 {
      --drop: 2.25rem;
      width: auto;
    }
    .tile--3 {
      --drop: 3.75rem;
      width: auto;
      margin-left: 0;
    }
  }
</style>
