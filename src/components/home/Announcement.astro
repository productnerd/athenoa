---
// Home: Athena writes to her students. A letter on a sheet of paper, a dark-blue slip for the
// newsletter laid over its corner, then the announced courses as course cards (the same cards as
// on the courses page, so a course looks like a course wherever it appears).
import { handCase } from '../../lib/hand';
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import CourseCard from '../courses/CourseCard.astro';
import CourseDialog from '../courses/CourseDialog.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { home, courses } = content(locale);
const { greeting, text, newsletter } = home.announcement;
// The announced courses, as their full course entries, so they are drawn as course cards.
const announced = home.announcement.courses
  .map((item) => courses.find((course) => course.slug === item.slug))
  .filter((course) => course !== undefined);
---

<section class="section announcement" aria-labelledby="announcement-title">
  <div class="wrap">
    <div class="announcement__top">
      <div class="letter box box--offset" data-reveal>
        <h2 class="hand hand--l" id="announcement-title">{handCase(greeting)}</h2>
        <p class="letter__text hand hand--l">{handCase(text)}</p>
      </div>

      <div class="slip box on-blue-deep" data-reveal data-depth="-0.04" style="--i:3">
        <Illustration name="dove-scroll" class="slip__dove" />
        <h3 class="slip__title t-3">{newsletter.title}</h3>
        <p class="slip__text">{newsletter.text}</p>
        <p><a class="btn" href={newsletter.cta.href}>{newsletter.cta.label}</a></p>
      </div>
    </div>

    <ul class="courses-row" role="list" data-reveal-group>
      {
        announced.map((course) => (
          <li>
            <CourseCard course={course} level={3} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

{/* The same popups as on the Courses page, so "Enroll" and the plus open in place here too */}
{announced.map((course) => <CourseDialog course={course} />)}

<script>
  // The dove's wings, very quietly, and a single chirp, as it flies in to the newsletter slip: eight soft beats in step
  // with the drawing (which starts half a second after the slip comes into view). Once per visit to
  // the page, only with motion on, and silent when the visitor has muted the site's sound.
  const VOLUME = 0.049;
  const CHIRP = 0.112;
  document.addEventListener('astro:page-load', () => {
    const slip = document.querySelector<HTMLElement>('.slip');
    if (!slip || slip.dataset.wings) return;
    slip.dataset.wings = 'ready';
    const play = () => {
      if (!document.documentElement.classList.contains('motion')) return;
      try {
        if (localStorage.getItem('ath-music') === 'off') return;
      } catch {}
      const sound = new Audio('/audio/wings.mp3');
      sound.volume = VOLUME;
      window.setTimeout(() => sound.play().catch(() => {}), 500);
      // and one small chirp as it comes in over the slip
      const chirp = new Audio('/audio/chirp-single.mp3');
      chirp.volume = CHIRP;
      window.setTimeout(() => chirp.play().catch(() => {}), 1700);
    };
    if (slip.classList.contains('is-in')) return; // already in view when the page opened: no sound
    const watch = new MutationObserver(() => {
      if (!slip.classList.contains('is-in')) return;
      watch.disconnect();
      play();
    });
    watch.observe(slip, { attributes: true, attributeFilter: ['class'] });
  });
</script>

<style>
  .announcement__top {
    position: relative;
    display: grid;
    gap: 0;
  }

  /* ---------- The letter ---------- */
  .letter {
    --box-r: var(--r-soft-2);
    padding: clamp(1.9rem, 1.2rem + 3.4vw, 4rem);
    padding-bottom: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
  }
  /* An announcement more than a letter: the hand is set smaller and closer than elsewhere */
  .letter h2,
  .letter__text {
    font-size: calc(var(--step-1) * 1.12);
    line-height: 1.24;
  }
  .letter h2 {
    max-width: 26ch;
    padding-right: 2.5rem;
  }
  .letter__text {
    margin-top: var(--space-xs);
    max-width: 30ch;
  }
  /* ---------- The newsletter slip ---------- */
  .slip {
    --box-r: var(--r-soft);
    z-index: 1;
    justify-self: end;
    width: min(94%, 23rem);
    margin-top: -1.75rem;
    padding: clamp(1.35rem, 1rem + 1.6vw, 2.25rem);
  }
  .slip .btn {
    padding-inline: 1.25em;
    text-align: center;
  }
  /* A dove carrying an open papyrus that hangs long beneath it: the old way to send word. It flies in from the left when the slip
     comes into view, wings beating, and settles above the text. */
  .slip :global(.slip__dove) {
    width: clamp(6.6rem, 5.8rem + 3vw, 8.6rem);
    margin: -0.5rem 0 0.8rem -0.4rem;
    color: var(--blue-light);
    --paper: var(--blue-deep);
  }
  /* The eye is always pale with a dark pupil. By day the slip is dark and the line light, so the
     line colour is the white of the eye; by night the slip is pale and the line dark, so it is the
     other way round. */
  :global(html[data-theme='dark']) .slip :global(.slip__dove) {
    --eye-white: #fffdf6;
    --eye-pupil: currentColor;
    --eye-line: currentColor;
  }
  @keyframes dove-in {
    0% {
      opacity: 0;
      transform: translate3d(-34rem, -4.5rem, 0) rotate(-9deg);
    }
    12% {
      opacity: 1;
    }
    60% {
      transform: translate3d(-5rem, 0.9rem, 0) rotate(4deg);
    }
    100% {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes dove-wing {
    50% {
      transform: rotate(-26deg);
    }
  }
  @keyframes dove-wing-far {
    50% {
      transform: rotate(18deg);
    }
  }
  :global(html.motion) .slip :global(.slip__dove) {
    opacity: 0;
  }
  :global(html.motion) .slip:global(.is-in) :global(.slip__dove) {
    animation: dove-in 2.6s cubic-bezier(0.22, 0.8, 0.3, 1) 0.5s both;
  }
  .slip :global(.dove-scroll__near-wing),
  .slip :global(.dove-scroll__far-wing) {
    transform-box: fill-box;
    transform-origin: 30% 100%;
  }
  /* Eight beats while it flies, then the wings rest */
  :global(html.motion) .slip:global(.is-in) :global(.dove-scroll__near-wing) {
    animation: dove-wing 0.36s ease-in-out 0.5s 8;
  }
  :global(html.motion) .slip:global(.is-in) :global(.dove-scroll__far-wing) {
    animation: dove-wing-far 0.36s ease-in-out 0.5s 8;
  }
  .slip__title {
    margin-bottom: 0.35rem;
  }
  .slip__text {
    margin-bottom: var(--space-s);
  }

  /* ---------- The announced courses ---------- */
  .courses-row {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 44rem) {
    .courses-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: stretch;
    }
    /* cards in a row share a height */
    .courses-row > li {
      display: grid;
    }
  }

  @media (min-width: 56rem) {
    .announcement__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 0.4rem + 1.7vw, 2rem);
      align-items: end;
    }
    /* The sheet sits to the right; the slip is laid over its lower left corner, in the margin */
    .letter {
      grid-column: 6 / span 7;
      grid-row: 1;
      padding-left: clamp(3rem, 1rem + 5vw, 5.5rem);
    }
    .slip {
      grid-column: 2 / span 4;
      grid-row: 1;
      justify-self: stretch;
      width: auto;
      margin: 0 -3.5rem -3.25rem 0;
    }
    .letter h2 {
      max-width: 30ch;
      padding-right: 0;
    }
    .letter__text {
      max-width: 32ch;
    }

    /* One even row: the three cards share a height */
    .courses-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
