---
// Home: Athena writes to her students. A letter on a sheet of paper, a dark-blue slip for the
// newsletter laid over its corner, then the announced courses as course cards (the same cards as
// on the courses page, so a course looks like a course wherever it appears).
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import CourseCard from '../courses/CourseCard.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { home, courses } = content(locale);
const { greeting, text, newsletter } = home.announcement;
// The announced courses, as their full course entries, so they are drawn as course cards.
const announced = home.announcement.courses
  .map((item) => courses.find((course) => course.slug === item.slug))
  .filter((course) => course !== undefined);
---

<section class="section announcement" aria-labelledby="announcement-title">
  <div class="wrap">
    <div class="announcement__top">
      <div class="letter box box--offset" data-reveal>
        <Illustration name="laurel" class="letter__seal" draw />
        <h2 class="hand hand--l" id="announcement-title">{greeting}</h2>
        <p class="letter__text hand hand--l">{text}</p>
      </div>

      <div class="slip box on-blue-deep" data-reveal data-depth="-0.04" style="--i:3">
        <svg class="slip__icon" viewBox="0 0 64 52" width="64" height="52" aria-hidden="true" focusable="false" data-draw>
          <path d="M6 12c0-3 2-5 5-5h42c3 0 5 2 5 5v28c0 3-2 5-5 5H11c-3 0-5-2-5-5z"></path>
          <path d="M7 11l22 18c2 1.6 4 1.6 6 0l22-18"></path>
          <path d="M7 43l17-15M57 43 40 28"></path>
          <path d="M32 2v-1M22 4l-1-2M42 4l1-2"></path>
        </svg>
        <p class="slip__text">{newsletter.text}</p>
        <p><a class="btn" href={newsletter.cta.href}>{newsletter.cta.label}</a></p>
      </div>
    </div>

    <ul class="courses-row" role="list" data-reveal-group>
      {
        announced.map((course) => (
          <li>
            <CourseCard course={course} cut="arch" level={3} />
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .announcement__top {
    position: relative;
    display: grid;
    gap: 0;
  }

  /* ---------- The letter ---------- */
  .letter {
    --box-r: var(--r-soft-2);
    padding: clamp(1.9rem, 1.2rem + 3.4vw, 4rem);
    padding-bottom: clamp(2.6rem, 1.6rem + 4vw, 4.75rem);
  }
  .letter h2 {
    max-width: 22ch;
    padding-right: 2.5rem;
  }
  .letter__text {
    margin-top: var(--space-s);
    max-width: 26ch;
  }
  /* A laurel postmark on the corner of the sheet */
  .letter :global(.letter__seal) {
    position: absolute;
    top: -1.5rem;
    right: 0.5rem;
    width: clamp(4.5rem, 3.6rem + 5vw, 8.5rem);
    color: color-mix(in srgb, var(--blue) 62%, transparent);
    pointer-events: none;
  }

  /* ---------- The newsletter slip ---------- */
  .slip {
    --box-r: var(--r-soft);
    z-index: 1;
    justify-self: end;
    width: min(94%, 23rem);
    margin-top: -1.75rem;
    padding: clamp(1.35rem, 1rem + 1.6vw, 2.25rem);
  }
  .slip .btn {
    padding-inline: 1.25em;
    text-align: center;
  }
  /* An envelope, so the slip reads at a glance as the place to subscribe */
  .slip__icon {
    width: 3.4rem;
    height: auto;
    margin-bottom: 0.7rem;
    overflow: visible;
    color: var(--blue-light);
    rotate: -6deg;
  }
  .slip__icon path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .slip__text {
    margin-bottom: var(--space-s);
  }

  /* ---------- The announced courses ---------- */
  .courses-row {
    display: grid;
    gap: var(--space-xl) var(--space-l);
    margin: var(--space-xl) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 44rem) {
    .courses-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 56rem) {
    .announcement__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: clamp(1rem, 0.4rem + 1.7vw, 2rem);
      align-items: end;
    }
    /* The sheet sits to the right; the slip is laid over its lower left corner, in the margin */
    .letter {
      grid-column: 6 / span 7;
      grid-row: 1;
      padding-left: clamp(3rem, 1rem + 5vw, 5.5rem);
    }
    /* On a wide sheet the laurel moves to the foot of the letter, where a seal would go:
       pressed over the lower edge, half on the sheet and half on the page, clear of the words */
    .letter :global(.letter__seal) {
      --seal-w: clamp(6.5rem, 3.5rem + 6vw, 9.75rem);
      top: auto;
      right: clamp(2rem, 5vw, 4.5rem);
      bottom: calc(var(--seal-w) * -0.52);
      width: var(--seal-w);
    }
    .slip {
      grid-column: 2 / span 4;
      grid-row: 1;
      justify-self: stretch;
      width: auto;
      margin: 0 -3.5rem -3.25rem 0;
    }
    .letter h2 {
      max-width: 25ch;
      padding-right: 0;
    }
    .letter__text {
      max-width: 24ch;
    }

    /* One even row: the three cards share a height */
    .courses-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
    .courses-row > li {
      display: grid;
    }
  }
</style>
