---
// A soft fire for the brazier in the hero drawing. It burns while the hero is in view and dies away as
// the page scrolls past it; on a page without a hero it never plays. It is a sound effect, not music:
// the sound button, which mutes only the music, leaves it alone (client direction, 15 October 2026).
// Before the visitor's first click, tap or key press (browsers allow no sound until then) it is silent.
---

<audio src="/audio/fire.mp3" loop preload="none" data-fire-audio></audio>

<script>
  const VOLUME = 0.045; // loudest, with the page at its top: under the music, a few steps from the flame
  const REACH = 0.85; // share of the hero's height over which the fire dies away
  const FADE_IN = 1500; // ms: every start eases in, it never arrives at full level

  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));

  let cleanup: Array<() => void> = [];

  function stop() {
    cleanup.forEach((fn) => fn());
    cleanup = [];
  }

  function setup() {
    stop();
    const audio = document.querySelector<HTMLAudioElement>('[data-fire-audio]');
    const hero = document.querySelector<HTMLElement>('.hero');
    if (!audio) return;
    if (!hero) {
      if (!audio.paused) audio.pause();
      return;
    }

    let frame = 0;
    let began = 0; // when the current fade in started

    // Tried at once: where the browser allows sound before a click it plays from the start, elsewhere
    // the attempt fails quietly and the first click, tap or key press starts it.
    const allowed = () => true;

    // 1 with the page at its top, 0 once most of the hero has scrolled away
    const level = () => {
      const height = hero.offsetHeight;
      if (!height) return 0;
      const left = clamp(1 - window.scrollY / (height * REACH), 0, 1);
      // Squared: loudness is heard on a curve, so a straight line would seem to hold and then drop
      return left * left;
    };

    const apply = () => {
      cancelAnimationFrame(frame);
      frame = 0;
      const target = allowed() ? VOLUME * level() : 0;
      if (target <= 0) {
        if (!audio.paused) audio.pause();
        return;
      }
      if (audio.paused) {
        began = performance.now();
        audio.volume = 0;
        // No file, or the browser still wants a gesture: stay silent, the next change tries again.
        audio.play().catch(() => {});
      }
      const fade = clamp((performance.now() - began) / FADE_IN, 0, 1);
      audio.volume = clamp(target * fade, 0, 1); // never outside 0..1: the browser throws on that
      if (fade < 1 && !audio.paused) frame = requestAnimationFrame(apply);
    };

    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(apply);
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    cleanup.push(() => window.removeEventListener('scroll', onScroll));

    // The music starts on the first click, tap or key press, in a listener that runs before this one.
    // Answering the same gesture lets the fire start inside it, which some browsers insist on.
    const onGesture = () => {
      apply();
    };
    for (const type of ['pointerdown', 'keydown']) {
      window.addEventListener(type, onGesture, { passive: true });
      cleanup.push(() => window.removeEventListener(type, onGesture));
    }

    cleanup.push(() => {
      cancelAnimationFrame(frame);
      if (!audio.paused) audio.pause();
    });

    apply();
  }

  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', stop);
  // The script can first arrive with a page change, after that page's astro:page-load has already fired.
  setup();
</script>
