---
// Home: "Benefits of Joining ATHENOA", on paper. Three benefits, each one a single piece: a photograph in
// an organic window set into the edge of its box. The photo changes side from one to the next and the
// boxes step through the three blues (light, Greek, darker). The fourth photo (ancient stones on a hilltop)
// completes the third benefit, the footsteps of the Ancient Sages, where its pale light reads best.
import type { ComponentProps } from 'astro/types';
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import column from '../../assets/media/academy-column.jpg';
import gathering from '../../assets/media/gathering-amphitheatre.jpg';
import reading from '../../assets/media/reading-by-the-sea.jpg';
import hilltop from '../../assets/media/hilltop-meditation.png';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { benefits } = content(locale).home;
const t = {
  en: {
    gatheringAlt: 'A circle of women dressed in white embrace on a stone terrace beside a pool, high above the sea',
    hilltopAlt: 'A woman sits in meditation among ancient stones on a sunlit hilltop, hazy mountains beyond',
    readingAlt: 'A smiling woman reads a book in the sun, the sea and a bright sky behind her',
    columnAlt:
      'A woman in a blue dress stands before the Academy of Athens, under the tall column that carries the statue of Athena',
  },
  el: {
    gatheringAlt:
      'Ένας κύκλος γυναικών ντυμένων στα λευκά αγκαλιάζονται σε ένα πέτρινο πλάτωμα δίπλα σε μια πισίνα, ψηλά πάνω από τη θάλασσα',
    hilltopAlt:
      'Μια γυναίκα κάθεται σε διαλογισμό ανάμεσα σε αρχαίες πέτρες, σε έναν ηλιόλουστο λόφο, με θαμπά βουνά στο βάθος',
    readingAlt:
      'Μια χαμογελαστή γυναίκα διαβάζει ένα βιβλίο στον ήλιο, με τη θάλασσα και τον φωτεινό ουρανό πίσω της',
    columnAlt:
      'Μια γυναίκα με μπλε φόρεμα στέκεται μπροστά στην Ακαδημία Αθηνών, κάτω από τον ψηλό κίονα με το άγαλμα της Αθηνάς',
  },
}[locale];

// One look per benefit, in the order of the copy: the experiential path and its community,
// methodical training in the texts, the footsteps of the Ancient Sages and the Platonic Academy.
// `surface` is the blue of the box, `mat` the blue of the cut-out behind each photograph.
type Photo = Pick<ComponentProps<typeof Media>, 'src' | 'alt' | 'shape' | 'ratio' | 'focus' | 'widths' | 'sizes'>;
const looks: { surface: string; mat: string; photo: Photo; second?: Photo }[] = [
  {
    surface: 'on-blue-light',
    mat: 'on-blue',
    photo: {
      src: gathering,
      alt: t.gatheringAlt,
      shape: 'pebble-1',
      ratio: '7 / 6',
      focus: '50% 62%',
      widths: [360, 560, 800, 1100],
      sizes: '(min-width: 60rem) 34rem, 80vw',
    },
  },
  {
    surface: 'on-blue',
    mat: 'on-blue-light',
    photo: {
      src: reading,
      alt: t.readingAlt,
      shape: 'pebble-3',
      ratio: '1 / 1',
      focus: '42% 45%',
      widths: [360, 560, 869],
      sizes: '(min-width: 60rem) 30rem, 80vw',
    },
  },
  {
    surface: 'on-blue-deep',
    mat: 'on-blue-light',
    photo: {
      src: column,
      alt: t.columnAlt,
      shape: 'arch',
      ratio: '3 / 4.1',
      focus: '50% 60%',
      widths: [360, 560, 800, 1100],
      sizes: '(min-width: 60rem) 26rem, 64vw',
    },
    // A small file (690px wide): it is never shown wider than 23rem.
    second: {
      src: hilltop,
      alt: t.hilltopAlt,
      shape: 'pill',
      ratio: '690 / 300',
      focus: '70% 60%',
      widths: [360, 520, 690],
      sizes: '(min-width: 60rem) 23rem, 50vw',
    },
  },
];
---

<section class="benefits section" aria-labelledby="benefits-title">
  <div class="wrap benefits__grid">
    <header class="benefits__head">
      <h2 class="t-1" id="benefits-title" data-split>{benefits.title}</h2>
      <p class="lead" data-reveal>{benefits.question}</p>
      <Illustration name="olive-branch" class="benefits__olive" draw />
    </header>

    <ul class="benefits__units" role="list">
      {
        benefits.items.map((item, i) => {
          const { surface, mat, photo, second } = looks[i];
          return (
            <li class:list={['unit', `unit--${i + 1}`]}>
              <div class="unit__photos" data-depth="-0.05">
                <div class:list={['unit__frame', mat]}>
                  <Media class="unit__photo" {...photo} />
                </div>
              </div>
              <div class:list={['unit__box box', surface, second && 'unit__box--second']} data-reveal>
                <h3 class="unit__title">{item.title}</h3>
                <p>{item.italic ? <em>{item.text}</em> : item.text}</p>
                {second && (
                  <div class:list={['unit__frame unit__second', mat]} data-depth="-0.04">
                    <Media class="unit__photo" {...second} />
                  </div>
                )}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .benefits__grid {
    display: grid;
    gap: var(--space-l);
  }
  .benefits__head {
    position: relative;
  }
  .benefits__head .lead {
    margin-top: var(--space-m);
    max-width: 30ch;
  }
  .benefits__olive {
    width: clamp(8rem, 5rem + 14vw, 15rem);
    margin-top: var(--space-m);
  }

  /* ---------- A benefit: photograph and box as one piece ---------- */
  .benefits__units {
    display: grid;
    gap: var(--space-l);
    margin: 0;
  }
  .unit {
    --lap: 4.5rem; /* how far the photograph reaches down into its box on narrow screens */
    display: grid;
  }
  .unit__photos {
    position: relative;
    z-index: 1;
    isolation: isolate;
    width: min(80%, 25rem);
    margin-bottom: calc(var(--lap) * -1);
  }
  .unit--2 .unit__photos {
    justify-self: end;
  }
  .unit--3 .unit__photos {
    width: min(62%, 19rem);
    margin-left: 6%;
  }
  .unit__frame {
    position: relative;
  }
  /* A cut-out in another blue lies behind each photograph and shows as a rim on one side. */
  .unit__frame::before {
    content: '';
    position: absolute;
    z-index: -1;
    background-color: var(--paper);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
  .unit--1 .unit__frame::before {
    inset: -3% 2% -5% -6%;
    border-radius: var(--r-pebble-3);
  }
  .unit--2 .unit__frame::before {
    inset: -5% -6% -3% 2%;
    border-radius: var(--r-pebble-1);
  }
  .unit--3 .unit__photos .unit__frame::before {
    inset: -0.7rem;
    border-radius: 50% 50% 3rem 3.4rem / 31% 31% 2.8rem 3.2rem;
  }
  /* The shared arch token flattens its lower corners on a narrow frame, so this arch sets its own. */
  .unit--3 .unit__photos .unit__photo {
    --media-r: 50% 50% 2.4rem 2.8rem / 32% 32% 2.2rem 2.6rem;
  }
  /* The second, smaller photograph of the last benefit rests on the lower edge of its box,
     half on the blue and half on the paper. It is a small file, so it never passes 23rem. */
  .unit--3 {
    --pill-w: clamp(11rem, 8rem + 14vw, 23rem);
    --pill-out: calc(var(--pill-w) * 300 / 690 / 2);
    margin-bottom: var(--pill-out);
  }
  .unit__second {
    position: absolute;
    right: 7%;
    bottom: calc(var(--pill-out) * -1);
    width: var(--pill-w);
  }
  .unit__second::before {
    inset: -0.5rem;
    border-radius: var(--r-pill);
  }

  .unit__box {
    padding-top: calc(var(--lap) + var(--space-m));
  }
  .unit__box--second {
    padding-bottom: calc(var(--pill-out) + var(--space-m));
  }
  .unit--1 .unit__box {
    --box-r: 3.4rem 4.6rem 3.8rem 5rem / 4.4rem 3.6rem 5rem 3.8rem;
  }
  .unit--2 .unit__box {
    --box-r: 5rem 3.2rem 4.6rem 3.6rem / 3.6rem 4.8rem 3.4rem 4.6rem;
  }
  .unit--3 .unit__box {
    --box-r: 3.8rem 5.2rem 3.4rem 4.4rem / 4.8rem 3.4rem 4.6rem 3.6rem;
  }
  .unit__box p {
    max-width: var(--measure);
  }
  .unit__title {
    margin-bottom: 0.7em;
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: calc(var(--step-2) * 0.86);
    line-height: calc(var(--title-leading) + 0.12);
    letter-spacing: var(--title-tracking);
    color: var(--ink-strong);
  }

  /* Between phone and desktop the pieces stop growing: two of the photographs are small files. */
  @media (min-width: 40rem) {
    .benefits__units {
      max-width: 44rem;
    }
  }

  @media (min-width: 60rem) {
    .benefits__grid {
      row-gap: var(--space-xl);
    }
    /* The olive sprig lies beside the question, under the title */
    .benefits__head {
      display: grid;
      grid-template-columns: minmax(0, max-content) auto;
      justify-content: start;
      align-items: end;
      column-gap: var(--space-m);
    }
    .benefits__head h2 {
      grid-column: 1 / -1;
    }
    .benefits__olive {
      width: clamp(8rem, 12vw, 12rem);
      margin: 0 0 0.4rem;
    }

    /* Photograph and box share one row and overlap by two columns; the photograph is the taller of the
       two, so it stands a little proud of the box above and below. Odd pieces carry the photograph on
       the left, the even one on the right. */
    .benefits__units {
      max-width: none;
      gap: var(--space-m);
    }
    .unit {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-m);
      align-items: center;
    }
    .unit__photos,
    .unit__box {
      grid-row: 1;
    }
    .unit__photos,
    .unit--3 .unit__photos {
      grid-column: 1 / span 5;
      width: auto;
      margin: 0;
    }
    .unit__box {
      --pad: clamp(2.25rem, 1rem + 3vw, 3.75rem);
      grid-column: 4 / span 8;
      padding: var(--pad) var(--pad) var(--pad) calc(25% + var(--space-l));
    }
    .unit__box--second {
      padding-bottom: calc(var(--pill-out) + var(--space-m));
    }
    .unit--2 .unit__photos {
      grid-column: 8 / span 5;
      justify-self: stretch;
      margin-left: 9%;
    }
    .unit--2 .unit__box {
      grid-column: 2 / span 8;
      padding-left: var(--pad);
      padding-right: calc(25% + var(--space-l));
    }
    /* Last benefit: the arch and the small photograph stand on one line, a little below the box. */
    .unit--3 {
      align-items: end;
    }
    .unit--3 .unit__photos {
      margin: 0 16% calc(var(--pill-out) * -1) 4%;
    }
  }
</style>
