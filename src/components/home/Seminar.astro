---
// Home: the monthly seminar on the Orphic Hymns. A Greek-blue cut-out with a round end like an apse.
// Inside it the lyre stands before a dark disc with light radiating around it; the Orphic egg sits
// on a light-blue pebble laid over the top edge, an olive branch slips out from underneath, and the
// date note is written on the paper below. All three blues meet here.
import { handCase } from '../../lib/hand';
import Illustration from '../Illustration.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const { home } = content(getLocale(Astro.url));
const { kicker, title, open, note } = home.seminar;
---

<section class="section seminar" aria-labelledby="seminar-title">
  <div class="wrap">
    <div class="seminar__stage">
      <div class="seminar__panel panel panel--arch on-blue">
        <div class="panel__clip">
          <div class="seminar__sun" data-depth="0.14">
            <div class="seminar__rays">
              <Illustration name="sun-rays" />
            </div>
          </div>
        </div>

        {/* An easter egg: pressed, the lyre sounds a chord and sways (client request, 14 October 2026) */}
        <div class="seminar__lyre" data-lyre>
          <Illustration name="lyre" draw />
        </div>

        <div class="seminar__copy">
          <p class="seminar__kicker" data-reveal>{kicker}</p>
          <h2 class="t-2" id="seminar-title" data-split>{title}</h2>
          <p class="seminar__open lead" data-reveal style="--delay:350ms"><strong>{open}</strong></p>
        </div>
      </div>

    </div>

    <p class="seminar__note hand hand--m" data-reveal>{handCase(note)}</p>
  </div>
</section>

<script>
  import { playSound } from '../../scripts/sound';

  // The sound of an ancient lyre, not a western chord (client direction, 15 October 2026): seven strings
  // swept once with a plectrum, tuned to the Dorian harmonia (E F G A B C D, two conjunct tetrachords)
  // in Pythagorean ratios, plucked gut with a short decay. Made by scripts/audio/lyre.mjs.
  document.addEventListener('astro:page-load', () => {
    const lyre = document.querySelector<HTMLElement>('[data-lyre]:not([data-lyre-ready])');
    if (!lyre) return;
    lyre.dataset.lyreReady = '';
    lyre.addEventListener('click', () => {
      playSound('/audio/lyre.mp3', 0.049);
      lyre.classList.remove('is-strummed');
      void lyre.offsetWidth; // (to sway again on a second press)
      lyre.classList.add('is-strummed');
    });
    lyre.addEventListener('animationend', () => lyre.classList.remove('is-strummed'));
  });
</script>

<style>
  .seminar__stage {
    position: relative;
    isolation: isolate;
  }

  /* ---------- The cut-out ---------- */
  .seminar__panel {
    --lyre-w: min(46vw, 15rem);
    --pad-t: clamp(3.5rem, 16vw, 6rem);
    --rays-w: calc(var(--lyre-w) * 3.1);
    z-index: 1;
    display: grid;
    gap: var(--space-l);
    padding-top: var(--pad-t);
    padding-bottom: var(--space-l);
  }
  .seminar__lyre {
    cursor: pointer;
    transform-origin: 50% 90%;
    width: var(--lyre-w);
    margin-inline: auto;
  }
  /* Behind the lyre, far away and cut to the outline: a disc of darker blue, light all round it */
  .seminar__sun {
    position: absolute;
    left: 50%;
    top: calc(var(--pad-t) + var(--lyre-w) * 0.6 - 5px);
    width: var(--rays-w);
    aspect-ratio: 1;
    margin: calc(var(--rays-w) / -2) 0 0 calc(var(--rays-w) / -2);
  }
  .seminar__sun::after {
    content: '';
    position: absolute;
    inset: calc(50% - var(--lyre-w) * 0.68);
    border-radius: var(--r-pebble-1);
    background: var(--blue-deep);
    filter: url(#rough-sm);
  }
  /* The light thins out before it reaches the words */
  .seminar__rays {
    mask-image: linear-gradient(180deg, #000 50%, transparent 74%);
  }
  .seminar__rays :global(.illo) {
    color: color-mix(in srgb, var(--blue-light) 62%, transparent);
  }

  .seminar__kicker {
    font-size: var(--step--1);
    font-weight: 560;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    margin-bottom: var(--space-s);
  }
  .seminar__open {
    margin-top: var(--space-m);
    max-width: none;
  }

  /* ---------- The Orphic egg, on a light-blue pebble at the shoulder of the arch ---------- */
  /* The arch is half an ellipse as wide as the panel, so a point on its shoulder is a fixed share of
     that width across and down (percentage margins also measure the width). The pebble's centre sits
     just outside that point, and never further right than the page gutter allows. */

  /* ---------- The olive branch, tucked under the lower edge ---------- */

  /* ---------- The note on the paper below ---------- */
  .seminar__note {
    position: relative;
    z-index: 2;
    /* one line wherever the screen is wide enough for it; it only wraps on a narrow one */
    max-width: none;
    margin: calc(var(--space-m) + 1.5rem) 4% 0 4%;
    line-height: 1.3;
  }

  @media (min-width: 56rem) {
    /* On wide screens the arch lies on its side: square-cut at the left, a half-round at the right */
    .seminar__panel {
      --lyre-w: clamp(13rem, 8rem + 14vw, 21rem);
      --pad-r: clamp(3.5rem, 1rem + 6vw, 7.5rem);
      --rays-w: calc(var(--lyre-w) * 2.8);
      --panel-r: 3.2rem 19rem 19rem 3.8rem / 3rem 50% 50% 3.4rem;
      grid-template-columns: minmax(0, 1fr) var(--lyre-w);
      align-items: center;
      column-gap: clamp(2rem, 5vw, 5.5rem);
      min-height: 34rem;
      padding-block: var(--space-xl);
      padding-right: var(--pad-r);
    }
    .seminar__copy {
      grid-column: 1;
      grid-row: 1;
      max-width: 44rem;
    }
    .seminar__copy h2 {
      max-width: 22ch;
    }
    .seminar__lyre {
      grid-column: 2;
      grid-row: 1;
      width: auto;
      margin: 0;
    }
    .seminar__sun {
      left: auto;
      right: calc(var(--pad-r) + var(--lyre-w) / 2 - var(--rays-w) / 2 - 5px);
      top: 50%;
      margin: calc(var(--rays-w) / -2) 0 0;
    }
    .seminar__rays {
      mask-image: linear-gradient(90deg, transparent 7%, #000 36%);
    }
    /* The pebble lies over the straight top edge and lines up with the text below it */
    .seminar__note {
      margin: var(--space-m) 0 0 clamp(1.25rem, 0.4rem + 4.6vw, 5.5rem);
    }
  }
  @keyframes lyre-sway {
    0%,
    100% {
      rotate: 0deg;
    }
    20% {
      rotate: -2.2deg;
    }
    45% {
      rotate: 1.4deg;
    }
    70% {
      rotate: -0.6deg;
    }
  }
  :global(html.motion) .seminar__lyre:global(.is-strummed) {
    animation: lyre-sway 1.1s ease-out;
  }
</style>
