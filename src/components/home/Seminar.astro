---
// Home: the monthly seminar on the Orphic Hymns. A blue cut-out with a round end like an apse,
// the lyre drawn inside it with light radiating behind; a symbol sits on the top edge, an olive
// branch slips out from underneath, and the date note is pencilled on the paper below.
import Illustration from '../Illustration.astro';
import { home } from '../../data/home';

const { kicker, title, open, note } = home.seminar;
---

<section class="section seminar" aria-labelledby="seminar-title">
  <div class="wrap">
    <div class="seminar__stage">
      <div class="seminar__mark" data-depth="-0.05">
        <Illustration name="orphic-egg" draw />
      </div>
      <div class="seminar__branch" data-depth="-0.12">
        <Illustration name="olive-branch" draw />
      </div>

      <div class="seminar__panel panel panel--arch on-blue">
        <div class="panel__clip">
          <div class="seminar__rays" data-depth="0.32">
            <Illustration name="sun-rays" />
          </div>
        </div>

        <div class="seminar__lyre">
          <Illustration name="lyre" draw />
        </div>

        <div class="seminar__copy">
          <p class="seminar__kicker" data-reveal>{kicker}</p>
          <h2 class="t-2" id="seminar-title" data-split>{title}</h2>
          <p class="seminar__open lead" data-reveal style="--delay:350ms"><strong>{open}</strong></p>
        </div>
      </div>
    </div>

    <p class="seminar__note hand hand--m hand--tilt" data-reveal>{note}</p>
  </div>
</section>

<style>
  .seminar__stage {
    position: relative;
    isolation: isolate;
  }

  /* ---------- The cut-out ---------- */
  .seminar__panel {
    --lyre-w: min(46vw, 15rem);
    --pad-t: clamp(3.5rem, 16vw, 6rem);
    z-index: 1;
    display: grid;
    gap: var(--space-l);
    padding-top: var(--pad-t);
    padding-bottom: var(--space-l);
  }
  .seminar__lyre {
    width: var(--lyre-w);
    margin-inline: auto;
  }
  /* Light behind the lyre: clipped to the cut-out, far away */
  .seminar__rays {
    position: absolute;
    --rays-w: calc(var(--lyre-w) * 3.1);
    left: 50%;
    top: calc(var(--pad-t) + var(--lyre-w) * 0.6 - 5px);
    width: var(--rays-w);
    margin: calc(var(--rays-w) / -2) 0 0 calc(var(--rays-w) / -2);
    /* The light thins out before it reaches the words */
    mask-image: linear-gradient(180deg, #000 50%, transparent 74%);
  }
  .seminar__rays :global(.illo) {
    color: color-mix(in srgb, var(--creme) 30%, transparent);
  }

  .seminar__kicker {
    font-size: var(--step--1);
    font-weight: 560;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    margin-bottom: var(--space-s);
  }
  .seminar__open {
    margin-top: var(--space-m);
    max-width: none;
  }

  /* ---------- Ornaments tucked behind the cut-out ---------- */
  .seminar__mark,
  .seminar__branch {
    position: absolute;
    z-index: 0;
    pointer-events: none;
  }
  /* The symbol sits at the shoulder of the arch */
  .seminar__mark {
    width: 4.25rem;
    right: 5%;
    bottom: calc(100% - 3.9rem);
    rotate: 5deg;
  }
  .seminar__branch {
    width: 9.5rem;
    right: 2%;
    top: calc(100% - 1.9rem);
    rotate: -7deg;
  }

  /* ---------- The pencilled note ---------- */
  .seminar__note {
    position: relative;
    z-index: 2;
    max-width: 22ch;
    margin: calc(var(--space-m) + 1.25rem) 0 0 4%;
    line-height: 1.3;
  }

  @media (min-width: 30rem) {
    .seminar__note {
      max-width: 26ch;
    }
  }

  @media (min-width: 56rem) {
    /* On wide screens the arch lies on its side: square-cut at the left, a half-round at the right */
    .seminar__panel {
      --lyre-w: clamp(13rem, 8rem + 14vw, 21rem);
      --pad-r: clamp(3.5rem, 1rem + 6vw, 7.5rem);
      --panel-r: 3.2rem 19rem 19rem 3.8rem / 3rem 50% 50% 3.4rem;
      grid-template-columns: minmax(0, 1fr) var(--lyre-w);
      align-items: center;
      column-gap: clamp(2rem, 5vw, 5.5rem);
      min-height: 34rem;
      padding-block: var(--space-xl);
      padding-right: var(--pad-r);
    }
    .seminar__copy {
      grid-column: 1;
      grid-row: 1;
      max-width: 44rem;
    }
    .seminar__copy h2 {
      max-width: 20ch;
    }
    .seminar__lyre {
      grid-column: 2;
      grid-row: 1;
      width: auto;
      margin: 0;
    }
    .seminar__rays {
      --rays-w: calc(var(--lyre-w) * 2.8);
      mask-image: linear-gradient(90deg, transparent 7%, #000 36%);
      left: auto;
      right: calc(var(--pad-r) + var(--lyre-w) / 2 - var(--rays-w) / 2 - 5px);
      top: 50%;
      width: var(--rays-w);
      margin: calc(var(--rays-w) / -2) 0 0;
    }
    .seminar__mark {
      width: clamp(5.5rem, 3.5rem + 4vw, 7.75rem);
      right: auto;
      left: 10%;
      bottom: calc(100% - 1.3rem);
      rotate: -3deg;
    }
    .seminar__branch {
      width: clamp(13rem, 8rem + 12vw, 19rem);
      right: 20%;
      top: calc(100% - 2.6rem);
    }
    .seminar__note {
      max-width: 30ch;
      margin: var(--space-m) 0 0 clamp(2rem, 7vw, 7rem);
    }
  }
</style>
