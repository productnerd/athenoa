---
// Home: "Let's Get Started". Raphael's fresco fills a very large arch, printed in blue ink like a cyanotype,
// with Athena's two lines set across it in the voice face.
import Media from '../Media.astro';
import fresco from '../../assets/media/school-of-athens.jpg';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { start } = content(locale).home;
const t = {
  en: {
    frescoAlt:
      'Raphael’s fresco The School of Athens: the philosophers of antiquity gathered beneath a great vaulted hall',
  },
  el: {
    frescoAlt:
      'Η τοιχογραφία του Ραφαήλ «Η Σχολή των Αθηνών»: οι φιλόσοφοι της αρχαιότητας συγκεντρωμένοι κάτω από μια μεγάλη θολωτή αίθουσα',
  },
}[locale];
---

<section class="start section" aria-labelledby="start-title">
  <div class="wrap start__wrap">
    <div class="start__arch panel on-blue">
      <div class="panel__clip">
        <div class="start__picture" data-reveal="unveil">
          <Media
            class="start__fresco"
            src={fresco}
            alt={t.frescoAlt}
            shape="arch"
            innerDepth={0.14}
            reveal={false}
            widths={[480, 800, 1200, 1600, 1920]}
            sizes="(min-width: 82rem) 82rem, 94vw"
          />
          <span class="start__plate start__plate--light" aria-hidden="true"></span>
          <span class="start__plate start__plate--deep" aria-hidden="true"></span>
          <span class="start__pool" aria-hidden="true"></span>
        </div>
      </div>

      <div class="start__text">
        <h2 class="t-1" id="start-title" data-split>{start.title}</h2>
        <div class="start__lines">
          {
            start.lines.map((line, i) => (
              <p class="hand hand--l" data-reveal style={`--i:${i * 3 + 4}`}>
                {line}
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .start__wrap {
    container-type: inline-size;
  }
  .start__arch {
    --arch: min(50cqw, 34rem);
    --panel-r: 50% 50% 3.2rem 3.8rem / var(--arch) var(--arch) 3rem 3.4rem;
    display: flex;
    align-items: flex-end;
    min-height: clamp(38rem, 150cqw, 46rem);
    padding: calc(var(--arch) * 0.72) clamp(1.4rem, 7cqw, 7rem) clamp(2.5rem, 7cqw, 5.5rem);
  }
  /* A light-blue hairline echoes the arch just inside its edge, like the border of a label. */
  .start__arch::after {
    content: '';
    position: absolute;
    inset: clamp(0.55rem, 1.5cqw, 1.1rem);
    z-index: -1;
    border: 1.5px solid color-mix(in srgb, var(--blue-light) 62%, transparent);
    border-radius: inherit;
    pointer-events: none;
  }

  /* The fresco fills the arch; the arch outline comes from the panel, so the photo's own radius is dropped. */
  .start__picture,
  .start__fresco,
  .start__plate,
  .start__pool {
    position: absolute;
    inset: 0;
  }
  .start__fresco :global(.media__clip) {
    height: 100%;
    border-radius: 0;
    background: var(--blue);
  }
  .start__fresco :global(img) {
    filter: grayscale(1) contrast(1.12);
  }

  /* Blue ink wash, printed from two plates so the fresco becomes a two-tone picture:
     nothing is lighter than the highlight plate, nothing darker than the darker blue.
     The highlight is the limit that keeps crème text above 4.5:1 anywhere on the fresco. */
  .start__plate--light {
    background-color: color-mix(in srgb, var(--blue-light) 30%, var(--blue));
    mix-blend-mode: multiply;
  }
  .start__plate--deep {
    background-color: var(--blue-deep);
    background-image: var(--grain);
    background-size: 400px 400px;
    mix-blend-mode: lighten;
  }
  /* A plain pool of Greek blue under the words: the voice face is thin and must not fight the figures. */
  .start__pool {
    background: radial-gradient(
      ellipse 130% 60% at 40% 78%,
      color-mix(in srgb, var(--blue) 96%, transparent) 0%,
      color-mix(in srgb, var(--blue) 86%, transparent) 55%,
      transparent 100%
    );
  }

  .start__text {
    position: relative;
    max-width: min(100%, 48rem);
  }
  .start__lines {
    margin-top: var(--space-m);
  }
  .start__lines .hand {
    max-width: 30ch;
    font-size: clamp(1.7rem, 1.2rem + 3.4cqw, 3rem);
    font-weight: 380;
    line-height: 1.18;
  }
  .start__lines .hand + .hand {
    margin-top: 0.4em;
  }

  @media (min-width: 60rem) {
    .start__arch {
      min-height: min(62cqw, 54rem);
    }
    .start__pool {
      background: radial-gradient(
        ellipse 68% 62% at 27% 76%,
        color-mix(in srgb, var(--blue) 96%, transparent) 0%,
        color-mix(in srgb, var(--blue) 86%, transparent) 55%,
        transparent 100%
      );
    }
  }
</style>
