---
// The practical guide (src/pages/nostos/guide.astro): the small symbol of a tradition, drawn in the
// page's ink like the site's line art (client request, 6 November 2026). Om, Ik Onkar and the
// Confucian 仁 are letters, so they are set as text.
import type { Kind } from '../../data/nostos-guide';

interface Props {
  kind: Kind;
}
const { kind } = Astro.props;
const paths: Partial<Record<Kind, string>> = {
  christian: 'M12 3.5V20.5M7.5 8.5H16.5',
  jewish: 'M12 3 19.8 16.5H4.2ZM12 21 4.2 7.5H19.8Z',
  islam:
    'M16.05 5.8A8 8 0 1 0 16.05 18.2 6.6 6.6 0 1 1 16.05 5.8ZM18.3 9.3 18.95 11.11 20.87 11.17 19.35 12.34 19.89 14.18 18.3 13.1 16.71 14.18 17.25 12.34 15.73 11.17 17.65 11.11Z',
  sufi: 'M12.4 12a1.6 1.6 0 0 1 3.2 0 3.2 3.2 0 0 1-6.4 0 4.8 4.8 0 0 1 9.6 0 6.4 6.4 0 0 1-12.8 0',
  buddhist:
    'M12 3.5a8.5 8.5 0 1 0 0 17 8.5 8.5 0 1 0 0-17ZM12 9.8a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 1 0 0-4.4ZM14.2 12H20.5M13.56 13.56 18.01 18.01M12 14.2V20.5M10.44 13.56 5.99 18.01M9.8 12H3.5M10.44 10.44 5.99 5.99M12 9.8V3.5M13.56 10.44 18.01 5.99',
  zen: 'M16.9 5.3A8 8 0 1 0 19.8 12.9',
  daoist: 'M12 3a9 9 0 1 0 0 18 9 9 0 1 0 0-18Z',
  shinto: 'M3.5 5.8C8 4.6 16 4.6 20.5 5.8M5 9H19M7.2 5.4V20.5M16.8 5.4V20.5M12 5V9',
  zoroastrian:
    'M12 3.2C13.5 6.4 17.5 8.6 17.5 13.6 17.5 17.6 15 20.5 12 20.5 9 20.5 6.5 17.6 6.5 13.8 6.5 11.2 8 9.4 9.3 8 9.4 10.2 10.4 11.6 11.6 12 11 9 11 6 12 3.2ZM12 20.5C10.6 20.5 9.8 19 9.8 17.6 9.8 16 11 15 12 13.6 13 15 14.2 16 14.2 17.6 14.2 19 13.4 20.5 12 20.5Z',
  akan: 'M12 19.6C8 16.8 4 13.5 4 9.6 4 7 5.9 5 8.2 5 10 5 11.3 6.1 12 7.6 12.7 6.1 14 5 15.8 5 18.1 5 20 7 20 9.6 20 13.5 16 16.8 12 19.6ZM12 7.6C11.6 10 9.4 11.2 8.1 10.1 7.2 9.3 7.8 8 8.9 8.3M12 7.6C12.4 10 14.6 11.2 15.9 10.1 16.8 9.3 16.2 8 15.1 8.3M12 19.6V21.4',
  stoic: 'M3 8.2 12 3.6 21 8.2ZM4 10.2H20M6.2 10.2V18.4M10 10.2V18.4M14 10.2V18.4M17.8 10.2V18.4M3.6 18.6H20.4M2.8 20.6H21.2',
  modern: 'M12 6.6C9.8 5.2 6.6 5 3.6 5.8V18.6C6.6 17.8 9.8 18 12 19.4 14.2 18 17.4 17.8 20.4 18.6V5.8C17.4 5 14.2 5.2 12 6.6ZM12 6.6V19.4',
};
const letters: Partial<Record<Kind, string>> = { hindu: 'ॐ', sikh: 'ੴ', confucian: '仁' };
---

<svg class:list={['ng-sym', `ng-sym--${kind}`]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {letters[kind] ? (
    <text x="12" y="18" text-anchor="middle">{letters[kind]}</text>
  ) : (
    <path d={paths[kind]} />
  )}
  {
    kind === 'daoist' && (
      <>
        <path class="ng-sym__fill" d="M12 3A9 9 0 0 1 12 21 4.5 4.5 0 0 1 12 12 4.5 4.5 0 0 0 12 3Z" />
        <circle class="ng-sym__fill" cx="12" cy="7.5" r="1.3" />
        <circle class="ng-sym__hole" cx="12" cy="16.5" r="1.3" />
      </>
    )
  }
</svg>

<style>
  .ng-sym {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    overflow: visible;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ng-sym--zen {
    stroke-width: 2.6;
  }
  .ng-sym text {
    fill: currentColor;
    stroke: none;
    font-size: 17px;
    font-family: 'Kohinoor Devanagari', 'Devanagari Sangam MN', 'Nirmala UI', 'Noto Sans Devanagari', 'Gurmukhi MN', 'Noto Sans Gurmukhi', 'PingFang SC', 'Noto Sans CJK SC', sans-serif;
  }
  .ng-sym__fill {
    fill: currentColor;
    stroke: none;
  }
  .ng-sym__hole {
    fill: var(--paper, var(--creme));
    stroke: none;
  }
</style>
