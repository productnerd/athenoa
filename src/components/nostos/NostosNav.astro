---
// Nostos: the small menu that joins its four pages (the map, play, the bookshelf, sources), at the head
// of each. The page you are on is marked and is not a link. Wording proposed (src/data/nostos/ui.ts).
import { nostosUi } from '../../data/nostos/ui';
import { barePath, getLocale, mainLocale, pathIn } from '../../lib/locale';

const locale = getLocale(Astro.url);
const t = nostosUi[mainLocale(locale)].entry.sub;
const here = barePath(Astro.url.pathname).replace(/\/+$/, '/') ;
const items = [
  { href: '/nostos/', label: t.map },
  { href: '/nostos/play/', label: t.play },
  { href: '/nostos/bookshelf/', label: t.shelf },
  { href: '/nostos/sources/', label: t.sources },
];
---

<nav class="nnav" aria-label={t.label}>
  <ul>
    {
      items.map((item) => (
        <li>
          {here === item.href ? (
            <span class="nnav__here" aria-current="page">{item.label}</span>
          ) : (
            <a href={pathIn(locale, item.href)}>{item.label}</a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .nnav {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.2rem;
    font-size: var(--step--1);
  }
  .nnav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nnav a,
  .nnav__here {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 1.1rem 0.9rem 1.2rem 1rem / 1rem 1.2rem 0.9rem 1.1rem;
    color: var(--ink-strong);
    text-decoration: none;
    transition: background-color var(--dur-1) var(--hover-delay);
  }
  .nnav a:hover {
    background: color-mix(in srgb, var(--blue-light) 40%, transparent);
  }
  .nnav__here {
    background: var(--blue-light);
    color: var(--blue-deep);
  }
</style>
