---
// The newsletter popup: one native <dialog id="newsletter"> for the whole site. Place it once, at
// body level (not inside an on-blue surface). Any link whose href ends in "#newsletter" and any
// element with data-newsletter-open opens it.
//
// The popup is a small Greek portico, drawn in pieces (portico-*.svg, built by
// scripts/illustrations/portico-gen.mjs). One unit of that drawing is 1/620 of the frame's width,
// so the pieces always meet; only the shafts stretch with the content.
//   Wide screens: the headline and the form stand in the opening between the two columns.
//   Narrow screens: no form fits between columns of a believable thickness, so the columns frame
//   the headline and stand on a podium, and the form is set into the face of the podium.
//
// Sign-up is NOT connected to a mailing service yet. Look for "NEWSLETTER SERVICE" below.
import Illustration from './Illustration.astro';
import { content } from '../data';
import { newsletter } from '../data/newsletter';
import { getLocale, pathIn } from '../lib/locale';

const locale = getLocale(Astro.url);
const { text, cta } = content(locale).home.announcement.newsletter;
const t = newsletter[locale];
const contactHref = pathIn(locale, '/about-athena/#contact');
---

<dialog class="nl" id="newsletter" aria-labelledby="newsletter-title">
  <div class="nl__bar">
    <button class="nl__close" type="button" data-newsletter-close>
      <span>{t.close}</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M5 5.4c4.6 4.2 9 8.800 14 13.400M19 5c-4.400 4.800-9.200 9-13.800 14"></path>
      </svg>
    </button>
    <!-- Without JavaScript the popup is shown by :target; this plain link leaves it again.
         The fragment matches nothing on purpose, so the page does not jump. -->
    <a class="nl__close nl__close--plain" href="#closed">{t.close}</a>
  </div>

  <div class="nl__frame">
    <div class="nl__grid">
      <div class="nl__paper"></div>
      <Illustration name="portico-pediment" class="nl__pediment" />
      {
        ['left', 'right'].map((side) => (
          <div class:list={['nl__column', `nl__column--${side}`]}>
            <Illustration name="portico-capital" />
            <Illustration name="portico-shaft" class="nl__shaft" />
            <Illustration name="portico-base" />
          </div>
        ))
      }

      <div class="nl__head">
        <h2 class="nl__title t-3" id="newsletter-title">{cta.label}</h2>
        <p class="nl__text">{text}</p>
      </div>

      <!-- The podium, on narrow screens only -->
      <Illustration name="portico-ledge" class="nl__ledge" />
      <div class="nl__wall"></div>

      <div class="nl__action">
        <!-- NEWSLETTER SERVICE, part 1 of 2. When a mailing service is connected, this form gets the
             service's endpoint as action (method="post") and the input gets the field name the
             service expects (name="email"; Mailchimp calls it EMAIL). Until then the input has no
             name, so even a native submission would carry nothing. -->
        <form class="nl__form" data-newsletter-form>
          <div class="field">
            <label for="newsletter-email">{t.label}</label>
            <input
              id="newsletter-email"
              type="email"
              required
              autocomplete="email"
              inputmode="email"
              placeholder={t.placeholder}
            />
          </div>
          <button class="btn" type="submit">{t.submit}</button>
        </form>

        <!-- Shown in place of the form after a valid address is entered (and, with no JavaScript,
             from the start): sign-up is not connected yet, and the popup says so. -->
        <div class="nl__note" tabindex="-1" data-newsletter-note>
          <p>{t.pending}</p>
          <p><a href={contactHref} data-newsletter-contact>{t.pendingLink}</a></p>
        </div>
      </div>

      <Illustration name="portico-steps" class="nl__steps" />
    </div>
  </div>
</dialog>

<script>
  const motionOn = () => document.documentElement.classList.contains('motion');
  const find = () => document.querySelector<HTMLDialogElement>('dialog#newsletter[data-ready]');
  // What was clicked to open the popup: focus goes back there when it closes.
  let opener: HTMLElement | null = null;

  function open(dialog: HTMLDialogElement, from: HTMLElement | null) {
    if (dialog.open) return;
    opener = from;
    dialog.classList.remove('is-closing');
    // With a mouse and keyboard the field is ready to type in. On a touch screen that would raise
    // the keyboard over the popup at once, so focus stays on the first control instead.
    dialog.querySelector('input')!.autofocus = matchMedia('(hover: hover) and (pointer: fine)').matches;
    dialog.showModal();
  }

  // Plays the closing transition, then closes for real.
  function close(dialog: HTMLDialogElement) {
    if (!dialog.open || dialog.classList.contains('is-closing')) return;
    if (!motionOn()) return dialog.close();
    const finish = () => {
      clearTimeout(timer);
      dialog.removeEventListener('transitionend', onEnd);
      dialog.close();
    };
    const onEnd = (event: TransitionEvent) => {
      if (event.target === dialog && event.propertyName === 'opacity') finish();
    };
    const timer = setTimeout(finish, 500);
    dialog.addEventListener('transitionend', onEnd);
    dialog.classList.add('is-closing');
  }

  function bind(dialog: HTMLDialogElement) {
    const form = dialog.querySelector<HTMLFormElement>('[data-newsletter-form]')!;
    const note = dialog.querySelector<HTMLElement>('[data-newsletter-note]')!;

    dialog.querySelector('[data-newsletter-close]')!.addEventListener('click', () => close(dialog));

    // Escape
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close(dialog);
    });

    // A click on the backdrop lands on the dialog element itself (so does one beside the gable,
    // where the frame lets clicks through). The press must start there too, so dragging a text
    // selection out of the field does not close the popup.
    let pressedBackdrop = false;
    dialog.addEventListener('pointerdown', (event) => (pressedBackdrop = event.target === dialog));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && pressedBackdrop) close(dialog);
    });

    // The browser only fires "submit" once the address has passed its own validation
    // (required, type="email"); an empty or malformed one gets the native message instead.
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      // NEWSLETTER SERVICE, part 2 of 2. Nothing is sent anywhere yet. To connect a service
      // (a Brevo, Mailchimp or Buttondown form endpoint), replace the two lines below with
      //   await fetch(form.action, { method: 'POST', body: new FormData(form) })
      // and show a confirmation or an error instead of the "not connected yet" note
      // (newsletter.pending in src/data/newsletter.ts, which can then go).
      dialog.setAttribute('data-sent', '');
      note.focus();
    });

    // The contact form may be on this very page: leave the popup before going there.
    dialog.querySelector('[data-newsletter-contact]')!.addEventListener('click', () => dialog.close());

    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-closing');
      dialog.removeAttribute('data-sent');
      form.reset();
      // Arrived by a link to .../#newsletter: drop the fragment (replaceState adds no history entry).
      if (location.hash === '#newsletter') history.replaceState(history.state, '', location.pathname + location.search);
      // Safari does not hand focus back to a clicked link by itself.
      if (opener?.isConnected) opener.focus({ preventScroll: true });
      opener = null;
    });
  }

  document.addEventListener('astro:page-load', () => {
    const dialog = document.querySelector<HTMLDialogElement>('dialog#newsletter');
    if (!dialog || dialog.hasAttribute('data-ready') || typeof dialog.showModal !== 'function') return;
    dialog.setAttribute('data-ready', '');
    bind(dialog);
    // Arriving at .../#newsletter
    if (location.hash === '#newsletter') open(dialog, null);
  });

  // One listener for every opener on every page, added once however often this module is run.
  // Capture phase: it answers before the page router treats the link as navigation.
  const bound = document.documentElement as HTMLElement & { athNewsletter?: boolean };
  if (!bound.athNewsletter) {
    bound.athNewsletter = true;
    document.addEventListener(
      'click',
      (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const from =
          event.target instanceof Element
            ? event.target.closest<HTMLElement>('a[href$="#newsletter"], [data-newsletter-open]')
            : null;
        const dialog = from && find();
        if (!dialog) return;
        event.preventDefault();
        open(dialog, from);
      },
      true,
    );
  }
</script>

<style>
  .nl {
    --nl-edge: 0.375rem; /* how far the paper reaches beyond the drawing at the sides and below */
    width: min(100% - 0.5rem, 26rem);
    max-width: none;
    max-height: calc(100dvh - 0.5rem);
    margin: auto;
    padding: 0.25rem 0.25rem 0.6rem;
    border: 0;
    background: none;
    color: var(--ink);
    overflow: hidden auto;
    overscroll-behavior: contain;
  }
  /* The page behind: blurred, under a thin wash of the darker blue */
  .nl::backdrop {
    background: color-mix(in srgb, var(--blue-deep, #071260) 36%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  /* The page behind stays put while the popup is open */
  :global(html:has(dialog.nl[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* ---------- Close ---------- */
  /* A bar of no height that stays at the top if the popup has to scroll; the control hangs from it,
     in the open corner beside the gable. */
  .nl__bar {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
    height: 0;
  }
  .nl__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1.5px solid color-mix(in srgb, var(--blue) 28%, transparent);
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    background: var(--creme-light);
    color: var(--blue);
    font-size: var(--step--1);
    font-weight: 560;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--dur-1),
      color var(--dur-1);
  }
  .nl__close:hover {
    background: var(--blue);
    color: var(--creme-light);
  }
  .nl__close:focus-visible {
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    outline-color: var(--creme-light);
    outline-offset: 3px;
  }
  .nl__close path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
  }
  /* On a narrow screen the corner only has room for the cross */
  .nl__close span {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .nl__close--plain {
    width: auto;
    padding-inline: 1rem;
  }

  /* ---------- The portico ---------- */
  .nl__frame {
    container-type: inline-size;
    margin: 1.25rem var(--nl-edge) 0;
    /* Clicks beside the gable fall through to the dialog, like clicks on the backdrop */
    pointer-events: none;
  }
  /* The measures below are those of scripts/illustrations/portico-gen.mjs: the frame is 620 units
     wide, a column piece 82, and it stands 15 units in from the edge.
     Rows: pediment and entablature, headline, ledge of the podium, form, steps. */
  .nl__grid {
    --u: calc(100cqw / 620); /* one unit of the drawing */
    --nl-line: 1.35px; /* its line weight */
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns:
      calc(15 * var(--u)) calc(82 * var(--u)) minmax(0, 1fr)
      calc(82 * var(--u)) calc(15 * var(--u));
    padding: calc(8 * var(--u)) 0 calc(10 * var(--u));
  }
  /* The sheet: crème paper cut to the outline of a temple front, with the rough edge of the other
     cut-outs. The clip sits on ::before and the filter on its parent, so the edge is displaced
     after it has been cut. */
  .nl__paper {
    position: absolute;
    inset: 0 calc(-1 * var(--nl-edge)) calc(-1 * var(--nl-edge));
    z-index: -1;
    filter: url(#rough-sm); /* the finer cut: on a narrow screen the margin round the drawing is small */
  }
  .nl__paper::before {
    /* The gable runs parallel to the roof (a pitch of 0.235), clear of the acroteria. Every corner
       is taken off with a short second cut, so none of them is sharp. */
    --eave: calc(72.8 * var(--u) + 0.235 * var(--nl-edge));
    content: '';
    position: absolute;
    inset: 0;
    background-color: var(--creme);
    background-image: var(--grain);
    background-size: 400px 400px;
    clip-path: polygon(
      calc(50% - 0.35rem) 0.04rem,
      calc(50% + 0.35rem) 0.04rem,
      calc(50% + 1rem) 0.235rem,
      calc(100% - 0.8rem) calc(var(--eave) - 0.19rem),
      calc(100% - 0.15rem) calc(var(--eave) + 0.1rem),
      100% calc(var(--eave) + 0.7rem),
      100% calc(100% - 0.9rem),
      calc(100% - 0.25rem) calc(100% - 0.25rem),
      calc(100% - 0.9rem) 100%,
      0.9rem 100%,
      0.25rem calc(100% - 0.25rem),
      0 calc(100% - 0.9rem),
      0 calc(var(--eave) + 0.7rem),
      0.15rem calc(var(--eave) + 0.1rem),
      0.8rem calc(var(--eave) - 0.19rem),
      calc(50% - 1rem) 0.235rem
    );
    pointer-events: auto;
  }
  .nl__grid :global(svg) {
    stroke-width: var(--nl-line);
  }
  .nl__pediment {
    grid-area: 1 / 1 / 2 / -1;
  }
  .nl__column {
    grid-row: 2;
    grid-column: 2;
    display: flex;
    flex-direction: column;
  }
  /* The same column, mirrored: both stand with their shaded side outwards */
  .nl__column--right {
    grid-column: 4;
    scale: -1 1;
  }
  /* The piece that stretches. It never falls below a believable height: with capital and base,
     a column of about eight and a half lower diameters. */
  .nl__shaft {
    position: relative;
    flex: 1 1 0;
    min-height: calc(348 * var(--u));
  }
  .nl__shaft :global(svg) {
    position: absolute;
    inset: 0;
    height: 100%;
  }
  .nl__ledge {
    grid-area: 3 / 1 / 4 / -1;
  }
  /* The sides of the podium: two lines of the drawing's weight, 23 units in from each edge */
  .nl__wall {
    grid-area: 4 / 1 / 5 / -1;
    margin-inline: calc(23 * var(--u) - var(--nl-line) / 2);
    border-inline: var(--nl-line) solid var(--ink-strong);
  }
  .nl__steps {
    grid-area: 5 / 1 / 6 / -1;
  }

  /* ---------- Words and form ---------- */
  .nl__head {
    grid-area: 2 / 3;
    align-self: center;
    display: grid;
    gap: 0.7rem;
    padding: 0.9rem 0.3rem 1rem;
    text-align: center;
    pointer-events: auto;
  }
  .nl__title {
    font-size: calc(var(--step-2) * 0.86);
  }
  .nl__text {
    line-height: 1.42;
  }
  /* Form and note share one cell, so the frame keeps its height when one replaces the other */
  .nl__action {
    grid-area: 4 / 1 / 5 / -1;
    display: grid;
    /* Inside the wall of the podium (23 units in), with less air on the smallest screens */
    padding: 1.05rem calc(23 * var(--u) + clamp(0.45rem, 9cqw - 1.2rem, 1rem)) 1.35rem;
    pointer-events: auto;
  }
  .nl__form,
  .nl__note {
    grid-area: 1 / 1;
  }
  .nl__form {
    display: grid;
    gap: 0.85rem;
  }
  .nl__note {
    align-self: center;
    display: grid;
    gap: 0.5rem;
    text-align: center;
    outline: none;
  }
  .nl__note a {
    color: var(--ink-strong);
    font-weight: 560;
  }
  /* The form until an address has been entered, then the note. Without JavaScript: the note only. */
  .nl[data-ready]:not([data-sent]) .nl__note,
  .nl[data-sent] .nl__form {
    visibility: hidden;
  }
  .nl:not([data-ready]) .nl__form,
  .nl[data-ready] .nl__close--plain,
  .nl:not([data-ready]) button.nl__close {
    display: none;
  }

  /* ---------- Wide screens: the form stands between the columns ---------- */
  @media (min-width: 36rem) {
    .nl {
      --nl-edge: 0.6rem;
      /* Narrower where the window is low, so the whole portico stays in view when it can */
      width: min(100% - 0.5rem, 43rem, max(34rem, 214dvh - 58rem));
      padding: 0.5rem 0.5rem 1.1rem;
    }
    .nl__paper {
      filter: url(#rough);
    }
    .nl__frame {
      margin-top: 0.5rem;
    }
    .nl__close {
      width: auto;
      padding: 0 1rem 0.05rem 1.15rem;
    }
    .nl__close span {
      position: static;
      width: auto;
      height: auto;
      clip-path: none;
    }
    .nl__ledge,
    .nl__wall {
      display: none;
    }
    /* The row of the ledge is shut, so the spare height of the columns goes above the headline and
       below the form, not between them */
    .nl__grid {
      --nl-line: 1.7px;
      grid-template-rows: auto auto 0 auto auto;
    }
    .nl__column {
      grid-row: 2 / 5;
    }
    .nl__shaft {
      min-height: calc(338 * var(--u));
    }
    .nl__head {
      align-self: end;
      gap: 0.9rem;
      padding: 1.75rem clamp(0.75rem, 4cqw, 1.9rem) 0;
    }
    .nl__title {
      font-size: calc(var(--step-2) * 0.9);
    }
    .nl__action {
      grid-area: 4 / 3;
      align-self: start;
      padding: 1.3rem clamp(0.75rem, 4cqw, 1.9rem) 1.5rem;
    }
    .nl__form {
      gap: 0.9rem;
    }
  }

  /* ---------- Without JavaScript ---------- */
  /* A link to #newsletter still reveals the popup: the dialog becomes a block fixed over the whole
     page (above the music button), carrying the wash and the blur itself, the portico in its middle. */
  .nl:target:not([data-ready]) {
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    position: fixed;
    inset: 0;
    z-index: 60;
    width: auto;
    height: auto;
    max-height: none;
    background: color-mix(in srgb, var(--blue-deep) 36%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .nl:target:not([data-ready]) > * {
    flex: none;
    width: min(100% - 2 * var(--nl-edge), 25rem);
    margin-inline: auto;
  }
  @media (min-width: 36rem) {
    .nl:target:not([data-ready]) > * {
      width: min(100% - 2 * var(--nl-edge), 40.8rem);
    }
  }

  /* ---------- Open and close ---------- */
  :global(html.motion) .nl[open] {
    transition:
      opacity var(--dur-1) var(--ease-soft),
      transform var(--dur-2) var(--ease-out);
    will-change: transform, opacity;
  }
  :global(html.motion) .nl[open]::backdrop {
    transition: opacity var(--dur-2) var(--ease-soft);
  }
  @starting-style {
    :global(html.motion) .nl[open] {
      opacity: 0;
      transform: translate3d(0, 1.5rem, 0) scale(0.965);
    }
    :global(html.motion) .nl[open]::backdrop {
      opacity: 0;
    }
  }
  :global(html.motion) .nl.is-closing {
    opacity: 0;
    transform: translate3d(0, 0.75rem, 0) scale(0.98);
    transition-duration: 0.26s;
    transition-timing-function: var(--ease-in-out);
  }
  :global(html.motion) .nl.is-closing::backdrop {
    opacity: 0;
    transition-duration: 0.26s;
  }
</style>
