---
// Preview aid, not part of the final site: switches between the type sets under test.
//   a  EB Garamond throughout (the default, and the only set that is shipped)
//   b  Tekst throughout
//   c  PP Editorial New throughout
// Remove this component (and its import in Base.astro) once a set is chosen.
const sets = [
  { id: 'a', label: 'EB Garamond' },
  { id: 'b', label: 'Tekst' },
  { id: 'c', label: 'Editorial New' },
];
---

<div class="font-toggle" data-font-toggle role="group" aria-label="Typeface preview">
  <span class="font-toggle__label">Type</span>
  {
    sets.map((set) => (
      <button type="button" data-set={set.id} aria-pressed={set.id === 'a' ? 'true' : 'false'}>
        {set.label}
      </button>
    ))
  }
</div>

<script>
  const current = () => {
    const set = document.documentElement.dataset.fonts;
    return set === 'b' || set === 'c' ? set : 'a';
  };
  function sync() {
    document.querySelectorAll<HTMLButtonElement>('[data-font-toggle] button').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.set === current()));
    });
  }
  document.addEventListener('astro:page-load', () => {
    sync();
    document.querySelectorAll<HTMLButtonElement>('[data-font-toggle] button').forEach((button) => {
      button.addEventListener('click', () => {
        const set = button.dataset.set ?? 'a';
        if (set === 'a') delete document.documentElement.dataset.fonts;
        else document.documentElement.dataset.fonts = set;
        try {
          localStorage.setItem('ath-fonts', set);
        } catch {}
        sync();
        // Line breaks change with the typeface, so parallax layers need measuring again.
        window.dispatchEvent(new Event('resize'));
      });
    });
  });
</script>

<style>
  .font-toggle {
    position: fixed;
    left: 0.9rem;
    bottom: 0.9rem;
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 0.15rem;
    padding: 0.3rem 0.35rem 0.3rem 0.9rem;
    background: color-mix(in srgb, var(--creme-light) 92%, transparent);
    border: 1.5px solid color-mix(in srgb, var(--blue) 28%, transparent);
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    font-family: system-ui, sans-serif;
    font-size: 0.78rem;
    color: var(--blue-deep);
    backdrop-filter: blur(6px);
  }
  .font-toggle__label {
    margin-right: 0.4rem;
    opacity: 0.7;
  }
  .font-toggle button {
    padding: 0.4rem 0.8rem;
    border: 0;
    border-radius: 999px;
    background: none;
    cursor: pointer;
    white-space: nowrap;
  }
  .font-toggle button[aria-pressed='true'] {
    background: var(--blue);
    color: var(--creme-light);
  }
  @media print {
    .font-toggle {
      display: none;
    }
  }
</style>
