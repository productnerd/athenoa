---
// Not found: a calm Aegean, the footer's sibling at sea.
// A paper theatre on the crème page: clouds drift across the top, a Greek sentence on eudaimonia
// stands in the sky, and below the horizon three bands of water slide past at their own pace while
// one boat sails from the left edge to the right and starts again. The plain words (heading, one
// line, two ways back) float on the nearest, darkest water.
//
// Artwork: src/assets/illustrations/sea-*.svg, generated by scripts/illustrations/sea-build.mjs.
// Every file is shown at (its viewBox width × --u), so the layers keep their proportions.
// Copy: src/data/notfound.ts.
//
// Motion is CSS only. The loops run under html.motion (set by Base when motion is allowed) and
// prefers-reduced-motion: no-preference; otherwise the same layers stand still as one picture,
// with the boat right of centre.
import Illustration from '../Illustration.astro';
import { notfound, type NotFoundLocale } from '../../data/notfound';

interface Props {
  locale?: NotFoundLocale;
}
const { locale = 'en' } = Astro.props;
const t = notfound[locale];
// The sentence breaks by sense, after the ano teleia.
const clauses = t.quote.text.split(/(?<=·)\s+/);
---

<section class="nf" lang={locale}>
  <!-- The plain words come first in the source; the grid sets them on the near water. -->
  <div class="nf__near on-blue-deep">
    <div class="nf__deep" aria-hidden="true">
      <div class="nf__swell">
        <div class="nf__run"><Illustration name="sea-waves-near" /></div>
      </div>
      <div class="nf__floor"><Illustration name="sea-floor" /></div>
    </div>
    <div class="nf__words wrap">
      <div class="nf__say">
        <h1 class="nf__title t-3">{t.heading}</h1>
        <p class="nf__line">{t.line}</p>
      </div>
      <p class="nf__ways">
        <a class="btn" href={t.home.href}>{t.home.label}</a>
        <a class="btn btn--ghost" href={t.courses.href}>{t.courses.label}</a>
      </p>
    </div>
  </div>

  <div class="nf__sky">
    <div class="nf__clouds" aria-hidden="true" data-reveal="fade" style="--delay: 500ms">
      {
        [1, 2, 3].map((n) => (
          <div class={`nf__cloud nf__cloud--${n}`}>
            <div class="nf__run">
              <Illustration name={`sea-cloud-${n}`} />
              <Illustration name={`sea-cloud-${n}`} />
            </div>
          </div>
        ))
      }
    </div>

    <figure class="nf__quote">
      <blockquote class="nf__greek t-2" lang={t.quote.lang} data-reveal style="--delay: 250ms">
        <p>
          {
            clauses.map((clause, i) => (
              <>
                {i > 0 && ' '}
                <span class="nf__clause">{clause}</span>
              </>
            ))
          }
        </p>
      </blockquote>
      <figcaption class="nf__caption" data-reveal style="--delay: 600ms">
        <span class="nf__translation">{t.quote.translation}</span>
        <span class="nf__source small">{t.quote.source}</span>
      </figcaption>
    </figure>

    <div class="nf__land" aria-hidden="true">
      <div class="nf__sun" data-reveal="fade" style="--delay: 150ms"><Illustration name="sea-sun" draw /></div>
      <div class="nf__island" data-reveal="fade"><Illustration name="sea-island" draw /></div>
      <div class="nf__cape" data-reveal="fade" style="--delay: 100ms"><Illustration name="sea-cape" draw /></div>
    </div>
  </div>

  <div class="nf__sea" aria-hidden="true">
    <div class="nf__horizon" data-reveal="fade"><Illustration name="sea-horizon" draw /></div>
    <div class="nf__band nf__band--far" data-reveal style="--delay: 80ms">
      <div class="nf__run"><Illustration name="sea-waves-far" /></div>
    </div>
    <div class="nf__band nf__band--mid" data-reveal style="--delay: 200ms">
      <div class="nf__run"><Illustration name="sea-waves-mid" /></div>
    </div>
    <div class="nf__boat" data-reveal="fade" style="--delay: 700ms">
      <div class="nf__voyage">
        <div class="nf__bob">
          <div class="nf__tilt"><Illustration name="sea-boat" /></div>
        </div>
      </div>
    </div>
  </div>

  <div class="nf__grain" aria-hidden="true"></div>
</section>

<style>
  .nf {
    /* One wave tile is 1600 drawing units and never narrower than the screen; --u is one unit. */
    --tile: max(100vw, 64rem);
    --u: calc(var(--tile) / 1600);
    /* Horizon to the edge of the near water. Shorter screens get a shallower sea. */
    --sea-h: min(calc(var(--u) * 206), 25svh);
    /* Sky kept clear: for the clouds above the sentence, and for the sun and the islands below it. */
    --cloud-zone: calc(var(--u) * 96);
    --land-zone: calc(var(--u) * 90);

    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) var(--sea-h) auto;
    min-height: max(100vh, 36rem);
    min-height: max(100svh, 36rem);
    /* Pulled up under the sticky header, which keeps its strip of crème sky. */
    margin-top: calc(var(--header-h) * -1);
    /* A little paper under the water's lower edge. */
    padding-bottom: calc(var(--u) * 26 + 0.7rem);
    overflow: clip;
    background-color: var(--paper);
  }
  .nf :global(.illo svg) {
    max-width: none;
  }

  /* ---------- rows ---------- */
  .nf__sky {
    grid-row: 1;
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: calc(var(--header-h) + var(--cloud-zone)) var(--gutter) var(--land-zone);
    text-align: center;
  }
  .nf__sea {
    grid-row: 2;
    position: relative;
  }
  .nf__near {
    grid-row: 3;
    position: relative;
    padding: calc(var(--u) * 66) 0 clamp(1.25rem, 3svh, 2.25rem);
  }

  /* ---------- the words ---------- */
  .nf__quote {
    position: relative;
    z-index: 8;
    max-width: 100%;
    margin: 0;
  }
  /* Polytonic Greek is always set in EB Garamond, whichever type set is on trial. */
  .nf__greek {
    margin: 0;
    font-family: 'EB Garamond Variable', 'EB Garamond', Garamond, serif;
    font-size: min(calc(clamp(2.3rem, 1.5rem + 3.5vw, 4.7rem) * 0.86), 7svh);
    font-weight: 400;
    letter-spacing: -0.005em;
    line-height: 1.1;
  }
  .nf__clause {
    display: block;
    text-wrap: balance;
  }
  .nf__caption {
    display: grid;
    justify-items: center;
    gap: 0.3rem;
    margin-top: clamp(0.8rem, 2.2svh, 1.5rem);
  }
  .nf__translation {
    max-width: 46ch;
    line-height: 1.34;
    text-wrap: balance;
  }
  .nf__source {
    color: var(--ink-soft);
  }

  .nf__words {
    position: relative;
    z-index: 8;
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-s) var(--space-l);
  }
  .nf__line {
    margin-top: 0.25rem;
    color: var(--ink-soft);
  }
  .nf__ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-s);
  }

  /* ---------- the picture ---------- */
  /* Sliding layers: two tiles wide, moved by exactly one tile. --at is where in the loop the
     still picture stands, and where the loop starts from. */
  .nf__run {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--tile) * 2);
    transform: translate3d(calc(-50% * (1 - var(--at, 0))), 0, 0);
  }

  .nf__clouds {
    --sky-tile: max(100vw, 60rem);
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    top: var(--header-h);
    height: var(--cloud-zone);
  }
  .nf__cloud {
    position: absolute;
    left: 0;
    top: calc(var(--u) * var(--y));
    width: 100%;
  }
  .nf__cloud .nf__run {
    width: calc(var(--sky-tile) * 2);
  }
  .nf__cloud :global(.illo) {
    position: absolute;
    top: 0;
    left: var(--x);
    width: calc(var(--u) * var(--w) * 0.82);
  }
  .nf__cloud :global(.illo + .illo) {
    left: calc(var(--x) + 50%);
  }
  .nf__cloud--1 {
    --w: 330;
    --x: 7%;
    --y: 0;
    --dur: 132s;
    --at: 0.08;
  }
  .nf__cloud--2 {
    --w: 236;
    --x: 27%;
    --y: 30;
    --dur: 158s;
    --at: 0.5;
  }
  .nf__cloud--3 {
    --w: 420;
    --x: 36%;
    --y: 8;
    --dur: 104s;
    --at: 0.02;
  }

  /* Sun and islands stand on the horizon: the bottom edge of the sky row. */
  .nf__land {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
  }
  .nf__land > * {
    position: absolute;
  }
  .nf__sun {
    left: 36.5%;
    bottom: calc(var(--u) * -64);
    width: calc(var(--u) * 300);
    margin-left: calc(var(--u) * -150);
  }
  .nf__island {
    left: 1.5%;
    bottom: calc(var(--u) * -4);
    width: calc(var(--u) * 560);
  }
  .nf__cape {
    right: calc(var(--u) * -80);
    bottom: calc(var(--u) * -4);
    width: calc(var(--u) * 560);
  }

  .nf__horizon {
    position: absolute;
    z-index: 1;
    left: 0;
    top: calc(var(--u) * -4);
    width: var(--tile);
  }
  .nf__band {
    position: absolute;
    left: 0;
    width: 100%;
  }
  /* The far band hangs from the horizon; the mid band and the boat are set off the near water,
     so the boat always stands against the same blue. */
  .nf__band--far {
    --dur: 210s;
    --at: 0.3;
    z-index: 3;
    top: calc(var(--u) * 46);
    height: calc(var(--u) * 112);
  }
  .nf__band--mid {
    --dur: 150s;
    --at: 0.62;
    z-index: 4;
    bottom: calc(var(--u) * -40);
    height: calc(var(--u) * 150);
  }
  .nf__band--mid :global(.illo) {
    color: var(--blue-light);
  }

  .nf__boat {
    --boat-w: calc(var(--u) * 200);
    --voyage: 62s;
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    bottom: calc(var(--u) * -24);
    height: calc(var(--u) * 178);
  }
  .nf__voyage {
    position: absolute;
    inset: 0;
    transform: translate3d(57%, 0, 0);
  }
  .nf__bob {
    width: var(--boat-w);
  }
  .nf__tilt {
    transform-origin: 50% 84%;
  }

  /* The near water: its wave-cut edge slides, the wash under it stays put and carries the words.
     Its lower edge is cut by hand and leaves a little paper below. */
  .nf__deep {
    position: absolute;
    z-index: 6;
    inset: 0;
  }
  .nf__deep::before {
    content: '';
    position: absolute;
    inset: calc(var(--u) * 40) 0 0;
    background-color: var(--blue-deep);
  }
  .nf__swell {
    --dur: 104s;
    --at: 0.15;
    position: absolute;
    left: 0;
    top: calc(var(--u) * -20);
    width: 100%;
    height: calc(var(--u) * 84);
  }
  .nf__swell :global(.illo) {
    color: var(--blue-light);
  }
  .nf__floor {
    position: absolute;
    left: 0;
    top: calc(100% - 1px);
    width: var(--tile);
  }

  /* Paper grain over the whole picture, still while the layers move underneath. */
  .nf__grain {
    position: absolute;
    z-index: 7;
    inset: 0;
    pointer-events: none;
    background-image: url('/textures/grain-dark.webp'), url('/textures/grain-light.webp');
    background-size: 400px 400px;
  }

  /* ---------- motion (only when it is allowed) ---------- */
  @keyframes nf-drift {
    from {
      transform: translate3d(-50%, 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }
  @keyframes nf-voyage {
    from {
      transform: translate3d(calc(var(--boat-w) * -1.1), 0, 0);
    }
    to {
      transform: translate3d(100%, 0, 0);
    }
  }
  @keyframes nf-bob {
    from {
      transform: translate3d(0, -0.05rem, 0);
    }
    to {
      transform: translate3d(0, 0.13rem, 0);
    }
  }
  @keyframes nf-tilt {
    from {
      transform: rotate(-1.2deg);
    }
    to {
      transform: rotate(1.5deg);
    }
  }
  @keyframes nf-arrive {
    from {
      opacity: 0;
      transform: translate3d(0, 1.1rem, 0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The loops. */
    :global(html.motion) .nf__run {
      animation: nf-drift var(--dur) linear infinite;
      animation-delay: calc(var(--dur) * var(--at, 0) * -1);
      will-change: transform;
    }
    :global(html.motion) .nf__voyage {
      animation: nf-voyage var(--voyage) linear infinite;
      animation-delay: calc(var(--voyage) * -0.3);
      will-change: transform;
    }
    :global(html.motion) .nf__bob {
      animation: nf-bob 5.4s ease-in-out infinite alternate;
    }
    :global(html.motion) .nf__tilt {
      animation: nf-tilt 7.2s ease-in-out infinite alternate;
    }

    /* The arrival, once: washes settle with a short rise, lines draw in, the near water and its
       words come last. The near water sits at the foot of the screen, below the line where the
       site's scroll reveals fire, so it arrives on a timer instead. */
    :global(html.motion) .nf__band[data-reveal]:not(.is-in) {
      transform: translate3d(0, 0.9rem, 0);
    }
    :global(html.motion) .nf :global([data-draw] path) {
      transition-duration: 1.3s;
      transition-delay: calc(min(var(--i, 0), 16) * 30ms + var(--delay, 0ms) + 100ms);
    }
    :global(html.motion) .nf__deep {
      animation: nf-arrive var(--dur-3) var(--ease-out) 0.45s both;
    }
    :global(html.motion) .nf__words {
      animation: nf-arrive var(--dur-3) var(--ease-out) 1.2s both;
    }
  }

  /* ---------- narrow screens: the sentence keeps the centre, the sea draws in ---------- */
  @media (max-width: 47.99rem) {
    .nf {
      --cloud-zone: calc(var(--u) * 88);
    }
    .nf__island {
      left: calc(var(--u) * -300);
    }
    .nf__sun {
      left: 43%;
    }
    .nf__cape {
      right: calc(var(--u) * -260);
    }
    .nf__boat {
      --voyage: 48s;
    }
    .nf__words {
      display: grid;
      justify-items: start;
    }
  }
</style>
