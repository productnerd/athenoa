---
// Not found: a calm Aegean, the footer's sibling at sea.
//
// CLIENT DIRECTION, 11 October 2026 (replaces the first brief; do not restore the old parts):
// the page has no site header; there is no visible "Page not found" heading, no second link and no
// sun; the water runs to the very bottom of the page in the darker blue (no paper under it). The only
// control is one button, bottom right ("Back to Ithaka"), with a small slanted note under it, marked
// with an asterisk like a note in a margin. There is no quotation on eudaimonia any more.
//
// A paper theatre on the crème page: clouds drift across the top, one sentence stands in the sky
// ("Not everybody who wanders is lost", in the reading face), and below the horizon three bands of
// water slide past at their own pace while one boat sails from the left edge to the right and starts
// again. The way home floats on the nearest, darkest water.
//
// Artwork: src/assets/illustrations/sea-*.svg, generated by scripts/illustrations/sea-build.mjs.
// Every file is shown at (its viewBox width × --u), so the layers keep their proportions.
// Copy: src/data/notfound.ts.
//
// Two languages in one page. A static site serves the same not-found page for every missing
// address, so the language cannot be known when the page is built: the words of both languages
// are in the markup, each marked with its language, and the small script below shows the Greek
// ones on addresses that begin with /el/. English shows otherwise, and without JavaScript.
//
// Motion is CSS only. The loops run under html.motion (set by Base when motion is allowed) and
// prefers-reduced-motion: no-preference; otherwise the same layers stand still as one picture,
// with the boat right of centre.
import Illustration from '../Illustration.astro';
import { notfound } from '../../data/notfound';

const locales = ['en', 'el'] as const;
// How far each word of the note strays from its line (in ems) and how much it leans: an uneven hand
const jot = (i: number) => ({ y: (Math.sin(i * 1.9 + 0.6) * 0.17).toFixed(2), r: (Math.cos(i * 1.3) * 3.2).toFixed(1) });
const headings = { en: notfound.en.heading, el: notfound.el.heading };
---

<section class="nf">
  <script is:inline data-astro-rerun define:vars={{ headings }}>
    if (/(^|\/)(el|grc)(\/|$)/.test(location.pathname)) {
      document.documentElement.setAttribute('data-nf-lang', 'el');
      document.title = document.title.replace(headings.en, headings.el);
    }
  </script>

  <!-- The plain words come first in the source; the grid sets them on the near water. -->
  {/* theme-day: the near water stays dark blue at night too (only blues there, never paper) */}
  <div class="nf__near on-blue-deep theme-day">
    <div class="nf__deep" aria-hidden="true">
      <div class="nf__swell">
        <div class="nf__run"><Illustration name="sea-waves-near" /></div>
      </div>
    </div>
    {
      locales.map((locale) => {
        const t = notfound[locale];
        return (
          <div class="nf__words wrap" lang={locale} data-lang={locale}>
            <h1 class="visually-hidden">{t.heading}</h1>
            <div class="nf__way">
              <a class="btn" href={t.home.href} data-nf-home>
                {t.home.label}
              </a>
              {/* Scribbled, not set: each word sits a little off the line and at its own slight angle.
                  (No credit line under it: client direction, 11 October 2026.) */}
              <p class="nf__aside hand">
                <span class="nf__star" aria-hidden="true">*</span>
                {t.journey.split(' ').map((word, i) => (
                  <>
                    <span class="nf__word" style={`--y:${jot(i).y}em;--r:${jot(i).r}deg`}>
                      {word}
                    </span>{' '}
                  </>
                ))}
              </p>
            </div>
          </div>
        );
      })
    }
  </div>

  <div class="nf__sky">
    {/* By night: the hero's sky, with its galaxy, its glimmering stars and now and then a falling star */}
    <div class="nf__night" aria-hidden="true">
      <Illustration name="portal-b-milkyway" />
      <Illustration name="portal-b-sky" />
      {[1, 2, 3].map((n) => <Illustration name={`portal-b-stars-${n}`} class="nf__tw" style={`--n:${n - 1}`} />)}
      <span class="nf__meteor"></span>
    </div>
    <div class="nf__clouds" aria-hidden="true" data-reveal="fade" style="--delay: 500ms">
      {
        [1, 2, 3].map((n) => (
          <div class={`nf__cloud nf__cloud--${n}`}>
            <div class="nf__run">
              <Illustration name={`sea-cloud-${n}`} />
              <Illustration name={`sea-cloud-${n}`} />
            </div>
          </div>
        ))
      }
    </div>

    <div class="nf__quote" data-reveal style="--delay: 250ms">
      {
        locales.map((locale) => (
          <p class="nf__line hand" lang={locale} data-lang={locale}>
            {notfound[locale].wander}
          </p>
        ))
      }
    </div>

    <div class="nf__land" aria-hidden="true">
      <div class="nf__island" data-reveal="fade"><Illustration name="sea-island" draw /></div>
      <div class="nf__cape" data-reveal="fade" style="--delay: 100ms"><Illustration name="sea-cape" draw /></div>
    </div>
  </div>

  <div class="nf__sea" aria-hidden="true">
    <div class="nf__horizon" data-reveal="fade"><Illustration name="sea-horizon" draw /></div>
    <div class="nf__band nf__band--far" data-reveal style="--delay: 80ms">
      <div class="nf__run"><Illustration name="sea-waves-far" /></div>
    </div>
    <div class="nf__band nf__band--mid" data-reveal style="--delay: 200ms">
      <div class="nf__run"><Illustration name="sea-waves-mid" /></div>
    </div>
    <div class="nf__boat" data-reveal="fade" style="--delay: 700ms">
      <div class="nf__voyage">
        <div class="nf__bob">
          <div class="nf__tilt"><Illustration name="sea-boat" /></div>
        </div>
      </div>
    </div>
  </div>

  <div class="nf__grain" aria-hidden="true"></div>
</section>

{/* A mellow sea, very quietly, for as long as the page is open */}
<audio src="/audio/sea.mp3" loop preload="none" data-nf-sea></audio>

<script>
  // Sound on the not-found page. The sea plays under everything, very low, while the site's sound is
  // on (it follows the music button, and starts with the first click or key press, as browsers
  // require). A gust of wind fills the sail when "Back to Ithaka" is pressed.
  const SEA = 0.09;
  const WIND = 0.3;
  let stop: (() => void) | undefined;
  const muted = () => {
    try {
      return localStorage.getItem('ath-music') === 'off';
    } catch {
      return false;
    }
  };
  function setup() {
    stop?.();
    stop = undefined;
    const sea = document.querySelector<HTMLAudioElement>('[data-nf-sea]');
    if (!sea) return;
    const music = document.querySelector<HTMLAudioElement>('[data-music-audio]');
    let ramp = 0;
    const play = () => {
      if (muted() || !sea.paused) return;
      sea.volume = 0;
      sea
        .play()
        .then(() => {
          const began = performance.now();
          const step = (now: number) => {
            const k = Math.min(1, Math.max(0, (now - began) / 2500));
            sea.volume = SEA * k;
            if (k < 1) ramp = requestAnimationFrame(step);
          };
          ramp = requestAnimationFrame(step);
        })
        .catch(() => {});
    };
    const pause = () => {
      cancelAnimationFrame(ramp);
      sea.pause();
    };
    const follow = () => (music && music.paused && muted() ? pause() : play());
    const gesture = () => play();
    const wind = (event: Event) => {
      const link = event.target instanceof Element ? event.target.closest('[data-nf-home]') : null;
      if (!link || muted()) return;
      const gust = new Audio('/audio/wind.mp3');
      gust.volume = WIND;
      gust.play().catch(() => {});
    };
    music?.addEventListener('play', follow);
    music?.addEventListener('pause', follow);
    window.addEventListener('pointerdown', gesture, { passive: true });
    window.addEventListener('keydown', gesture, { passive: true });
    document.addEventListener('click', wind, true);
    play();
    stop = () => {
      music?.removeEventListener('play', follow);
      music?.removeEventListener('pause', follow);
      window.removeEventListener('pointerdown', gesture);
      window.removeEventListener('keydown', gesture);
      document.removeEventListener('click', wind, true);
      pause();
    };
  }
  document.addEventListener('astro:page-load', setup);
  document.addEventListener('astro:before-swap', () => stop?.());
</script>

<style>
  .nf {
    /* --u is one drawing unit. By width, the picture is 1600 units across and never narrower than
       64rem. By height, it must leave room for the words: --fixed is what the header, the
       translation and the plain words take, and 638 units is the picture from the clouds to the
       foot of the water (484) plus two lines of Greek (154). The smaller of the two is used, so
       the whole page fits a laptop window; below --least of the width scale it stops shrinking
       and the page scrolls instead. */
    --vh: 100vh;
    --fixed: 25.5rem;
    --least: 0.5;
    --uw: calc(max(100vw, 64rem) / 1600);
    --u: clamp(calc(var(--uw) * var(--least)), calc((var(--vh) - var(--fixed)) / 638), var(--uw));
    /* One wave tile. It may be narrower than the screen, so the bands are four tiles long. */
    --tile: calc(var(--u) * 1600);
    /* Horizon to the edge of the near water. */
    --sea-h: calc(var(--u) * 206);
    /* Sky kept clear: for the clouds above the sentence, and for the sun and the islands below it. */
    --cloud-zone: calc(var(--u) * 96);
    --land-zone: calc(var(--u) * 90);
    /* Where the sun stands along the horizon. */
    --sun: 43%;

    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) var(--sea-h) auto;
    min-height: var(--vh);
    /* The page has no header and the water runs to the bottom edge. */
    margin-top: 0;
    padding-bottom: 0;
    overflow: clip;
    background-color: var(--paper);
  }
  @supports (height: 100svh) {
    .nf {
      --vh: 100svh;
    }
  }
  .nf :global(.illo svg) {
    max-width: none;
  }
  /* Both languages are in the page; the address decides which one shows (see the script). */
  :global(html:not([data-nf-lang='el'])) .nf [data-lang='el'],
  :global(html[data-nf-lang='el']) .nf [data-lang='en'] {
    display: none;
  }
  /* Editorial New has no Greek and the Tekst trial lacks accented Greek: the Greek words are set
     in EB Garamond throughout, so that no word is pieced together from two typefaces. */
  .nf [data-lang='el'] {
    --font-title: 'EB Garamond Variable', 'EB Garamond', Garamond, serif;
    --font-body: 'EB Garamond Variable', 'EB Garamond', Garamond, serif;
    font-family: var(--font-body);
  }

  /* ---------- rows ---------- */
  .nf__sky {
    grid-row: 1;
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    padding: calc(var(--header-h) + var(--cloud-zone)) var(--gutter) var(--land-zone);
    text-align: center;
  }
  .nf__sea {
    grid-row: 2;
    position: relative;
  }
  /* The foot of the near water stays clear of the music button, which is fixed in the lower left
     corner of every page (3rem square, at most 1.5rem from the edges). */
  .nf__near {
    grid-row: 3;
    position: relative;
    padding: calc(var(--u) * 66) 0 3rem;
  }

  /* ---------- the night sky ---------- */
  /* Shown only in the night view. The drawings are the hero's own; each set of large stars is a
     layer by itself whose opacity alone moves, so the glimmer costs nothing. */
  .nf__night {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    display: none;
    color: var(--blue-deep);
    pointer-events: none;
  }
  :global(html[data-theme='dark']) .nf__night {
    display: block;
  }
  .nf__night :global(.illo) {
    position: absolute;
    inset: 0;
  }
  .nf__night :global(svg) {
    width: 100%;
    height: 100%;
  }
  .nf__night :global(.illo--portal-b-milkyway) {
    opacity: 0.8;
  }
  @keyframes nf-twinkle {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.3;
    }
  }
  :global(html.motion) .nf__night :global(.nf__tw svg) {
    animation: nf-twinkle calc(2.6s + var(--n, 0) * 0.9s) var(--ease-in-out) calc(var(--n, 0) * -1.3s) infinite alternate;
    will-change: opacity;
  }
  .nf__meteor {
    position: absolute;
    left: 70%;
    top: 14%;
    width: clamp(4rem, 9vmin, 7rem);
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to left, transparent, color-mix(in srgb, var(--blue-deep) 55%, transparent) 55%, var(--blue-deep));
    opacity: 0;
  }
  @keyframes nf-meteor {
    0% {
      opacity: 0;
      transform: translate3d(0, 0, 0) rotate(-19.5deg);
    }
    0.5% {
      opacity: 1;
    }
    2.9% {
      opacity: 1;
    }
    3.8%,
    100% {
      opacity: 0;
      transform: translate3d(-36vmin, 12.7vmin, 0) rotate(-19.5deg);
    }
  }
  :global(html.motion) .nf__meteor {
    animation: nf-meteor 25s linear 6s infinite;
    will-change: transform, opacity;
  }

  /* ---------- the words ---------- */
  .nf__quote {
    position: relative;
    z-index: 8;
    max-width: 100%;
    margin: 0;
  }
  /* The sentence in the sky, in the reading face (Greek falls back to EB Garamond, see above). */
  .nf__line {
    /* in the handwritten voice (client direction, 12 October 2026) */
    position: relative;
    z-index: 2;
    max-width: 18ch;
    margin: 0;
    font-size: max(1.9rem, min(clamp(2.5rem, 1.6rem + 3.6vw, 4.9rem), calc(var(--u) * 84)));
    line-height: 1.25;
    color: var(--ink-strong);
    text-wrap: balance;
  }
  /* Greek in the handwritten face too (the rule above, which sets Greek in EB Garamond, would win) */
  .nf [data-lang='el'] .hand,
  .nf .hand[data-lang='el'] {
    font-family: 'ATH Lolotte', var(--font-hand);
  }
  /* Greek words are longer: a wider measure keeps the sentence to two lines */
  .nf__line[lang='el'] {
    max-width: 22ch;
  }

  /* One way back, bottom right: the button, and a small slanted note tucked under it. */
  .nf__words {
    position: relative;
    z-index: 8;
    display: flex;
    justify-content: flex-end;
  }
  .nf__way {
    display: grid;
    justify-items: end;
    gap: 0.15rem;
    max-width: min(100%, 30rem);
    text-align: right;
  }
  /* A casual note in the margin: half the size the voice face has elsewhere, and at an angle. */
  .nf__aside {
    font-size: calc(var(--step-1) * 0.62);
    line-height: var(--hand-leading);
    color: var(--creme-light);
    rotate: -5deg;
    transform-origin: 100% 0;
    margin-right: 0.4rem;
  }
  .nf__star {
    margin-right: 0.15em;
    font-size: 1.5em;
    line-height: 0;
    vertical-align: -0.18em;
  }
  .nf__word {
    display: inline-block;
    translate: 0 var(--y, 0);
    rotate: var(--r, 0deg);
  }

  /* ---------- the picture ---------- */
  /* Sliding layers: four tiles long, moved by exactly one tile (--step, a share of their own
     length). --at is where in the loop the still picture stands, and where the loop starts from. */
  .nf__run {
    --step: -25%;
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--tile) * 4);
    transform: translate3d(calc(var(--step) * (1 - var(--at, 0))), 0, 0);
  }

  .nf__clouds {
    --sky-tile: max(100vw, 60rem);
    position: absolute;
    z-index: 1;
    left: 0;
    right: 0;
    top: var(--header-h);
    height: var(--cloud-zone);
  }
  .nf__cloud {
    position: absolute;
    left: 0;
    top: calc(var(--u) * var(--y));
    width: 100%;
  }
  /* Each cloud is set twice, one sky tile apart, on a strip two sky tiles long. */
  .nf__cloud .nf__run {
    --step: -50%;
    width: calc(var(--sky-tile) * 2);
  }
  .nf__cloud :global(.illo) {
    position: absolute;
    top: 0;
    left: var(--x);
    width: calc(var(--u) * var(--w) * 0.82);
  }
  .nf__cloud :global(.illo + .illo) {
    left: calc(var(--x) + 50%);
  }
  /* The slowest cloud is the farthest: the faster ones pass in front of it. */
  .nf__cloud--1 {
    z-index: 2;
    --w: 330;
    --x: 7%;
    --y: 0;
    --dur: 132s;
    --at: 0.08;
  }
  .nf__cloud--2 {
    z-index: 1;
    --w: 236;
    --x: 27%;
    --y: 30;
    --dur: 158s;
    --at: 0.5;
  }
  .nf__cloud--3 {
    z-index: 3;
    --w: 420;
    --x: 36%;
    --y: 8;
    --dur: 104s;
    --at: 0.02;
  }

  /* Sun and islands stand on the horizon: the bottom edge of the sky row. */
  .nf__land {
    position: absolute;
    z-index: 2;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
  }
  .nf__land > * {
    position: absolute;
  }
  /* The sun stands a little left of centre. The island ends just short of it on one side; the cape
     runs off the right edge and, on narrow screens, further off, so it keeps clear on the other. */
  .nf__island {
    left: calc(var(--sun) - var(--u) * 670);
    bottom: calc(var(--u) * -4);
    width: calc(var(--u) * 560);
  }
  .nf__cape {
    right: calc(max(var(--u) * 80, var(--u) * 670 - (100% - var(--sun))) * -1);
    bottom: calc(var(--u) * -4);
    width: calc(var(--u) * 560);
  }

  .nf__horizon {
    position: absolute;
    z-index: 1;
    left: 0;
    top: calc(var(--u) * -4);
    width: calc(var(--tile) * 2);
  }
  .nf__band {
    position: absolute;
    left: 0;
    width: 100%;
  }
  /* The far band hangs from the horizon; the mid band and the boat are set off the near water,
     so the boat always stands against the same blue. */
  .nf__band--far {
    --dur: 210s;
    --at: 0.3;
    z-index: 3;
    top: calc(var(--u) * 46);
    height: calc(var(--u) * 112);
  }
  .nf__band--mid {
    --dur: 150s;
    --at: 0.62;
    z-index: 4;
    bottom: calc(var(--u) * -40);
    height: calc(var(--u) * 150);
  }
  .nf__band--mid :global(.illo) {
    color: var(--blue-light);
  }

  .nf__boat {
    --boat-w: calc(var(--u) * 200);
    --voyage: 62s;
    position: absolute;
    z-index: 5;
    left: 0;
    right: 0;
    bottom: calc(var(--u) * -24);
    height: calc(var(--u) * 178);
  }
  .nf__voyage {
    position: absolute;
    inset: 0;
    transform: translate3d(57%, 0, 0);
  }
  .nf__bob {
    width: var(--boat-w);
  }
  .nf__tilt {
    transform-origin: 50% 84%;
  }

  /* The near water: its wave-cut edge slides, the wash under it stays put and carries the words.
     Its lower edge is cut by hand and leaves a little paper below. */
  .nf__deep {
    position: absolute;
    z-index: 6;
    inset: 0;
  }
  .nf__deep::before {
    content: '';
    position: absolute;
    inset: calc(var(--u) * 40) 0 0;
    background-color: var(--blue-deep);
  }
  .nf__swell {
    --dur: 104s;
    --at: 0.15;
    position: absolute;
    left: 0;
    top: calc(var(--u) * -20);
    width: 100%;
    height: calc(var(--u) * 84);
  }
  .nf__swell :global(.illo) {
    color: var(--blue-light);
  }

  /* Paper grain over the whole picture, still while the layers move underneath. */
  .nf__grain {
    position: absolute;
    z-index: 7;
    inset: 0;
    pointer-events: none;
    background-image: url('/textures/grain-dark.webp'), url('/textures/grain-light.webp');
    background-size: 400px 400px;
  }

  /* ---------- motion (only when it is allowed) ---------- */
  @keyframes nf-drift {
    from {
      transform: translate3d(var(--step), 0, 0);
    }
    to {
      transform: translate3d(0, 0, 0);
    }
  }
  @keyframes nf-voyage {
    from {
      transform: translate3d(calc(var(--boat-w) * -1.1), 0, 0);
    }
    to {
      transform: translate3d(100%, 0, 0);
    }
  }
  @keyframes nf-bob {
    from {
      transform: translate3d(0, -0.05rem, 0);
    }
    to {
      transform: translate3d(0, 0.13rem, 0);
    }
  }
  @keyframes nf-tilt {
    from {
      transform: rotate(-1.2deg);
    }
    to {
      transform: rotate(1.5deg);
    }
  }
  @keyframes nf-arrive {
    from {
      opacity: 0;
      transform: translate3d(0, 1.1rem, 0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    /* The loops. */
    :global(html.motion) .nf__run {
      animation: nf-drift var(--dur) linear infinite;
      animation-delay: calc(var(--dur) * var(--at, 0) * -1);
      will-change: transform;
    }
    :global(html.motion) .nf__voyage {
      animation: nf-voyage var(--voyage) linear infinite;
      animation-delay: calc(var(--voyage) * -0.3);
      will-change: transform;
    }
    :global(html.motion) .nf__bob {
      animation: nf-bob 5.4s ease-in-out infinite alternate;
    }
    :global(html.motion) .nf__tilt {
      animation: nf-tilt 7.2s ease-in-out infinite alternate;
    }

    /* The arrival, once: washes settle with a short rise, lines draw in, the near water and its
       words come last. The near water sits at the foot of the screen, below the line where the
       site's scroll reveals fire, so it arrives on a timer instead. */
    :global(html.motion) .nf__band[data-reveal]:not(.is-in) {
      transform: translate3d(0, 0.9rem, 0);
    }
    :global(html.motion) .nf :global([data-draw] path) {
      transition-duration: 1.3s;
      transition-delay: calc(min(var(--i, 0), 16) * 30ms + var(--delay, 0ms) + 100ms);
    }
    :global(html.motion) .nf__deep {
      animation: nf-arrive var(--dur-3) var(--ease-out) 0.45s both;
    }
    :global(html.motion) .nf__words {
      animation: nf-arrive var(--dur-3) var(--ease-out) 1.2s both;
    }
  }

  /* ---------- narrow screens: the sentence keeps the centre, the sea draws in ---------- */
  @media (max-width: 47.99rem) {
    /* The sentence and the way home stacked take more of the height; the sea gives way, but not
       below about three quarters of its size. */
    .nf {
      --fixed: 32rem;
      --least: 0.72;
      --cloud-zone: calc(var(--u) * 88);
    }
    .nf__boat {
      --voyage: 48s;
    }
    .nf__words {
      display: grid;
