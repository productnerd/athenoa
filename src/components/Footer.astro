---
// Footer: contact details and social marks above a borderless nature scene, drawn straight onto the page.
// Each page ends on a different scene:
//   attica   Home (and anything not listed)   mountains of Attica with umbrella pines
//   olympus  About Athena                     Mount Olympus with mountain pines
//   aegean   Courses and course pages         the Aegean
//
// Every scene is three layered SVG files (far, mid, near) that move at different depths:
//   attica   footer-mountains.svg, footer-hills.svg, footer-pines.svg
//   olympus  footer-olympus-far.svg, footer-olympus-mid.svg, footer-olympus-near.svg
//   aegean   footer-aegean-far.svg, footer-aegean-mid.svg, footer-aegean-near.svg
// To swap artwork, replace those files. Or drop one transparent image named footer-landscape,
// footer-olympus or footer-aegean (.png, .webp or .avif) in src/assets/illustrations and it
// replaces the drawn layers of that scene. No code changes either way.
// The far file of each scene also holds its sun and its night sky (moon and stars) as groups
// named .sky-day and .sky-night: a replacement drawing needs the same groups (see the styles below).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Illustration from './Illustration.astro';
import SocialIcons from './SocialIcons.astro';
import logo from '../assets/media/logo.png';
import { content } from '../data';
import { getLocale } from '../lib/locale';

type Scene = 'attica' | 'olympus' | 'aegean';
interface Props {
  /** Overrides the scene chosen from the page address. */
  scene?: Scene;
}

const { site } = content(getLocale(Astro.url));
const path = Astro.url.pathname.replace(/^\/el(?=\/)/, '');
const byPage: Scene = path.startsWith('/about-athena') ? 'olympus' : path.startsWith('/courses') ? 'aegean' : 'attica';
const scene = Astro.props.scene ?? byPage;

const layers: Record<Scene, { far: string; mid: string; near: string; image: string }> = {
  attica: { far: 'footer-mountains', mid: 'footer-hills', near: 'footer-pines', image: 'footer-landscape' },
  olympus: {
    far: 'footer-olympus-far',
    mid: 'footer-olympus-mid',
    // The first Olympus foreground read as bonsai. Until its pines are redrawn, the page uses the
    // pine forest the client preferred. Switch back to 'footer-olympus-near' when the new drawing lands.
    near: 'footer-pines',
    image: 'footer-olympus',
  },
  aegean: { far: 'footer-aegean-far', mid: 'footer-aegean-mid', near: 'footer-aegean-near', image: 'footer-aegean' },
};
const art = layers[scene];

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/illustrations/footer-*.{png,webp,avif}', {
  eager: true,
});
const custom = Object.entries(images).find(([file]) =>
  new RegExp(`/${art.image}\\.(png|webp|avif)$`).test(file),
)?.[1].default;
---

<footer class:list={['footer', `footer--${scene}`]}>
  <div class="wrap footer__grid" data-reveal-group>
    <div class="footer__brand">
      <Image src={logo} alt="" width={96} height={94} class="footer__logo" />
      <p class="footer__name">{site.name}</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">{site.footer.connectTitle}</h2>
      <ul class="footer__list">
        <li><a href={site.routes.contact}>{site.footer.contactFormLabel}</a></li>
        {
          site.emails.map((email) => (
            <li>
              <a href={`mailto:${email}`}>{email}</a>
            </li>
          ))
        }
        <li><a href={site.phone.href}>{site.phone.display}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">{site.footer.followTitle}</h2>
      <SocialIcons />
    </div>
  </div>

  {/* A click on the picture wakes something in it (script below): the donkey brays, a bird leaves a
      pine, the dolphins dive. A small surprise for the pointer; nothing depends on it. */}
  <div
    class:list={['footer__scene', `footer__scene--${scene}`, !custom && 'footer__scene--drawn']}
    aria-hidden="true"
    data-footer-scene={scene}
  >
    {
      custom ? (
        <div class="footer__layer footer__layer--custom" data-depth="0.12">
          <Image src={custom} alt="" widths={[800, 1400, 2200]} sizes="100vw" />
        </div>
      ) : (
        <>
          <div class="footer__layer footer__layer--far" data-depth="0.26">
            <Illustration name={art.far} draw />
          </div>
          <div class="footer__layer footer__layer--mid" data-depth="0.13">
            <Illustration name={art.mid} draw />
          </div>
          {/* Olympus: a small bird waits out of sight behind a pine */}
          {scene === 'olympus' && (
            <span class="footer__flyer" data-footer-flyer>
              <Illustration name="hero-sparrow" class="footer__flyer-body" />
              <Illustration name="hero-sparrow-wing" class="footer__flyer-wing" />
            </span>
          )}
          <div class="footer__layer footer__layer--near" data-depth="-0.05">
            <Illustration name={art.near} />
          </div>
          {/* A donkey among the pines of Attica (client request, 12 October 2026): on the Home page only */}
          {scene === 'attica' && (
            <div class="footer__donkey" data-depth="-0.05">
              <Illustration name="donkey" draw />
            </div>
          )}
        </>
      )
    }
  </div>

  <p class="footer__legal" lang="el">{site.copyright}</p>
</footer>

<script>
  // The pictures at the foot of the pages answer a click.
  //   Home (Attica):     the donkey lifts its head twice and brays.
  //   About (Olympus):   a small bird flies out from behind a pine and off the screen, with a chirp.
  //                      Once only: it does not come back until the page is opened again.
  //   Courses (Aegean):  the dolphins dive under the first wave with a splash; a second click and
  //                      they leap again with another.
  // Sounds follow the site's sound button.
  const quiet = () => {
    try {
      return localStorage.getItem('ath-music') === 'off';
    } catch {
      return false;
    }
  };
  const play = (file: string, volume: number) => {
    if (quiet()) return;
    const sound = new Audio(file);
    sound.volume = volume;
    sound.play().catch(() => {});
  };
  const once = (el: Element, name: string, ms: number) => {
    if (el.classList.contains(name)) return false;
    el.classList.add(name);
    window.setTimeout(() => el.classList.remove(name), ms);
    return true;
  };
  document.addEventListener('astro:page-load', () => {
    const scene = document.querySelector<HTMLElement>('[data-footer-scene]:not([data-footer-ready])');
    if (!scene) return;
    scene.dataset.footerReady = '';
    scene.addEventListener('click', () => {
      const kind = scene.dataset.footerScene;
      if (kind === 'attica') {
        const donkey = scene.querySelector('.footer__donkey');
        if (donkey && once(donkey, 'is-braying', 2000)) play('/audio/bray.mp3', 0.16);
      } else if (kind === 'olympus') {
        // once only: the bird has left, so later clicks find the tree empty
        const bird = scene.querySelector('[data-footer-flyer]');
        if (bird && !('footerDone' in scene.dataset)) {
          scene.dataset.footerDone = '';
          bird.classList.add('is-flying');
          window.setTimeout(() => bird.classList.remove('is-flying'), 3600);
          window.setTimeout(() => play('/audio/chirp-2.mp3', 0.16), 250);
        }
      } else if (kind === 'aegean') {
        const dived = scene.classList.toggle('is-dived');
        // a splash as they go under, another as they break the surface
        if (dived) window.setTimeout(() => play('/audio/splash-in.mp3', 0.16), 450);
        else window.setTimeout(() => play('/audio/splash-out.mp3', 0.16), 120);
      }
    });
  });
</script>

<style>
  .footer {
    position: relative;
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    overflow: clip;
  }
  .footer__grid {
    position: relative;
    z-index: 2;
    display: grid;
    /* The name on the left; "Connect with us" and "Follow us" side by side on the right */
    grid-template-columns: 1fr auto auto;
    gap: var(--space-l) clamp(1.75rem, 0.5rem + 4vw, 5rem);
    align-items: start;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .footer__logo {
    width: clamp(2.75rem, 2.4rem + 1.2vw, 3.75rem);
    height: auto;
  }
  .footer__name {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-2);
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--blue);
  }
  .footer__title {
    font-family: var(--font-hand);
    font-style: italic;
    font-size: calc(var(--step-1) * 1.25);
    line-height: 1.15;
    color: var(--blue);
    margin-bottom: 0.05rem;
  }
  /* The Greek hand is a wider, heavier face: a fifth smaller, so the two headings sit as they do in English */
  :global(html[lang='el']) .footer__title {
    font-size: calc(var(--step-1) * 1);
    /* the Greek hand has long tails: more room before the list under it */
    margin-bottom: 0.6rem;
  }
  .footer__list {
    display: grid;
    gap: 0.3rem;
    font-size: var(--step--1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-variant-numeric: lining-nums;
  }
  .footer__list a {
    text-decoration-color: transparent;
    overflow-wrap: anywhere;
  }
  .footer__list a:hover {
    text-decoration-color: currentColor;
  }
  /* The row of icons starts on the same left edge as its heading */
  .footer__col :global(.social) {
    justify-content: flex-start;
    margin-left: -0.3rem;
  }

  /* The landscape: no box, no border, drawn straight onto the page.
     The scene is exactly as wide as the drawing (never narrower than 64rem, so small screens
     see the middle of it) and its height follows that width, so the three layers keep their
     places in the picture at every size. Offsets are fractions of the scene height. */
  .footer__scene {
    position: relative;
    z-index: 1;
    left: 50%;
    width: max(100%, 64rem);
    margin-left: calc(max(100%, 64rem) / -2);
    aspect-ratio: 1600 / 525;
    pointer-events: none;
  }
  .footer__layer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    color: var(--blue);
  }
  .footer__layer--far {
    bottom: 16%;
  }
  .footer__layer--mid {
    bottom: 2.7%;
  }
  .footer__layer--near {
    bottom: -1px;
  }
  /* The picture can be clicked (see the script); its layers still let the click through to it */
  .footer__scene[data-footer-scene] {
    pointer-events: auto;
    cursor: pointer;
  }

  /* The donkey brays: its head comes up twice. (The head is a group inside the drawing; it turns
     about the top of the neck. A short, one-off movement of a very small drawing.) */
  /* at night the line is pale, so the pupils take the dark of the sky instead */
  :global(html[data-theme='dark']) .footer__donkey {
    --eye-pupil: var(--paper);
  }
  .footer__donkey :global(.donkey__head) {
    transform-box: view-box;
    transform-origin: 93px 35px;
  }
  @keyframes donkey-bray {
    0%,
    100% {
      transform: rotate(0deg);
    }
    14% {
      transform: rotate(-24deg);
    }
    34% {
      transform: rotate(-6deg);
    }
    56% {
      transform: rotate(-27deg);
    }
    80% {
      transform: rotate(-4deg);
    }
  }
  .footer__donkey:global(.is-braying) :global(.donkey__head) {
    animation: donkey-bray 1.9s ease-in-out;
  }

  /* The bird of Olympus: out of sight behind a pine until the picture is clicked, then up and away
     past the right-hand edge of the screen. It is drawn before the pines, so they hide it at first. */
  .footer__flyer {
    position: absolute;
    left: 58.5%;
    bottom: 47%;
    width: 2.1%;
    min-width: 1.4rem;
    aspect-ratio: 42 / 36;
    color: var(--blue);
    --bird-fill: var(--paper);
    opacity: 0;
    scale: -1 1; /* it flies to the right; the drawing faces left */
  }
  .footer__flyer :global(.illo) {
    position: absolute;
    inset: 0;
  }
  .footer__flyer :global(.footer__flyer-wing) {
    transform-origin: 55% 47%;
  }
  @keyframes flyer-away {
    0% {
      opacity: 0;
      transform: translate3d(0, 0.4rem, 0);
    }
    8% {
      opacity: 1;
    }
    30% {
      transform: translate3d(-9vw, -3.2rem, 0);
    }
    100% {
      opacity: 1;
      transform: translate3d(-62vw, -11rem, 0);
    }
  }
  @keyframes flyer-flap {
    from {
      transform: scaleY(1);
    }
    to {
      transform: translate3d(0, -22%, 0) scaleY(-1.5);
    }
  }
  .footer__flyer:global(.is-flying) {
    animation: flyer-away 3.4s cubic-bezier(0.35, 0, 0.7, 0.6) both;
  }
  .footer__flyer:global(.is-flying) :global(.footer__flyer-wing) {
    animation: flyer-flap 0.13s ease-in-out infinite alternate;
  }

  /* The dolphins of the Aegean dive under the first wave (it is drawn after them, so it covers them
     as they go down), and leap out again on the next click. */
  .footer__scene :global(.aeg-dolphin) {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    transition:
      transform 0.9s cubic-bezier(0.34, 1.4, 0.5, 1),
      opacity 0.3s linear;
  }
  .footer__scene :global(.aeg-dolphin + .aeg-dolphin) {
    transition-delay: 0.14s;
  }
  .footer__scene:global(.is-dived) :global(.aeg-dolphin) {
    transform: translateY(64px) rotate(26deg);
    opacity: 0;
    transition:
      transform 0.8s cubic-bezier(0.5, -0.3, 0.8, 0.5),
      opacity 0.25s linear 0.55s;
  }

  /* It stands on the ground line of the scene (60 of the picture's 1600 units up), left of centre */
  .footer__donkey {
    position: absolute;
    left: 30.5%;
    bottom: 14.4%;
    width: 6.2%;
    color: var(--blue);
  }
  /* The drawn layers hide one another with flat paper-coloured fills. The page grain is laid
     back over the whole picture (on a flat ground, so the sky is not grained twice), which
     keeps land and sky the same sheet of paper. */
  .footer__scene--drawn::before,
  .footer__scene--drawn::after {
    content: '';
    position: absolute;
    inset: -6rem 0 0;
  }
  .footer__scene--drawn::before {
    z-index: -1;
    background-color: var(--paper);
  }
  .footer__scene--drawn::after {
    background-image: var(--grain);
    background-size: 400px 400px;
  }
  /* Day and night sky. The far drawing of each scene starts with a group .sky-night (a crescent moon
     in .sky-moon and a few stars, each in its own .sky-star) and, where the scene has a sun, a group
     .sky-day before it. Only one sky shows, and it follows the header's day and night button without
     a reload. Both skies are drawn behind the land and the sea. By night the sun rests below the
     horizon, by day the moon does; each drawing says in its own units how far its sun sinks (--set)
     and its moon rises (--rise). Without motion the hidden sky is simply taken out of the drawing. */
  .footer__scene :global(.sky-night) {
    display: none;
  }
  :global(html[data-theme='dark']) .footer__scene :global(.sky-night),
  :global(html.motion) .footer__scene :global(.sky-night) {
    display: inline;
  }
  :global(html[data-theme='dark']:not(.motion)) .footer__scene :global(.sky-day) {
    display: none;
  }
  :global(html[data-theme='dark']) .footer__scene :global(.sky-day) {
    transform: translateY(var(--set, 150px));
    visibility: hidden;
  }
  .footer__scene :global(.sky-moon) {
    transform: translateY(var(--rise, 24px));
    opacity: 0;
    visibility: hidden;
  }
  .footer__scene :global(.sky-star) {
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.7);
    opacity: 0;
  }
  :global(html[data-theme='dark']) .footer__scene :global(.sky-moon),
  :global(html[data-theme='dark']) .footer__scene :global(.sky-star) {
    transform: none;
    opacity: 1;
    visibility: visible;
  }

  /* With motion the two skies trade places. Nightfall: the sun sinks out of sight, the moon rises,
     the stars come out one after another (each drawing numbers its stars with --n). Daybreak is the
     same backwards, and quicker. The first 0.35s belongs to the cross-fade of the page. --dusk is
     when the moon starts: straight away where there is no sun to wait for.
     In every pair of rules below, the transition written for a state is the one that leads into it. */
  :global(html.motion) .footer__scene :global(.sky-night) {
    --dusk: 0.35s;
  }
  :global(html.motion) .footer__scene :global(.sky-day ~ .sky-night) {
    --dusk: 1.1s;
  }
  :global(html.motion) .footer__scene :global(.sky-day) {
    transition: transform 0.8s var(--ease-soft) 0.35s;
  }
  :global(html.motion[data-theme='dark']) .footer__scene :global(.sky-day) {
    transition:
      transform 0.9s var(--ease-in-out) 0.35s,
      visibility 0s 1.25s;
  }
  :global(html.motion) .footer__scene :global(.sky-moon) {
    transition:
      transform 0.5s var(--ease-in-out),
      opacity 0.3s ease,
      visibility 0s 0.5s;
  }
  :global(html.motion[data-theme='dark']) .footer__scene :global(.sky-moon) {
    transition:
      transform 0.95s var(--ease-soft) var(--dusk),
      opacity 0.4s ease var(--dusk),
      visibility 0s var(--dusk);
  }
  :global(html.motion) .footer__scene :global(.sky-star) {
    transition:
      transform 0.25s ease,
      opacity 0.25s ease;
  }
  :global(html.motion[data-theme='dark']) .footer__scene :global(.sky-star) {
    transition:
      transform 0.5s var(--ease-soft),
      opacity 0.4s ease;
    transition-delay: calc(var(--dusk) + 0.4s + var(--n, 0) * 70ms);
  }
  .footer__layer--custom :global(img) {
    width: 100%;
    height: auto;
  }

  /* The page ends on a low band of ink: the ground of the drawing and a slim strip under it.
     The copyright line is centred on that band. */
  .footer {
    padding-bottom: 1rem;
    background: linear-gradient(to top, var(--footer-ground, var(--blue)) 1.05rem, transparent 1.05rem);
  }
  .footer__legal {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--footer-band) / 2 - 0.62em);
    z-index: 3;
    margin: 0;
    padding: 0 var(--gutter);
    text-align: center;
    font-size: var(--step--1);
    line-height: 1.24;
    letter-spacing: 0.08em;
    color: var(--creme-light);
  }
  .footer--aegean {
    --footer-ground: var(--blue-deep);
  }

  @media (max-width: 60rem) {
    /* the name sits close above the two headings */
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      row-gap: var(--space-s);
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34rem) {
    .footer__grid {
      grid-template-columns: 1fr;
      row-gap: var(--space-m);
    }
  }
</style>
