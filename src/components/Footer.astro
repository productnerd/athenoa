---
// Footer: contact details and social marks above a borderless nature scene, drawn straight onto the page.
// Each page ends on a different scene:
//   attica   Home (and anything not listed)   mountains of Attica with umbrella pines
//   olympus  About Athena                     Mount Olympus with mountain pines
//   aegean   Courses and course pages         the Aegean
//
// Every scene is three layered SVG files (far, mid, near) that move at different depths:
//   attica   footer-mountains.svg, footer-hills.svg, footer-pines.svg
//   olympus  footer-olympus-far.svg, footer-olympus-mid.svg, footer-olympus-near.svg
//   aegean   footer-aegean-far.svg, footer-aegean-mid.svg, footer-aegean-near.svg
// To swap artwork, replace those files. Or drop one transparent image named footer-landscape,
// footer-olympus or footer-aegean (.png, .webp or .avif) in src/assets/illustrations and it
// replaces the drawn layers of that scene. No code changes either way.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Illustration from './Illustration.astro';
import SocialIcons from './SocialIcons.astro';
import logo from '../assets/media/logo.png';
import { content } from '../data';
import { getLocale } from '../lib/locale';

type Scene = 'attica' | 'olympus' | 'aegean';
interface Props {
  /** Overrides the scene chosen from the page address. */
  scene?: Scene;
}

const { site } = content(getLocale(Astro.url));
const path = Astro.url.pathname.replace(/^\/el(?=\/)/, '');
const byPage: Scene = path.startsWith('/about-athena') ? 'olympus' : path.startsWith('/courses') ? 'aegean' : 'attica';
const scene = Astro.props.scene ?? byPage;

const layers: Record<Scene, { far: string; mid: string; near: string; image: string }> = {
  attica: { far: 'footer-mountains', mid: 'footer-hills', near: 'footer-pines', image: 'footer-landscape' },
  olympus: {
    far: 'footer-olympus-far',
    mid: 'footer-olympus-mid',
    // The first Olympus foreground read as bonsai. Until its pines are redrawn, the page uses the
    // pine forest the client preferred. Switch back to 'footer-olympus-near' when the new drawing lands.
    near: 'footer-pines',
    image: 'footer-olympus',
  },
  aegean: { far: 'footer-aegean-far', mid: 'footer-aegean-mid', near: 'footer-aegean-near', image: 'footer-aegean' },
};
const art = layers[scene];

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/illustrations/footer-*.{png,webp,avif}', {
  eager: true,
});
const custom = Object.entries(images).find(([file]) =>
  new RegExp(`/${art.image}\\.(png|webp|avif)$`).test(file),
)?.[1].default;
---

<footer class:list={['footer', `footer--${scene}`]}>
  <div class="wrap footer__grid" data-reveal-group>
    <div class="footer__brand">
      <Image src={logo} alt="" width={96} height={94} class="footer__logo" />
      <p class="footer__name">{site.name}</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">{site.footer.connectTitle}</h2>
      <ul class="footer__list">
        <li><a href={site.routes.contact}>{site.footer.contactFormLabel}</a></li>
        {
          site.emails.map((email) => (
            <li>
              <a href={`mailto:${email}`}>{email}</a>
            </li>
          ))
        }
        <li><a href={site.phone.href}>{site.phone.display}</a></li>
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__title">{site.footer.followTitle}</h2>
      <SocialIcons />
    </div>
  </div>

  <div class:list={['footer__scene', `footer__scene--${scene}`, !custom && 'footer__scene--drawn']} aria-hidden="true">
    {
      custom ? (
        <div class="footer__layer footer__layer--custom" data-depth="0.12">
          <Image src={custom} alt="" widths={[800, 1400, 2200]} sizes="100vw" />
        </div>
      ) : (
        <>
          <div class="footer__layer footer__layer--far" data-depth="0.26">
            <Illustration name={art.far} draw />
          </div>
          <div class="footer__layer footer__layer--mid" data-depth="0.13">
            <Illustration name={art.mid} draw />
          </div>
          <div class="footer__layer footer__layer--near" data-depth="-0.05">
            <Illustration name={art.near} />
          </div>
        </>
      )
    }
  </div>

  <p class="footer__legal" lang="el">{site.copyright}</p>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: var(--space-xl);
    padding-top: var(--space-l);
    overflow: clip;
  }
  .footer__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--space-l) clamp(1.75rem, 0.5rem + 4vw, 5rem);
    align-items: start;
  }
  .footer__brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .footer__logo {
    width: clamp(2.75rem, 2.4rem + 1.2vw, 3.75rem);
    height: auto;
  }
  .footer__name {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-2);
    letter-spacing: 0.05em;
    line-height: 1;
    color: var(--blue);
  }
  .footer__title {
    font-family: var(--font-hand);
    font-style: italic;
    font-size: var(--step-0);
    line-height: var(--hand-leading);
    color: var(--blue);
    margin-bottom: 0.7rem;
  }
  .footer__list {
    display: grid;
    gap: 0.3rem;
    font-size: var(--step--1);
    margin: 0;
    padding: 0;
    list-style: none;
    font-variant-numeric: lining-nums;
  }
  .footer__list a {
    text-decoration-color: transparent;
    overflow-wrap: anywhere;
  }
  .footer__list a:hover {
    text-decoration-color: currentColor;
  }
  /* The row of icons starts on the same left edge as its heading */
  .footer__col :global(.social) {
    justify-content: flex-start;
    margin-left: -0.3rem;
  }

  /* The landscape: no box, no border, drawn straight onto the page.
     The scene is exactly as wide as the drawing (never narrower than 64rem, so small screens
     see the middle of it) and its height follows that width, so the three layers keep their
     places in the picture at every size. Offsets are fractions of the scene height. */
  .footer__scene {
    position: relative;
    z-index: 1;
    left: 50%;
    width: max(100%, 64rem);
    margin-left: calc(max(100%, 64rem) / -2);
    aspect-ratio: 1600 / 525;
    pointer-events: none;
  }
  .footer__layer {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    color: var(--blue);
  }
  .footer__layer--far {
    bottom: 16%;
  }
  .footer__layer--mid {
    bottom: 2.7%;
  }
  .footer__layer--near {
    bottom: -1px;
  }
  /* The drawn layers hide one another with flat paper-coloured fills. The page grain is laid
     back over the whole picture (on a flat ground, so the sky is not grained twice), which
     keeps land and sky the same sheet of paper. */
  .footer__scene--drawn::before,
  .footer__scene--drawn::after {
    content: '';
    position: absolute;
    inset: -6rem 0 0;
  }
  .footer__scene--drawn::before {
    z-index: -1;
    background-color: var(--paper);
  }
  .footer__scene--drawn::after {
    background-image: var(--grain);
    background-size: 400px 400px;
  }
  .footer__layer--custom :global(img) {
    width: 100%;
    height: auto;
  }

  /* The page ends on a low band of ink: the ground of the drawing and a slim strip under it.
     The copyright line is centred on that band. */
  .footer {
    padding-bottom: 1rem;
    background: linear-gradient(to top, var(--footer-ground, var(--blue)) 1.05rem, transparent 1.05rem);
  }
  .footer__legal {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(var(--footer-band) / 2 - 0.62em);
    z-index: 3;
    margin: 0;
    padding: 0 var(--gutter);
    text-align: center;
    font-size: var(--step--1);
    line-height: 1.24;
    letter-spacing: 0.08em;
    color: var(--creme-light);
  }
  .footer--aegean {
    --footer-ground: var(--blue-deep);
  }

  @media (max-width: 60rem) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 34rem) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
