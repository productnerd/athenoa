---
// The gate in front of the GitHub Pages preview (client request, 9 November 2026). Base.astro shows it
// only when the build has PUBLIC_PREVIEW_GATE=on. It is the newsletter's portico (Portico.astro) over
// the blurred site: the inscription between the columns, one of Athena's lines to complete, and the
// answer in the podium. The answer is checked against hashes (src/data/gate.ts); a visitor who knew
// it hears a key turn and the door's bell, «Εἴσελθε» takes the place of the field, and the portico
// slowly fades as the site comes back into focus. They are then remembered in this browser ("ath-worthy"). A velvet rope, not a lock: the pages are public files.
import Portico from './Portico.astro';
import { gate } from '../data/gate';
import { getLocale } from '../lib/locale';

const locale = getLocale(Astro.url);
const w = gate.words[locale];
---

<div
  class="gate"
  id="gate"
  role="dialog"
  aria-modal="true"
  aria-labelledby="gate-inscription"
  data-hashes={gate.hashes.join(' ')}
  data-refusal={gate.refusal}
  data-welcome={gate.welcome}
>
  <div class="gate__veil" aria-hidden="true"></div>
  <div class="gate__popup">
    <Portico>
      <Fragment slot="head">
        <h2 class="gate__inscription t-3" id="gate-inscription" lang="grc">{gate.inscription}</h2>
        <p class="gate__quote hand">
          {w.before} <span class="gate__end"><span class="gate__blank" role="img" aria-label={w.blank}></span>{w.after}</span>
        </p>
      </Fragment>
      <Fragment slot="action">
        <form class="gate__form" id="gate-form" autocomplete="off">
          <!-- The field and the button, and in the same place the welcome that takes their place -->
          <div class="gate__door">
            <div class="gate__controls">
              <div class="field">
                <label class="visually-hidden" for="gate-answer">{w.blank}</label>
                <input
                  id="gate-answer"
                  name="answer"
                  type="text"
                  placeholder={w.placeholder}
                  autocapitalize="none"
                  autocorrect="off"
                  spellcheck="false"
                  enterkeyhint="go"
                />
              </div>
              <button class="btn" type="submit">{w.knock}</button>
            </div>
            <p class="gate__welcome t-3" id="gate-welcome" lang="grc" aria-live="polite"></p>
          </div>
          <!-- The longest refusal, invisible, holds the room it appears in, so nothing moves -->
          <p class="gate__verdict" lang="grc">
            <span class="gate__sizer" aria-hidden="true">{gate.refusal}</span>
            <span id="gate-verdict" aria-live="polite"></span>
          </p>
        </form>
      </Fragment>
    </Portico>
  </div>
</div>

<style>
  .gate {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    justify-content: safe center;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-block: max(0.5rem, env(safe-area-inset-top, 0px)) max(0.5rem, env(safe-area-inset-bottom, 0px));
    color: var(--ink);
  }
  :global(html.worthy) .gate {
    display: none;
  }
  /* The page behind stays put, and its own animations rest, while the gate stands: under a blur
     every moving thing would make the browser blur the page again on each frame. */
  :global(html.gate-up) {
    overflow: hidden;
  }
  /* (paused only once the page's own entrance has played, so the site behind is not caught half-drawn) */
  :global(html.gate-rest body > :not(.gate)),
  :global(html.gate-rest body > :not(.gate) *),
  :global(html.gate-rest body > :not(.gate) *::before),
  :global(html.gate-rest body > :not(.gate) *::after) {
    animation-play-state: paused !important;
  }
  /* The page behind, blurred under a thin wash of the darker blue, as behind the newsletter. The blur
     sits on its own layer and only ever fades out, once. */
  .gate__veil {
    position: fixed;
    inset: 0;
    background: color-mix(in srgb, var(--blue-deep) 36%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  /* Sized as the newsletter popup */
  .gate__popup {
    --portico-edge: 0.375rem;
    position: relative;
    flex: none;
    width: min(100% - 0.5rem, 26rem);
    margin-inline: auto;
    padding: 0.25rem 0.25rem 0.6rem;
  }
  @media (min-width: 36rem) {
    .gate__popup {
      --portico-edge: 0.6rem;
      width: min(100% - 0.5rem, 43rem, max(34rem, 214dvh - 58rem));
      padding: 0.5rem 0.5rem 1.1rem;
    }
  }

  .gate__inscription {
    margin: 0;
    font-size: calc(var(--step-2) * 0.82);
    letter-spacing: 0.1em;
    padding-left: 0.1em;
    line-height: 1.12;
    text-wrap: balance;
  }
  .gate__quote {
    margin: 0;
    font-size: calc(var(--step-1) * 1.3);
    line-height: 1.3;
    text-wrap: balance;
  }
  /* the blank and the closing marks never part */
  .gate__end {
    white-space: nowrap;
  }
  .gate__blank {
    display: inline-block;
    width: 3.4em;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-0.15em);
  }
  .gate__form {
    display: grid;
    gap: 0.85rem;
  }
  .gate__form input {
    text-align: center;
  }
  /* The controls and the welcome share one cell: the welcome fades in where they were */
  .gate__door {
    display: grid;
  }
  .gate__door > * {
    grid-area: 1 / 1;
  }
  .gate__controls {
    display: grid;
    gap: 0.85rem;
  }
  .gate__welcome {
    margin: 0;
    align-self: center;
    justify-self: center;
    font-size: calc(var(--step-2) * 0.9);
    letter-spacing: 0.04em;
    color: var(--ink-strong);
    opacity: 0;
    pointer-events: none;
  }
  .gate__form.is-welcome .gate__controls {
    opacity: 0;
    visibility: hidden;
  }
  .gate__form.is-welcome .gate__welcome {
    opacity: 1;
  }
  :global(html.motion) .gate__controls {
    transition:
      opacity 0.45s var(--ease-soft),
      visibility 0s 0.45s;
  }
  :global(html.motion) .gate__welcome {
    transition: opacity 1.1s var(--ease-soft) 0.3s;
  }
  .gate__verdict {
    margin: 0;
    display: grid;
    text-align: center;
    font-size: var(--step-0);
    color: var(--ink-strong);
  }
  .gate__verdict > span {
    grid-area: 1 / 1;
  }
  .gate__sizer {
    visibility: hidden;
  }

  /* Knock, knock, knock: three small jolts of the portico, in time with the three knocks (at 0, 0.28
     and 0.56 seconds). Only the portico moves; the blurred page behind stays still. */
  :global(html.motion) .gate__popup.is-knocking {
    animation: gate-knock 0.84s linear;
  }
  @keyframes gate-knock {
    0%, 12%, 33%, 45%, 67%, 79%, 100% { transform: none; }
    3%, 36%, 70% { transform: translate3d(0, 2px, 0) scale(0.996); }
  }
  /* A wrong answer: the portico shakes its head */
  :global(html.motion) .gate__popup.is-refused {
    animation: gate-refuse 0.5s var(--ease-out);
  }
  @keyframes gate-refuse {
    20% { transform: translateX(-0.55rem); }
    40% { transform: translateX(0.45rem); }
    60% { transform: translateX(-0.3rem); }
    80% { transform: translateX(0.15rem); }
  }
  /* The right one: after a moment with the welcome, the portico slowly goes, and the site slowly comes back into focus */
  :global(html.motion) .gate.is-leaving .gate__popup {
    opacity: 0;
    transform: translate3d(0, -1.25rem, 0) scale(0.985);
    transition:
      opacity 2.6s var(--ease-in-out),
      transform 3s var(--ease-out);
  }
  :global(html.motion) .gate.is-leaving .gate__veil {
    opacity: 0;
    transition: opacity 3.4s var(--ease-in-out) 0.4s;
  }
</style>

<script>
  // Runs once, on the first page loaded. Later pages are reached through the site's own links, which
  // a visitor can only use once past the gate; html.worthy (set in Base.astro) then hides it.
  import { soundContext } from '../scripts/sound';
  import { knock, unlock, doorBell } from '../scripts/gate-sounds';

  const KEY = 'ath-worthy';
  const root = document.documentElement;
  const gate = document.getElementById('gate');
  const worthy = () => {
    try {
      return localStorage.getItem(KEY) === '1';
    } catch {
      return false;
    }
  };

  if (gate && !worthy()) {
    const popup = gate.querySelector<HTMLElement>('.gate__popup')!;
    const form = gate.querySelector<HTMLFormElement>('#gate-form')!;
    const input = gate.querySelector<HTMLInputElement>('#gate-answer')!;
    const verdict = gate.querySelector<HTMLElement>('#gate-verdict')!;
    const hashes = (gate.dataset.hashes || '').split(' ');
    const behind = [...document.body.children].filter((el) => el !== gate && el.tagName !== 'SCRIPT') as HTMLElement[];

    behind.forEach((el) => (el.inert = true));
    root.classList.add('gate-up');
    const rest = setTimeout(() => root.classList.add('gate-rest'), 3500);
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) input.focus({ preventScroll: true });

    const norm = (s: string) =>
      s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/ς/g, 'σ').replace(/[^a-zα-ω]/g, '');
    const digest = async (s: string) => {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode('athenoa:' + s));
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
    };

    const pass = () => {
      try {
        localStorage.setItem(KEY, '1');
      } catch {}
      // The field and the button fade, and «Εἴσελθε» fades in in their place
      verdict.textContent = '';
      input.disabled = true;
      form.querySelector('#gate-welcome')!.textContent = gate.dataset.welcome || '';
      form.classList.add('is-welcome');
      // The key turns in the lock, and the door's bell rings
      soundContext().then((ctx) => {
        if (!ctx) return;
        unlock(ctx, 0, 0.16);
        doorBell(ctx, 0.75, 0.14);
      });
      const motion = root.classList.contains('motion');
      // A moment to read the welcome, then the slow leaving (about four seconds), then the site is free
      setTimeout(
        () => {
          clearTimeout(rest);
          root.classList.remove('gate-up', 'gate-rest');
          behind.forEach((el) => (el.inert = false));
          gate.classList.add('is-leaving');
          setTimeout(() => root.classList.add('worthy'), motion ? 3900 : 0);
        },
        motion ? 1700 : 1200,
      );
    };

    // Knock: three knocks and three jolts of the portico, then the answer from within
    let knocking = false;
    const replay = (name: string) => {
      popup.classList.remove('is-knocking', 'is-refused');
      void popup.offsetWidth;
      popup.classList.add(name);
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (input.disabled || knocking) return;
      const answer = norm(input.value);
      if (!answer) return input.focus();
      knocking = true;
      verdict.textContent = '';
      const right = digest(answer).then((h) => hashes.includes(h));
      soundContext().then((ctx) => {
        if (ctx) [0, 0.28, 0.56].forEach((at) => knock(ctx, at, 0.2));
      });
      replay('is-knocking');
      const isRight = await right;
      setTimeout(() => {
        knocking = false;
        if (isRight) return pass();
        verdict.textContent = gate.dataset.refusal || '';
        replay('is-refused');
        input.select();
      }, 1000);
    });
  }
</script>
