---
// Monochrome social marks in a plain row: no circles, no boxes. They take the current ink colour.
import { content } from '../data';
import { getLocale } from '../lib/locale';
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { site, ui } = content(getLocale(Astro.url));
const icons: Record<string, string> = {
  facebook:
    'M14.2 21.5v-7.9h2.7l.4-3.3h-3.1V8.2c0-1 .3-1.6 1.7-1.6h1.5V3.7c-.3 0-1.2-.2-2.3-.2-2.4 0-4 1.5-4 4.1v2.7H8.4v3.3h2.7v7.9h3.1z',
  instagram:
    'M12 7.3a4.7 4.7 0 1 0 0 9.4 4.7 4.7 0 0 0 0-9.4zm0 7.7a3 3 0 1 1 0-6 3 3 0 0 1 0 6zm6-7.9a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0zM16.4 3H7.6A4.6 4.6 0 0 0 3 7.6v8.8A4.6 4.6 0 0 0 7.6 21h8.8a4.6 4.6 0 0 0 4.6-4.6V7.6A4.6 4.6 0 0 0 16.4 3zm2.9 13.4a2.9 2.9 0 0 1-2.9 2.9H7.6a2.9 2.9 0 0 1-2.9-2.9V7.6a2.9 2.9 0 0 1 2.9-2.9h8.8a2.9 2.9 0 0 1 2.9 2.9v8.8z',
  youtube:
    'M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z',
};
---

<ul class:list={['social', className]}>
  {
    site.social.map((item, i) => (
      <li style={`--i:${i}`}>
        <a href={item.url} rel="me noopener" target="_blank" aria-label={ui.socialOn(item.name)}>
          <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false">
            <path d={icons[item.id]} fill="currentColor" />
          </svg>
        </a>
      </li>
    ))
  }
</ul>

<style>
  /* A straight, even row: no tilt, no offsets */
  .social {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 0.7rem + 0.8vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social a {
    display: block;
    padding: 0.3rem;
    color: var(--ink-strong);
    transition:
      color var(--dur-1),
      opacity var(--dur-1);
  }
  .social a:hover {
    opacity: 0.68;
  }
  .social svg {
    display: block;
    width: 1.6rem;
    height: 1.6rem;
  }
</style>
