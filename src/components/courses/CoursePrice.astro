---
// The tuition line: label and amount exactly as written in the data.
import type { Course } from '../../data/courses';

interface Props {
  price: NonNullable<Course['price']>;
  class?: string;
  [key: string]: unknown;
}
const { price, class: className, ...rest } = Astro.props;
// "€200 & VAT (24%)": the amount stands out, the tax note sits smaller beside it.
const cut = price.display.indexOf(' ');
const amount = cut < 0 ? price.display : price.display.slice(0, cut);
const tax = cut < 0 ? '' : price.display.slice(cut + 1);
---

<p class:list={['price', className]} {...rest}>
  <span class="price__label">{price.label}</span>
  <span class="price__amount">{amount}</span>
  {tax && <span class="price__tax">{tax}</span>}
</p>

<style>
  .price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.15em 0.6em;
  }
  .price__label {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .price__amount {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--price-size, var(--step-2));
    line-height: 1;
    letter-spacing: var(--title-tracking);
    font-variant-numeric: lining-nums;
    color: var(--ink-strong);
  }
  .price__tax {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
</style>
