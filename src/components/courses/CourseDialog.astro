---
// The course popup: a native <dialog>, one per course, rendered in the page so its content is in the HTML.
// A card link with data-course-open="<slug>" opens it; so does arriving at /courses/#<slug>.
import Illustration from '../Illustration.astro';
import CourseBody from './CourseBody.astro';
import CoursePrice from './CoursePrice.astro';
import EnrollFlow from './EnrollFlow.astro';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';

interface Props {
  course: Course;
}
const { course } = Astro.props;
const { ui } = content(getLocale(Astro.url)).coursesPage;
const titleId = `course-title-${course.slug}`;
const canEnrol = course.status === 'open' && course.price;
---

<dialog class:list={['cd', canEnrol && 'cd--full']} data-course-dialog={course.slug} aria-labelledby={titleId}>
  <div class="cd__sheet">
    <button class="cd__close" type="button" data-course-close>
      <span>{ui.close}</span>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <path d="M5 5.4c4.6 4.2 9 8.800 14 13.400M19 5c-4.400 4.800-9.200 9-13.800 14"></path>
      </svg>
    </button>

    <div class="cd__scroll" data-course-scroll>
      <CourseBody course={course} variant="dialog" titleId={titleId} />
    </div>

    {
      canEnrol && (
        <div class="cd__foot on-blue-deep" data-course-foot>
          <CoursePrice class="cd__price" price={course.price!} />
          <EnrollFlow course={course} id={`enroll-${course.slug}`} />
          <Illustration name="torch" class="cd__mark" />
        </div>
      )
    }
  </div>
</dialog>

<script>
  const motionOn = () => document.documentElement.classList.contains('motion');
  const find = (slug: string) =>
    slug ? document.querySelector<HTMLDialogElement>(`dialog[data-course-dialog="${CSS.escape(slug)}"]`) : null;
  const hashSlug = () => decodeURIComponent(location.hash.slice(1));
  // replaceState keeps Astro's router state and adds no history entry.
  const setHash = (slug: string) =>
    history.replaceState(history.state, '', slug ? `#${slug}` : location.pathname + location.search);

  function open(dialog: HTMLDialogElement) {
    if (dialog.open) return;
    dialog.classList.remove('is-closing');
    dialog.showModal();
    setHash(dialog.dataset.courseDialog!);
  }

  // Plays the closing transition, then closes for real.
  function close(dialog: HTMLDialogElement) {
    if (!dialog.open || dialog.classList.contains('is-closing')) return;
    if (!motionOn()) return dialog.close();
    const finish = () => {
      clearTimeout(timer);
      dialog.removeEventListener('transitionend', onEnd);
      dialog.close();
    };
    const onEnd = (event: TransitionEvent) => {
      if (event.target === dialog && event.propertyName === 'opacity') finish();
    };
    const timer = setTimeout(finish, 500);
    dialog.addEventListener('transitionend', onEnd);
    dialog.classList.add('is-closing');
  }

  function bind(dialog: HTMLDialogElement) {
    const slug = dialog.dataset.courseDialog!;

    dialog.querySelector('[data-course-close]')?.addEventListener('click', () => close(dialog));

    // Escape
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      close(dialog);
    });

    // A click on the backdrop lands on the dialog element itself. The press must start there too,
    // so dragging a text selection out of a field does not close the popup.
    let pressedBackdrop = false;
    dialog.addEventListener('pointerdown', (event) => (pressedBackdrop = event.target === dialog));
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog && pressedBackdrop) close(dialog);
    });

    // The enrol flow reports its step: the sheet swaps between course information and enrolment.
    dialog.addEventListener('enroll:step', (event) => {
      const enrolling = (event as CustomEvent<string>).detail !== 'idle';
      dialog.toggleAttribute('data-enrolling', enrolling);
      dialog.querySelector('[data-course-foot]')?.scrollTo(0, 0);
    });

    dialog.addEventListener('close', () => {
      dialog.classList.remove('is-closing');
      dialog.querySelector('[data-enroll]')?.dispatchEvent(new CustomEvent('enroll:reset'));
      dialog.querySelector('[data-course-scroll]')?.scrollTo(0, 0);
      if (hashSlug() === slug) setHash('');
      // Back to the card that leads here (Safari does not restore focus to a clicked link by itself).
      document.querySelector<HTMLElement>(`a[data-course-open="${CSS.escape(slug)}"]:not([tabindex="-1"])`)?.focus();
    });
  }

  document.addEventListener('astro:page-load', () => {
    const dialogs = document.querySelectorAll<HTMLDialogElement>('dialog[data-course-dialog]');
    if (!dialogs.length) return;

    dialogs.forEach((dialog) => {
      if (dialog.hasAttribute('data-ready')) return;
      dialog.setAttribute('data-ready', '');
      bind(dialog);
    });

    // Card links are real links to the course page; here they open the popup instead.
    document.querySelectorAll<HTMLAnchorElement>('a[data-course-open]:not([data-ready])').forEach((link) => {
      const dialog = find(link.dataset.courseOpen!);
      if (!dialog) return;
      link.setAttribute('data-ready', '');
      link.addEventListener('click', (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        open(dialog);
      });
    });

    // Arriving at /courses/#<slug>
    const wanted = find(hashSlug());
    if (wanted) open(wanted);
  });

  // The hash changing while the page is open (a pasted address, a link from the footer)
  window.addEventListener('hashchange', () => {
    const wanted = find(hashSlug());
    document.querySelectorAll<HTMLDialogElement>('dialog[data-course-dialog][open]').forEach((dialog) => {
      if (dialog !== wanted) close(dialog);
    });
    if (wanted) open(wanted);
  });
</script>

<style>
  .cd {
    --cd-max: calc(100dvh - 1.5rem);
    width: min(100% - 1rem, 62rem);
    max-width: none;
    max-height: var(--cd-max);
    margin: auto;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    overflow: visible;
  }
  .cd::backdrop {
    background: color-mix(in srgb, var(--blue-deep, #071260) 62%, transparent);
  }
  /* The page behind stays put while a popup is open */
  :global(html:has(dialog.cd[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  /* The sheet: rough-cut paper. Colour and edge live on ::before so the text is never distorted. */
  .cd__sheet {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    max-height: var(--cd-max);
    border-radius: 2.2rem 2.8rem 2.4rem 3rem / 2.8rem 2.2rem 3rem 2.4rem;
  }
  .cd--full .cd__sheet {
    height: min(var(--cd-max), 54rem);
  }
  .cd__sheet::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--creme);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough);
  }

  .cd__scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4rem clamp(1.1rem, 0.4rem + 3.4vw, 3rem) clamp(1.5rem, 1rem + 2vw, 2.5rem);
    border-radius: inherit;
  }

  .cd__close {
    position: absolute;
    top: 0.8rem;
    right: 0.9rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 1rem 0.45rem 1.15rem;
    border: 1.5px solid color-mix(in srgb, var(--blue) 28%, transparent);
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    background: var(--creme-light);
    color: var(--blue);
    font-size: var(--step--1);
    font-weight: 560;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--hover-delay),
      color var(--dur-1) var(--hover-delay);
  }
  .cd__close:hover {
    background: var(--blue);
    color: var(--creme-light);
  }
  .cd__close:focus-visible {
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    outline-offset: 3px;
  }
  .cd[data-enrolling] .cd__close:focus-visible {
    outline-color: var(--creme-light);
  }
  .cd__close path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
  }

  /* The foot: a darker blue cut-out along the bottom of the sheet holding the fee and the way in.
     During enrolment it grows to fill the sheet. */
  .cd__foot {
    position: relative;
    isolation: isolate;
    flex: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    margin: 0 0.55rem 0.55rem;
    padding: 1rem clamp(1.1rem, 0.4rem + 3vw, 2.4rem) 1.1rem;
    border-radius: 1.7rem 2rem 1.9rem 2.5rem / 1.9rem 1.6rem 2.5rem 1.9rem;
  }
  .cd__foot::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--paper);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
  .cd__mark {
    display: none;
  }

  .cd[data-enrolling] .cd__scroll,
  .cd[data-enrolling] .cd__price {
    display: none;
  }
  .cd[data-enrolling] .cd__foot {
    flex: 1 1 auto;
    display: block;
    min-height: 0;
    margin: 0.55rem;
    padding: 4.25rem clamp(1.1rem, 0.4rem + 3.6vw, 3.25rem) 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border-radius: 1.9rem 2.5rem 2.1rem 2.7rem / 2.5rem 1.9rem 2.7rem 2.1rem;
  }
  /* The torch stands in the lower corner of the enrolment sheet, in line with the edge of the form,
     drawn in the lighter blue. Only where the sheet is tall enough for it to clear the form. */
  @media (min-width: 52rem) and (min-height: 46rem) {
    .cd[data-enrolling] .cd__mark {
      display: block;
      position: absolute;
      right: clamp(1.1rem, 0.4rem + 3.6vw, 3.25rem);
      bottom: 2rem;
      width: clamp(6.5rem, 10vw, 9rem);
      color: var(--blue-light);
      opacity: 0.8;
      pointer-events: none;
    }
  }

  /* ---------- Open and close ---------- */
  .cd[open] {
    display: block;
  }
  :global(html.motion) .cd[open] {
    transition:
      opacity var(--dur-1) var(--ease-soft),
      transform var(--dur-2) var(--ease-out);
    will-change: transform, opacity;
  }
  :global(html.motion) .cd[open]::backdrop {
    transition: opacity var(--dur-2) var(--ease-soft);
  }
  @starting-style {
    :global(html.motion) .cd[open] {
      opacity: 0;
      transform: translate3d(0, 1.75rem, 0) scale(0.955);
    }
    :global(html.motion) .cd[open]::backdrop {
      opacity: 0;
    }
  }
  :global(html.motion) .cd.is-closing {
    opacity: 0;
    transform: translate3d(0, 0.9rem, 0) scale(0.975);
    transition-duration: 0.26s;
    transition-timing-function: var(--ease-in-out);
  }
  :global(html.motion) .cd.is-closing::backdrop {
    opacity: 0;
    transition-duration: 0.26s;
  }

  @media (max-width: 30rem) {
    .cd {
      --cd-max: calc(100dvh - 1rem);
    }
    .cd__sheet {
      border-radius: 1.7rem 2.1rem 1.8rem 2.2rem / 2.1rem 1.7rem 2.2rem 1.8rem;
    }
  }
</style>
