---
// One course, drawn the same way wherever a course appears (the courses page and the home page).
// Three cuts, one for each ground:
//   lead   a large Greek blue cut-out, the artwork breaking out of its top edge
//   arch   an arch cut from light blue, the picture set into it like a window
//   paper  the picture straight on the page with a darker blue pebble behind it, the words on a paper label over its corner
// The action is a real link to the course page; CourseDialog upgrades it to open the popup.
// A course that cannot be enrolled in yet also gets "Join waitlist": the filled button stands where
// "Enroll" would, and "View course" stays beside it as the quiet link (WaitlistDialog opens the popup).
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';
import { courseFocus, courseImage } from './media';
import { keepHyphens } from './text';

interface Props {
  course: Course;
  cut: 'lead' | 'arch' | 'paper';
  /** Heading level of the title: 2 on the courses page, 3 where the card sits under a section heading. */
  level?: 2 | 3;
}
const { course, cut, level = 2 } = Astro.props;
const Title = level === 3 ? 'h3' : 'h2';
const { coursesPage, coursePageHref, site } = content(getLocale(Astro.url));
const { ui } = coursesPage;
const image = courseImage(course.image);
const href = coursePageHref(course.slug);
const titleId = `card-title-${course.slug}`;
const actionId = `card-action-${course.slug}`;
const waitId = `card-waitlist-${course.slug}`;
const lead = cut === 'lead';
// The same four facts on every card, in the same order, so cards can be compared at a glance.
const facts = [
  { label: ui.facts.dates, value: course.schedule },
  { label: ui.facts.duration, value: course.duration },
  { label: ui.facts.format, value: course.format },
  { label: ui.facts.fee, value: course.price?.display, fee: true },
].filter((fact) => fact.value);
// "€200 & VAT (24%)": the amount stands out, the tax note sits smaller beside it.
const splitFee = (display: string) => {
  const at = display.indexOf(' ');
  return at < 0 ? [display, ''] : [display.slice(0, at), display.slice(at + 1)];
};
---

<article
  class:list={[
    'card',
    `card--${cut}`,
    lead && 'panel panel--big on-blue',
    cut === 'arch' && 'panel panel--arch on-blue-light',
  ]}
  id={course.slug}
>
  {
    lead && (
      <div class="panel__clip card__clip">
        <Illustration name="sun-rays" class="card__rays" draw data-depth="0.22" />
      </div>
    )
  }

  <div class="card__figure">
    {/* The pebble swells in once the picture in front of it has faded up, so it never shows through */}
    {cut === 'paper' && <span class="card__pebble" data-reveal="grow" style="--delay:450ms" />}
    <Media
      class="card__media"
      src={image}
      alt={course.imageAlt}
      shape="arch"
      ratio={lead ? '16 / 9' : '10 / 9'}
      focus={courseFocus(course.image)}
      sizes={lead ? '(min-width: 62rem) 52vw, 92vw' : '(min-width: 48rem) 46vw, 92vw'}
      priority={lead}
      data-depth={lead ? '-0.05' : undefined}
    />
    {/* The picture is a second way in for a pointer; keyboard and screen readers use the one named link below. */}
    <a class="card__cover" href={href} data-course-open={course.slug} tabindex="-1" aria-hidden="true"></a>
  </div>

  <div class:list={['card__text', cut === 'paper' && 'box box--offset']} data-reveal-group>
    <div class="card__head">
      <Title class:list={['card__title', lead ? 't-2' : 't-3']} id={titleId} set:html={keepHyphens(course.title)} />
      {course.subtitle && <p class="card__subtitle" set:html={keepHyphens(course.subtitle)} />}
    </div>
    {course.summary && <p class="card__summary">{course.summary}</p>}
    <dl class="card__facts">
      {
        facts.map((fact) => (
          <div class="card__fact">
            <dt>{fact.label}</dt>
            {fact.fee ? (
              <dd class="card__fee">
                <span class="card__amount">{splitFee(fact.value!)[0]}</span>
                <span class="card__tax">{splitFee(fact.value!)[1]}</span>
              </dd>
            ) : (
              <dd>{fact.value}</dd>
            )}
          </div>
        ))
      }
    </dl>
    <p class="card__go">
      {
        !course.available && (
          <a
            class="btn"
            href={site.routes.contact}
            id={waitId}
            aria-labelledby={`${waitId} ${titleId}`}
            aria-haspopup="dialog"
            data-waitlist-open
            data-waitlist-course={course.title}
          >
            {ui.joinWaitlist}
          </a>
        )
      }
      <a
        class:list={['btn', !course.available && 'btn--quiet']}
        href={href}
        id={actionId}
        aria-labelledby={`${actionId} ${titleId}`}
        data-course-open={course.slug}
      >
        {course.available ? ui.enrollNow : ui.viewCourse}
      </a>
    </p>
  </div>
</article>

<style>
  .card {
    position: relative;
  }
  .card__figure {
    position: relative;
    isolation: isolate;
  }
  /* --arch is the outline of the picture; the link laid over it follows the same curve.
     --pad is the margin around the picture and --foot the space under the action. Both are shared by the
     arch and the paper cut, so their pictures come out the same size and their last lines level. */
  .card {
    --arch: var(--r-arch);
    --pad: clamp(0.7rem, 0.5rem + 0.8vw, 1rem);
    --foot: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
  }
  .card__media {
    --media-r: var(--arch);
  }
  .card__cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--arch);
  }
  .card :global(.media__clip img) {
    transition: scale var(--dur-3) var(--ease-out) var(--hover-delay);
  }
  .card__figure:hover :global(.media__clip img) {
    scale: 1.035;
  }
  .card__text > :global(* + *) {
    margin-top: var(--space-s);
  }
  /* One action, or two for a course with a waitlist: side by side where there is room, else stacked */
  .card__go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 1.5rem;
    padding-top: 0.35rem;
  }
  /* A long label (Greek) may run to two lines in a narrow card */
  .card__go .btn {
    text-align: center;
  }

  /* ---------- lead ---------- */
  /* A lunette: the banner is wide and lettered, so its arch is low and the full artwork shows */
  .card--lead {
    --arch: 50% 50% 1.8rem 2.2rem / 60% 60% 1.7rem 2rem;
    --rise: clamp(2.75rem, 1.5rem + 5vw, 5.5rem);
    display: flow-root;
    margin-top: var(--rise);
    padding-top: 0;
    padding-bottom: var(--space-l);
  }
  .card--lead .card__figure {
    margin: calc(var(--rise) * -1) -0.35rem var(--space-m);
  }
  /* Rays behind the picture in the lighter blue, cut to the panel.
     Centred with margins: parallax owns `translate` here. */
  .card__rays {
    --rays: 100%;
    position: absolute;
    left: 50%;
    top: 1.25rem;
    width: var(--rays);
    margin: calc(var(--rays) / -2) 0 0 calc(var(--rays) / -2);
    color: var(--blue-light);
    opacity: 0.5;
  }
  .card__head {
    display: grid;
    gap: 0.3rem;
  }
  .card__subtitle {
    font-family: var(--font-title);
    font-size: var(--step-1);
    line-height: 1.15;
    color: var(--ink-soft);
  }
  .card__summary {
    max-width: 44ch;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  /* The facts: a small ruled table, the same on every card */
  .card__facts {
    display: grid;
    margin: var(--space-s) 0 0;
    border-top: 1.5px solid var(--line);
  }
  .card__fact {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.42rem 0 0.46rem;
    border-bottom: 1.5px solid var(--line);
  }
  .card__fact dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .card__fact dd {
    margin: 0;
    font-variant-numeric: lining-nums;
  }
  .card__fee {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45em;
  }
  .card__amount {
    font-family: var(--font-title);
    font-size: var(--step-1);
    line-height: 1;
  }
  .card__tax {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  @media (min-width: 62rem) {
    /* Picture, facts and action down the left; title down the right, the summary beside the facts */
    .card--lead {
      display: grid;
      grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr);
      grid-template-areas:
        'figure title'
        'facts summary'
        'go summary';
      grid-template-rows: auto auto 1fr;
      column-gap: clamp(2rem, 4vw, 4.5rem);
      align-items: start;
    }
    .card--lead .card__text {
      display: contents;
    }
    .card--lead .card__figure {
      grid-area: figure;
      margin: calc(var(--rise) * -1) 0 var(--space-m) calc(clamp(1.25rem, 0.4rem + 4.6vw, 5.5rem) * -1 - 1rem);
    }
    .card--lead .card__head {
      grid-area: title;
      padding-top: var(--space-l);
    }
    .card--lead .card__subtitle {
      font-size: var(--step-2);
      color: var(--sub-ink);
    }
    /* Greek is set in the fallback face, which runs wider than the title face. Beside the picture it goes
       a step smaller, so the long compound in the title stays whole instead of breaking at its hyphen. */
    .card--lead .card__title:lang(el) {
      font-size: calc(clamp(2.5rem, 1.8rem + 3.4vw, 4.9rem) * 0.8);
    }
    .card--lead .card__summary {
      grid-area: summary;
    }
    .card--lead .card__facts {
      grid-area: facts;
    }
    /* Under the facts, starting on the same left edge */
    .card--lead .card__go {
      grid-area: go;
      margin-top: var(--space-m);
    }
    .card__rays {
      --rays: 50rem;
      left: 29%;
      top: 24%;
    }
    /* The rays fade out above the season and the fee, which stand over the action at the foot of the panel */
    .card__clip {
      mask-image: linear-gradient(to bottom, #000 calc(100% - 21.5rem), transparent calc(100% - 16rem));
    }
  }

  /* ---------- arch ---------- */
  .card--arch {
    padding: var(--pad) var(--pad) var(--foot);
  }
  .card--arch .card__figure {
    margin-bottom: var(--space-m);
  }
  .card--arch .card__text {
    padding-inline: clamp(0.6rem, 0.3rem + 1.2vw, 1.25rem);
  }

  /* ---------- paper ---------- */
  /* The picture stands where it would inside an arch cut-out, so the two cuts line up side by side */
  .card--paper .card__figure {
    margin: var(--pad) var(--pad) 0;
  }
  /* A darker blue pebble behind the shoulder of the arch */
  .card__pebble {
    position: absolute;
    z-index: -1;
    /* It reaches into the page gutter, never past the edge of the screen */
    left: max(-5%, -1.4rem);
    top: 0;
    width: 38%;
    aspect-ratio: 1;
    border-radius: var(--r-pebble-1);
    background-color: var(--blue-deep);
    background-image: url('/textures/grain-light.webp');
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
  .card--paper .card__text {
    width: min(100% - 1.5rem, 26rem);
    padding-inline: clamp(1.4rem, 1rem + 1.6vw, 2.2rem);
    padding-bottom: var(--foot);
    margin: -2.25rem 0 0 auto;
    z-index: 3;
    --box-r: var(--r-soft-2);
  }

  /* Side by side, the cards share the height of their row. The picture keeps its frame, the same in every
     card; the words take up the difference, so the facts and the action stand at the foot of each card. */
  @media (min-width: 48rem) {
    :is(.card--arch, .card--paper),
    :is(.card--arch, .card--paper) .card__text {
      display: flex;
      flex-direction: column;
    }
    :is(.card--arch, .card--paper) .card__text {
      flex: 1 0 auto;
    }
    /* The slack goes under the last lines before the facts: the summary, or the title when there is none */
    :is(.card--arch, .card--paper) .card__text > :nth-last-child(3) {
      flex-grow: 1;
    }
    /* With a card beside it there is room for the label to hang out over the left edge of the picture.
       It laps over the foot of the picture by the same share at every width. */
    .card--paper .card__text {
      margin: clamp(-5.5rem, -6vw, -2.25rem) 0 0 -1.25rem;
    }
  }
</style>
