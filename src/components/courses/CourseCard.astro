---
// One course, drawn the same way wherever a course appears (the courses page and the home page):
// an arch cut from coloured paper, the picture set into it like a window, then the title, the same
// four facts and the actions.
//
// CLIENT DIRECTION, 11 October 2026: every course uses this one card, and what tells the courses
// apart is the colour of the paper. A course keeps its colour wherever it appears (its place in the
// course list decides it), so the colour works like a small brand of its own.
//
// The actions are real links to the course page; CourseDialog upgrades them to open the popup, and
// "Enroll" opens it at the request form. A course that cannot be enrolled in yet has "Join waitlist"
// in that place (WaitlistDialog opens that popup).
import Media from '../Media.astro';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale } from '../../lib/locale';
import { courseBanner, courseFocus, courseImage } from './media';
import { keepHyphens } from './text';

interface Props {
  course: Course;
  /** Heading level of the title: 2 on the courses page, 3 where the card sits under a section heading. */
  level?: 2 | 3;
  /** Load the picture at once (a card at the top of a page) */
  priority?: boolean;
}
const { course, level = 2, priority = false } = Astro.props;
const Title = level === 3 ? 'h3' : 'h2';
const { courses, coursesPage, coursePageHref, site } = content(getLocale(Astro.url));
const { ui } = coursesPage;
const image = courseImage(course.image);
const href = coursePageHref(course.slug);
const titleId = `card-title-${course.slug}`;
const actionId = `card-action-${course.slug}`;
const mainId = `card-main-${course.slug}`;
// The papers, in the order of the course list and then round again: Greek blue, light blue,
// darker paper, darker blue. The surface class turns the inks to suit.
const tones = [
  { name: 'blue', surface: 'on-blue' },
  { name: 'light', surface: 'on-blue-light' },
  { name: 'paper', surface: '' },
  { name: 'deep', surface: 'on-blue-deep' },
];
const place = courses.findIndex((item) => item.slug === course.slug);
const tone = tones[Math.max(0, place) % tones.length];
// The same four facts on every card, in the same order, so cards can be compared at a glance.
const facts = [
  { label: ui.facts.dates, value: course.schedule },
  { label: ui.facts.duration, value: course.duration },
  { label: ui.facts.format, value: course.format, aside: true },
  { label: ui.facts.fee, value: course.price?.display, fee: true },
].filter((fact) => fact.value);
// "€200 & VAT (24%)": the amount stands out, the tax note sits smaller beside it.
const splitFee = (display: string) => {
  const at = display.indexOf(' ');
  return at < 0 ? [display, ''] : [display.slice(0, at), display.slice(at + 1)];
};
---

<article
  class:list={[
    'card',
    `card--${tone.name}`,
    courseBanner(course.image) && 'card--banner',
    'panel panel--arch',
    tone.surface,
  ]}
  id={course.slug}
>
  <div class="card__figure">
    <Media
      class="card__media"
      src={image}
      alt={course.imageAlt}
      shape="arch"
      ratio="10 / 9"
      focus={courseFocus(course.image)}
      sizes="(min-width: 48rem) 46vw, 92vw"
      priority={priority}
    />
    {/* The picture is a second way in for a pointer; keyboard and screen readers use the named links below. */}
    <a class="card__cover" href={href} data-course-open={course.slug} tabindex="-1" aria-hidden="true"></a>
  </div>

  <div class="card__text" data-reveal-group>
    <div class="card__head">
      <Title class="card__title t-3" id={titleId} set:html={keepHyphens(course.title)} />
      {course.subtitle && <p class="card__subtitle" set:html={keepHyphens(course.subtitle)} />}
    </div>
    {course.summary && <p class="card__summary">{course.summary}</p>}
    <dl class="card__facts">
      {
        facts.map((fact) => (
          <div class="card__fact">
            <dt>{fact.label}</dt>
            {fact.fee ? (
              <dd class="card__fee">
                <span class="card__amount">{splitFee(fact.value!)[0]}</span>
                <span class="card__tax">{splitFee(fact.value!)[1]}</span>
              </dd>
            ) : fact.aside && fact.value!.includes(', ') ? (
              /* "Live on Zoom, with recordings": what follows the comma is a quieter line of its own */
              <dd>
                {fact.value!.slice(0, fact.value!.indexOf(', '))}
                <span class="card__aside">{fact.value!.slice(fact.value!.indexOf(', ') + 2)}</span>
              </dd>
            ) : (
              <dd>{fact.value}</dd>
            )}
          </div>
        ))
      }
    </dl>
    <p class="card__go">
      {
        course.available ? (
          <a
            class="btn"
            href={href}
            id={mainId}
            aria-labelledby={`${mainId} ${titleId}`}
            aria-haspopup="dialog"
            data-course-open={course.slug}
            data-course-enroll
          >
            {ui.enrollNow}
          </a>
        ) : (
          <a
            class="btn"
            href={site.routes.contact}
            id={mainId}
            aria-labelledby={`${mainId} ${titleId}`}
            aria-haspopup="dialog"
            data-waitlist-open
            data-waitlist-course={course.title}
          >
            {ui.joinWaitlist}
          </a>
        )
      }
      {/* "View course" is a small round plus (client direction, 12 October 2026); the words stay for screen readers */}
      <a
        class="card__more"
        href={href}
        id={actionId}
        aria-labelledby={`${actionId} ${titleId}`}
        title={ui.viewCourse}
        data-course-open={course.slug}
      >
        <span class="visually-hidden">{ui.viewCourse}</span>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M12 5.2c.2 4.4.1 9-.1 13.600M5.200 12.100c4.500-.3 9-.2 13.600.1" />
        </svg>
      </a>
    </p>
  </div>
</article>

<style>
  /* --arch is the outline of the picture; the link laid over it follows the same curve.
     --pad is the margin of coloured paper around the picture and --foot the space under the actions. */
  .card {
    --arch: var(--r-arch);
    --pad: clamp(0.7rem, 0.5rem + 0.8vw, 1rem);
    --foot: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    position: relative;
    padding: var(--pad) var(--pad) var(--foot);
  }
  /* The third paper is paper itself, a shade darker than the page it lies on */
  .card--paper {
    --paper: var(--creme-deep);
  }
  .card__figure {
    position: relative;
    isolation: isolate;
    margin-bottom: var(--space-m);
  }
  .card__media {
    --media-r: var(--arch);
  }
  .card__cover {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: var(--arch);
  }
  .card :global(.media__clip img) {
    transition: scale var(--dur-3) var(--ease-out) var(--hover-delay);
  }
  .card__figure:hover :global(.media__clip img) {
    scale: 1.035;
  }
  /* A lettered banner, wider than the frame: it is shown whole at the foot of the arch and its night
     sky is carried on above it, instead of being cropped through its words. */
  .card--banner :global(.media__clip) {
    background-color: #1a2334;
  }
  .card--banner :global(.media__clip img) {
    object-fit: contain;
    object-position: 50% 100%;
    mask-image: linear-gradient(to bottom, transparent 37%, #000 49%);
  }
  .card__text {
    padding-inline: clamp(0.6rem, 0.3rem + 1.2vw, 1.25rem);
  }
  .card__text > :global(* + *) {
    margin-top: var(--space-s);
  }
  /* Two actions: side by side where there is room, else stacked */
  .card__go {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.9rem;
    padding-top: 0.35rem;
  }
  .card__more {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.1rem;
    height: 3.1rem;
    border: 1.5px solid currentColor;
    border-radius: 54% 46% 52% 48% / 48% 54% 46% 52%;
    color: var(--ink-strong);
    transition:
      background-color var(--dur-1) var(--hover-delay),
      color var(--dur-1) var(--hover-delay),
      rotate var(--dur-2) var(--ease-out) var(--hover-delay);
  }
  .card__more path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
  }
  .card__more:hover {
    background-color: var(--ink-strong);
    color: var(--paper);
    rotate: 90deg;
  }
  /* A long label (Greek) may run to two lines in a narrow card */
  .card__go .btn {
    text-align: center;
  }
  .card__head {
    display: grid;
    gap: 0.3rem;
  }
  .card__subtitle {
    font-family: var(--font-title);
    font-size: var(--step-1);
    line-height: 1.15;
    color: var(--ink-soft);
  }
  .card__summary {
    max-width: 44ch;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  /* The facts: a small ruled table, the same on every card */
  .card__facts {
    display: grid;
    margin: var(--space-s) 0 0;
    border-top: 1.5px solid var(--line);
  }
  .card__fact {
    display: grid;
    grid-template-columns: 5.2rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.42rem 0 0.46rem;
    border-bottom: 1.5px solid var(--line);
  }
  .card__fact dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .card__fact dd {
    margin: 0;
    font-variant-numeric: lining-nums;
  }
  .card__aside {
    display: block;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .card__fee {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.45em;
  }
  .card__amount {
    font-family: var(--font-title);
    font-size: var(--step-1);
    line-height: 1;
  }
  .card__tax {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* Side by side, the cards share the height of their row. The picture keeps its frame, the same in every
     card; the words take up the difference, so the facts and the actions stand at the foot of each card. */
  @media (min-width: 48rem) {
    .card,
    .card__text {
      display: flex;
      flex-direction: column;
    }
    .card__text {
      flex: 1 0 auto;
    }
    /* The slack goes under the last lines before the facts: the summary, or the title when there is none */
    .card__text > :nth-last-child(3) {
      flex-grow: 1;
    }
  }
</style>
