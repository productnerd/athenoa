---
// A paper note laid over the edge of a picture, in the voice face: the season a course runs.
// ("Details to follow" is no longer one of these: CourseBody jots it on the page at an angle.)
// The caller positions it (it is absolutely placed). It sits straight.
interface Props {
  class?: string;
  [key: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<p class:list={['note', 'hand', 'hand--m', className]} {...rest}><slot /></p>

<style>
  .note {
    position: absolute;
    z-index: 3;
    isolation: isolate;
    padding: 0.4rem 1.2rem 0.6rem;
    color: var(--blue);
    white-space: nowrap;
    pointer-events: none;
  }
  .note::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--r-pebble-2);
    background-color: var(--creme-light);
    background-image: url('/textures/grain-dark.webp');
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
</style>
