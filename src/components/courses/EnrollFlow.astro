---
// Enrolment. Used inside the course popup and on the course page.
//
// CLIENT DIRECTION, 11 October 2026: "Enroll" opens a short form: name, email, why the course
// interests you, where you heard of the Academy.
// EXPERIMENT, 14 October 2026 (branch experiment/checkout): for a course with a fee, that form is now
// the first of two steps and the second is a card payment, as a Stripe checkout would take it, in
// TEST MODE ONLY. Nothing is charged, sent or kept: the card fields never leave the browser, accept
// only Stripe's published test cards, and are hidden from the browser's and password managers' card
// autofill, so that nobody's real card is offered. See STRIPE CONNECTS HERE for going live.
// A course without a fee keeps the request: "Send request", and a note that nothing was sent.
//
// Without JavaScript only the first button shows. It is a real link, to the contact form.
import { handCase } from '../../lib/hand';
import Illustration from '../Illustration.astro';
import SourceField from '../SourceField.astro';
import { content } from '../../data';
import type { Course } from '../../data/courses';
import { getLocale, mainLocale } from '../../lib/locale';
import { courseSymbol } from './media';
import { keepHyphens } from './text';

interface Props {
  course: Course;
  /** Unique prefix for field ids */
  id: string;
  class?: string;
  [key: string]: unknown;
}
const { course, id, class: className, ...rest } = Astro.props;
const locale = getLocale(Astro.url);
const { coursesPage, site } = content(locale);
const { ui } = coursesPage;
const c = ui.checkout;
// The sums the checkout shows: the fee, its VAT and the total, in the page's language
const price = course.price;
const money = (n: number) =>
  new Intl.NumberFormat(mainLocale(locale) === 'el' ? 'el-GR' : 'en-IE', { style: 'currency', currency: price?.currency ?? 'EUR' }).format(n);
const vat = price ? Math.round(price.amount * price.vatRate) / 100 : 0;
const total = price ? price.amount + vat : 0;
const [feeAmount, ...feeWords] = course.price?.display.split(' ') ?? [];
const feeRest = feeWords.join(' ');
// What the form says when a field is empty or wrong, in the language of the page
// (the browser's own messages follow the browser's language instead).
const t = {
  en: {
    nameMissing: 'Please enter your full name.',
    emailMissing: 'Please enter your email address.',
    emailInvalid: 'Please enter a valid email address.',
  },
  el: {
    nameMissing: 'Συμπληρώστε το ονοματεπώνυμό σας.',
    emailMissing: 'Συμπληρώστε τη διεύθυνση email σας.',
    emailInvalid: 'Συμπληρώστε μια έγκυρη διεύθυνση email.',
  },
}[mainLocale(locale)];
---

<div
  class:list={['enroll', className]}
  data-enroll
  data-step="idle"
  data-errors={price ? JSON.stringify(c.errors) : undefined}
  {...rest}
>
  <a class="btn enroll__start" href={site.routes.contact} data-enroll-start>{ui.enroll}</a>

  <div class="enroll__flow">
    <div class="enroll__grid">
      <div class="enroll__aside">
        <div class="enroll__ticket">
          <h3 class="enroll__ticket-title" id={`${id}-title`}>{ui.orderSummary}</h3>
          <p class="enroll__course" set:html={keepHyphens(course.title)} />
          <div class="enroll__stub">
            {course.schedule && <p class="hand hand--m">{handCase(course.schedule)}</p>}
            {/* The fee large, and what is added to it small under it ("€200" over "& VAT (24%)"):
                client direction, 14 October 2026. The amount is the first word of the display. */}
            {course.price && (
              <p class="enroll__amount">
                {feeAmount}
                {feeRest && <span class="enroll__vat">{feeRest}</span>}
              </p>
            )}
          </div>
          {
            price && (
              <dl class="enroll__sums">
                <div>
                  <dt>{c.fee}</dt>
                  <dd>{money(price.amount)}</dd>
                </div>
                <div>
                  <dt>
                    {c.vat} ({price.vatRate}%)
                  </dt>
                  <dd>{money(vat)}</dd>
                </div>
                <div class="enroll__total">
                  <dt>{c.total}</dt>
                  <dd>{money(total)}</dd>
                </div>
              </dl>
            )
          }
        </div>
        {/* The course's own symbol, under its summary (client direction, 11 October 2026) */}
        <Illustration name={courseSymbol(course.slug)} class="enroll__mark" />
      </div>

      <form class="enroll__panel" data-enroll-form aria-labelledby={`${id}-title`}>
        {price && <p class="enroll__step">1 / 2 · {c.stepDetails}</p>}
        <div class="field">
          <label for={`${id}-name`}>{ui.fullName}</label>
          <input
            id={`${id}-name`}
            name="name"
            type="text"
            autocomplete="name"
            required
            data-missing={t.nameMissing}
          />
        </div>
        <div class="field">
          <label for={`${id}-email`}>{ui.email}</label>
          <input
            id={`${id}-email`}
            name="email"
            type="email"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            required
            data-missing={t.emailMissing}
            data-mismatch={t.emailInvalid}
          />
        </div>
        <div class="field">
          <label for={`${id}-why`}>{ui.whyInterested}</label>
          <textarea id={`${id}-why`} name="why" rows="3"></textarea>
        </div>
        <div class="field">
          <label for={`${id}-source`}>{ui.heardFrom}</label>
          <SourceField id={`${id}-source`} label={ui.heardFrom} />
        </div>
        {/* No "Back": in the popup the cross closes it (client direction, 12 October 2026) */}
        <div class="enroll__actions">
          <button class="btn" type="submit">{price ? c.continue : ui.sendRequest}</button>
        </div>
        <p class="enroll__ask">
          {ui.waitlist.question}{' '}
          <a href={`mailto:${site.emails[0]}`}>{ui.contactInstead}</a>
        </p>
      </form>

      {
        price && (
          <form class="enroll__panel" data-enroll-pay-form novalidate aria-labelledby={`${id}-pay-title`}>
            <p class="enroll__step" id={`${id}-pay-title`}>
              2 / 2 · {c.stepPayment}
            </p>
            <p class="enroll__test">
              <strong>{c.testMode}</strong> {c.testHint}
            </p>
            {/* autocomplete="off" and the password-manager hints keep anyone's saved real card out of
                these fields: they are a test and must never hold one */}
            <div class="field">
              <label for={`${id}-card`}>{c.cardNumber}</label>
              <input
                id={`${id}-card`}
                type="text"
                inputmode="numeric"
                autocomplete="off"
                data-1p-ignore
                data-lpignore="true"
                data-bwignore
                placeholder="4242 4242 4242 4242"
                maxlength="19"
                data-pay-card
              />
            </div>
            <div class="enroll__pair">
              <div class="field">
                <label for={`${id}-exp`}>{c.expiry}</label>
                <input
                  id={`${id}-exp`}
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  data-1p-ignore
                  data-lpignore="true"
                  data-bwignore
                  placeholder="MM / YY"
                  maxlength="7"
                  data-pay-exp
                />
              </div>
              <div class="field">
                <label for={`${id}-cvc`}>{c.cvc}</label>
                <input
                  id={`${id}-cvc`}
                  type="text"
                  inputmode="numeric"
                  autocomplete="off"
                  data-1p-ignore
                  data-lpignore="true"
                  data-bwignore
                  placeholder="123"
                  maxlength="4"
                  data-pay-cvc
                />
              </div>
            </div>
            <div class="field">
              <label for={`${id}-holder`}>{c.cardName}</label>
              <input id={`${id}-holder`} type="text" autocomplete="off" data-1p-ignore data-lpignore="true" data-pay-name />
            </div>
            <div class="enroll__actions">
              <button class="btn enroll__pay" type="submit" data-pay-button data-busy={c.processing}>
                {c.pay} {money(total)}
              </button>
            </div>
            <p class="enroll__ask">
              <button class="enroll__link" type="button" data-enroll-change>
                {c.changeDetails}
              </button>
              <span aria-hidden="true"> · </span>
              {c.handledBy}
            </p>
          </form>
        )
      }

      {
        price && (
          <div class="enroll__panel" data-enroll-paid tabindex="-1">
            <h3 class="enroll__done">{c.paidTitle}</h3>
            <p>
              {c.paidText} <strong data-paid-email />.
            </p>
            <p class="enroll__ref">
              {c.reference} <span data-paid-ref />
            </p>
            <p class="enroll__notice on-blue-light">{c.testNote}</p>
          </div>
        )
      }

      {/* Shown in place of the form once it has been filled in */}
      <div class="enroll__panel" data-enroll-sent tabindex="-1">
        <p class="enroll__notice on-blue-light">{ui.requestPending}</p>
        <p class="enroll__ask">
          {ui.waitlist.question}{' '}
          <a href={`mailto:${site.emails[0]}`}>{ui.contactInstead}</a>
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { clearError, showError } from '../../scripts/fields';

  type Step = 'idle' | 'details' | 'payment' | 'paid' | 'sent';

  // STRIPE CONNECTS HERE (going live). This page is static, so the card can never be taken here. Either:
  //  - a Stripe Payment Link per course (src/data/courses.ts, stripePaymentLink): on "Continue to
  //    payment", send the visitor to the link with ?prefilled_email=<email> instead of showing step 2; or
  //  - Stripe Checkout or the Payment Element, with a small server function (Netlify or Cloudflare)
  //    that creates the session or payment intent for the course's slug and returns it.
  // Until then step 2 is this simulation of Stripe's test mode, with Stripe's own test cards:
  const TEST_CARDS: Record<string, 'ok' | 'declined' | 'funds'> = {
    '4242424242424242': 'ok',
    '5555555555554444': 'ok',
    '4000000000000002': 'declined',
    '4000000000009995': 'funds',
  };
  const digits = (value: string) => value.replace(/\D/g, '');

  function bind(root: HTMLElement) {
    const start = root.querySelector<HTMLAnchorElement>('[data-enroll-start]')!;
    const form = root.querySelector<HTMLFormElement>('[data-enroll-form]')!;
    const sent = root.querySelector<HTMLElement>('[data-enroll-sent]')!;

    const go = (step: Step) => {
      root.dataset.step = step;
      // The popup listens for this to swap its view.
      root.dispatchEvent(new CustomEvent<Step>('enroll:step', { bubbles: true, detail: step }));
    };

    start.addEventListener('click', (event) => {
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      go('details');
      form.querySelector('input')?.focus();
    });

    // The browser holds back an empty or malformed field; the words it shows come from the page.
    form.querySelectorAll<HTMLInputElement>('input[data-missing]').forEach((input) => {
      const say = () => {
        input.setCustomValidity('');
        const { valueMissing, typeMismatch } = input.validity;
        input.setCustomValidity((valueMissing ? input.dataset.missing : typeMismatch && input.dataset.mismatch) || '');
      };
      say();
      input.addEventListener('input', say);
    });

    const pay = root.querySelector<HTMLFormElement>('[data-enroll-pay-form]');
    const paid = root.querySelector<HTMLElement>('[data-enroll-paid]');

    // Fires only once validation has passed.
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (pay) {
        // the name on the card starts as the name just given
        const holder = pay.querySelector<HTMLInputElement>('[data-pay-name]')!;
        if (!holder.value) holder.value = (form.elements.namedItem('name') as HTMLInputElement).value;
        go('payment');
        pay.querySelector<HTMLInputElement>('[data-pay-card]')?.focus();
        return;
      }
      // REQUESTS CONNECT HERE. Send new FormData(form) (name, email, why, source, source-other) with the
      // course to the service that will carry requests to Athena, and show its answer instead of the
      // note below. Until then nothing leaves the browser.
      go('sent');
      sent.focus();
    });

    if (pay && paid) {
      const errors = JSON.parse(root.dataset.errors ?? '{}') as Record<string, string>;
      const card = pay.querySelector<HTMLInputElement>('[data-pay-card]')!;
      const exp = pay.querySelector<HTMLInputElement>('[data-pay-exp]')!;
      const cvc = pay.querySelector<HTMLInputElement>('[data-pay-cvc]')!;
      const holder = pay.querySelector<HTMLInputElement>('[data-pay-name]')!;
      const button = pay.querySelector<HTMLButtonElement>('[data-pay-button]')!;
      const label = button.textContent ?? '';

      // As typed: the number in fours, the date as MM / YY
      card.addEventListener('input', () => {
        card.value = digits(card.value).slice(0, 16).replace(/(\d{4})(?=\d)/g, '$1 ');
      });
      exp.addEventListener('input', (event) => {
        const d = digits(exp.value).slice(0, 4);
        const erasing = (event as InputEvent).inputType?.startsWith('delete');
        exp.value = d.length > 2 || (d.length === 2 && !erasing) ? `${d.slice(0, 2)} / ${d.slice(2)}` : d;
      });
      cvc.addEventListener('input', () => (cvc.value = digits(cvc.value).slice(0, 4)));

      // The message stands under the field it is about, as on every form of the site (scripts/fields.ts)
      const fail = (text: string, field: HTMLInputElement) => {
        pay.querySelectorAll('input').forEach((input) => clearError(input));
        showError(field, text);
        field.focus();
      };
      const check = (): string | null => {
        const number = digits(card.value);
        if (number.length !== 16) return fail(errors.number, card), null;
        const outcome = TEST_CARDS[number];
        if (!outcome) return fail(errors.notTestCard, card), null;
        const [mm, yy] = [Number(digits(exp.value).slice(0, 2)), Number(digits(exp.value).slice(2, 4))];
        const now = new Date();
        const ends = new Date(2000 + yy, mm, 1); // the first day after the card's last month
        if (!(mm >= 1 && mm <= 12) || digits(exp.value).length !== 4 || ends <= now) return fail(errors.expiry, exp), null;
        if (!/^\d{3,4}$/.test(cvc.value)) return fail(errors.cvc, cvc), null;
        if (!holder.value.trim()) return fail(errors.name, holder), null;
        return outcome;
      };

      pay.addEventListener('submit', (event) => {
        event.preventDefault();
        if (button.disabled) return;
        const outcome = check();
        if (!outcome) return;
        // What Stripe's test mode would take a moment over
        button.disabled = true;
        button.classList.add('is-busy');
        button.textContent = button.dataset.busy ?? '';
        window.setTimeout(() => {
          button.disabled = false;
          button.classList.remove('is-busy');
          button.textContent = label;
          if (outcome !== 'ok') return fail(outcome === 'funds' ? errors.funds : errors.declined, card);
          const email = (form.elements.namedItem('email') as HTMLInputElement).value;
          paid.querySelector('[data-paid-email]')!.textContent = email;
          paid.querySelector('[data-paid-ref]')!.textContent = `TEST-${Math.random().toString(36).slice(2, 8).toUpperCase()}`;
          // the card is not kept, not even in the page
          [card, exp, cvc].forEach((input) => (input.value = ''));
          go('paid');
          paid.focus();
        }, 1400);
      });

      root.querySelector('[data-enroll-change]')?.addEventListener('click', () => {
        go('details');
        form.querySelector('input')?.focus();
      });
    }

    root.querySelectorAll('[data-enroll-back]').forEach((button) =>
      button.addEventListener('click', () => {
        if (root.dataset.step === 'sent') {
          go('details');
          form.querySelector('input')?.focus();
        } else {
          go('idle');
          start.focus();
        }
      }),
    );

    root.addEventListener('enroll:reset', () => {
      // a closed popup forgets the card fields
      root.querySelectorAll<HTMLInputElement>('[data-enroll-pay-form] input').forEach((input) => (input.value = ''));
      go('idle');
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-enroll]:not([data-enroll-ready])').forEach((root) => {
      root.dataset.enrollReady = '';
      bind(root);
    });
  });
</script>

<style>
  .enroll[data-step='idle'] .enroll__flow,
  .enroll:not([data-step='idle']) .enroll__start,
  .enroll:not([data-step='sent']) [data-enroll-sent],
  .enroll:not([data-step='details']) [data-enroll-form],
  .enroll:not([data-step='payment']) [data-enroll-pay-form],
  .enroll:not([data-step='paid']) [data-enroll-paid] {
    display: none;
  }
  /* The sums appear on the ticket once the payment is in view */
  .enroll:not([data-step='payment'], [data-step='paid']) .enroll__sums {
    display: none;
  }

  .enroll__flow {
    display: grid;
    gap: var(--space-l);
  }

  .enroll__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: var(--space-m) var(--space-l);
    align-items: start;
  }

  .enroll__aside {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }
  /* The symbol stands under the ticket, in the lighter blue, where the column has room for it */
  .enroll__mark {
    display: none;
    width: clamp(6rem, 9vw, 8.5rem);
    margin-left: clamp(1rem, 3vw, 2.5rem);
    color: var(--sub-ink);
    opacity: 0.85;
    pointer-events: none;
  }
  @media (min-width: 40rem) {
    .enroll__mark {
      display: block;
    }
  }
  /* The summary is a paper ticket laid on the sheet, so it keeps paper colours wherever it sits */
  .enroll__ticket {
    --ink: var(--blue-deep);
    --ink-strong: var(--blue);
    --ink-soft: color-mix(in srgb, var(--blue-deep) 72%, var(--creme));
    --line: color-mix(in srgb, var(--blue) 28%, transparent);
    position: relative;
    isolation: isolate;
    display: grid;
    gap: 0.5rem;
    max-width: 26rem;
    padding: clamp(1.3rem, 1rem + 1.4vw, 2rem);
    color: var(--ink);
    border-radius: var(--r-soft-2);
  }
  .enroll__ticket::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background-color: var(--creme-light);
    background-image: url('/textures/grain-dark.webp');
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }
  .enroll__ticket-title {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .enroll__course {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-1);
    line-height: 1.08;
    letter-spacing: var(--title-tracking);
    color: var(--ink-strong);
    text-wrap: balance;
  }
  .enroll__stub {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1.25rem;
    margin-top: 0.5rem;
    padding-top: 0.9rem;
    border-top: 1.5px dashed var(--line);
  }
  .enroll__amount {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-1);
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--ink-strong);
  }

  .enroll__vat {
    display: block;
    margin-top: 0.3rem;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: var(--step--1);
    letter-spacing: 0;
    color: var(--ink-soft);
  }

  .enroll__panel {
    display: grid;
    gap: var(--space-s);
    max-width: 28rem;
  }
  .enroll__panel:focus {
    outline: none;
  }
  .enroll__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.4rem;
  }
  /* The one light blue shape in the flow, so the message cannot be missed */
  .enroll__notice {
    padding: 1rem 1.3rem 1.1rem;
    background: var(--paper);
    border-radius: 1.5rem 1.9rem 1.4rem 2rem / 1.9rem 1.4rem 2rem 1.5rem;
  }
  .enroll__notice a {
    font-weight: 620;
    text-decoration-color: currentColor;
    white-space: nowrap;
  }

  /* ---------- the test checkout ---------- */
  .enroll__step {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .enroll__sums {
    display: grid;
    gap: 0.35rem;
    margin: 0.4rem 0 0;
    font-size: var(--step--1);
  }
  .enroll__sums div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .enroll__sums dd {
    margin: 0;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .enroll__total {
    margin-top: 0.2rem;
    padding-top: 0.45rem;
    border-top: 1.5px dashed var(--line);
    font-weight: 600;
    color: var(--ink-strong);
  }
  /* Test mode is said plainly, before any field */
  .enroll__test {
    padding: 0.75rem 1rem 0.8rem;
    font-size: var(--step--1);
    line-height: 1.45;
    border: 1.5px dashed var(--line);
    border-radius: 1.1rem 1.4rem 1rem 1.5rem / 1.4rem 1rem 1.5rem 1.1rem;
  }
  .enroll__test strong {
    color: var(--ink-strong);
  }
  .enroll__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    /* (a message under one field must not push the other one down) */
    align-items: start;
    gap: var(--space-s);
  }
  .enroll__pay {
    font-variant-numeric: lining-nums;
  }
  .enroll__pay.is-busy[disabled] {
    opacity: 1;
    cursor: progress;
  }
  /* A small turning ring while the payment "goes through" */
  .enroll__pay.is-busy::after {
    content: '';
    width: 0.9em;
    height: 0.9em;
    margin-left: 0.6em;
    border: 2px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: enroll-turn 0.8s linear infinite;
  }
  @keyframes enroll-turn {
    to {
      transform: rotate(1turn);
    }
  }
  .enroll__link {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.18em;
    cursor: pointer;
  }
  .enroll__done {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-2);
    line-height: 1.05;
    color: var(--ink-strong);
  }
  .enroll__ref {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .enroll__ref span {
    font-variant-numeric: lining-nums;
    letter-spacing: 0.06em;
    color: var(--ink-strong);
  }

  /* Night: the kit's field turns a fixed light colour when hovered or focused (global.css), which
     would leave pale writing unreadable as it is typed. Here it stays night paper, a shade lifted. */
  :global(html[data-theme='dark']) .enroll :global(.field :is(input, textarea, select):is(:hover, :focus)) {
    background-color: color-mix(in srgb, var(--blue) 12%, var(--creme-light));
  }

  /* The way to ask something first: small and quiet, under everything else */
  .enroll__ask {
