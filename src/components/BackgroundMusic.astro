---
// The two small controls in the lower left corner: very quiet background music with a mute button,
// and the day and night switch beside it.
// Browsers do not allow sound before the visitor has interacted with the page, so "autoplay" works like
// this: playback is attempted on load, and if the browser refuses, it starts on the first click, tap or
// key press. The visitor's choice (on or off) is remembered. The element persists across page changes,
// so the music does not restart when moving between pages. Where the browser has to load a whole new
// document (an address typed by hand, such as a page that does not exist, or the language switch), the
// place in the piece is remembered and the music picks up from there, easing in, instead of starting
// again. A link that forces such a reload fades the music out first, so it never cuts.
import { content } from '../data';
import { getLocale, mainLocale } from '../lib/locale';

const t = {
  en: { group: 'Background music', turnOff: 'Turn the music off', turnOn: 'Turn the music on' },
  el: { group: 'Μουσική υπόκρουση', turnOff: 'Απενεργοποίηση μουσικής', turnOn: 'Ενεργοποίηση μουσικής' },
}[mainLocale(getLocale(Astro.url))];
const { ui } = content(getLocale(Astro.url));
---

<div class="music" data-music role="group" aria-label={t.group} transition:persist="background-music">
  <audio src="/audio/ambient.mp3" loop preload="none" data-music-audio></audio>
  <button
    type="button"
    class="music__button"
    data-music-toggle
    data-label-on={t.turnOff}
    data-label-off={t.turnOn}
    aria-pressed="false"
    aria-label={t.turnOn}
    title={t.turnOn}
  >
    <svg viewBox="0 0 28 28" width="28" height="28" aria-hidden="true" focusable="false">
      <path class="music__speaker" d="M4.5 11.2h3.6l5.4-4.4v14.4l-5.4-4.4H4.5z"></path>
      <path class="music__wave music__wave--1" d="M17.2 10.6c1.7 1.8 1.7 5 0 6.8"></path>
      <path class="music__wave music__wave--2" d="M20.3 7.9c3.3 3.4 3.3 8.8 0 12.2"></path>
      <path class="music__slash" d="M17.4 11.3l5.6 5.4M23 11.3l-5.6 5.4"></path>
    </svg>
  </button>
  {/* Day and night, beside the sound button (client direction, 11 October 2026; it used to sit in the header) */}
  <button
    type="button"
    class="music__button music__theme"
    data-theme-toggle
    data-label-night={ui.toNight}
    data-label-day={ui.toDay}
    aria-pressed="false"
    aria-label={ui.toNight}
    title={ui.toNight}
  >
    <svg viewBox="0 0 28 28" width="24" height="24" aria-hidden="true" focusable="false">
      <path class="moon" d="M19.8 16.9A8.3 8.3 0 0 1 11 6.2a8.3 8.3 0 1 0 8.8 10.7z"></path>
      <g class="sun">
        <circle cx="14" cy="14" r="4.6"></circle>
        <path d="M14 3.5v3M14 21.5v3M3.5 14h3M21.5 14h3M6.6 6.6l2.1 2.1M19.3 19.3l2.1 2.1M6.6 21.4l2.1-2.1M19.3 8.7l2.1-2.1"></path>
      </g>
    </svg>
  </button>
</div>

<script>
  import { playSound } from '../scripts/sound';

  const KEY = 'ath-music';
  const AT = 'ath-music-at'; // where in the piece the last page left off (this tab only)
  const VOLUME = 0.112; // very low: it should sit under the page, not on top of it (lowered by a fifth on 11 October 2026)

  function setup() {
    const root = document.querySelector<HTMLElement>('[data-music]');
    if (!root || root.dataset.ready) return;
    root.dataset.ready = 'true';
    const audio = root.querySelector<HTMLAudioElement>('[data-music-audio]')!;
    const button = root.querySelector<HTMLButtonElement>('[data-music-toggle]')!;

    let wanted = true;
    try {
      wanted = localStorage.getItem(KEY) !== 'off';
    } catch {}

    // With no music file to play (it is kept out of the public preview until its licence is settled)
    // the button still records the choice, so it then shows that choice.
    let broken = audio.error !== null;
    const render = () => {
      const playing = broken ? wanted : !audio.paused;
      const label = playing ? button.dataset.labelOn! : button.dataset.labelOff!;
      button.setAttribute('aria-pressed', String(playing));
      button.setAttribute('aria-label', label);
      button.title = label;
      root.classList.toggle('is-playing', playing);
    };

    // Pick up where the last page left off
    try {
      const at = Number(sessionStorage.getItem(AT));
      if (at > 0) audio.currentTime = at;
    } catch {}
    const keepPlace = () => {
      try {
        sessionStorage.setItem(AT, String(audio.currentTime));
      } catch {}
    };
    window.addEventListener('pagehide', keepPlace);

    let ramp = 0;
    const start = () => {
      audio.volume = 0;
      audio
        .play()
        .then(() => {
          // Ease the sound in over about two seconds
          cancelAnimationFrame(ramp);
          const began = performance.now();
          const step = (now: number) => {
            const progress = Math.min(1, Math.max(0, (now - began) / 2200));
            audio.volume = VOLUME * progress;
            if (progress < 1) ramp = requestAnimationFrame(step);
          };
          ramp = requestAnimationFrame(step);
        })
        .catch(() => {
          // The browser is waiting for the visitor to interact first.
        });
    };

    const remember = (value: 'on' | 'off') => {
      try {
        localStorage.setItem(KEY, value);
      } catch {}
    };

    button.addEventListener('click', () => {
      if (broken ? !wanted : audio.paused) {
        wanted = true;
        remember('on');
        start();
      } else {
        wanted = false;
        remember('off');
        audio.pause();
      }
      if (broken) render();
    });
    audio.addEventListener('error', () => {
      broken = true;
      render();
    });

    // First interaction anywhere on the page starts the music, unless it was the mute button itself.
    const onFirstGesture = (event: Event) => {
      if (event.target instanceof Node && button.contains(event.target)) return;
      if (wanted && audio.paused) start();
    };
    for (const type of ['pointerdown', 'keydown']) {
      window.addEventListener(type, onFirstGesture, { once: true, passive: true, capture: true });
    }

    // A link that reloads the whole page (the language switch) would cut the music: fade it out first.
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[data-astro-reload]') : null;
      if (!link || audio.paused || event.defaultPrevented) return;
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || link.target) return;
      event.preventDefault();
      cancelAnimationFrame(ramp);
      const from = audio.volume;
      const began = performance.now();
      const step = (now: number) => {
        const progress = Math.min(1, (now - began) / 260);
        audio.volume = from * (1 - progress);
        if (progress < 1) requestAnimationFrame(step);
        else location.href = link.href;
      };
      requestAnimationFrame(step);
    });

    audio.addEventListener('play', render);
    audio.addEventListener('pause', render);
    if (wanted) start();
    render();

    // Day and night. An owl calls when night falls; a soft wave greets the day.
    // (Sound effects: they play whether the music is on or off, client direction, 15 October 2026.)
    const moon = root.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (moon) {
      const page = document.documentElement;
      const isNight = () => page.dataset.theme === 'dark';
      const label = () => {
        const text = isNight() ? moon.dataset.labelDay! : moon.dataset.labelNight!;
        moon.setAttribute('aria-pressed', String(isNight()));
        moon.setAttribute('aria-label', text);
        moon.title = text;
      };
      const play = (file: string) => playSound(file, 0.14);
      const apply = (night: boolean) => {
        if (night) page.dataset.theme = 'dark';
        else delete page.dataset.theme;
        // The choice is kept with the sun's state, and holds until the sun next rises or sets
        // (see the script in Base.astro, which otherwise follows the sun).
        try {
          localStorage.setItem('ath-theme', `${night ? 'dark' : 'light'}@${page.dataset.sun ?? 'up'}`);
        } catch {}
        label();
      };
      moon.addEventListener('click', () => {
        const night = !isNight();
        play(night ? '/audio/owl.mp3' : '/audio/daylight.mp3');
        const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!still && 'startViewTransition' in document) {
          (document as Document & { startViewTransition: (run: () => void) => unknown }).startViewTransition(() =>
            apply(night),
          );
        } else {
          apply(night);
        }
      });
      label();
      // The page can change by itself at sunrise and sunset: keep the button's label true
      new MutationObserver(label).observe(page, { attributes: true, attributeFilter: ['data-theme'] });
    }
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .music {
    display: flex;
    gap: 0.45rem;
    position: fixed;
    left: clamp(0.75rem, 0.4rem + 1vw, 1.5rem);
    /* Level with the copyright line when the page is scrolled to its end */
    bottom: max(0.2rem, calc(var(--footer-band) / 2 - 1.2rem));
    z-index: 55;
  }
  .music__button {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    padding: 0;
    border: 1.5px solid color-mix(in srgb, var(--blue) 26%, transparent);
    border-radius: 54% 46% 52% 48% / 48% 54% 46% 52%;
    background-color: color-mix(in srgb, var(--creme-light) 92%, transparent);
    color: var(--blue);
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition:
      background-color var(--dur-1) var(--hover-delay),
      color var(--dur-1) var(--hover-delay),
      border-color var(--dur-1) var(--hover-delay);
  }
  .music__button:hover {
    background-color: var(--blue-light);
    border-color: transparent;
  }
  .music__button svg {
    width: 1.45rem;
    height: 1.45rem;
  }
  .music__button :is(path, circle) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: opacity var(--dur-1);
  }
  /* A moon by day, a sun by night */
  .music__theme .sun {
    display: none;
  }
  :global(html[data-theme='dark']) .music__theme .sun {
    display: inline;
  }
  :global(html[data-theme='dark']) .music__theme .moon {
    display: none;
  }
  /* Silent: speaker with a cross. Playing: speaker with two waves. */
  .music__wave {
    opacity: 0;
  }
  .music.is-playing .music__wave {
    opacity: 1;
  }
  .music.is-playing .music__slash {
    opacity: 0;
  }
  @keyframes music-pulse {
    50% {
      opacity: 0.35;
    }
  }
  :global(html.motion) .music.is-playing .music__wave--2 {
    animation: music-pulse 2.8s var(--ease-in-out) infinite;
  }
  @media print {
    .music {
      display: none;
    }
  }
</style>
