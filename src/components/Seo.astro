---
// Head tags for search engines, link previews and AI agents, in the language of the address.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { content } from '../data';
import { getLocale, locales, pathIn, type Locale } from '../lib/locale';
import { twins } from '../lib/markdown';

type Graph = Record<string, unknown> | null | undefined | false;

interface Props {
  title: string;
  description: string;
  /** Link-preview image: an absolute or site-relative address, or an imported photo (cropped here to 1200 x 630) */
  image?: string | ImageMetadata;
  /** What the preview image shows. Pass it whenever `image` is set. */
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  /** One or more schema.org objects, emitted as JSON-LD */
  schema?: Graph | Graph[];
}

const { title, description, image, imageAlt, type = 'website', noindex = false, schema } = Astro.props;
const locale = getLocale(Astro.url);
const { site, home } = content(locale);
const origin = Astro.site ?? site.url;
const absolute = (to: string) => new URL(to, origin).href;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = absolute(path);

const t = {
  en: { ogLocale: 'en_US', preview: '/og-default.jpg', llms: 'Site summary for AI agents' },
  el: {
    ogLocale: 'el_GR',
    preview: '/og-default-el.jpg',
    llms: 'Σύνοψη του ιστότοπου για πράκτορες τεχνητής νοημοσύνης',
  },
} satisfies Record<Locale, Record<string, string>>;

// The default preview is lettered with the home page title, so each language has its own file in public/.
let preview = { src: t[locale].preview, width: 1200 as number | undefined, height: 630 as number | undefined };
let previewAlt: string | undefined = home.meta.title;
if (typeof image === 'string') {
  preview = { src: image, width: undefined, height: undefined };
  previewAlt = imageAlt;
} else if (image) {
  // Previews are 1200 x 630. A smaller photo keeps that shape at its own size instead of being enlarged.
  const scale = Math.min(1, image.width / 1200, image.height / 630);
  const size = { width: Math.round(1200 * scale), height: Math.round(630 * scale) };
  preview = { src: (await getImage({ src: image, ...size, fit: 'cover', format: 'jpg' })).src, ...size };
  previewAlt = imageAlt;
}
const imageUrl = absolute(preview.src);

// Every page that is indexed exists in both languages at the same address, with /el in front for Greek.
const languages = noindex ? [] : locales.map((code) => ({ code, href: absolute(pathIn(code, path)) }));
const twin = noindex ? undefined : twins[path];
const graphs = (Array.isArray(schema) ? schema : [schema]).filter((graph) => !!graph);

// Structured data built without the page's language (organizationSchema() on a Greek page) gives itself away.
const foreign = locales.find((code) => code !== locale && JSON.stringify(graphs).includes(`"inLanguage":"${code}"`));
if (foreign) console.warn(`[seo] ${path} has structured data in "${foreign}": pass the page's locale to the builder`);

// One title and one description per page: say so in the terminal when two pages share either.
if (!noindex) {
  const store = globalThis as unknown as { athSeoSeen?: Map<string, string> };
  const seen = (store.athSeoSeen ??= new Map<string, string>());
  for (const [kind, value] of Object.entries({ title, description })) {
    const first = seen.get(`${kind}:${value}`);
    if (first && first !== path) console.warn(`[seo] ${path} and ${first} have the same ${kind}: "${value}"`);
    else seen.set(`${kind}:${value}`, path);
  }
}
---

<title>{title}</title>
<meta name="description" content={description} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <>
      <link rel="canonical" href={canonical} />
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    </>
  )
}
{languages.map((language) => <link rel="alternate" hreflang={language.code} href={language.href} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={absolute(pathIn('en', path))} />}
{twin && <link rel="alternate" type="text/markdown" href={twin} title={title} />}
<link rel="alternate" type="text/plain" href={pathIn(locale, '/llms.txt')} title={t[locale].llms} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={imageUrl} />
{preview.width && <meta property="og:image:width" content={String(preview.width)} />}
{preview.height && <meta property="og:image:height" content={String(preview.height)} />}
{previewAlt && <meta property="og:image:alt" content={previewAlt} />}
<meta property="og:locale" content={t[locale].ogLocale} />
{
  languages
    .filter((language) => language.code !== locale)
    .map((language) => <meta property="og:locale:alternate" content={t[language.code].ogLocale} />)
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
{previewAlt && <meta name="twitter:image:alt" content={previewAlt} />}

{
  graphs.map((graph) => (
    <script type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, '\\u003c')} />
  ))
}
