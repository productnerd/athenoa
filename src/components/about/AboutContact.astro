---
// Contact section that closes the page: a Greek blue cut-out with the form on it and the direct
// contact details beside it.
import Illustration from '../Illustration.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

// Every word here comes from the data; the component adds none of its own.
const { about } = content(getLocale(Astro.url));
const { contact } = about;
// A short title stays on one line; a longer one (the Greek) is sized so that its longest word fits the column.
const fit =
  contact.title.length <= 12 ? contact.title.length : Math.max(...contact.title.split(' ').map((word) => word.length));
// A range of numbers ("2-3") stays on one line: browsers will otherwise break after its hyphen.
const note = contact.note.replace(/\d+-\d+/g, '<span class="contact__range">$&</span>');
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact__wrap">
    <div class="panel panel--big on-blue contact__panel">
      <div class="panel__clip">
        <div class="contact__scales scales" data-depth="0.14"></div>
      </div>

      <div class="contact__grid">
        <div class="contact__lead">
          <h2 id="contact-title" class="t-1 contact__title" data-split style={`--fit:${fit}`}>{contact.title}</h2>
          <p class="lead" data-reveal>{contact.intro}</p>

          <Illustration name="tripod" class="contact__tripod" draw />
        </div>

        <!-- Not connected to a mail service yet: without JavaScript the browser hands the fields to the
             visitor's mail app; with it, the script below composes a tidier message. -->
        <form
          class="contact__form"
          method="post"
          action={`mailto:${contact.fallbackEmail}`}
          enctype="text/plain"
          data-contact-form
          data-reveal
        >
          <div class="contact__fields">
            {
              contact.fields.map((field) => (
                <div class:list={['field', `field--${field.name}`]}>
                  <label for={`contact-${field.name}`}>
                    {field.label}
                    {field.required && (
                      <span class="contact__required" aria-hidden="true">
                        *
                      </span>
                    )}
                  </label>
                  {field.type === 'textarea' ? (
                    <textarea
                      id={`contact-${field.name}`}
                      name={field.name}
                      rows="6"
                      placeholder={field.placeholder}
                      autocomplete={field.autocomplete}
                      required={field.required}
                      data-label={field.label}
                    />
                  ) : (
                    <input
                      id={`contact-${field.name}`}
                      name={field.name}
                      type={field.type}
                      placeholder={field.placeholder}
                      autocomplete={field.autocomplete}
                      required={field.required}
                      data-label={field.label}
                    />
                  )}
                </div>
              ))
            }
            <div class="contact__send">
              <button class="btn" type="submit">{contact.submit}</button>
              <p class="hand hand--m contact__note" set:html={note} />
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  // Until a form service is connected, "Send" opens the visitor's own mail app with the message written out.
  document.addEventListener('astro:page-load', () => {
    const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea'));
      const value = (name: string) => fields.find((field) => field.name === name)?.value.trim() ?? '';

      // FORM SERVICE: connect it here. Replace everything below in this handler with a request to the
      // service, for example fetch(endpoint, { method: 'POST', body: new FormData(form) }), and show its reply.
      const details = fields
        .filter((field) => !['subject', 'message'].includes(field.name) && field.value.trim())
        // A label that is itself a question keeps its own mark (";" is the Greek question mark).
        .map((field) => `${field.dataset.label}${/[?;]$/.test(field.dataset.label ?? '') ? '' : ':'} ${field.value.trim()}`);
      // Mail links want CRLF line breaks.
      const body = [value('message'), '', ...details].join('\n').replace(/\r?\n/g, '\r\n');
      const address = form.getAttribute('action');
      window.location.href = `${address}?subject=${encodeURIComponent(value('subject'))}&body=${encodeURIComponent(body)}`;
    });
  });
</script>

<style>
  .contact {
    position: relative;
    padding-top: var(--space-xl);
  }
  .contact__wrap {
    position: relative;
  }
  /* A darker blue pebble carrying the scale pattern, cut off by the panel's corner */
  /* The tripod of Delphi stands under the invitation, in the lighter blue */
  .contact__tripod {
    width: clamp(8rem, 6rem + 9vw, 13rem);
    margin-top: var(--space-l);
    color: var(--blue-light);
  }
  .contact__scales {
    position: absolute;
    left: -7rem;
    bottom: -9rem;
    width: clamp(19rem, 14rem + 16vw, 30rem);
    aspect-ratio: 1;
    border-radius: var(--r-pebble-2);
    background-color: var(--blue-deep);
  }

  .contact__grid {
    display: grid;
    gap: var(--space-l);
  }
  .contact__lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    align-content: start;
    container-type: inline-size;
  }
  /* Sized against its own column (0.45em is a generous average letter), so no word of the title can
     reach under the form, in either language */
  .contact__title {
    font-size: min(var(--step-4), calc(100cqi / (var(--fit) * 0.45)));
  }
  /* The shared icons brighten to a blue on hover, which disappears on a blue ground */

  /* The short fields pair up only when the form itself is wide enough to hold their placeholders */
  .contact__form {
    container-type: inline-size;
  }
  .contact__fields {
    display: grid;
    gap: var(--space-s) var(--space-m);
  }
  .contact__required {
    margin-left: 0.15em;
  }
  /* Darker than the kit default so placeholder text keeps a 4.5:1 contrast on the crème field */
  .contact__form :is(input, textarea)::placeholder {
    color: color-mix(in srgb, var(--blue-deep) 66%, transparent);
  }
  .contact__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-2xs);
  }
  /* Even lines when the note wraps */
  .contact__note {
    text-wrap: balance;
  }
  .contact__note :global(.contact__range) {
    white-space: nowrap;
  }

  @container (min-width: 35rem) {
    .contact__fields {
      grid-template-columns: 1fr 1fr;
    }
    .field--subject,
    .field--message,
    .contact__send {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 62rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-xl);
    }
  }
</style>
