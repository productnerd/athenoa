---
// Contact section that closes the page: a Greek blue cut-out with the form on it and the direct
// contact details beside it.
import Illustration from '../Illustration.astro';
import ContactForm from '../ContactForm.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

// Every word here comes from the data; the component adds none of its own.
const { about } = content(getLocale(Astro.url));
const { contact } = about;
// A short title stays on one line; a longer one (the Greek) is sized so that its longest word fits the column.
const fit =
  contact.title.length <= 12 ? contact.title.length : Math.max(...contact.title.split(' ').map((word) => word.length));
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap contact__wrap">
    <div class="panel panel--big on-blue contact__panel">
      <div class="panel__clip">
        <div class="contact__scales scales" data-depth="0.14"></div>
      </div>

      <div class="contact__grid">
        <div class="contact__lead">
          <h2 id="contact-title" class="t-1 contact__title" data-split style={`--fit:${fit}`}>{contact.title}</h2>
          {/* The line under the title ("Contact us regarding our work…") was removed at the client's wish, 12 October 2026 */}
          <Illustration name="tripod" class="contact__tripod" draw />
        </div>

        <ContactForm reveal />
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    position: relative;
    padding-top: var(--space-xl);
  }
  .contact__wrap {
    position: relative;
  }
  /* A darker blue pebble carrying the scale pattern, cut off by the panel's corner */
  /* The tripod of Delphi stands under the invitation, in the lighter blue */
  .contact__tripod {
    width: clamp(8rem, 6rem + 9vw, 13rem);
    margin-top: var(--space-l);
    color: var(--blue-light);
  }
  .contact__scales {
    position: absolute;
    left: -7rem;
    bottom: -9rem;
    width: clamp(19rem, 14rem + 16vw, 30rem);
    aspect-ratio: 1;
    border-radius: var(--r-pebble-2);
    background-color: var(--blue-deep);
  }

  .contact__grid {
    display: grid;
    gap: var(--space-l);
  }
  .contact__lead {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
    align-content: start;
    container-type: inline-size;
  }
  /* Sized against its own column (0.45em is a generous average letter), so no word of the title can
     reach under the form, in either language */
  .contact__title {
    font-size: min(var(--step-4), calc(100cqi / (var(--fit) * 0.45)));
  }
  /* The shared icons brighten to a blue on hover, which disappears on a blue ground */

  /* Tablets, where the form runs under the title: the tripod stands to the right of the title */
  @media (min-width: 34rem) and (max-width: 61.99rem) {
    .contact__lead {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-m);
    }
    .contact__title {
      font-size: min(var(--step-4), calc((100cqi - 12rem) / (var(--fit) * 0.45)));
    }
    .contact__tripod {
      width: clamp(7.5rem, 5rem + 9vw, 10.5rem);
      margin-top: 0;
      justify-self: end;
    }
  }
  @media (min-width: 62rem) {
    .contact__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-xl);
    }
  }
</style>
