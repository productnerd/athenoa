---
// Opening of "About Dr. Athena Potari": the title and the three introductory paragraphs beside a tall
// arch portrait. Depth, far to near: sun rays, a blue paper arch, the photograph.
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import temple from '../../assets/media/temple-blue-dress.jpg';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { about, site } = content(locale);
const t = {
  en: { photo: 'A woman in a long blue dress stands between the marble columns of an ancient temple' },
  el: { photo: 'Μια γυναίκα με μακρύ μπλε φόρεμα στέκεται ανάμεσα στους μαρμάρινους κίονες ενός αρχαίου ναού' },
}[locale];

// The title breaks where the name begins: a short opening line ("About"), then the name with its
// title on a line of its own. The name starts at the honorific that also opens site.founder.
const [honorific] = site.founder.split(' ');
const at = Math.max(about.title.indexOf(honorific), 0);
const opening = about.title.slice(0, at).trim();
const name = about.title.slice(at);
const [lead, ...paragraphs] = about.intro;
---

<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__head">
      <h1 class="hero__title t-hero" data-split style={`--name-chars:${name.length}`}>
        {opening && <span class="hero__opening t-sub">{opening}</span>}{' '}<span class="hero__name">{name}</span>
      </h1>
    </div>

    <div class="hero__figure">
      <div class="hero__halo">
        <Illustration name="sun-rays" class="hero__rays" draw data-depth="0.3" />
      </div>
      <div class="hero__plate" data-reveal="grow"></div>
      <div class="hero__photo" data-depth="-0.05">
        <Media
          src={temple}
          alt={t.photo}
          shape="arch"
          ratio="5 / 7"
          focus="60% 50%"
          widths={[360, 560, 800, 1100]}
          sizes="(min-width: 46rem) 31vw, 70vw"
          innerDepth={0.1}
          priority
        />
      </div>
    </div>

    <p class="lead hero__lead" data-reveal set:html={lead} />

    <div class="hero__more">
      {paragraphs.map((text, i) => <p data-reveal style={`--i:${i + 1}`} set:html={text} />)}
    </div>
  </div>
</section>

<style>
  .hero {
    --fig: min(70vw, 20rem);
    position: relative;
    /* The first screen slides up under the sticky header */
    margin-top: calc(var(--header-h) * -1);
    padding-top: calc(var(--header-h) + var(--space-m));
    padding-bottom: var(--space-l);
    /* The rays reach past the page edge */
    overflow-x: clip;
  }
  .hero__grid {
    display: grid;
    gap: var(--space-m);
  }

  /* The title is sized against its own column and the length of the name, so the name stays on one
     line whatever the copy and whichever type set is chosen (0.45em is a generous average letter).
     A still wider face simply breaks the name. */
  .hero__head {
    position: relative;
    z-index: 2;
    container-type: inline-size;
  }
  .hero__title {
    font-size: min(var(--step-5), calc(100cqi / (var(--name-chars) * 0.45)));
  }
  /* The opening words are set as the title's smaller first line, in the lighter blue of a subtitle */
  .hero__opening {
    margin: 0 0 0.1em;
    font-size: 0.58em;
  }
  .hero__name {
    display: block;
  }

  .hero__figure {
    /* The kit's arch radius collapses its lower corners on tall frames; the width is known here,
       so the top is a true half circle and the foot keeps its curve. */
    --r-arch: calc(var(--fig) / 2) calc(var(--fig) / 2) 2.4rem 2.9rem / calc(var(--fig) / 2) calc(var(--fig) / 2)
      2.2rem 2.6rem;
    position: relative;
    width: var(--fig);
    /* Room above the arch for the rays, so they never run behind the title */
    margin-top: calc(var(--fig) * 0.26);
    margin-left: auto;
    margin-right: 0.5rem;
  }
  /* A square on the arch's round top: its centre is the centre of the sun */
  .hero__halo {
    position: absolute;
    inset: 0 0 auto;
    aspect-ratio: 1;
    pointer-events: none;
  }
  .hero__rays {
    position: absolute;
    inset: -30%;
  }
  .hero__plate {
    position: absolute;
    inset: 0;
    translate: -0.9rem 1rem;
    border-radius: var(--r-arch);
    background-color: var(--blue);
    background-image: url('/textures/grain-light.webp');
    background-size: 400px 400px;
    filter: url(#rough);
  }
  .hero__photo {
    position: relative;
  }

  .hero__lead {
    max-width: 36ch;
    margin-top: var(--space-s);
    color: var(--ink-strong);
  }
  .hero__more {
    display: grid;
    gap: var(--space-s);
    max-width: 25.5em;
  }
  .hero__more :global([lang='grc']) {
    white-space: nowrap;
  }

  /* Tablet: the portrait moves up beside the title and the lead; the rest runs underneath */
  @media (min-width: 46rem) {
    .hero {
      --fig: clamp(14rem, 31vw, 27rem);
      padding-top: calc(var(--header-h) + var(--space-l));
      padding-bottom: var(--space-xl);
    }
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) var(--fig);
      grid-template-areas:
        'head figure'
        'lead figure'
        'more more';
      /* Wide enough that the rays stop short of the text */
      column-gap: calc(var(--fig) * 0.3 + var(--space-s));
      align-items: start;
    }
    .hero__head {
      grid-area: head;
    }
    .hero__figure {
      grid-area: figure;
      /* The top of the rays stops just below the header, so the navigation stays on clean paper */
      margin-top: calc(var(--fig) * 0.3 + 0.75rem - var(--space-l));
      margin-right: 0;
    }
    .hero__plate {
      translate: -1.2rem 1.3rem;
    }
    .hero__lead {
      grid-area: lead;
      margin-top: 0;
    }
    .hero__more {
      grid-area: more;
    }
  }

  /* Desktop: all the text in one column, the portrait standing beside it */
  @media (min-width: 62rem) {
    .hero {
      --fig: clamp(19rem, 30vw, 27rem);
    }
    .hero__grid {
      grid-template-rows: auto auto 1fr;
      grid-template-areas:
        'head figure'
        'lead figure'
        'more figure';
    }
    .hero__head {
      margin-bottom: var(--space-s);
    }
    .hero__plate {
      translate: -1.5rem 1.6rem;
    }
  }
</style>
