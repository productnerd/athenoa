---
// "What Athena Says…": the first-person story in its four blocks, each with its photograph.
// The composition changes from block to block so the long text never settles into a template:
//   1 roots    a small pebble portrait hangs off the column and the text runs around it; the spring of
//              Mnemosyne stands in the margin beside the paragraph that names her
//   2 studies  the longest block; its photograph keeps the reader company (sticky on desktop)
//   3 return   a darker blue cut-out; the arch portrait stands out of its top edge, Athena rises behind it
//   4 academy  a light blue sheet laid over the corner of the last photograph, then the maxim
import { handCase } from '../../lib/hand';
import { withLemma } from '../../lib/lemma';
import type { ImageMetadata } from 'astro';
import Media from '../Media.astro';
import Illustration from '../Illustration.astro';
import Logos from './Logos.astro';
import { content } from '../../data';
import { getLocale, mainLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { about } = content(locale);
const t = {
  en: {
    library: 'A woman with dark hair and a white blouse smiles between library bookshelves, holding a book',
    graduation:
      'Graduates in red and blue academic gowns take their seats in a ceremony hall; one of them looks back over her shoulder',
    sea: 'A woman in white sits with her eyes closed and her hands folded, high above the blue sea',
    pines: 'A small group sits in a circle under pine trees, with the Acropolis on its rock behind them',
  },
  el: {
    library:
      'Μια γυναίκα με σκούρα μαλλιά και λευκή μπλούζα χαμογελά ανάμεσα στα ράφια μιας βιβλιοθήκης, κρατώντας ένα βιβλίο',
    graduation:
      'Απόφοιτοι με κόκκινες και μπλε ακαδημαϊκές τηβέννους παίρνουν τις θέσεις τους σε μια αίθουσα τελετών· μία απόφοιτη κοιτάζει πίσω, πάνω από τον ώμο της',
    sea: 'Μια γυναίκα ντυμένη στα λευκά κάθεται με κλειστά μάτια και ενωμένα χέρια, ψηλά πάνω από τη γαλάζια θάλασσα',
    pines: 'Μια μικρή ομάδα κάθεται σε κύκλο κάτω από πεύκα, με την Ακρόπολη πάνω στον βράχο της πίσω τους',
  },
}[mainLocale(locale)];

const files = import.meta.glob<{ default: ImageMetadata }>('../../assets/media/*.jpg', { eager: true });
const photo = (name: string) => files[`../../assets/media/${name}.jpg`].default;
const [roots, studies, back, academy] = about.story;
---

<section class="story" aria-labelledby="story-title">
  <div class="wrap">
    <div class="roots">
      <h2 id="story-title" class="hand story__title" data-reveal>{handCase(about.saysTitle)}</h2>
      <div class="story__text roots__text" data-reveal>
        <div class="roots__aside">
          <div data-depth="0.06">
            <Media
              src={photo(roots.image)}
              alt={t.library}
              shape="pebble-1"
              ratio="1 / 1"
              widths={[260, 389]}
              sizes="15rem"
              framed
            />
          </div>
        </div>
        {
          roots.paragraphs.map((text, i) => (
            <>
              <p set:html={text} />
            </>
          ))
        }
      </div>
    </div>

    <div class="story__block studies">
      <div class="studies__aside">
        <div class="studies__sticky">
          <div class="studies__pebble" data-reveal="grow"></div>
          <Media
            src={photo(studies.image)}
            alt={t.graduation}
            shape="leaf"
            ratio="3 / 4"
            focus="66% 50%"
            sizes="(min-width: 62rem) 46vw, 88vw"
          />
          <Illustration name="laurel" class="studies__laurel" draw />
        </div>
      </div>
      <div class="story__text studies__text" data-reveal>
        {
          studies.paragraphs.map((text, i) => (
            <>
              <p set:html={text} />
              {/* The marks of the institutions named so far stand where the academic part of the story ends */}
              {i === 3 && <Logos />}
            </>
          ))
        }
      </div>
    </div>

    <div class="story__block back">
      {/* The drawing of Athena that rose behind this panel is hidden at the client's wish (11 October 2026) */}
      <div class="panel panel--big on-blue-deep back__panel">
        <div class="panel__clip">
          <Illustration name="waves" class="back__waves" data-depth="0.12" />
        </div>
        <div class="back__photo" data-depth="-0.07">
          <Media
            src={photo(back.image)}
            alt={t.sea}
            shape="arch"
            ratio="3 / 4"
            focus="60% 40%"
            widths={[360, 560, 800, 1100]}
            sizes="(min-width: 62rem) 30vw, 60vw"
          />
        </div>
        <div class="story__text back__text" data-reveal>
          {back.paragraphs.map((text) => <p set:html={withLemma(text, locale)} />)}
        </div>
      </div>
    </div>

    <div class="story__block academy">
      <div class="box on-blue-light academy__sheet" data-reveal>
        <div class="story__text academy__text">
          {academy.paragraphs.map((text) => <p set:html={withLemma(text, locale)} />)}
        </div>
      </div>
      <div class="academy__photo" data-depth="0.1">
        <Media
          src={photo(academy.image)}
          alt={t.pines}
          shape="soft-2"
          ratio="3 / 2"
          sizes="(min-width: 62rem) 64vw, 90vw"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // A dictionary entry opens its note a moment after the pointer (or the keyboard) rests on it, and
  // a soft, warm two-note chime sounds as it opens (a low note, then the fifth above it). Silent when the visitor has muted the site.
  const WAIT = 260; // the same pause the stylesheet gives the note before it opens
  const VOLUME = 0.04;
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-lemma]:not([data-lemma-ready])').forEach((entry) => {
      entry.dataset.lemmaReady = '';
      let timer = 0;
      const open = () => {
        clearTimeout(timer);
        timer = window.setTimeout(() => {
          try {
            if (localStorage.getItem('ath-music') === 'off') return;
          } catch {}
          const sound = new Audio('/audio/pluck.mp3');
          sound.volume = VOLUME;
          sound.play().catch(() => {});
        }, WAIT);
      };
      const close = () => clearTimeout(timer);
      entry.addEventListener('pointerenter', open);
      entry.addEventListener('pointerleave', close);
      entry.addEventListener('focus', open);
      entry.addEventListener('blur', close);
    });
  });
</script>

<style>
  .story {
    position: relative;
    padding-block: var(--space-l) var(--space-xl);
    overflow-x: clip;
  }
  .story__block {
    position: relative;
    margin-top: var(--space-xl);
  }
  .story__title {
    margin-bottom: var(--space-l);
    font-size: clamp(2.4rem, 1.5rem + 3.8vw, 4.75rem);
    font-weight: 320;
    line-height: 1.05;
  }

  /* The reading column: about 64 characters to the line, open leading */
  .story__text {
    max-width: 25.5em;
    line-height: 1.62;
  }
  .story__text > p ~ p {
    margin-top: 1em;
  }
  .story__text :global([lang='grc']) {
    white-space: nowrap;
  }

  /* ---------- 1. Roots ---------- */
  .roots__aside {
    position: relative;
    width: 11.5rem;
    margin: 0 0 var(--space-m) 0.75rem;
  }
  .roots__text {
    position: relative;
  }
  .roots__text > p:first-of-type {
    font-size: calc(var(--step-0) * 1.16);
    line-height: 1.5;
    /* The opening quotation mark hangs in the margin */
    text-indent: -0.42em;
    hanging-punctuation: none;
  }
  /* The spring by the white cypress, where the Orphic soul drinks from Mnemosyne.
     On a phone it stands beside the portrait. */

  /* ---------- 2. Studies ---------- */
  .studies__aside {
    margin: 0 calc(var(--gutter) * -0.4) var(--space-l) 12%;
  }
  .studies__sticky {
    position: relative;
  }
  /* A light Aegean pebble behind the photograph's far corner */
  /* A portrait crop: tall, but never taller than the window it sticks in */
  .studies__sticky :global(.media) {
    max-width: min(100%, 64svh);
  }
  .studies__pebble {
    position: absolute;
    right: -7%;
    top: -16%;
    width: 52%;
    aspect-ratio: 1;
    border-radius: var(--r-pebble-3);
    background-color: var(--blue-light);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough);
  }
  .studies__laurel {
    position: absolute;
    left: -2.75rem;
    bottom: -2.5rem;
    width: 5.5rem;
  }

  /* ---------- 3. Return ---------- */
  /* (the top margin is the room the photograph needs where it leans out of the panel) */
  .back {
    --fig: min(56vw, 15.5rem);
    margin-top: calc(var(--space-xl) + 5.75rem);
  }
  .back__panel {
    z-index: 1;
    padding-bottom: calc(var(--space-xl) + 3rem);
  }
  .back__photo {
    --r-arch: calc(var(--fig) / 2) calc(var(--fig) / 2) 2.4rem 2.9rem / calc(var(--fig) / 2) calc(var(--fig) / 2)
      2.2rem 2.6rem;
    width: var(--fig);
    /* Leans out of the panel's top edge */
    margin-top: calc(var(--space-xl) * -1 - 4.75rem);
    margin-bottom: var(--space-m);
  }
  .back__waves {
    position: absolute;
    left: -2%;
    bottom: 1rem;
    width: max(104%, 44rem);
  }

  /* ---------- 4. Academy ---------- */
  .academy__sheet {
    z-index: 1;
    width: fit-content;
    margin-inline: calc(var(--gutter) * -0.3);
  }
  /* Tucked under the sheet's lower edge, but only as far as the sky: the Acropolis stays in view */
  .academy__photo {
    --r-soft-2: 5rem 8rem 6rem 9rem / 7rem 5rem 8rem 6rem;
    margin: -1.5rem calc(var(--gutter) * -0.4) 0 9%;
  }
  /* The olive branch lies above the button at every width, whatever the length of the label */
  .academy__olive {
    width: 8.5rem;
  }

  /* Tablet and up: the first block takes its editorial shape */
  @media (min-width: 46rem) {
    .roots {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-m);
    }
    .story__title {
      grid-column: 3 / -1;
    }
    .roots__text {
      grid-column: 5 / -1;
    }
    /* The portrait hangs off the column's left edge and the first lines follow its curve */
    .roots__aside {
      float: left;
      width: 15rem;
      margin: 0.4rem 1.9rem 1.2rem -9.75rem;
      shape-outside: circle(50%) border-box;
      shape-margin: 1.5rem;
    }

    .academy__photo {
      margin-top: -3.5rem;
    }
  }

  @media (min-width: 62rem) {
    .studies,
    .academy {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-m);
      align-items: start;
    }

    .studies__text {
      grid-column: 1 / span 6;
      grid-row: 1;
    }
    .studies__aside {
      grid-column: 7 / -1;
      grid-row: 1;
      align-self: stretch;
      margin: 0 calc(var(--gutter) * -0.5) 0 var(--space-m);
    }
    .studies__laurel {
      left: -4rem;
      bottom: -5.25rem;
      width: 9rem;
    }

    .back {
      --fig: clamp(17rem, 32vw, 28rem);
      margin-top: calc(var(--space-xl) + 7rem);
    }
    .back__panel {
      display: grid;
      grid-template-columns: var(--fig) minmax(0, 1fr);
      column-gap: var(--space-l);
      align-items: start;
      padding-bottom: calc(var(--space-xl) + 4.5rem);
    }
    .back__photo {
      margin-top: calc(var(--space-xl) * -1 - 6rem);
      margin-bottom: 0;
    }
    .back__waves {
      bottom: 1.5rem;
    }

    .academy__sheet {
      grid-column: 1 / span 7;
      grid-row: 1;
      margin-inline: 0;
    }
    .academy__photo {
      grid-column: 5 / -1;
      grid-row: 2;
      margin: -23rem calc(var(--gutter) * -0.5) 0 0;
    }
    .academy__olive {
      width: 14rem;
    }
  }

  /* The photograph only travels with the reader when the screen is tall enough to hold it */
  @media (min-width: 62rem) and (min-height: 44rem) {
    .studies__sticky {
      position: sticky;
      top: calc(var(--header-h) + 2.5rem);
    }
  }
</style>
