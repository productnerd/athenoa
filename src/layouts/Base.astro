---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import SvgDefs from '../components/SvgDefs.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackgroundMusic from '../components/BackgroundMusic.astro';
import NewsletterDialog from '../components/NewsletterDialog.astro';
import WaitlistDialog from '../components/WaitlistDialog.astro';
import { content } from '../data';
import { getLocale } from '../lib/locale';

interface Props {
  title: string;
  description: string;
  image?: string | import('astro').ImageMetadata;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  /** Adds a class to <body>, e.g. to let a page's hero sit under the header */
  bodyClass?: string;
  /** False for pages that end on their own scene (the 404 page). */
  footer?: boolean;
  /** False for pages that stand alone without the site header (the 404 page). */
  header?: boolean;
}
const { bodyClass, footer = true, header = true, ...seo } = Astro.props;
const locale = getLocale(Astro.url);
const { ui } = content(locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f2e9d3" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <Seo {...seo} />
    <!-- Runs before first paint: decides whether motion is on and whether it is night -->
    <script is:inline>
      (function () {
        // Is the sun down where the visitor is? Nobody is asked for their location: the place is
        // guessed from the device's time zone. Greece's zone is reckoned from Athens itself;
        // anywhere else from the zone's own meridian at a middling latitude, north or south, which
        // is right to within about an hour. (Declination and equation of time by the usual
        // short formulas; sunrise and sunset are where the sun's centre is 0.83 degrees down.)
        function sunDown(now) {
          var zone = '';
          try {
            zone = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
          } catch (e) {}
          var year = now.getFullYear();
          var jan = new Date(year, 0, 1).getTimezoneOffset();
          var jul = new Date(year, 6, 1).getTimezoneOffset();
          var lat = 38;
          var lon = -Math.max(jan, jul) / 4; // the zone's standard meridian: 15 degrees an hour
          var south = /^(Australia|Antarctica)\/|Auckland|Fiji|Sao_Paulo|Argentina|Santiago|Montevideo|Asuncion|La_Paz|Lima|Johannesburg|Maputo|Harare|Windhoek/;
          if (zone === 'Europe/Athens') {
            lat = 37.98;
            lon = 23.73;
          } else if (jan < jul || south.test(zone)) {
            lat = -34; // summer time in January, or a zone known to lie south
          }
          var rad = Math.PI / 180;
          var day = Math.floor((now.getTime() - Date.UTC(now.getUTCFullYear(), 0, 0)) / 864e5);
          var g = ((2 * Math.PI) / 365) * (day - 81);
          var decl = 0.4093 * Math.sin(g);
          var eot = 9.87 * Math.sin(2 * g) - 7.53 * Math.cos(g) - 1.5 * Math.sin(g); // minutes
          var cosH =
            (Math.sin(-0.833 * rad) - Math.sin(lat * rad) * Math.sin(decl)) / (Math.cos(lat * rad) * Math.cos(decl));
          var half = (Math.acos(Math.max(-1, Math.min(1, cosH))) / rad) * 4; // half the day, in minutes
          var noon = 720 - 4 * lon - eot; // solar noon, minutes after midnight UTC
          var fromNoon = (((now.getUTCHours() * 60 + now.getUTCMinutes() - noon) % 1440) + 1440) % 1440;
          return Math.min(fromNoon, 1440 - fromNoon) > half;
        }
        // Night after sunset, day after sunrise. A visitor who presses the switch keeps their
        // choice until the sun next rises or sets (it is stored with the sun's state, as
        // "dark@up"); ?theme=dark or ?theme=light in the address decides outright.
        function theme() {
          var root = document.documentElement;
          var sun = sunDown(new Date()) ? 'down' : 'up';
          root.dataset.sun = sun;
          var asked = new URLSearchParams(location.search).get('theme');
          if (!asked) {
            try {
              var kept = (localStorage.getItem('ath-theme') || '').split('@');
              if (kept[1] === sun) asked = kept[0];
              else localStorage.removeItem('ath-theme'); // the sun has moved on: the choice is spent
            } catch (e) {}
          }
          if (!asked) asked = sun === 'down' ? 'dark' : 'light';
          if (asked === 'dark') {
            if (root.dataset.theme !== 'dark') root.dataset.theme = 'dark';
          } else if (root.dataset.theme) delete root.dataset.theme;
        }
        function apply() {
          var root = document.documentElement;
          var query = new URLSearchParams(location.search);
          var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.classList.toggle('motion', !reduce && !query.has('nomotion'));
          theme();
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
        // A page left open follows the sun too: looked at again every few minutes and whenever
        // the tab comes back into view.
        setInterval(theme, 240000);
        document.addEventListener('visibilitychange', function () {
          if (!document.hidden) theme();
        });
        // If the motion script never arrives, do not leave content hidden.
        setTimeout(function () {
          if (!window.__athMotion) document.documentElement.classList.remove('motion');
        }, 5000);
      })();
    </script>
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <SvgDefs />
    {header && <Header />}
    <main id="main">
      <slot />
    </main>
    {footer && <Footer />}
    <BackgroundMusic />
    <NewsletterDialog />
    <WaitlistDialog />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
