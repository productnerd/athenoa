---
// Type test: every typeface option on one page, in English and Greek. A working page for choosing
// fonts, not part of the public site (noindex, left out of the sitemap). Delete it once the choice is made.
import Base from '../layouts/Base.astro';
import '@fontsource/alegreya/400-italic.css';

const sets = [
  {
    id: 'main',
    name: 'In use: PP Editorial New titles, Tekst reading text',
    note: 'Both load from this computer for now (trial or separately licensed cuts). Editorial New has no Greek and the Tekst trial has no accented Greek vowels, so Greek falls back to EB Garamond. A web licence for each is needed before launch.',
  },
  {
    id: 'a',
    name: 'EB Garamond throughout',
    note: 'Open licence and shipped with the site, so every visitor sees it. Complete Greek, including ancient polytonic.',
  },
  {
    id: 'b',
    name: 'Tekst throughout',
    note: 'Loaded from this computer (trial cut). Greek capitals and plain lowercase only: accented Greek vowels, and & € ( ) % and curly quotes, fall back to EB Garamond.',
  },
  {
    id: 'c',
    name: 'PP Editorial New throughout',
    note: 'Loaded from this computer. Latin only: everything in Greek falls back to EB Garamond.',
  },
];

const voices = [
  {
    name: 'Noto Serif Display Italic (in use)',
    note: 'Open licence, shipped. Complete Greek, including polytonic.',
    style: "font-family:'Noto Serif Display Variable',serif;font-style:italic;font-weight:320",
  },
  {
    name: 'Trattatello',
    note: 'A penned Renaissance hand. Built into macOS only, so other visitors would see the shipped fallback; a licensed web font would be needed. Modern Greek, no polytonic.',
    style: "font-family:'Trattatello',serif",
  },
  {
    name: 'Snell Roundhand',
    note: 'Formal copperplate script. Built into macOS only. Complete Greek, including polytonic.',
    style: "font-family:'Snell Roundhand',cursive;font-size:1.12em",
  },
  {
    name: 'Savoye LET',
    note: 'A light French-style script. Built into macOS only. Modern Greek, no polytonic.',
    style: "font-family:'Savoye LET',cursive;font-size:1.35em",
  },
  {
    name: 'Alegreya Italic',
    note: 'Open licence. Complete Greek, including polytonic.',
    style: "font-family:'Alegreya',serif;font-style:italic;font-weight:400",
  },
  {
    name: 'EB Garamond Italic',
    note: 'Already shipped. Complete Greek, including polytonic.',
    style: "font-family:'EB Garamond Variable',serif;font-style:italic;font-weight:400",
  },
];

// A wider set of handwriting to choose from. Most come from Google Fonts and are loaded for this page
// only; a few are fonts already installed on this computer. Very few handwriting fonts cover Greek.
const hands = [
  { group: 'More handwriting and calligraphic hands that cover Greek', fonts: [
    { name: 'Bimbo', greek: true, local: true, scale: 1.1 },
    { name: 'Zen Kurenaido', greek: true },
    { name: 'Bona Nova', greek: true, italic: true, spec: 'Bona+Nova:ital@1' },
    { name: 'Arima', greek: true, scale: 0.95 },
    { name: 'Arturo Trial', greek: true, local: true, scale: 0.9 },
    { name: 'Lovelace Trial', greek: true, local: true, italic: true },
    { name: 'Monterchi Trial', greek: true, local: true, italic: true },
    { name: 'Luminari', greek: true, local: true, scale: 0.9 },
    { name: 'NF-Lolotte', greek: true, local: true, scale: 2 },
    { name: 'Brush Script MT', greek: true, local: true, scale: 1.2 },
    { name: 'Marker Felt', greek: true, local: true, scale: 0.95 },
    { name: 'Chalkboard SE', greek: true, local: true, scale: 0.9 },
    { name: 'Comic Relief', greek: true, scale: 0.9 },
  ] },
  { group: 'Handwriting that covers Greek (the first eight)', fonts: [
    { name: 'Mynerve', greek: true },
    { name: 'Playpen Sans', greek: true, scale: 0.9 },
    { name: 'Bradley Hand', greek: true, local: true },
    { name: 'Noteworthy', greek: true, local: true, scale: 0.95 },
    { name: 'SignPainter', greek: true, local: true, scale: 1.2 },
    { name: 'Trattatello', greek: true, local: true },
    { name: 'Snell Roundhand', greek: true, local: true, scale: 1.15 },
    { name: 'Savoye LET', greek: true, local: true, scale: 1.45 },
  ] },
  { group: 'Natural pen handwriting', fonts: [
    { name: 'Homemade Apple', greek: false },
    { name: 'Nothing You Could Do', greek: false },
    { name: 'La Belle Aurore', greek: false },
    { name: 'Cedarville Cursive', greek: false },
    { name: 'Zeyada', greek: false, scale: 1.25 },
    { name: 'Dawning of a New Day', greek: false, scale: 1.15 },
    { name: 'Over the Rainbow', greek: false },
  ] },
  { group: 'Elegant script', fonts: [
    { name: 'Pinyon Script', greek: false, scale: 1.15 },
    { name: 'Italianno', greek: false, scale: 1.4 },
    { name: 'Petit Formal Script', greek: false, scale: 0.9 },
    { name: 'Mrs Saint Delafield', greek: false, scale: 1.4 },
    { name: 'Monsieur La Doulaise', greek: false, scale: 1.3 },
    { name: 'Tangerine', greek: false, scale: 1.5 },
    { name: 'Allura', greek: false, scale: 1.2 },
    { name: 'Parisienne', greek: false, scale: 1.1 },
  ] },
  { group: 'Loose and modern', fonts: [
    { name: 'Caveat', greek: false, scale: 1.25 },
    { name: 'Reenie Beanie', greek: false, scale: 1.35 },
    { name: 'Shadows Into Light', greek: false },
    { name: 'Covered By Your Grace', greek: false, scale: 1.15 },
  ] },
  { group: 'Already installed on this computer (English only)', fonts: [
    { name: 'Alex Brush', greek: false, local: true, scale: 1.2 },
    { name: 'Fonseca Script', greek: false, local: true },
    { name: 'Heliuk Script', greek: false, local: true },
    { name: 'Lovelace Script Trial', greek: false, local: true },
    { name: 'Gunsan Script', greek: false, local: true },
    { name: 'Kaushan Script', greek: false, local: true },
  ] },
];
const webFamilies = hands
  .flatMap((group) => group.fonts)
  .filter((font) => !font.local)
  .map((font) => `family=${font.spec ?? font.name.replace(/ /g, '+')}`)
  .join('&');
const webFontsUrl = `https://fonts.googleapis.com/css2?${webFamilies}&display=swap`;

const sample = {
  en: {
    lang: 'en',
    label: 'English',
    title: ['STUDY AT THE MODERN ', 'PLATONIC', 'ACADEMY'],
    sub: '& REMEMBER WHO YOU REALLY ARE',
    h2: 'Benefits of Joining ATHENOA',
    h3: 'You will follow in the footsteps of Education followed by the Ancient Sages',
    lead: 'Would you like to study methodically on the Path of Greek Philosophy and Light?',
    voice: 'Dear Friends and Bright Fellow Travelers on the Path of the Greek Light,',
    button: 'Get started',
    figures: '€200 & VAT (24%) ~ 387 BC - 529 AD ~ “philo” ~ ‘sophia’',
  },
  el: {
    lang: 'el',
    label: 'Ελληνικά',
    title: ['ΣΠΟΥΔΑΣΤΕ ΣΤΗ ΣΥΓΧΡΟΝΗ ', 'ΠΛΑΤΩΝΙΚΗ', 'ΑΚΑΔΗΜΙΑ'],
    sub: '& ΘΥΜΗΘΕΙΤΕ ΠΟΙΟΙ ΠΡΑΓΜΑΤΙΚΑ ΕΙΣΤΕ',
    h2: 'Τα οφέλη της συμμετοχής στην ATHENOA',
    h3: 'Θα ακολουθήσετε τα βήματα της Παιδείας που ακολούθησαν οι Αρχαίοι Σοφοί',
    lead: 'Θα θέλατε να σπουδάσετε μεθοδικά στον Δρόμο της Ελληνικής Φιλοσοφίας και του Φωτός;',
    voice: 'Αγαπητοί Φίλοι και Φωτεινοί Συνοδοιπόροι στον Δρόμο του Ελληνικού Φωτός,',
    button: 'Ξεκινήστε',
    figures: '€200 & ΦΠΑ (24%) ~ 387 π.Χ. - 529 μ.Χ. ~ «φιλο-» ~ «σοφία»',
  },
};
---

<Base title="Type test | ATHENOA" description="Every typeface option for the site, in English and Greek." noindex>
  <section class="section wrap intro">
    <h1 class="t-1">Type test</h1>
    <p class="lead">
      The type in use and its alternatives for titles and reading, then the handwritten voice: six first options and a wider gallery of thirty more.
    </p>
  </section>

  {
    sets.map((set) => (
      <section class="wrap set" data-fonts={set.id}>
        <header class="set__head">
          <h2 class="t-2">{set.name}</h2>
          <p class="set__note">{set.note}</p>
        </header>
        <div class="set__cols">
          {[sample.en, sample.el].map((text) => (
            <div class="set__col stack" lang={text.lang}>
              <p class="set__lang">{text.label}</p>
              <p class="t-hero set__hero">
                {text.title[0]}
                <span class="hl">
                  <span class="hl__w">{text.title[1]}</span> <span class="hl__w">{text.title[2]}</span>
                </span>
                <span class="t-sub">{text.sub}</span>
              </p>
              <p class="t-2">{text.h2}</p>
              <p class="t-3">{text.h3}</p>
              <p class="lead">{text.lead}</p>
              {text.lang === 'en' ? (
                <p class="measure">
                  The Greek philosophical tradition did not originate from division; it did not begin with an
                  ontological rupture between being and mind, <strong>spirit and matter</strong>,{' '}
                  <em>knower and known</em>, inner and outer. What the Ancients called the Good life:{' '}
                  <span lang="grc">Εὖ Ζῆν</span>.
                </p>
              ) : (
                <p class="measure">
                  Η ελληνική φιλοσοφική παράδοση δεν γεννήθηκε από τον διχασμό· δεν ξεκίνησε με μια οντολογική ρήξη
                  ανάμεσα στο είναι και τον νου, <strong>το πνεύμα και την ύλη</strong>,{' '}
                  <em>τον γνώστη και το γνωστό</em>, το μέσα και το έξω. Αυτό που οι Αρχαίοι ονόμαζαν:{' '}
                  <span lang="grc">Εὖ Ζῆν</span>.
                </p>
              )}
              <p class="set__figures">{text.figures}</p>
              <p>
                <span class="btn">{text.button}</span>
              </p>
            </div>
          ))}
        </div>
      </section>
    ))
  }

  <section class="wrap set">
    <header class="set__head">
      <h2 class="t-2">The voice</h2>
      <p class="set__note">
        Used where Athena speaks in her own voice: greetings, asides and maxims. No script font with an open licence
        covers Greek, so the true scripts here are ones built into macOS; the italics are the open alternatives.
      </p>
    </header>
    <div class="voices">
      {
        voices.map((voice) => (
          <div class="voice">
            <p class="set__lang">
              {voice.name}. {voice.note}
            </p>
            <p class="voice__line" style={voice.style}>{sample.en.voice}</p>
            <p class="voice__line" style={voice.style} lang="el">{sample.el.voice}</p>
          </div>
        ))
      }
    </div>
  </section>
  <section class="wrap set">
    <link rel="stylesheet" href={webFontsUrl} />
    <header class="set__head">
      <h2 class="t-2">More handwriting</h2>
      <p class="set__note">
        One sentence in each, in English and in Greek. Very few handwriting fonts cover Greek: where one does not,
        its Greek line is set in the italic that would stand in for it on the Greek pages. "On this computer" means
        the font is installed here and would need a web licence before launch.
      </p>
    </header>
    {
      hands.map((group) => (
        <div class="hands">
          <h3 class="hands__group">{group.group}</h3>
          <ul class="hands__list" role="list">
            {group.fonts.map((font) => (
              <li class="hand-card">
                <p class="set__lang">
                  {font.name}
                  {font.local ? ' · on this computer' : ''}
                  {font.greek ? ' · covers Greek' : ' · no Greek: the Greek line shows the stand-in italic'}
                </p>
                <p class="hand-card__line" style={`font-family:'${font.name}',cursive;--k:${font.scale ?? 1};${font.italic ? 'font-style:italic;' : ''}`}>
                  {sample.en.voice}
                </p>
                {/* Where the font has no Greek, the Greek line is set in the hand that would stand in for it */}
                <p
                  class="hand-card__line"
                  lang="el"
                  style={`font-family:'${font.name}','Noto Serif Display Variable',serif;--k:${font.scale ?? 1};${font.greek && !font.italic ? '' : 'font-style:italic;'}`}
                >
                  {sample.el.voice}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</Base>

<style>
  .intro {
    padding-bottom: var(--space-l);
  }
  .set {
    padding-block: var(--space-l);
    border-top: 1.5px solid var(--line);
  }
  .set__head {
    display: grid;
    gap: 0.4rem;
    margin-bottom: var(--space-l);
  }
  .set__note,
  .set__lang {
    font-family: system-ui, sans-serif;
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--ink-soft);
    max-width: 62ch;
  }
  .set__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) clamp(2rem, 1rem + 4vw, 5rem);
  }
  .set__col {
    --stack: var(--space-m);
    min-width: 0;
  }
  /* The hero size is scaled down here so two columns fit; proportions between sets are kept */
  .set__hero {
    font-size: calc(var(--step-5) * 0.46);
  }
  .set__hero :global(.t-sub),
  .set__hero .t-sub {
    font-size: calc(var(--step-3) * 0.5);
  }
  .set__figures {
    font-variant-numeric: lining-nums;
  }
  .voices {
    display: grid;
    gap: var(--space-l);
  }
  .voice__line {
    font-size: var(--step-2);
    line-height: 1.16;
    color: var(--blue);
  }
  .voice__small {
    margin-top: 0.5rem;
    font-size: var(--step-1);
    line-height: 1.25;
    color: var(--blue);
  }
  .hands + .hands {
    margin-top: var(--space-l);
  }
  .hands__group {
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--blue);
    margin-bottom: var(--space-s);
  }
  .hands__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 27rem), 1fr));
    gap: var(--space-m) var(--space-l);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hand-card {
    padding-top: 0.9rem;
    border-top: 1.5px solid var(--line);
  }
  .hand-card__line {
    margin-top: 0.35rem;
    font-size: calc(1.9rem * var(--k, 1));
    line-height: 1.25;
    color: var(--blue);
  }
  .hand-card__small {
    margin-top: 0.2rem;
    font-size: calc(1.35rem * var(--k, 1));
    line-height: 1.3;
    color: var(--sub-ink);
  }
  .hand-card__line > *,
  .hand-card__small > * {
    font-size: inherit;
  }
  @media (max-width: 56rem) {
    .set__cols {
      grid-template-columns: 1fr;
    }
    .set__hero {
      font-size: calc(var(--step-5) * 0.7);
    }
    .set__hero .t-sub {
      font-size: calc(var(--step-3) * 0.7);
    }
  }
</style>
