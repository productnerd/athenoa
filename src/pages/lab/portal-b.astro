---
// Lab page: home hero "Portal" attempt B (side by side) above plain filler, so the scroll
// parallax can be judged. Not part of the published site.
import Base from '../../layouts/Base.astro';
import PortalB from '../../components/home/hero/PortalB.astro';
---

<Base title="Portal B | ATHENOA lab" description="Home hero: the original picture redrawn, side by side" noindex>
  <PortalB />
  <div class="wrap filler" aria-hidden="true"></div>
  <div class="wrap filler filler--short" aria-hidden="true"></div>
</Base>

<style>
  .filler {
    height: 85vh;
    margin-block: var(--space-l);
    border: 1.5px dashed var(--line);
    border-radius: var(--r-soft);
  }
  .filler--short {
    height: 60vh;
    border-radius: var(--r-soft-2);
  }
</style>
