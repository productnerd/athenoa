---
// Lab page: candidates for the "voice" face, in English and Greek. Not part of the published site.
import Base from '../../layouts/Base.astro';
import '@fontsource/mansalva/latin-400.css';
import '@fontsource/mansalva/greek-400.css';
import '@fontsource/alegreya/400-italic.css';
import '@fontsource/alegreya/500-italic.css';
import '@fontsource-variable/noto-serif-display/wght-italic.css';
const faces = [
  { name: 'Alegreya Italic', css: "font-family:'Alegreya';font-style:italic;font-weight:400" },
  { name: 'Noto Serif Display Italic, light (now in use)', css: "font-family:'Noto Serif Display Variable';font-style:italic;font-weight:300" },
  { name: 'EB Garamond Italic', css: "font-family:'EB Garamond Variable';font-style:italic;font-weight:400" },
  { name: 'Mansalva (the earlier handwriting)', css: "font-family:'Mansalva'" },
];
---

<Base title="Voice face | ATHENOA lab" description="Voice face candidates" noindex>
  <section class="section wrap">
    {
      faces.map((face) => (
        <div style="margin-bottom:2.6rem">
          <p class="small" style="opacity:.7">{face.name}</p>
          <p style={`${face.css};font-size:2.5rem;line-height:1.18;color:var(--blue)`}>
            Dear Friends and Bright Fellow Travelers on the Path of the Greek Light,
          </p>
          <p style={`${face.css};font-size:2.5rem;line-height:1.18;color:var(--blue)`}>
            Αγαπητοί Φίλοι και Φωτεινοί Συνοδοιπόροι στον Δρόμο του Ελληνικού Φωτός, Εὖ Ζῆν
          </p>
          <p style={`${face.css};font-size:1.5rem;line-height:1.25;color:var(--blue)`}>
            I await you with joy and enthusiasm on a New Initiatic Journey · *THE SEMINAR START DATE WILL BE ANNOUNCED SOON* · ΓΝΩΘΙ ΣΑΥΤΟΝ
          </p>
        </div>
      ))
    }
  </section>
</Base>
