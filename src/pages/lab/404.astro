---
// Lab page: the not-found scene on its own, at /lab/404/. Not part of the published site.
// The scene picks its language from the address (/el/...); here ?locale=el shows the Greek words.
import Base from '../../layouts/Base.astro';
import NotFoundScene from '../../components/notfound/NotFoundScene.astro';
import { notfound } from '../../data/notfound';
import { site } from '../../data/site';
---

<Base title={`${notfound.en.heading} | ${site.name}`} description={notfound.en.line} noindex footer={false}>
  <script is:inline data-astro-rerun>
    if (new URLSearchParams(location.search).get('locale') === 'el')
      document.documentElement.setAttribute('data-nf-lang', 'el');
  </script>
  <NotFoundScene />
</Base>
