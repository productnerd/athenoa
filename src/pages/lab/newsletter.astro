---
// Lab page: the newsletter popup on its own, at /lab/newsletter/ (Greek at /el/lab/newsletter/).
// A link to #newsletter and an element with data-newsletter-open, the two ways of opening it, over
// enough of a page (paper, a blue panel, line art) to judge the blur behind the popup.
// Not part of the published site. Once the layout carries <NewsletterDialog />, drop it from here.
import Base from '../../layouts/Base.astro';
import Illustration from '../../components/Illustration.astro';
import NewsletterDialog from '../../components/NewsletterDialog.astro';
import { content } from '../../data';
import { getLocale } from '../../lib/locale';

const { announcement } = content(getLocale(Astro.url)).home;
const { text, cta } = announcement.newsletter;
---

<Base title="Newsletter popup | ATHENOA" description={text} noindex>
  <section class="section">
    <div class="wrap wrap--narrow stack" style="--stack: var(--space-m)">
      <p class="hand hand--m">{announcement.greeting}</p>
      <p class="lead">{text}</p>
      <p><a class="btn" href="#newsletter" data-lab-link>{cta.label}</a></p>
      <p><button class="btn btn--ghost" type="button" data-newsletter-open>{cta.label}</button></p>
      <div class="panel on-blue stack">
        <h2 class="t-2">{announcement.text}</h2>
        <Illustration name="temple" style="width: min(100%, 22rem)" />
      </div>
    </div>
  </section>
  <NewsletterDialog />
</Base>
