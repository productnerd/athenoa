---
// Nostos, Play: ten short activities drawn from her talks, and Diotima's ladder as the visitor's
// progress (tasks/nostos.md, Play and Progress). The menu and the ladder are in the page; each activity
// runs in one dialog (src/scripts/nostos-play.ts) and fetches its own material when it starts. The path
// and Review open a page of their own (path.astro).
// Not in the sitemap and noindex until launch. THE CONTENT IS NEW WORDING for Athena to review.
import Base from '../../layouts/Base.astro';
import NostosNav from '../../components/nostos/NostosNav.astro';
import Illustration from '../../components/Illustration.astro';
import { nostosUi } from '../../data/nostos/ui';
import {
  concepts,
  distinctions,
  edges,
  etymologies,
  myths,
  nostosFlags,
  practices,
  quiz,
  sequences,
} from '../../lib/nostos';
import { askedTotal, pathOutline } from '../../lib/nostos-path';
import { numerals, stageArt } from '../../lib/nostos-stages';
import StageStele from '../../components/nostos/StageStele.astro';
import { getLocale, mainLocale, pathIn } from '../../lib/locale';
import '../../styles/nostos-arena.css';

const locale = getLocale(Astro.url);
const ui = nostosUi[mainLocale(locale)];
const t = ui.play;
const cards = concepts.filter((c) => c.greek && c.take).length;
const count = (text: string, n: number) => text.replace('{n}', String(n));

// Each activity: its symbol, its paper, its shape and how much of the row it takes, so the menu is not
// a grid of identical cards (DESIGN, Avoid)
type Act = { id: keyof typeof t.acts; symbol: string; surface: string; shape: string; span: number; count: string };
const acts: Record<'remember' | 'understand' | 'own', Act[]> = {
  remember: [
    { id: 'cards', symbol: 'tetractys', surface: 'on-blue-light', shape: 'var(--r-soft)', span: 7, count: count(t.acts.cards.count, cards) },
    { id: 'match', symbol: 'bow-lyre', surface: '', shape: 'var(--r-pebble-2)', span: 5, count: t.acts.match.none },
    { id: 'quiz', symbol: 'tripod', surface: 'on-blue-deep', shape: 'var(--r-leaf)', span: 5, count: count(t.acts.quiz.count, quiz.length) },
    { id: 'tf', symbol: 'torch', surface: 'box--deep', shape: 'var(--r-soft-2)', span: 7, count: t.acts.tf.none },
  ],
  understand: [
    { id: 'ladder', symbol: 'ladder', surface: 'on-blue', shape: 'var(--r-soft-2)', span: 5, count: count(t.acts.ladder.count, sequences.filter((s) => s.steps?.length >= 3 && s.steps.length <= 9).length) },
    { id: 'myth', symbol: 'orphic-egg', surface: '', shape: 'var(--r-pebble-1)', span: 7, count: count(t.acts.myth.count, myths.filter((m) => m.beats?.length >= 2).length) },
    { id: 'forge', symbol: 'wheat', surface: 'box--deep', shape: 'var(--r-soft)', span: 7, count: count(t.acts.forge.count, etymologies.filter((e) => e.parts?.length >= 2 && e.parts.length <= 4).length) },
    { id: 'fork', symbol: 'spring-cypress', surface: 'on-blue-light', shape: 'var(--r-leaf)', span: 5, count: count(t.acts.fork.count, distinctions.filter((d) => d.a && d.b && d.a_gloss && d.b_gloss).length) },
    { id: 'links', symbol: 'olive-branch', surface: 'on-blue-deep', shape: 'var(--r-pebble-1)', span: 7, count: count(t.acts.links.count, edges.filter((e) => e.her && e.why && e.why.length > 12).length) },
  ],
  own: [
    { id: 'threads', symbol: 'butterfly', surface: 'on-blue-deep', shape: 'var(--r-pebble-3)', span: 6, count: count(t.acts.threads.count, 0) },
    { id: 'askesis', symbol: 'cave-sun', surface: 'on-blue-light', shape: 'var(--r-soft)', span: 6, count: count(t.acts.askesis.count, practices.length) },
    ...(nostosFlags.claude
      ? ([
          { id: 'spar', symbol: 'monad', surface: '', shape: 'var(--r-soft-2)', span: 6, count: t.acts.spar.count },
          { id: 'teach', symbol: 'olive-branch', surface: 'on-blue', shape: 'var(--r-pebble-1)', span: 6, count: t.acts.teach.count },
        ] as Act[])
      : []),
  ],
};
const words = { ...t, groups: ui.groups, uncertain: ui.note.uncertain };
const fill = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, k) => String(values[k] ?? ''));
const lessons = pathOutline.reduce((n, c) => n + c.lessons.length, 0);

// the journey: each stone's sway left or right (-1 to 1), and the dotted trail through them, in a box
// 100 wide and 100 high per stone (stretched to the column)
const sway = (ci: number, li: number) => Math.sin(li * 0.95 + ci * 1.7) * 0.95;
// stepping stones: each its own pebble, turned a little, a few a touch larger or smaller; and each
// chapter's banner its own hand-cut shape (client direction, 6 November 2026)
const pebbles = [
  '52% 48% 50% 50% / 50% 52% 48% 50%',
  'var(--r-pebble-1)',
  '47% 53% 44% 56% / 55% 46% 54% 45%',
  'var(--r-pebble-2)',
  '56% 44% 52% 48% / 45% 56% 44% 55%',
  'var(--r-pebble-3)',
  '50% 50% 50% 50%',
];
const pebble = (ci: number, li: number) => {
  const k = ci * 7 + li * 5;
  return `--sr:${pebbles[k % pebbles.length]};--rot:${((k * 13) % 15) - 7}deg;--sz:${[1, 1.06, 0.95, 1, 1.03, 0.97][k % 6]}`;
};
const cuts = ['var(--r-soft)', 'var(--r-soft-2)', '2.8rem 2rem 3.2rem 2.4rem / 2.2rem 3rem 2.4rem 3.2rem', '2.2rem 3.4rem 2.6rem 3rem / 3.2rem 2.4rem 3.4rem 2.2rem'];
const trail = (ci: number, n: number) =>
  Array.from({ length: n }, (_, li) => [50 + sway(ci, li) * 50, li * 100 + 50])
    .map(([x, y], k, all) => {
      if (!k) return `M${x.toFixed(1)} ${y}`;
      const [px, py] = all[k - 1];
      return ` C${px.toFixed(1)} ${py + 50} ${x.toFixed(1)} ${y - 50} ${x.toFixed(1)} ${y}`;
    })
    .join('');
// the places on the way home, drawn in src/assets/illustrations/journey-*.svg, three chapters to each;
// each drawing is defined once (as a symbol) and shown behind its chapters
const raw = import.meta.glob<string>('../../assets/illustrations/journey-*.svg', { query: '?raw', import: 'default', eager: true });
const scenes = Object.entries(raw)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([file, svg], k) => {
    const open = svg.match(/<svg\b([^>]*)>/)!;
    // (the line weight is left to the page, so phones can have it heavier)
    const attrs = open[1].replace(/\s(xmlns(:\w+)?|viewBox|width|height|stroke-width)="[^"]*"/g, '');
    const inner = svg.slice(open.index! + open[0].length, svg.lastIndexOf('</svg>'));
    return { id: k, viewBox: open[1].match(/viewBox="([^"]+)"/)?.[1] ?? '0 0 1600 1000', attrs, inner, name: file };
  });
// a stage of the arc shows its own place (the cave in the cave, client direction); talks, before the arc,
// took the places in turn
const sceneFor = (ci: number) => {
  const named = pathOutline[ci].scene && scenes.findIndex((sc) => sc.name.includes(`-${pathOutline[ci].scene}.`));
  if (typeof named === 'number' && named >= 0) return named;
  return scenes.length ? Math.min(scenes.length - 1, Math.floor((ci * scenes.length) / pathOutline.length)) : 0;
};
// a talk's long title is cut at its natural break (a colon, a tilde, a dash, a bracket, "according
// to"): the first part is the chapter's title, the rest the line under it (client direction)
const split = (title: string): [string, string] => {
  for (const sep of [': ', '? ', ' ~ ', ' – ', ' - ', ' (', ' according to ']) {
    const at = title.toLowerCase().indexOf(sep);
    if (at > 3) {
      const rest = title.slice(at + sep.length).replace(/\)$/, sep === ' (' && !title.slice(at + 2).includes('(') ? '' : ')');
      const sub = (sep === ' according to ' ? 'According to ' : '') + rest;
      const head = title.slice(0, at).replace(/[,;]\s*$/, '') + (sep === '? ' ? '?' : '');
      return [head, sub.charAt(0).toUpperCase() + sub.slice(1)];
    }
  }
  return [title, ''];
};
// a chapter's name and line: its own (from the arc, in the page's language), else its stage's, else
// its talk's title cut in two
const lang = mainLocale(locale) === 'en' ? 'en' : 'el';
type Ch = (typeof pathOutline)[number];
const stageName = (id: string) => (t.path.stages as Record<string, string>)[id] ?? id;
const stageAbout = (id: string) => (t.path.about as Record<string, string>)[id] ?? '';
const chapterTitle = (c: Ch) => c.names?.[lang] ?? (c.stage ? stageName(c.stage) : split(c.title)[0] || t.path.across);
const chapterAbout = (c: Ch) => c.about?.[lang] ?? (c.stage && !c.names ? stageAbout(c.stage) : c.stage ? '' : split(c.title)[1]);
// with stages: each stage opens with its own heading, and its chapters are numbered within it
const stageIds = [...new Set(pathOutline.map((c) => c.stage).filter((x): x is string => !!x))];
const opensStage = (ci: number) => !!pathOutline[ci].stage && pathOutline[ci].stage !== pathOutline[ci - 1]?.stage;
const placeIn = (ci: number) => {
  const st = pathOutline[ci].stage;
  if (!st) return { i: ci + 1, n: pathOutline.length };
  const same = pathOutline.filter((c) => c.stage === st);
  return { i: same.indexOf(pathOutline[ci]) + 1, n: same.length };
};
const staged = stageIds.length > 0 && pathOutline.some((c) => c.names);
// each stage's own drawing (the site's symbols), on its milestone and faint across its chapters' cards,
// and its number in Greek numerals, carved on the milestone (client direction, 6 November 2026)
---

<Base title={`${t.metaTitle} | ATHENOA`} description={t.metaDescription} noindex>
  <NostosNav />
  <div
    data-nplay
    data-feed-src="/nostos/data/"
    data-map-href={pathIn(locale, '/nostos/')}
    data-path-href={pathIn(locale, '/nostos/path/')}
    data-asked={askedTotal}
    data-stars={concepts.length}
  >
    <h1 class="visually-hidden">{t.title}</h1>
    <p class="nplay-nojs wrap">
      {t.noScript} <a href={pathIn(locale, '/nostos/')}>{t.mapLink}</a>
    </p>

    {/* The path as a journey (client direction, 6 November 2026): one column of lesson stones to
        scroll down, a chapter (a talk) at a time. Each chapter's banner stays at the top while it is
        walked, so the title is always the chapter you are in; behind it, the chapter's place on the
        journey home (scenes in src/assets/illustrations/journey-*.svg). */}
    {/* the places on the way home: one still layer behind the journey, each place fading into the
        next as the chapters change (a place can stay for several chapters; client direction) */}
    {
      scenes.length > 0 && (
        <div class="njscenes" aria-hidden="true" data-scenes>
          {scenes.map((sc) => (
            <svg class="njscene" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMax meet" focusable="false" data-scene={sc.id} data-place={sc.name.match(/journey-\d+-([a-z]+)/)?.[1]}>
              <use href={`#njenv-${sc.id}`} />
            </svg>
          ))}
        </div>
      )
    }
    <div class="njourney" data-journey>
      {
        pathOutline.map((c, ci) => (
          <section class="njch" data-ch={ci} data-ch-stage={c.stage} data-ch-scene={scenes.length ? sceneFor(ci) : undefined} aria-labelledby={`njch-${ci}`}>
            {staged && opensStage(ci) && (
              <header class:list={['njstage', ci === 0 && 'is-first']} id={`stage-${c.stage}`}>
                {/* a milestone, as the Greeks marked their roads: the stage's drawing on its face, its
                    number carved at the top */}
                <StageStele stage={c.stage!} numeral={numerals[stageIds.indexOf(c.stage!)]} />
                <h2 class="njstage__title">{stageName(c.stage!)}</h2>
                {stageAbout(c.stage!) && <p class="njstage__about">{stageAbout(c.stage!)}</p>}
              </header>
            )}
            {/* the stages take the dark blue and the light blue in turn, so each new stage reads as one */}
            <header
              class:list={['njch__banner box', c.stage && stageIds.indexOf(c.stage) % 2 ? 'on-blue-light' : 'on-blue']}
              style={`--box-r:${cuts[ci % cuts.length]}`}
            >
              {c.stage && stageArt[c.stage] && (
                <span class="njch__art" aria-hidden="true">
                  <Illustration name={stageArt[c.stage]} note={false} />
                </span>
              )}
              <p class="njch__n">{fill(t.path.chapter, placeIn(ci))}</p>
              <h2 class="njch__title" id={`njch-${ci}`} lang={!c.stage && c.title ? 'en' : undefined}>
                {chapterTitle(c)}
              </h2>
              {chapterAbout(c) && (
                <p class="njch__about" lang={!c.stage ? 'en' : undefined}>
                  {chapterAbout(c)}
                </p>
              )}
              <div class="njch__bar" aria-hidden="true">
                <span data-ch-fill />
              </div>
              <p class="njch__count" data-ch-count></p>
              <button type="button" class="njch__skip" data-skip-ch={ci} hidden>{t.path.skip.start}</button>
            </header>
            <ol class="njch__stones" style={`--rows:${c.lessons.length}`}>
              <svg class="njch__trail" viewBox={`0 0 100 ${c.lessons.length * 100}`} preserveAspectRatio="none" aria-hidden="true">
                <path d={trail(ci, c.lessons.length)} />
              </svg>
              {c.lessons.map((_, li) => (
                <li style={`--x:${sway(ci, li).toFixed(3)}`}>
                  <button
                    type="button"
                    class="nnode"
                    style={pebble(ci, li)}
                    data-node
                    data-c={ci}
                    data-l={li}
                    aria-label={fill(t.path.lesson, { i: li + 1, n: c.lessons.length })}
                    disabled
                  >
                    <span class="nnode__n">{li + 1}</span>
                    <svg class="nnode__tick" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                      <path d="M5 12.6c2 1.6 3.6 3.4 5 5.4 2.6-4.6 5.6-8.6 9-12" />
                    </svg>
                    <span class="nnode__go" data-node-go />
                  </button>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>

    {/* the stages at a glance: one mark each, the one you are in filled, those walked ticked; a mark
        scrolls to its stage */}
    {
      staged && (
        <nav class="njrail" aria-label={t.path.rail}>
          <ol>
            {stageIds.map((st, k) => (
              <li>
                <button type="button" class="njrail__mark" data-rail={st} title={stageName(st)}>
                  <span class="njrail__num" lang="grc">{numerals[k]}</span>
                  <span class="visually-hidden">{stageName(st)}</span>
                </button>
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    {/* Review and the ascent, a button away (client direction, 6 November 2026) */}
    <div class="nfloat">
      {/* always at hand: on to the lesson you are at (client direction, 6 November 2026) */}
      <button type="button" class="nfloat__btn nfloat__btn--go" data-path-go>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 12h13M13 6.5 18.5 12 13 17.5" />
        </svg>
        <span data-path-go-label>{t.path.begin}</span>
      </button>
      <button type="button" class="nfloat__btn" data-pop-open="review">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M4.5 12a7.5 7.5 0 1 0 2.4-5.5M4.6 3.8l.3 3.6 3.6-.4" />
        </svg>
        <span>{t.review.title}</span>
        <span class="nfloat__badge" data-review-badge hidden></span>
      </button>
      <button type="button" class="nfloat__btn" data-pop-open="ascent">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M8 3v18M16 3v18M8 7h8M8 12h8M8 17h8" />
        </svg>
        <span>{t.ascent.title}</span>
      </button>
    </div>

    <dialog class="npop" data-pop="skip" aria-labelledby="npop-skip">
      <div class="npop__sheet box on-blue-light">
        <h2 class="t-3" id="npop-skip">{t.path.skip.title}</h2>
        <p>{t.path.skip.line}</p>
        <div class="nplay-today__btns">
          <button type="button" class="btn" data-skip-go>{t.path.skip.go}</button>
          <button type="button" class="btn btn--ghost" data-skip-stay>{t.path.skip.stay}</button>
        </div>
      </div>
    </dialog>

    <dialog class="npop" data-pop="review" aria-labelledby="npop-review">
      <div class="npop__sheet box on-blue-light">
        <button type="button" class="npop__close" data-pop-close aria-label={t.arena.close}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M5 5.4c4.6 4.2 9 8.8 14 13.4M19 5c-4.4 4.8-9.2 9-13.8 14"></path>
          </svg>
        </button>
        <h2 class="t-3" id="npop-review">{t.review.title}</h2>
        <p class="npop__line" data-review-line>{t.review.none}</p>
        <p class="small">{t.review.empty}</p>
        <div>
          <button type="button" class="btn" data-review disabled>{t.review.go}</button>
        </div>
      </div>
    </dialog>

    {
      nostosFlags.activities &&
      (Object.keys(acts) as (keyof typeof acts)[]).map((key) => (
        <section class="section nplay-sec" aria-labelledby={`nplay-${key}`}>
          <div class="wrap">
            <h2 class="t-2 nplay-sec__h" id={`nplay-${key}`}>
              {t.sections[key].title} <span class="nplay-sec__sub">{t.sections[key].sub}</span>
            </h2>
            <ul class="nplay-acts" role="list" data-reveal-group>
              {acts[key].map((a, n) => (
                <li style={`--span:${a.span}`}>
                  <button
                    type="button"
                    class:list={['nplay-act box', a.surface, n % 2 && 'nplay-act--flip']}
                    style={`--box-r:${a.shape}`}
                    data-act={a.id}
                    disabled
                  >
                    <Illustration name={a.symbol} class="nplay-act__mark" note={false} />
                    <span class="nplay-act__text">
                      <span class="nplay-act__name">{t.acts[a.id].name}</span>
                      <span class="nplay-act__desc">{t.acts[a.id].desc}</span>
                      <span class="nplay-act__meta">
                        <span data-count>{a.count}</span>
                        <span data-played></span>
                      </span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    <dialog class="npop npop--wide" data-pop="ascent" aria-labelledby="nplay-ascent">
        <div class="npop__sheet box on-blue nplay-ascent__panel">
          <button type="button" class="npop__close" data-pop-close aria-label={t.arena.close}>
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
              <path d="M5 5.4c4.6 4.2 9 8.8 14 13.4M19 5c-4.4 4.8-9.2 9-13.8 14"></path>
            </svg>
          </button>
          <div class="nplay-ascent__head">
            <h2 class="t-2" id="nplay-ascent">{t.ascent.title}</h2>
            <p class="npop__line" data-path-line>{fill(t.path.overall, { done: 0, n: lessons })}</p>
            <dl class="nplay-stats">
              <div><dt>{t.ascent.xp}</dt><dd data-stat="xp">0</dd></div>
              <div><dt>{t.ascent.streak}</dt><dd data-stat="streak">0</dd></div>
              <div><dt>{t.ascent.known}</dt><dd data-stat="known">0 / {concepts.length}</dd></div>
              <div><dt>{t.ascent.long}</dt><dd data-stat="long">0</dd></div>
            </dl>
          </div>

          {/* The ladder itself: the lowest rung at the foot */}
          <ol class="nplay-rungs" reversed>
            {
              t.rungs.map((r, k) => (
                <li class="nplay-rung" data-rung={k}>
                  <span class="nplay-rung__name">{r[1]}</span>
                  <span class="nplay-rung__line">{r[2]}</span>
                  <span class="nplay-rung__pts">
                    {r[0]} <span data-togo></span>
                  </span>
                </li>
              ))
            }
          </ol>

          <div class="nplay-boxes">
            <h3 class="t-3">{t.ascent.boxes}</h3>
            <p class="small">{t.ascent.boxesIntro}</p>
            <div class="nplay-boxes__bars">
              {
                [0, 1, 2, 3, 4, 5].map((k) => (
                  <div class="nplay-boxes__bar" data-box={k} style="--h:0.04">
                    <span class="nplay-boxes__fill" />
                    <span class="nplay-boxes__n" data-box-n>0</span>
                    <span class="nplay-boxes__k">{k === 0 ? t.ascent.boxNew : t.ascent.box.replace('{n}', String(k))}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="nplay-reset">
            <button type="button" class="btn btn--ghost" data-reset>{t.ascent.reset}</button>
            <div data-reset-area aria-live="polite"></div>
          </div>
        </div>
    </dialog>

    <dialog class="narena" data-arena aria-labelledby="narena-title">
      <div class="narena__sheet box"></div>
    </dialog>
  </div>
</Base>

{
  scenes.length > 0 && (
    <svg class="visually-hidden" aria-hidden="true" focusable="false">
      {scenes.map((sc) => (
        <symbol id={`njenv-${sc.id}`} viewBox={sc.viewBox} set:html={`<g${sc.attrs}>${sc.inner}</g>`} />
      ))}
    </svg>
  )
}
<script type="application/json" data-nplay-words set:html={JSON.stringify(words)} />
<script type="application/json" data-npath set:html={JSON.stringify(pathOutline)} />

<script>
  import '../../scripts/nostos-play';

  // the journey's places: whichever chapter crosses the middle of the window shows its place; a place
  // shared by several chapters stays as it is, and past the journey (at the foot) none shows
  let watch: IntersectionObserver | undefined;
  document.addEventListener('astro:page-load', () => {
    watch?.disconnect();
    const layer = document.querySelector<HTMLElement>('[data-scenes]');
    if (!layer) return;
    const show = (id: string | null) =>
      layer.querySelectorAll<SVGElement>('[data-scene]').forEach((sc) => sc.classList.toggle('is-on', sc.dataset.scene === id));
    const mark = (stage: string | null) => {
      document.querySelectorAll<HTMLElement>('[data-rail]').forEach((m) => m.classList.toggle('is-here', m.dataset.rail === stage));
      // past the journey (at the foot of the page) the rail steps aside
      document.querySelector('.njrail')?.classList.toggle('is-away', !stage);
    };
    const inView = new Set<HTMLElement>();
    watch = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? inView.add(e.target as HTMLElement) : inView.delete(e.target as HTMLElement)));
        show([...inView][0]?.dataset.chScene ?? null);
        mark([...inView][0]?.dataset.chStage ?? null);
      },
      { rootMargin: '-50% 0px -50% 0px' },
    );
    document.querySelectorAll<HTMLElement>('[data-ch-scene]').forEach((section) => watch!.observe(section));
  });
  document.addEventListener('astro:before-swap', () => watch?.disconnect());
</script>

