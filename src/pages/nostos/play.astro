---
// Nostos, Play: ten short activities drawn from her talks, and Diotima's ladder as the visitor's
// progress (tasks/nostos.md, Play and Progress). The menu and the ladder are in the page; each activity
// runs in one dialog (src/scripts/nostos-play.ts) and fetches its own material when it starts.
// Not in the sitemap and noindex until launch. THE CONTENT IS NEW WORDING for Athena to review.
import Base from '../../layouts/Base.astro';
import NostosNav from '../../components/nostos/NostosNav.astro';
import Illustration from '../../components/Illustration.astro';
import { nostosUi } from '../../data/nostos/ui';
import {
  concepts,
  distinctions,
  edges,
  etymologies,
  lines,
  myths,
  nostosFlags,
  practices,
  quiz,
  sequences,
  talkUrl,
} from '../../lib/nostos';
import { askedTotal, pathOutline } from '../../lib/nostos-path';
import { getLocale, mainLocale, pathIn } from '../../lib/locale';

const locale = getLocale(Astro.url);
const ui = nostosUi[mainLocale(locale)];
const t = ui.play;
const cards = concepts.filter((c) => c.greek && c.take).length;
const count = (text: string, n: number) => text.replace('{n}', String(n));

// Each activity: its symbol, its paper, its shape and how much of the row it takes, so the menu is not
// a grid of identical cards (DESIGN, Avoid)
type Act = { id: keyof typeof t.acts; symbol: string; surface: string; shape: string; span: number; count: string };
const acts: Record<'remember' | 'understand' | 'own', Act[]> = {
  remember: [
    { id: 'cards', symbol: 'tetractys', surface: 'on-blue-light', shape: 'var(--r-soft)', span: 7, count: count(t.acts.cards.count, cards) },
    { id: 'match', symbol: 'bow-lyre', surface: '', shape: 'var(--r-pebble-2)', span: 5, count: t.acts.match.none },
    { id: 'quiz', symbol: 'tripod', surface: 'on-blue-deep', shape: 'var(--r-leaf)', span: 5, count: count(t.acts.quiz.count, quiz.length) },
    { id: 'tf', symbol: 'torch', surface: 'box--deep', shape: 'var(--r-soft-2)', span: 7, count: t.acts.tf.none },
  ],
  understand: [
    { id: 'ladder', symbol: 'ladder', surface: 'on-blue', shape: 'var(--r-soft-2)', span: 5, count: count(t.acts.ladder.count, sequences.filter((s) => s.steps?.length >= 3 && s.steps.length <= 9).length) },
    { id: 'myth', symbol: 'orphic-egg', surface: '', shape: 'var(--r-pebble-1)', span: 7, count: count(t.acts.myth.count, myths.filter((m) => m.beats?.length >= 2).length) },
    { id: 'forge', symbol: 'wheat', surface: 'box--deep', shape: 'var(--r-soft)', span: 7, count: count(t.acts.forge.count, etymologies.filter((e) => e.parts?.length >= 2 && e.parts.length <= 4).length) },
    { id: 'fork', symbol: 'spring-cypress', surface: 'on-blue-light', shape: 'var(--r-leaf)', span: 5, count: count(t.acts.fork.count, distinctions.filter((d) => d.a && d.b && d.a_gloss && d.b_gloss).length) },
    { id: 'links', symbol: 'olive-branch', surface: 'on-blue-deep', shape: 'var(--r-pebble-1)', span: 7, count: count(t.acts.links.count, edges.filter((e) => e.her && e.why && e.why.length > 12).length) },
  ],
  own: [
    { id: 'threads', symbol: 'butterfly', surface: 'on-blue-deep', shape: 'var(--r-pebble-3)', span: 6, count: count(t.acts.threads.count, 0) },
    { id: 'askesis', symbol: 'cave-sun', surface: 'on-blue-light', shape: 'var(--r-soft)', span: 6, count: count(t.acts.askesis.count, practices.length) },
    ...(nostosFlags.claude
      ? ([
          { id: 'spar', symbol: 'monad', surface: '', shape: 'var(--r-soft-2)', span: 6, count: t.acts.spar.count },
          { id: 'teach', symbol: 'olive-branch', surface: 'on-blue', shape: 'var(--r-pebble-1)', span: 6, count: t.acts.teach.count },
        ] as Act[])
      : []),
  ],
};
const line = lines[0];
const words = { ...t, groups: ui.groups, uncertain: ui.note.uncertain };
const labels = Object.fromEntries(concepts.map((c) => [c.id, c.label]));
const fill = (text: string, values: Record<string, string | number>) =>
  text.replace(/\{(\w+)\}/g, (_, k) => String(values[k] ?? ''));
const lessons = pathOutline.reduce((n, c) => n + c.lessons.length, 0);
---

<Base title={`${t.metaTitle} | ATHENOA`} description={t.metaDescription} noindex>
  <div
    data-nplay
    data-feed-src="/nostos/data/"
    data-map-href={pathIn(locale, '/nostos/')}
    data-asked={askedTotal}
    data-stars={concepts.length}
    data-labels={JSON.stringify(labels)}
  >
    <section class="section nplay-top">
      <div class="wrap">
        <header class="nostos-head">
          <NostosNav />
          <h1 class="t-1" data-split>{t.title}</h1>
          <p class="lead nostos-intro" data-reveal>{t.intro}</p>
        </header>

        <div class="nplay-today" data-reveal>
          <div class="nplay-path box on-blue">
            <p class="nplay-path__h">
              {t.path.title} · <span data-path-chapter>{fill(t.path.chapter, { i: 1, n: pathOutline.length })}</span>
            </p>
            <h2 class="nplay-path__title" lang="en" data-path-title>{pathOutline[0].title}</h2>
            <ol class="nplay-stones" role="list" data-path-stones>
              {pathOutline[0].lessons.map(() => (
                <li>
                  <span class="nstone" />
                </li>
              ))}
            </ol>
            <p class="nplay-path__line" data-path-line>{fill(t.path.overall, { done: 0, n: lessons })}</p>
            <p class="nplay-path__intro">{t.path.intro}</p>
            <div class="nplay-today__btns">
              <button type="button" class="btn" data-path-go>{t.path.begin}</button>
            </div>
          </div>
          <div class="nplay-side">
            <div class="nplay-review box on-blue-light">
              <p class="nplay-path__h">{t.review.title}</p>
              <p class="nplay-review__line" data-review-line>{t.review.none}</p>
              <p class="nplay-review__note">{t.review.empty}</p>
              <div class="nplay-today__btns">
                <button type="button" class="btn" data-review disabled>{t.review.go}</button>
                <button type="button" class="btn btn--ghost" data-surprise>{t.surprise}</button>
              </div>
            </div>
            {
              line && (
                <figure class="nplay-line">
                  <blockquote class="hand hand--m" lang="en">{line.text}</blockquote>
                  <figcaption class="small">
                    <a href={talkUrl(line.talk!, line.t)} target="_blank" rel="noopener">{t.herLine}</a>
                  </figcaption>
                </figure>
              )
            }
          </div>
        </div>
        <p class="nplay-nojs">
          {t.noScript} <a href={pathIn(locale, '/nostos/')}>{t.mapLink}</a>
        </p>
      </div>
    </section>

    {
      (Object.keys(acts) as (keyof typeof acts)[]).map((key) => (
        <section class="section nplay-sec" aria-labelledby={`nplay-${key}`}>
          <div class="wrap">
            <h2 class="t-2 nplay-sec__h" id={`nplay-${key}`}>
              {t.sections[key].title} <span class="nplay-sec__sub">{t.sections[key].sub}</span>
            </h2>
            <ul class="nplay-acts" role="list" data-reveal-group>
              {acts[key].map((a, n) => (
                <li style={`--span:${a.span}`}>
                  <button
                    type="button"
                    class:list={['nplay-act box', a.surface, n % 2 && 'nplay-act--flip']}
                    style={`--box-r:${a.shape}`}
                    data-act={a.id}
                    disabled
                  >
                    <Illustration name={a.symbol} class="nplay-act__mark" note={false} />
                    <span class="nplay-act__text">
                      <span class="nplay-act__name">{t.acts[a.id].name}</span>
                      <span class="nplay-act__desc">{t.acts[a.id].desc}</span>
                      <span class="nplay-act__meta">
                        <span data-count>{a.count}</span>
                        <span data-played></span>
                      </span>
                    </span>
                  </button>
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    <section class="section nplay-ascent" aria-labelledby="nplay-ascent">
      <div class="wrap">
        <div class="panel panel--big on-blue nplay-ascent__panel">
          <div class="nplay-ascent__head">
            <h2 class="t-2" id="nplay-ascent">{t.ascent.title}</h2>
            <p>{t.ascent.intro}</p>
            <dl class="nplay-stats">
              <div><dt>{t.ascent.xp}</dt><dd data-stat="xp">0</dd></div>
              <div><dt>{t.ascent.streak}</dt><dd data-stat="streak">0</dd></div>
              <div><dt>{t.ascent.known}</dt><dd data-stat="known">0 / {concepts.length}</dd></div>
              <div><dt>{t.ascent.long}</dt><dd data-stat="long">0</dd></div>
            </dl>
          </div>

          {/* The ladder itself: the lowest rung at the foot */}
          <ol class="nplay-rungs" reversed>
            {
              t.rungs.map((r, k) => (
                <li class="nplay-rung" data-rung={k}>
                  <span class="nplay-rung__name">{r[1]}</span>
                  <span class="nplay-rung__line">{r[2]}</span>
                  <span class="nplay-rung__pts">
                    {r[0]} <span data-togo></span>
                  </span>
                </li>
              ))
            }
          </ol>

          <div class="nplay-boxes">
            <h3 class="t-3">{t.ascent.boxes}</h3>
            <p class="small">{t.ascent.boxesIntro}</p>
            <div class="nplay-boxes__bars">
              {
                [0, 1, 2, 3, 4, 5].map((k) => (
                  <div class="nplay-boxes__bar" data-box={k} style="--h:0.04">
                    <span class="nplay-boxes__fill" />
                    <span class="nplay-boxes__n" data-box-n>0</span>
                    <span class="nplay-boxes__k">{k === 0 ? t.ascent.boxNew : t.ascent.box.replace('{n}', String(k))}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <div class="nplay-known">
            <h3 class="t-3">{t.ascent.knownTitle}</h3>
            <div class="nplay-known__list" data-known><p class="small">{t.ascent.knownNone}</p></div>
            <div class="nplay-reset">
              <button type="button" class="btn btn--ghost" data-reset>{t.ascent.reset}</button>
              <div data-reset-area aria-live="polite"></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <dialog class="narena" data-arena aria-labelledby="narena-title">
      <div class="narena__sheet box"></div>
    </dialog>
  </div>
</Base>

<script type="application/json" data-nplay-words set:html={JSON.stringify(words)} />
<script type="application/json" data-npath set:html={JSON.stringify(pathOutline)} />

<script>
  import '../../scripts/nostos-play';
</script>

<style>
  .nplay-top {
    padding-top: var(--space-l);
    padding-bottom: var(--space-m);
  }
  .nostos-head {
    display: grid;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
  }
  .nostos-head > * {
    margin: 0;
  }
  /* the Nostos menu at the right, with a little air before the title */
  .nostos-head > :global(.nnav) {
    justify-self: end;
    margin-bottom: var(--space-s);
  }
  @media (max-width: 61.99rem) {
    .nostos-head h1,
    .nostos-intro {
      max-width: 46rem;
    }
  }
  @media (min-width: 62rem) {
    .nostos-head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--space-xl);
      align-items: end;
    }
    .nostos-head > :global(.nnav) {
      grid-column: 1 / -1;
    }
    .nostos-head h1 {
      grid-column: 1;
    }
    .nostos-intro {
      grid-column: 2;
      grid-row: 2;
    }
  }

  /* ---------- the path and Review ---------- */
  .nplay-today {
    display: grid;
    gap: var(--space-m);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .nplay-today {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }
  .nplay-path {
    --box-r: var(--r-soft-2);
    display: grid;
    gap: 0.7rem;
  }
  .nplay-path > p,
  .nplay-review > p {
    margin: 0;
  }
  .nplay-path__h {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .nplay-path__title {
    margin: 0;
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-2);
    line-height: 1.1;
    letter-spacing: var(--title-tracking);
    color: var(--ink-strong);
  }
  .nplay-path__line {
    font-size: var(--step--1);
    color: var(--ink);
  }
  .nplay-path__intro {
    max-width: 38rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  /* the chapter's lessons as stones on the way: walked, here, still ahead */
  .nplay-stones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 0.5rem;
    margin: 0.5rem 0 0.2rem;
    padding: 0;
    list-style: none;
  }
  .nplay-stones :global(li) {
    display: flex;
  }
  .nplay-stones :global(li:nth-child(odd)) {
    translate: 0 0.18rem;
  }
  .nplay-stones :global(.nstone) {
    display: block;
    width: 1.35rem;
    height: 1.1rem;
    padding: 0;
    background: none;
    border: 1.5px solid currentColor;
    border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
    color: var(--ink);
    opacity: 0.45;
    cursor: pointer;
    transition: opacity var(--dur-1) var(--hover-delay);
  }
  .nplay-stones :global(li:nth-child(3n) .nstone) {
    border-radius: 46% 54% 44% 56% / 55% 45% 55% 45%;
  }
  .nplay-stones :global(.nstone.is-done) {
    background: currentColor;
    opacity: 0.85;
  }
  .nplay-stones :global(.nstone.is-here) {
    width: 1.7rem;
    height: 1.4rem;
    background: var(--blue-light);
    border-color: var(--blue-light);
    outline: 1.5px solid currentColor;
    outline-offset: 3px;
    opacity: 1;
  }
  .nplay-stones :global(.nstone:disabled) {
    cursor: default;
  }
  .nplay-stones :global(.nstone:not(:disabled):hover) {
    opacity: 1;
  }
  .nplay-side {
    display: grid;
    gap: var(--space-m);
  }
  .nplay-review {
    --box-r: var(--r-pebble-2);
    display: grid;
    gap: 0.5rem;
  }
  .nplay-review__line {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-1);
    line-height: 1.2;
    color: var(--ink-strong);
  }
  .nplay-review__note {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .nplay-today__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.4rem;
  }
  .nplay-line {
    margin: 0;
  }
  .nplay-line blockquote {
    margin: 0;
    color: var(--ink-strong);
  }
  /* her line is in English: in the English voice face on every version of the site */
  .nplay-line blockquote:lang(en) {
    font-family: 'ATH Hand', var(--font-hand);
  }
  .nplay-line figcaption {
    margin-top: 0.4rem;
  }
  .nplay-line a {
    color: var(--ink-soft);
  }
  .nplay-nojs {
    margin: var(--space-m) 0 0;
  }
  :global(html.nostos-play-live) .nplay-nojs {
    display: none;
  }
  :global(html:not(.nostos-play-live)) .nplay-today__btns {
    display: none;
  }

  /* ---------- the menu ---------- */
  .nplay-sec {
    padding-block: var(--space-m);
  }
  .nplay-sec__h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1rem;
    margin: 0 0 var(--space-m);
  }
  .nplay-sec__sub {
    font-family: var(--font-body);
    font-size: var(--step-0);
    letter-spacing: 0;
    color: var(--ink-soft);
  }
  .nplay-acts {
    display: grid;
    gap: var(--space-m);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48rem) {
    .nplay-acts {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }
    .nplay-acts > li {
      grid-column: span var(--span, 6);
    }
    /* the second of each row sits a little lower, so the row is not a hard line */
    .nplay-acts > li:nth-child(even) {
      margin-top: var(--space-m);
    }
  }
  .nplay-act {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1.2rem;
    align-items: center;
    width: 100%;
    min-height: 100%;
    padding: clamp(1.3rem, 1rem + 1.4vw, 2.2rem);
    color: var(--ink);
    font: inherit;
    text-align: left;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .nplay-act--flip {
    grid-template-columns: minmax(0, 1fr) auto;
  }
  .nplay-act--flip :global(.nplay-act__mark) {
    order: 2;
  }
  .nplay-act:disabled {
    cursor: default;
  }
  .nplay-act :global(.nplay-act__mark) {
    width: clamp(4.2rem, 3rem + 3vw, 6.2rem);
    color: var(--ink-strong);
    transition: transform var(--dur-2) var(--ease-out) var(--hover-delay);
  }
  .nplay-act:not(:disabled):hover :global(.nplay-act__mark) {
    transform: translateY(-0.25rem);
  }
  .nplay-act::before {
    transition: scale var(--dur-2) var(--ease-out) var(--hover-delay);
  }
  .nplay-act:not(:disabled):hover::before {
    scale: 1.015;
  }
  .nplay-act__text {
    display: grid;
    gap: 0.4rem;
  }
  .nplay-act__name {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-2);
    line-height: 1.05;
    letter-spacing: var(--title-tracking);
    color: var(--ink-strong);
  }
  .nplay-act__desc {
    line-height: 1.45;
  }
  .nplay-act__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* ---------- the ascent ---------- */
  .nplay-ascent__panel {
    display: grid;
    gap: var(--space-l);
  }
  @media (min-width: 62rem) {
    .nplay-ascent__panel {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: var(--space-xl);
    }
    .nplay-rungs {
      grid-row: 1 / span 3;
      grid-column: 2;
      align-self: start;
    }
  }
  .nplay-ascent__head > p {
    margin: var(--space-xs) 0 var(--space-m);
  }
  .nplay-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.5rem;
    margin: 0;
  }
  .nplay-stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.1rem;
  }
  .nplay-stats dt {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .nplay-stats dd {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--step-2);
    line-height: 1;
    font-variant-numeric: lining-nums;
    color: var(--ink-strong);
  }
  /* Diotima's ladder: two rails and seven rungs, the lowest at the foot */
  .nplay-rungs {
    position: relative;
    display: flex;
    flex-direction: column-reverse;
    margin: 0;
    padding: 0 1.4rem;
    list-style: none;
  }
  .nplay-rungs::before,
  .nplay-rungs::after {
    content: '';
    position: absolute;
    top: -0.6rem;
    bottom: -0.6rem;
    width: 2px;
    border-radius: 2px;
    background: var(--ink);
    opacity: 0.55;
  }
  .nplay-rungs::before {
    left: 0.4rem;
  }
  .nplay-rungs::after {
    right: 0.4rem;
  }
  .nplay-rung {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.1rem 1rem;
    padding: 0.8rem 0.9rem 0.9rem;
    opacity: 0.6;
  }
  /* the rung itself, rail to rail, under the words */
  .nplay-rung::after {
    content: '';
    position: absolute;
    left: -1rem;
    right: -1rem;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    opacity: 0.55;
  }
  .nplay-rung.is-reached {
    opacity: 1;
  }
  .nplay-rung.is-here {
    border-radius: 1.4rem 1.1rem 1.5rem 1.2rem / 1.2rem 1.5rem 1.1rem 1.4rem;
    background: var(--creme);
    color: var(--blue-deep);
    --ink-strong: var(--blue);
    --ink-soft: color-mix(in srgb, var(--blue-deep) 72%, var(--creme));
  }
  .nplay-rung__name {
    font-family: var(--font-title);
    font-size: var(--step-1);
    line-height: 1.15;
    color: var(--ink-strong);
  }
  .nplay-rung__line {
    grid-column: 1;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }
  .nplay-rung__pts {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-size: var(--step--1);
    font-variant-numeric: lining-nums tabular-nums;
    text-align: right;
    color: var(--ink-soft);
  }
  .nplay-rung__pts span {
    display: block;
  }
  .nplay-boxes h3,
  .nplay-known h3 {
    margin: 0 0 0.4rem;
  }
  .nplay-boxes__bars {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.5rem;
    align-items: end;
    height: 9rem;
    margin-top: var(--space-s);
  }
  .nplay-boxes__bar {
    display: grid;
