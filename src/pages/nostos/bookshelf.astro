<style is:global>
  /* ---------- the book, off the shelf ---------- */
  .nstage {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 1rem;
    border: 0;
    background: none;
    overflow: hidden;
    perspective: 2200px;
  }
  .nstage[open] {
    display: grid;
    place-items: center;
  }
  .nstage::backdrop {
    background: color-mix(in srgb, var(--blue-deep, #071260) 55%, transparent);
  }
  html:has(dialog.nstage[open]) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  html.motion .nstage[open] {
    transition: opacity 0.45s var(--ease-out);
  }
  @starting-style {
    html.motion .nstage[open] {
      opacity: 0;
    }
  }
  html.motion .nstage.is-leaving {
    opacity: 0;
  }
  .nstage__close {
    position: fixed;
    top: max(0.9rem, env(safe-area-inset-top, 0px));
    right: max(0.9rem, env(safe-area-inset-right, 0px));
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    color: var(--ink-strong);
    background: var(--creme-light);
    border: 1.5px solid var(--line);
    border-radius: 1.6rem 1.3rem 1.7rem 1.2rem / 1.3rem 1.7rem 1.2rem 1.6rem;
    cursor: pointer;
    transition:
      background-color var(--dur-1) var(--hover-delay),
      color var(--dur-1) var(--hover-delay);
  }
  .nstage__close:hover {
    color: var(--creme-light);
    background: var(--ink-strong);
  }
  .nstage__close path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.9;
    stroke-linecap: round;
  }

  .nbook3d {
    --c: var(--blue);
    --ci: var(--creme-light);
    position: relative;
    width: min(52rem, 96vw);
    height: min(36rem, 84vh);
    transform-style: preserve-3d;
  }
  .nbook3d[data-paper='light'] {
    --c: var(--blue-light);
    --ci: var(--blue-deep);
  }
  .nbook3d[data-paper='deep'] {
    --c: var(--blue-deep);
    --ci: var(--creme);
  }
  .nbook3d[data-paper='creme'] {
    --c: var(--creme-deep);
    --ci: var(--blue);
  }
  html.motion .nbook3d {
    transition: transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  /* seen first from the spine, small, as it leaves the shelf */
  .nbook3d.is-closed {
    transform: rotateY(78deg) scale(0.55);
  }
  .nbook3d.is-front {
    transform: translateX(-25%) scale(0.9);
  }
  .nbook3d.is-open {
    transform: none;
  }
  .nbook3d__page,
  .nbook3d__inside {
    overflow: auto;
    overscroll-behavior: contain;
    background-color: var(--creme-light);
    background-image: var(--grain);
    background-size: 400px 400px;
    color: var(--ink);
  }
  .nbook3d__page {
    position: absolute;
    inset: 0 0 0 50%;
    padding: 1.6rem 1.7rem 1.8rem 2rem;
    border-radius: 0.4rem 1.6rem 1.4rem 0.4rem / 0.4rem 1.3rem 1.6rem 0.4rem;
  }
  .nbook3d__cover {
    position: absolute;
    inset: 0 0 0 50%;
    transform-origin: left center;
    transform-style: preserve-3d;
  }
  html.motion .nbook3d__cover {
    transition: transform 1.1s cubic-bezier(0.3, 0.7, 0.2, 1) 0.15s;
  }
  .nbook3d.is-open .nbook3d__cover {
    transform: rotateY(-178deg);
  }
  .nbook3d__outside,
  .nbook3d__inside {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .nbook3d__outside {
    display: grid;
    align-content: space-between;
    justify-items: start;
    gap: 1rem;
    padding: 2.2rem 2rem;
    background: var(--c);
    color: var(--ci);
    border-radius: 0.4rem 1.6rem 1.4rem 0.4rem / 0.4rem 1.3rem 1.6rem 0.4rem;
  }
  .nbook3d__outside p {
    margin: 0;
  }
  .nbook3d__outside .nbook3d__mark {
    width: clamp(5rem, 4rem + 4vw, 8rem);
    color: var(--ci);
    --paper: var(--c);
  }
  .nbook3d__author {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
  }
  .nbook3d__title {
    font-family: var(--font-title);
    font-weight: var(--title-weight);
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: var(--title-tracking);
    overflow-wrap: break-word;
    hyphens: auto;
    max-width: 100%;
  }
  .nbook3d__title:lang(grc) {
    font-family: 'EB Garamond Variable', 'EB Garamond', Garamond, serif;
    font-weight: 500;
    line-height: 1.08;
  }
  .nbook3d__title.is-long {
    font-size: var(--step-2);
  }
  .nbook3d__title.is-longer {
    font-size: var(--step-1);
  }
  .nbook3d__greek {
    font-family: 'EB Garamond Variable', 'EB Garamond', Garamond, serif;
    font-size: var(--step-1);
  }
  .nbook3d__inside {
    transform: rotateY(180deg);
    padding: 1.8rem 1.8rem 1.8rem 1.6rem;
    background-color: var(--creme-deep);
    border-radius: 1.6rem 0.4rem 0.4rem 1.4rem / 1.3rem 0.4rem 0.4rem 1.6rem;
  }
  .nbook3d__spine {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 2.2rem;
    margin-left: -2.2rem;
    background: var(--c);
    filter: brightness(0.8);
    transform-origin: right;
    transform: rotateY(-90deg);
  }
  .nbook3d.is-open .nbook3d__spine {
    opacity: 0;
  }
  .nbook3d__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.8rem;
  }
  .nbook3d__page .nbook__page,
  .nbook3d__inside .nbook__inside {
    display: grid;
    gap: 0.5rem;
  }
  .nbook3d__page > .nbook__inside {
    display: none;
  }

  /* phones: one page; the cover turns away and fades, leaving the page */
  @media (max-width: 47.99rem) {
    .nbook3d {
      height: min(40rem, 86vh);
    }
    .nbook3d__page,
    .nbook3d__cover {
      inset: 0;
    }
    .nbook3d__page {
      padding: 1.5rem 1.3rem 1.6rem;
      border-radius: 1.4rem 1.6rem 1.3rem 1.5rem / 1.5rem 1.3rem 1.6rem 1.4rem;
    }
    .nbook3d__outside {
      border-radius: 1.4rem 1.6rem 1.3rem 1.5rem / 1.5rem 1.3rem 1.6rem 1.4rem;
    }
    .nbook3d.is-front {
      transform: scale(0.92);
    }
    .nbook3d.is-open .nbook3d__cover {
      transform: rotateY(-178deg);
      opacity: 0;
      pointer-events: none;
    }
    html.motion .nbook3d.is-open .nbook3d__cover {
      transition:
        transform 1.1s,
        opacity 0.3s 1s;
    }
    .nbook3d__spine {
      display: none;
    }
    /* the inside of the cover joins the page, at its head */
    .nbook3d__inside {
      display: none;
    }
    .nbook3d__page > .nbook__inside {
      display: grid;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1.5px dashed var(--line);
    }
  }
</style>
