---
// Nostos, the practical guide (client request, 6 November 2026): a private working page for Maria, a
// down-to-earth guide that turns Athena's teaching into phases, habits, a sample day, what to do when
// life hits, love, work, traps and a first month. English only, not in the Nostos menu, not in the
// sitemap, noindex. ALL ITS WORDING IS NEW AND PROPOSED: it lives in src/data/nostos-guide.ts, where
// every step names the talk it comes from.
import Base from '../../layouts/Base.astro';
import NostosNav from '../../components/nostos/NostosNav.astro';
import { talkUrl } from '../../lib/nostos';
import GuideEcho from '../../components/nostos/GuideEcho.astro';
import GuideFigure from '../../components/nostos/GuideFigure.astro';
import GuideSymbol from '../../components/nostos/GuideSymbol.astro';
import { intro, words, phases, habits, meditations, day, hard, love, work, traps, closing, talkShort, echoes, echoNote, maps, kinds, gates, gateNote } from '../../data/nostos-guide';
import type { Src } from '../../data/nostos-guide';

const srcUrl = (s: Src) => talkUrl(s[0], s[1]);
const srcLabel = (s: Src) => `${talkShort[s[0]] ?? 'Talk'}${s[1] ? ` · ${s[1]}` : ''}`;
const slug = (s: string) =>
  'ng-' + s.toLowerCase().normalize('NFD').replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-+|-+$/g, '');

// each step named in the sample day links to where it is explained: the first step of that name owns the anchor
const anchors = new Map<string, string>();
const owners = new WeakSet<object>();
const claim = (item: { name: string }) => {
  if (anchors.has(item.name)) return;
  anchors.set(item.name, slug(item.name));
  owners.add(item);
};
phases.items.forEach((p) => p.do.forEach(claim));
habits.groups.forEach((g) => g.items.forEach(claim));
meditations.items.forEach(claim);
love.items.forEach(claim);
work.items.forEach(claim);
// two moves of the day are explained in "When life hits"
anchors.set('Red boundaries', slug(hard.items[4].when));
anchors.set('Accept in order to act', slug(hard.items[3].when));
const idOf = (item: { name: string }) => (owners.has(item) ? anchors.get(item.name) : undefined);
const fill = (text: string, values: Record<string, string | number>) => text.replace(/\{(\w+)\}/g, (_, k) => String(values[k] ?? ''));

const toc = [
  { href: '#ng-words', label: words.title },
  { href: '#ng-phases', label: phases.title },
  { href: '#ng-habits', label: habits.title },
  { href: '#ng-day', label: day.title },
  { href: '#ng-hard', label: hard.title },
  { href: '#ng-love', label: love.title },
  { href: '#ng-work', label: work.title },
  { href: '#ng-traps', label: traps.title },
];
---

<Base title={`${intro.title}: a practical guide | ATHENOA`} description={intro.sub} noindex>
  <NostosNav />

  <header class="section ng-hero">
    <div class="wrap">
      <p class="ng-eyebrow">{intro.eyebrow}</p>
      <h1 class="t-1 ng-hero__title">{intro.title}</h1>
      <p class="ng-hero__sub">{intro.sub}</p>
      <p class="ng-hero__lead">{intro.lead}</p>
      <figure class="ng-line ng-line--big">
        <blockquote><p>{intro.line.text}</p></blockquote>
        <figcaption>Athena · <a href={srcUrl(intro.line.src)} target="_blank" rel="noopener">{srcLabel(intro.line.src)}</a></figcaption>
      </figure>
      <p class="ng-draft">{intro.note}</p>
      <nav class="ng-toc" aria-label="On this page">
        <ol>
          {toc.map((t, i) => <li><a href={t.href}><span class="ng-toc__n">{i + 1}</span>{t.label}</a></li>)}
        </ol>
      </nav>
    </div>
  </header>

  {/* 1. the big words */}
  <section class="section ng-sec" id="ng-words" aria-labelledby="ng-words-h">
    <div class="wrap">
      <h2 class="t-2" id="ng-words-h">{words.title}</h2>
      <p class="ng-intro">{words.intro}</p>
      <ul class="ng-words" role="list">
        {words.items.map((w) => (
          <li class="ng-word">
            <p class="ng-word__greek" lang="grc">{w.greek}</p>
            <p class="ng-word__latin">{w.latin}</p>
            <p class="ng-word__means">{w.means}</p>
            <p class="ng-word__tuesday"><span>On a Tuesday</span>{w.tuesday}</p>
            <a class="ng-src" href={srcUrl(w.src)} target="_blank" rel="noopener">{srcLabel(w.src)}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 2. the phases */}
  <section class="section ng-sec" id="ng-phases" aria-labelledby="ng-phases-h">
    <div class="wrap">
      <h2 class="t-2" id="ng-phases-h">{phases.title}</h2>
      {phases.intro.map((p) => <p class="ng-intro">{p}</p>)}
      {/* the six steps climb, and the seventh comes back down to the ground */}
      <ol class="ng-stair" aria-label="The seven phases">
        {phases.items.map((p, i) => (
          <li class="ng-stair__step" style={`--lvl: ${i < 6 ? i + 1 : 0}`} data-return={i === 6 ? '' : undefined}>
            <a href={`#ng-phase-${p.id}`}>
              <span class="ng-stair__n">{i + 1}</span>
              <span class="ng-stair__name">{p.name}</span>
              <span class="ng-stair__greek" lang="grc">{p.greek}</span>
            </a>
          </li>
        ))}
      </ol>

      {/* the maps from other places that run through all seven phases (added for this draft) */}
      <aside class="ng-maps" aria-labelledby="ng-maps-h">
        <div class="ng-maps__text">
          <h3 class="t-3" id="ng-maps-h">{maps.title}</h3>
          <p class="ng-intro">{echoNote.intro} <a class="ng-src" href={srcUrl(echoNote.introSrc)} target="_blank" rel="noopener">{srcLabel(echoNote.introSrc)}</a></p>
          <p class="ng-added">{echoNote.added}</p>
          <p class="ng-h4">{echoNote.key}</p>
          <ul class="ng-key" role="list">
            {kinds.map((k) => (
              <li>
                <GuideSymbol kind={k.id} />
                {k.label}
              </li>
            ))}
          </ul>
          <ul class="ng-echoes ng-echoes--maps" role="list">
            {maps.items.map((e, k) => <GuideEcho echo={e} uid={`ng-map-${k}`} big />)}
          </ul>
        </div>
        <GuideFigure image={maps.image} uid="ng-map-fig" />
      </aside>

      {phases.items.map((p, i) => (
        <article class="ng-phase" id={`ng-phase-${p.id}`} aria-labelledby={`ng-phase-${p.id}-h`}>
          <div class="ng-phase__top">
            <header class="ng-phase__head">
              <span class="ng-phase__n" aria-hidden="true">{i + 1}</span>
              <div>
                <p class="ng-phase__greek" lang="grc">{p.greek}</p>
                <h3 class="t-2 ng-phase__name" id={`ng-phase-${p.id}-h`}><span class="visually-hidden">Phase {i + 1}: </span>{p.name}</h3>
                <p class="ng-phase__tag">{p.tagline}</p>
              </div>
            </header>
            {echoes[p.id]?.image && <GuideFigure image={echoes[p.id].image!} uid={`ng-fig-${p.id}`} />}
          </div>
          <div class="ng-phase__body">
            <div class="ng-phase__side">
              <h4 class="ng-h4">What it feels like</h4>
              <ul class="ng-dots">{p.feels.map((f) => <li>{f}</li>)}</ul>
              <h4 class="ng-h4">What shifts</h4>
              <p class="ng-shift">{p.shift}</p>
            </div>
            <div class="ng-phase__main">
              <h4 class="ng-h4">What to do</h4>
              <ol class="ng-steps">
                {p.do.map((s) => (
                  <li class="ng-step" id={idOf(s)}>
                    <p class="ng-step__name">{s.name}</p>
                    <p class="ng-step__how">{s.how}</p>
                    {s.why && <p class="ng-step__why">{s.why}</p>}
                    {s.src && <a class="ng-src" href={srcUrl(s.src)} target="_blank" rel="noopener">{srcLabel(s.src)}</a>}
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <div class="ng-phase__foot">
            <div class="ng-watch">
              <h4 class="ng-h4">Watch out for</h4>
              <ul class="ng-dots">{p.watch.map((w) => <li>{w}</li>)}</ul>
            </div>
            <div class="ng-ladders">
              <h4 class="ng-h4">In Athena’s ladders</h4>
              <ul role="list">
                {p.ladders.map((l) => (
                  <li>
                    <span class="ng-ladders__name">{l.ladder}</span>
                    <span>{l.rung}</span>
                    <a class="ng-src" href={srcUrl(l.src)} target="_blank" rel="noopener">{srcLabel(l.src)}</a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
          {echoes[p.id] && (
            <div class="ng-elsewhere">
              <h4 class="ng-h4">{echoNote.label} <span class="ng-added">{echoNote.added}</span></h4>
              <ul class="ng-echoes" role="list">
                {echoes[p.id].items.map((e, k) => <GuideEcho echo={e} uid={`ng-echo-${p.id}-${k}`} />)}
              </ul>
            </div>
          )}
          {gates[p.id] && (
            <div class="ng-gate" data-gate>
              <div class="ng-gate__head">
                <h4 class="ng-gate__title">
                  <span class="ng-gate__label">{gateNote.label}</span>{' '}
                  {i < phases.items.length - 1 ? fill(gateNote.next, { n: i + 2, name: phases.items[i + 1].name }) : gateNote.last}
                </h4>
                <p class="ng-gate__count" data-gate-count data-text={gateNote.count} aria-live="polite"></p>
              </div>
              <p class="ng-gate__intro">{gateNote.intro}</p>
              <ul class="ng-gate__list" role="list">
                {gates[p.id].map((g, k) => (
                  <li>
                    <label>
                      <input type="checkbox" data-gate-box={`${p.id}-${k}`} />
                      <span>{g}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </article>
      ))}
    </div>
  </section>

  {/* 3. habits, with the meditations written out */}
  <section class="section ng-sec" id="ng-habits" aria-labelledby="ng-habits-h">
    <div class="wrap">
      <h2 class="t-2" id="ng-habits-h">{habits.title}</h2>
      <p class="ng-intro">{habits.intro} <a class="ng-src" href={srcUrl(habits.introSrc)} target="_blank" rel="noopener">{srcLabel(habits.introSrc)}</a></p>
      {habits.groups.map((g) => (
        <div class="ng-group">
          <h3 class="t-3 ng-group__h">{g.label}</h3>
          <ul class="ng-cards" role="list">
            {g.items.map((s) => (
              <li class="ng-step ng-card" id={idOf(s)}>
                <p class="ng-step__name">{s.name}</p>
                <p class="ng-step__how">{s.how}</p>
                {s.why && <p class="ng-step__why">{s.why}</p>}
                {s.src && <a class="ng-src" href={srcUrl(s.src)} target="_blank" rel="noopener">{srcLabel(s.src)}</a>}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="ng-meds">
        <h3 class="t-3 ng-group__h">{meditations.title}</h3>
        <p class="ng-intro">{meditations.intro}</p>
        <ul class="ng-meds__list" role="list">
          {meditations.items.map((m) => (
            <li class="ng-med" id={idOf(m)}>
              <p class="ng-med__name">{m.name}</p>
              <p class="ng-med__mins">{m.mins}</p>
              <ol>{m.steps.map((s) => <li>{s}</li>)}</ol>
              <a class="ng-src" href={srcUrl(m.src)} target="_blank" rel="noopener">{srcLabel(m.src)}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {/* 4. a sample day */}
  <section class="section ng-sec" id="ng-day" aria-labelledby="ng-day-h">
    <div class="wrap">
      <h2 class="t-2" id="ng-day-h">{day.title}</h2>
      {day.intro.map((p) => <p class="ng-intro">{p}</p>)}
      <ol class="ng-day" role="list">
        {day.items.map((d) => (
          <li class="ng-day__item">
            <time class="ng-day__time">{d.time}</time>
            <div class="ng-day__body">
              <p>{d.text}</p>
              <p class="ng-day__uses">
                {d.uses.map((u) => (anchors.has(u) ? <a href={`#${anchors.get(u)}`}>{u}</a> : <span>{u}</span>))}
              </p>
            </div>
          </li>
        ))}
      </ol>
      <p class="ng-after">{day.after} <a class="ng-src" href={srcUrl(day.afterSrc)} target="_blank" rel="noopener">{srcLabel(day.afterSrc)}</a></p>
    </div>
  </section>

  {/* 5. hard moments */}
  <section class="section ng-sec" id="ng-hard" aria-labelledby="ng-hard-h">
    <div class="wrap">
      <h2 class="t-2" id="ng-hard-h">{hard.title}</h2>
      <p class="ng-intro">{hard.intro}</p>
      <p class="ng-care">{hard.care}</p>
      <ul class="ng-cards ng-cards--wide" role="list">
        {hard.items.map((h) => (
          <li class="ng-card ng-hard" id={slug(h.when)}>
            <p class="ng-hard__when">{h.when}</p>
            <ol>{h.steps.map((s) => <li>{s}</li>)}</ol>
            {h.line && (
              <p class="ng-hard__line">
                “{h.line.text}” <a class="ng-src" href={srcUrl(h.line.src)} target="_blank" rel="noopener">{srcLabel(h.line.src)}</a>
              </p>
            )}
            <a class="ng-src" href={srcUrl(h.src)} target="_blank" rel="noopener">{srcLabel(h.src)}</a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* 6 and 7. love; work */}
  {[
    { id: 'ng-love', part: love },
    { id: 'ng-work', part: work },
  ].map(({ id, part }) => (
    <section class="section ng-sec" id={id} aria-labelledby={`${id}-h`}>
      <div class="wrap">
        <h2 class="t-2" id={`${id}-h`}>{part.title}</h2>
        <p class="ng-intro">{part.intro} <a class="ng-src" href={srcUrl(part.introSrc)} target="_blank" rel="noopener">{srcLabel(part.introSrc)}</a></p>
        <ul class="ng-cards" role="list">
          {part.items.map((s) => (
            <li class="ng-step ng-card" id={idOf(s)}>
              <p class="ng-step__name">{s.name}</p>
              <p class="ng-step__how">{s.how}</p>
              {s.why && <p class="ng-step__why">{s.why}</p>}
              {s.src && <a class="ng-src" href={srcUrl(s.src)} target="_blank" rel="noopener">{srcLabel(s.src)}</a>}
            </li>
          ))}
        </ul>
        <figure class="ng-line">
          <blockquote><p>{part.line.text}</p></blockquote>
          <figcaption>Athena · <a href={srcUrl(part.line.src)} target="_blank" rel="noopener">{srcLabel(part.line.src)}</a></figcaption>
        </figure>
      </div>
    </section>
  ))}

  {/* 8. traps */}
  <section class="section ng-sec" id="ng-traps" aria-labelledby="ng-traps-h">
    <div class="wrap">
      <h2 class="t-2" id="ng-traps-h">{traps.title}</h2>
      <p class="ng-intro">{traps.intro}</p>
      <div class="ng-traps">
        {traps.groups.map((g) => (
          <div class="ng-traps__group">
            <h3 class="t-3 ng-group__h">{g.label}</h3>
            <ul role="list">
              {g.items.map((t) => (
                <li class="ng-trap">
                  <p class="ng-trap__trap">{t.trap}</p>
                  <p class="ng-trap__instead"><span>Instead</span>{t.instead}</p>
                  <a class="ng-src" href={srcUrl(t.src)} target="_blank" rel="noopener">{srcLabel(t.src)}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Athena's last word (the first thirty days are gone: client direction, 6 November 2026) */}
  <section class="section ng-end">
    <div class="wrap">
      <figure class="ng-line ng-line--big ng-line--end">
        <blockquote><p>{closing.line.text}</p></blockquote>
        <figcaption>Athena · <a href={srcUrl(closing.line.src)} target="_blank" rel="noopener">{srcLabel(closing.line.src)}</a></figcaption>
      </figure>
    </div>
  </section>
</Base>

<script>
  // a parallel's link to its phase: on hover (CSS), or on a tap or a click, one at a time; Escape or a
  // tap elsewhere closes it
  const shut = (keep?: Element | null) =>
    document.querySelectorAll('[data-echo].is-open').forEach((el) => {
      if (el === keep) return;
      el.classList.remove('is-open');
      el.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
    });
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest?.('.ng-echo__btn, .ng-fig__btn');
    const host = btn?.closest('[data-echo]') ?? null;
    shut(host);
    if (!btn || !host) return;
    btn.setAttribute('aria-expanded', String(host.classList.toggle('is-open')));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') shut();
  });

  // the gates: what is ticked is kept in this browser only
  const KEY = 'nostos-guide-gates';
  let ticked: string[] = [];
  try {
    ticked = JSON.parse(localStorage.getItem(KEY) || '[]');
  } catch {}
  const boxes = [...document.querySelectorAll<HTMLInputElement>('[data-gate-box]')];
  const tally = () =>
    document.querySelectorAll<HTMLElement>('[data-gate]').forEach((gate) => {
      const own = [...gate.querySelectorAll<HTMLInputElement>('[data-gate-box]')];
      const on = own.filter((b) => b.checked).length;
      const out = gate.querySelector<HTMLElement>('[data-gate-count]');
      if (out) out.textContent = (out.dataset.text ?? '').replace('{k}', String(on)).replace('{n}', String(own.length));
      gate.classList.toggle('is-through', on === own.length);
    });
  for (const box of boxes) {
    box.checked = ticked.includes(box.dataset.gateBox!);
    box.addEventListener('change', () => {
      try {
        localStorage.setItem(KEY, JSON.stringify(boxes.filter((b) => b.checked).map((b) => b.dataset.gateBox)));
      } catch {}
      tally();
    });
  }
  tally();
</script>

<style>
  .ng-hero {
    padding-bottom: var(--space-l);
  }
  .ng-eyebrow {
    margin: 0 0 0.6rem;
    font-size: calc(var(--step-0) * 0.8);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ng-hero__title {
    margin: 0;
  }
  .ng-hero__sub {
    margin: 0.4rem 0 0;
    font-family: var(--font-title);
    font-size: var(--step-2);
    line-height: 1.15;
    color: var(--ink-strong);
  }
  .ng-hero__lead {
    max-width: var(--measure);
    margin: var(--space-m) 0 0;
    font-size: var(--step-1);
    line-height: 1.4;
  }
  .ng-draft {
    max-width: var(--measure);
    margin: var(--space-m) 0 0;
    padding: 0.9rem 1.2rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
    border: 1.5px dashed var(--line);
    border-radius: 1.2rem 1rem 1.3rem 1.1rem / 1.1rem 1.3rem 1rem 1.2rem;
  }
  .ng-toc ol {
    display: grid;
    gap: 0.2rem 2rem;
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 40rem) {
    .ng-toc ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 48rem;
    }
  }
  @media (min-width: 64rem) {
    .ng-toc ol {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: none;
    }
  }
  .ng-toc a {
    display: flex;
    gap: 0.7rem;
    align-items: baseline;
    padding: 0.45rem 0;
    color: var(--ink-strong);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .ng-toc a:hover {
    color: var(--blue);
  }
  .ng-toc__n {
    min-width: 1.2rem;
    font-family: var(--font-title);
    color: var(--ink-soft);
  }

  /* sections */
  .ng-sec {
    border-top: 1px solid var(--line);
  }
  .ng-sec h2 {
    margin: 0 0 var(--space-s);
  }
  .ng-intro {
    max-width: var(--measure);
    margin: 0 0 0.9rem;
  }
  .ng-h4 {
    margin: 1.2rem 0 0.5rem;
    font-family: var(--font-body);
    font-size: calc(var(--step-0) * 0.78);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .ng-h4:first-child {
    margin-top: 0;
  }
  .ng-dots {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ng-dots li {
    position: relative;
    padding-left: 1.3em;
  }
  .ng-dots li + li {
    margin-top: 0.45em;
  }
  .ng-dots li::before {
    content: '';
    position: absolute;
    left: 0.15em;
    top: 0.6em;
    width: 0.45em;
    height: 0.45em;
    border-radius: 50%;
    background: var(--blue);
    opacity: 0.6;
  }
  .ng-src {
    display: inline-block;
    font-size: var(--step--1);
    color: var(--ink-soft);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .ng-src::before {
    content: '↗ ';
  }
  .ng-src:hover {
    color: var(--blue);
    border-bottom-color: currentColor;
  }

  /* quotes */
  .ng-line {
    max-width: 40rem;
    margin: var(--space-l) 0 0;
  }
  .ng-line blockquote {
    margin: 0;
  }
  .ng-line blockquote p {
    margin: 0;
    font-family: var(--font-title);
    font-size: var(--step-2);
    line-height: 1.2;
    color: var(--blue-deep);
  }
  .ng-line blockquote p::before {
    content: '“';
  }
  .ng-line blockquote p::after {
    content: '”';
  }
  .ng-line--big blockquote p {
    font-size: var(--step-3);
  }
  .ng-line figcaption {
