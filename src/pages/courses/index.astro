---
// Courses: every course on the same arch card, two to a row, each on its own colour of paper
// (CourseCard.astro). The course that is open comes first.
// Each card links to its own page; with JavaScript the link opens the course popup instead.
// The same file renders /courses/ and /el/courses/: the copy follows the address.
import Base from '../../layouts/Base.astro';
import Illustration from '../../components/Illustration.astro';
import CourseCard from '../../components/courses/CourseCard.astro';
import CourseDialog from '../../components/courses/CourseDialog.astro';
import { trail } from '../../components/courses/trail';
import { content } from '../../data';
import { breadcrumbSchema, courseSchema } from '../../data/schema';
import { getLocale } from '../../lib/locale';

const locale = getLocale(Astro.url);
const { courses, coursesPage, site } = content(locale);
const lead = courses.find((course) => course.status === 'open') ?? courses[0];
const others = courses.filter((course) => course !== lead);
---

<Base
  title={`${coursesPage.title} | ${site.name}`}
  description={coursesPage.description}
  schema={[breadcrumbSchema(trail(locale)), ...courses.map(courseSchema)]}
>
  <section class="courses section">
    <div class="wrap">
      <header class="courses__head">
        <h1 class="t-hero" data-split>{coursesPage.title}</h1>
        {/* The tetractys, the Pythagorean figure of the ten, on a light blue pebble */}
        <Illustration name="tetractys" class="courses__mark" draw />
        <p class="courses__line hand hand--l" data-reveal style="--delay:300ms">
          {coursesPage.description}
        </p>
      </header>

      <div class="courses__list">
        {[lead, ...others].map((course, i) => <CourseCard course={course} priority={i < 2} />)}
      </div>
    </div>
  </section>

  {courses.map((course) => <CourseDialog course={course} />)}
</Base>

<style>
  .courses {
    padding-block: calc(var(--space-l) + 0.5rem) var(--space-m);
  }
  /* Title and symbol side by side; the line in Athena's voice runs under them on a small screen */
  .courses__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-s) clamp(0.75rem, 3vw, 1.75rem);
    margin-bottom: var(--space-l);
  }
  /* Greek is set in the fallback face, which runs wider than the title face: a step smaller,
     so the title still fits beside the symbol on a phone */
  .courses__head h1:lang(el) {
    font-size: calc(clamp(3.4rem, 1.4rem + 9.6vw, 11.5rem) * 0.86);
  }
  .courses__line {
    grid-column: 1 / -1;
    max-width: 30ch;
  }
  .courses__mark {
    --mark: clamp(3.5rem, 1rem + 12vw, 10rem);
    position: relative;
    isolation: isolate;
    grid-column: 2;
    grid-row: 1;
    width: var(--mark);
    /* Room for the pebble, whose edge then lines up with the cards below */
    margin: calc(var(--mark) * 0.24);
  }
  .courses__mark::before {
    content: '';
    position: absolute;
    inset: -24%;
    z-index: -1;
    border-radius: var(--r-pebble-1);
    background-color: var(--blue-light);
    background-image: var(--grain);
    background-size: 400px 400px;
    filter: url(#rough-sm);
  }

  .courses__list {
    display: grid;
    gap: var(--space-l) var(--space-m);
  }
  .courses__list > :global(.card) {
    width: min(100%, 34rem);
  }

  /* One even row: two equal columns, so the cards are the same width and their pictures the same size.
     The cards start and end on the same lines (each lets its words take up the slack). */
  @media (min-width: 48rem) {
    .courses__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-l);
    }
    .courses__list > :global(.card) {
      width: auto;
    }
  }
  @media (min-width: 62rem) {
    .courses__head {
      margin-bottom: var(--space-xl);
    }
    .courses__line {
      grid-column: 1;
    }
    .courses__mark {
      grid-row: 1 / span 2;
    }
  }
</style>
