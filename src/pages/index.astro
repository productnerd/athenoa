---
// PROVISIONAL home page: shows whichever home sections exist so far, so the build can be watched.
// It is replaced by explicit imports once the hero is chosen and every section has landed.
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import Base from '../layouts/Base.astro';
import { content } from '../data';
import { getLocale } from '../lib/locale';
import { organizationSchema, websiteSchema } from '../data/schema';

const { home } = content(getLocale(Astro.url));
const found = import.meta.glob<{ default: AstroComponentFactory }>('../components/home/*.astro', { eager: true });
const order = ['Membership', 'Announcement', 'Seminar', 'Series', 'CourseTabs', 'Transmission', 'Start', 'Benefits'];
const sections = order.map((name) => found[`../components/home/${name}.astro`]?.default).filter(Boolean);
const highlight = home.hero.highlight;
---

<Base title={home.meta.title} description={home.meta.description} schema={[organizationSchema(getLocale(Astro.url)), websiteSchema(getLocale(Astro.url))]}>
  <section class="section wrap provisional-hero">
    <h1 class="t-hero" data-split>
      {
        home.hero.titleLines.map((line, n) => {
          const at = line.indexOf(highlight);
          // The first line is the title; what follows is its subtitle, set smaller.
          if (at < 0) return <span class:list={['line', n > 0 && 't-sub']}>{n > 0 ? home.hero.subtitle : line}</span>;
          return (
            <span class="line">
              {line.slice(0, at)}
              <span class="hl">
                {highlight.split(' ').map((word, n) => (
                  <>
                    {n > 0 && ' '}
                    <span class="hl__w">{word}</span>
                  </>
                ))}
              </span>
              {line.slice(at + highlight.length)}
            </span>
          );
        })
      }
    </h1>
  </section>
  {sections.map((Section) => <Section />)}
</Base>

<style>
  .provisional-hero {
    padding-block: var(--space-xl) var(--space-l);
  }
  .line {
    display: block;
  }
</style>
