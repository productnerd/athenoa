---
// Home. One page, top to bottom: the night hero, then the sections of the live home page in their order
// (the "new course series" intro was removed at the client's request; its course detail remains).
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import HeroDive from '../components/home/HeroDive.astro';
import Membership from '../components/home/Membership.astro';
import Announcement from '../components/home/Announcement.astro';
import Seminar from '../components/home/Seminar.astro';
import CourseTabs from '../components/home/CourseTabs.astro';
import Transmission from '../components/home/Transmission.astro';
import Start from '../components/home/Start.astro';
import Benefits from '../components/home/Benefits.astro';
import { content } from '../data';
import { organizationSchema, websiteSchema } from '../data/schema';
import { getLocale } from '../lib/locale';

const locale = getLocale(Astro.url);
const { home } = content(locale);
---

<Base
  title={home.meta.title}
  description={home.meta.description}
  schema={[organizationSchema(locale), websiteSchema(locale)]}
  bodyClass="has-hero"
>
  {/* EXPERIMENT (branch experiment/temple-dive): the scroll dive into the temple (HeroDive.astro) */}
  <div class="dive" data-dive>
    <Hero />
    <div class="dive__room" aria-hidden="true"></div>
  </div>
  <HeroDive />
  <Membership />
  <Announcement />
  <Seminar />
  <CourseTabs />
  <Transmission />
  <Start />
  <Benefits />
</Base>
