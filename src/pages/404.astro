---
// Not found. A laurel hangs in an arched window above the sea; two ways lead back into the site.
// The only words here that are not in the data are "Page not found".
import Base from '../layouts/Base.astro';
import Illustration from '../components/Illustration.astro';
import { site } from '../data/site';

const message = 'Page not found';
const ways = [site.nav[0], site.nav[2]];
---

<Base title={`${message} | ${site.name}`} description={message} noindex>
  <section class="section lost">
    <div class="wrap lost__grid">
      <div class="lost__text">
        <h1 class="t-1" data-split>{message}</h1>
        <p class="lost__ways" data-reveal style="--delay: 350ms">
          {ways.map((way, i) => <a class:list={['btn', i > 0 && 'btn--ghost']} href={way.href}>{way.label}</a>)}
        </p>
      </div>

      <div class="lost__sea" data-depth="0.1">
        <Illustration name="waves" draw />
      </div>

      <div class="lost__window panel panel--arch on-blue" data-reveal="fade">
        <div class="panel__clip">
          <div class="lost__rays" data-depth="0.3">
            <Illustration name="sun-rays" />
          </div>
        </div>
        <div class="lost__mark" data-depth="-0.08">
          <Illustration name="laurel" draw />
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* The words sit low on the left, the window stands taller on the right with its foot in the sea,
     and the sea runs behind both from edge to edge. */
  .lost {
    padding-block: var(--space-l) var(--space-xl);
    overflow-x: clip;
  }
  .lost__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-l);
  }
  .lost__text {
    grid-area: 1 / 1;
    position: relative;
    z-index: 2;
  }
  .lost__ways {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s) var(--space-m);
    margin-top: var(--space-l);
  }

  .lost__window {
    grid-area: 2 / 1 / 4 / 2;
    z-index: 1;
    justify-self: end;
    display: grid;
    place-items: end center;
    width: min(70%, 16rem);
    aspect-ratio: 5 / 7;
    padding: 0 0 12%;
    margin: 0 6% var(--space-s) 0;
    rotate: 1.5deg;
  }
  .lost__rays {
    position: absolute;
    left: 50%;
    top: 60%;
    width: 190%;
    margin: -95% 0 0 -95%;
    opacity: 0.4;
  }
  .lost__mark {
    width: 50%;
  }

  .lost__sea {
    grid-area: 3 / 1;
    z-index: 0;
    width: 230%;
    margin-left: -90%;
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .lost {
      padding-block: var(--space-m) var(--space-xl);
    }
    .lost__grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      grid-template-rows: minmax(22rem, 1fr) auto;
      column-gap: var(--gutter);
      row-gap: 0;
    }
    .lost__text {
      align-self: end;
      padding-bottom: var(--space-l);
    }
    .lost__window {
      grid-area: 1 / 2 / 3 / 3;
      align-self: end;
      width: min(100%, 22rem);
      margin: 0 10% var(--space-m) 0;
    }
    .lost__sea {
      grid-area: 2 / 1 / 3 / -1;
      width: calc(100% + 2 * var(--gutter));
      margin-left: calc(var(--gutter) * -1);
    }
  }
</style>
