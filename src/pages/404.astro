---
// Not found. The page ends on its own sea, so the footer is switched off.
// A static site serves this one page for every missing address: the scene carries the words of
// both languages and shows the Greek ones on addresses that begin with /el/ (see NotFoundScene).
import Base from '../layouts/Base.astro';
import NotFoundScene from '../components/notfound/NotFoundScene.astro';
import { notfound } from '../data/notfound';
import { site } from '../data/site';
---

<Base title={`${notfound.en.heading} | ${site.name}`} description={notfound.en.line} noindex footer={false}>
  <NotFoundScene />
</Base>
